{% assign sq_bfl_new_ps_sub = "function subcategory(p,cat){var s=semanticText(p),c=n(cat),type=n(p&&p.product_type);if(cfg.mode==='law'||cfg.mode==='fire'){var ps=titleType(p),pt=n(p&&p.product_type);if(/\\b(burial flag cases?|flag display cases?|flag & medal display cases?|frames?|shadow boxes?|display cases?|memorial cases?)\\b/.test(pt)||/\\b(flag case|flag display case|burial flag|shadow box|display frame)\\b/.test(ps))return'Displays & Memorials';if(/\\b(art prints?|posters?|wall art|wall decor|plaques?)\\b/.test(pt)||/\\b(art print|poster|wall art|wall decor|plaque)\\b/.test(ps))return'Art & Decor';if(/\\b(books?|paperbacks?|hardcovers?|manuals?|reference|study guides?|training guides?|field guides?|handbooks?)\\b/.test(pt)||/\\b(book|paperback|hardcover|manual|reference|study guide|training guide|field guide|handbook)\\b/.test(ps))return'Books & Training';if(/\\b(stickers?|decals?|sticker & decal packs?|patches?)\\b/.test(pt)||/\\b(sticker|decal|patch)\\b/.test(ps))return'Patches, Decals & Support';if(/\\b(toys?|games?|coins?|medallions?|collectibles?|gifts?|ornaments?|keychains?)\\b/.test(pt)||/\\b(toy|game|coin|medallion|collectible|gift|ornament|keychain)\\b/.test(ps))return'Gifts & Collectibles';if(/\\b(apparel|uniforms?|shirts?|t-shirts?|hoodies?|sweatshirts?|polos?|pants?|trousers?|shorts?|headwear|hats?|caps?|beanies?)\\b/.test(pt)||/\\b(t-shirt|tee|hoodie|sweatshirt|polo|shirt|pants|trousers|shorts|uniform|apparel|hat|cap|beanie|headwear)\\b/.test(ps))return'Uniforms & Apparel';if(/\\b(rank|insignia|badges?|devices?|nameplates?|identification)\\b/.test(pt)||/\\b(rank|insignia|badge|device|nameplate|name plate|collar device|lapel pin)\\b/.test(ps))return'Rank, Insignia & Identification';if(/\\b(first aid|medical|trauma|bleeding control|tourniquet|bandage|gauze|splint|stethoscope|aed|cpr|resuscitation|medic bag|medical bag|medical pouch|trauma pouch|ifak|trauma shears|emt shears|wound|hemostatic|blood pressure|pulse oximeter|oxygen mask|nasopharyngeal)\