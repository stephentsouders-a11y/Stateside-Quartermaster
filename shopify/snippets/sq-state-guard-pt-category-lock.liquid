{% if request.page_type == 'collection' %}
{% if collection.handle contains 'state-guard-series-' or collection.handle == 'new-jersey-state-guard-naval-militia' %}
<script id="sq-state-guard-pt-category-lock">
(function(){
  if(window.__sqStateGuardPtCategoryLockV2)return;window.__sqStateGuardPtCategoryLockV2=true;
  var q=new URLSearchParams(location.search);if(String(q.get('sg_type')||'').trim().toLowerCase()!=='pt uniform')return;
  var component=String(q.get('sg_component')||'').trim().toLowerCase(),SHOE='m-tac-carbon-performance-sneakers';
  var NOT_COLD={'m-tac-carbon-performance-sneakers':1,'pt-lo-cut-cushioned-running-socks':1,'reflective-pt-belt-random-color':1,'state-guard-hi-vis-vest':1,'casio-g-shock-mod-oak-black':1,'casio-g-shock-mod-oak-all-black':1,'casio-g-shock-mod-oversized-full-black':1,'casio-g-shock-mod-grand-digit-black':1,'casio-g-shock-mod-countdown-black':1,'casio-g-shock-mod-the-king-xl-all-black-white-backlight':1};
  window.__sqStateGuardPtProductPromises=window.__sqStateGuardPtProductPromises||{};
  function root(){var r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';return r.slice(-1)==='/'?r:r+'/'}
  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[c]})}
  function baseHandle(a){var raw=a&&a.getAttribute?a.getAttribute('href')||'':'';var m=raw.match(/^\/products\/([^?]+)/);if(!m)return'';try{return decodeURIComponent(m[1])}catch(e){return m[1]}}
  function loadProduct(h){var map=window.__sqStateGuardPtProductPromises;if(map[h])return map[h];map[h]=window.fetch(root()+'products/'+encodeURIComponent(h)+'.js',{credentials:'same-origin'}).then(function(r){return r&&r.ok?r.json():null}).catch(function(){return null});return map[h]}
  function blackVariants(p){return (p&&Array.isArray(p.variants)?p.variants:[]).filter(function(v){return v&&/\bblack\b/i.test(String(v.title||''))})}
  function stockedBlack(p){return blackVariants(p).filter(function(v){return v&&v.available===true})}
  function productImage(p){var x=p&&p.featured_image;if(x&&typeof x==='object')x=x.src||x.url||'';if(!x&&p&&p.images&&p.images.length){x=p.images[0];if(x&&typeof x==='object')x=x.src||x.url||''}return String(x||'')}
  function loadShoe(){return loadProduct(SHOE).then(function(p){return p&&stockedBlack(p).length?p:null})}
  function productUrl(v){var u=new URL(root()+'products/'+SHOE,location.origin);if(v&&v.id)u.searchParams.set('variant',String(v.id));u.searchParams.set('sq_state_guard_pt','1');var preview=q.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return u.pathname+u.search}
  function componentUrl(name){var u=new URL(location.href);u.searchParams.set('sg_component',name);return u.pathname+u.search}
  function variantPrice(v){if(!v||v.price===undefined||v.price===null)return'';var raw=String(v.price),n=Number(raw);if(!isFinite(n))return'';var dollars=/^\d+$/.test(raw)?n/100:n;return '$'+dollars.toFixed(2)}
  function removeCard(card){if(!card||!card.parentNode)return;var sec=card.closest('.sqsg-section');card.remove();if(sec&&!sec.querySelector('a.sqsg-product[href^="/products/"]'))sec.remove()}
  function setCount(n){var small=document.querySelector('[data-sqsg-view] .sqsg-head small');if(small)small.textContent=n+' '+(n===1?'item':'items')}
  function relabel(){document.querySelectorAll('.sqsg-card .sqsg-copy strong,.sqsg-head h2').forEach(function(el){var t=String(el.textContent||'').trim();if(t==='Footwear')el.textContent='PT Footwear';else if(t==='Reflective Belt')el.textContent='PT Belt'})}
  function componentName(card){try{return String(new URL(card.href,location.origin).searchParams.get('sg_component')||'').trim().toLowerCase()}catch(e){return''}}
  function ensureRootCard(p){if(component)return;var grid=document.querySelector('[data-sqsg-view] .sqsg-grid');if(!grid)return;var cards=[].slice.call(grid.querySelectorAll('a.sqsg-card')),matches=cards.filter(function(a){return componentName(a)==='footwear'||String(a.textContent||'').trim().toLowerCase().indexOf('pt footwear')!==-1}),card=matches.shift();matches.forEach(function(x){x.remove()});var img=productImage(p);if(!card){card=document.createElement('a');card.className='sqsg-card';card.setAttribute('data-sq-pt-footwear-guaranteed','1');var cold=cards.find(function(a){return componentName(a)==='cold weather pt'});if(cold&&cold.parentNode)cold.insertAdjacentElement('afterend',card);else grid.appendChild(card)}card.href=componentUrl('Footwear');card.innerHTML='<span class="sqsg-media">'+(img?'<img src="'+esc(img)+'" alt="M-Tac Carbon Performance Sneakers - Black" loading="lazy">':'SQ')+'</span><span class="sqsg-copy"><strong>PT Footwear</strong><small>1 item</small><b>&rarr;</b></span>'}
  function ensureFootwearView(p){if(component!=='footwear')return;var blacks=stockedBlack(p);if(!blacks.length)return;var pick=blacks[0],view=document.querySelector('[data-sqsg-view]');if(!view)return;var cards=[].slice.call(view.querySelectorAll('a.sqsg-product[href^="/products/"]')),keep=null;cards.forEach(function(card){var h=baseHandle(card);if(h===SHOE&&!keep)keep=card;else removeCard(card)});view.querySelectorAll('.sqsg-empty').forEach(function(x){if(/no customer-purchasable|unable to load/i.test(x.textContent||''))x.remove()});if(!keep){var sec=document.createElement('section');sec.className='sqsg-section';sec.setAttribute('data-sq-pt-footwear-injected','1');sec.innerHTML='<h3>SHARED UNIFORM COMPONENTS</h3><div class="sqsg-products"></div>';var head=view.querySelector('.sqsg-head');if(head)head.insertAdjacentElement('afterend',sec);else view.appendChild(sec);keep=document.createElement('a');keep.className='sqsg-product';sec.querySelector('.sqsg-products').appendChild(keep)}var img=productImage(p),price=variantPrice(pick);keep.href=productUrl(pick);keep.setAttribute('data-sq-pt-footwear-guaranteed','1');keep.innerHTML='<span class="sqsg-pmedia">'+(img?'<img src="'+esc(img)+'" alt="M-Tac Carbon Performance Sneakers - Black" loading="lazy">':'SQ')+'</span><span class="sqsg-pcopy"><strong>M-Tac Carbon Performance Sneakers - Black</strong><small>'+esc(price)+'</small></span>';setCount(1)}
  function cleanColdWeather(){if(component!=='cold weather pt')return;var view=document.querySelector('[data-sqsg-view]');if(!view)return;[].slice.call(view.querySelectorAll('a.sqsg-product[href^="/products/"]')).forEach(function(card){var h=baseHandle(card),txt=String(card.textContent||'');if(NOT_COLD[h]||/\b(shoe|shoes|footwear|sneaker|sneakers|boot|boots|running sock|pt belt|hi vis vest|g-shock)\b/i.test(txt))removeCard(card)});setCount(view.querySelectorAll('a.sqsg-product[href^="/products/"]').length)}
  function cleanOther(){if(component!=='other pt components')return;document.querySelectorAll('[data-sqsg-view] a.sqsg-product[href^="/products/"]').forEach(function(card){if(baseHandle(card)===SHOE)removeCard(card)});var view=document.querySelector('[data-sqsg-view]');if(view)setCount(view.querySelectorAll('a.sqsg-product[href^="/products/"]').length)}
  function cleanFootwear(){if(component!=='footwear')return;document.querySelectorAll('[data-sqsg-view] a.sqsg-product[href^="/products/"]').forEach(function(card){if(baseHandle(card)!==SHOE)removeCard(card)})}
  var scheduled=false;function run(){scheduled=false;relabel();cleanFootwear();cleanColdWeather();cleanOther();loadShoe().then(function(p){if(!p)return;ensureRootCard(p);ensureFootwearView(p);relabel()})}function schedule(){if(scheduled)return;scheduled=true;setTimeout(run,0)}
  var obs=new MutationObserver(schedule);obs.observe(document.documentElement,{childList:true,subtree:true});if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',schedule,{once:true});else schedule();[300,900,1800,3500,7000,12000].forEach(function(ms){setTimeout(schedule,ms)});setTimeout(function(){run();obs.disconnect()},18000);
})();
</script>
{% endif %}{% endif %}