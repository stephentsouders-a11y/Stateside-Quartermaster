<script>
(function(){
  function stabilizeTypeImages(){
    document.querySelectorAll('.sq-third-level__type[data-image-product=""]').forEach(function(card){
      var media=card.querySelector('.sq-third-level__media');
      if(!media)return;
      if(!media.querySelector('img[src]')){
        media.innerHTML='<span class="sq-third-level__placeholder" aria-hidden="true"></span>';
        card.setAttribute('data-sq-type-image-stabilized','true');
      }
    });
  }
  function normalizeImageUrl(value){if(!value)return '';try{var url=new URL(value,window.location.origin);return url.origin+url.pathname}catch(error){return String(value).split('?')[0]}}
  function lineRootHandle(){var parts=window.location.pathname.split('/').filter(Boolean);if(parts.length!==2||parts[0]!=='collections')return '';var handle=decodeURIComponent(parts[1]||'');if(handle==='products-built-for-the-line-u-s-army'||handle==='products-built-for-the-line-u-s-air-force')return handle;return ''}
  function readCachedImage(key){try{var raw=window.sessionStorage.getItem(key);if(!raw)return null;var parsed=JSON.parse(raw);if(!parsed||!parsed.src)return null;return parsed}catch(error){return null}}
  function writeCachedImage(key,value){try{window.sessionStorage.setItem(key,JSON.stringify(value))}catch(error){}}
  function imageCandidatesFromHtml(html){var doc=new DOMParser().parseFromString(html,'text/html'),candidates=[];doc.querySelectorAll('.product-grid__item').forEach(function(item){var img=item.querySelector('img[src]');if(!img)return;var src=img.getAttribute('src')||'';if(!src)return;var link=item.querySelector('a[href*="/products/"]'),title=(img.getAttribute('alt')||'').trim();if(!title&&link)title=(link.textContent||'').trim().replace(/\s+/g,' ');candidates.push({src:src,title:title})});if(candidates.length)return candidates;doc.querySelectorAll('collection-component img[src],#ResultsList img[src]').forEach(function(img){var src=img.getAttribute('src')||'';if(src)candidates.push({src:src,title:(img.getAttribute('alt')||'').trim()})});return candidates}
  function applyRecoveredImage(card,candidate,used){if(!candidate||!candidate.src)return false;var media=card.querySelector('.sq-third-level__media');if(!media)return false;var img=media.querySelector('img');if(!img){media.innerHTML='<img width="720" height="480" loading="lazy">';img=media.querySelector('img')}var label=card.querySelector('.sq-third-level__name');img.src=candidate.src;img.alt=label?(label.textContent||'').trim():(candidate.title||'Product type');img.removeAttribute('srcset');img.removeAttribute('sizes');card.setAttribute('data-image-product',candidate.title||'Recovered type image');card.setAttribute('data-sq-line-image-recovered','true');used[normalizeImageUrl(candidate.src)]=true;return true}
  async function recoverOneLineTypeImage(card,used){var href=card.getAttribute('href')||'';if(!href)return;var target;try{target=new URL(href,window.location.origin)}catch(error){return}var cacheKey='sq-line-type-image-v2:'+target.pathname,cached=readCachedImage(cacheKey);if(cached&&(!used[normalizeImageUrl(cached.src)]||card.getAttribute('data-sq-line-duplicate')!=='true')){if(applyRecoveredImage(card,cached,used))return}target.search='';target.searchParams.set('filter.v.availability','1');var response=await fetch(target.pathname+target.search,{credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}});if(!response.ok)return;var html=await response.text(),candidates=imageCandidatesFromHtml(html);if(!candidates.length)return;var selected=null;for(var i=0;i<candidates.length;i++){var candidate=candidates[i],key=normalizeImageUrl(candidate.src);if(key&&!used[key]){selected=candidate;break}}if(!selected)selected=candidates[0];if(!selected||!selected.src)return;writeCachedImage(cacheKey,selected);applyRecoveredImage(card,selected,used)}
  function recoverLineTypeImages(){var handle=lineRootHandle();if(!handle)return;var root=document.querySelector('.sq-third-level[data-sq-collection-handle="'+handle+'"]');if(!root||root.getAttribute('data-sq-line-image-recovery')==='running'||root.getAttribute('data-sq-line-image-recovery')==='done')return;var cards=Array.prototype.slice.call(root.querySelectorAll('.sq-third-level__type[data-product-type]'));if(!cards.length)return;root.setAttribute('data-sq-line-image-recovery','running');var used={},needs=[];cards.forEach(function(card){var img=card.querySelector('.sq-third-level__media img[src]'),src=img?normalizeImageUrl(img.currentSrc||img.getAttribute('src')||''):'',sourceProduct=(card.getAttribute('data-image-product')||'').trim(),duplicate=!!(src&&used[src]);if(duplicate)card.setAttribute('data-sq-line-duplicate','true');if(!src||!sourceProduct||duplicate){needs.push(card)}else if(src){used[src]=true}});if(!needs.length){root.setAttribute('data-sq-line-image-recovery','done');root.setAttribute('data-sq-line-image-recovered-count','0');return}var cursor=0,recovered=0;async function worker(){while(cursor<needs.length){var card=needs[cursor++],before=card.getAttribute('data-sq-line-image-recovered');try{await recoverOneLineTypeImage(card,used)}catch(error){console.error('SQ line type image recovery:',error)}if(before!=='true'&&card.getAttribute('data-sq-line-image-recovered')==='true')recovered++}}Promise.all([worker(),worker(),worker(),worker()]).then(function(){root.setAttribute('data-sq-line-image-recovery','done');root.setAttribute('data-sq-line-image-recovered-count',String(recovered))})}
  function run(){stabilizeTypeImages();recoverLineTypeImages();var hits=[];document.querySelectorAll('#MainContent h2').forEach(function(h){var t=(h.textContent||'').trim().toLowerCase().replace(/\s+/g,' ');if(t==='shop by category'){var s=h.closest('section');if(s&&hits.indexOf(s)===-1)hits.push(s)}});if(hits.length<2)return;function score(s){if(s.matches('.sq-subcategory-section')||s.querySelector('.sq-subcategory-section'))return 100;if(s.matches('.sq-public-safety-root-section')||s.querySelector('.sq-public-safety-root-section'))return 95;if(s.matches('.vac-guard-folders')||s.querySelector('.vac-guard-folders'))return 90;if(s.matches('.sq-afg-branch-section')||s.querySelector('.sq-afg-branch-section'))return 85;return 10}hits.sort(function(a,b){return score(b)-score(a)});var keep=hits[0];hits.slice(1).forEach(function(s){if(keep.contains(s))return;var w=s.closest('.shopify-section');if(w&&!w.contains(keep))w.style.setProperty('display','none','important');else s.style.setProperty('display','none','important');s.setAttribute('data-sq-category-duplicate-hidden','true')});keep.setAttribute('data-sq-category-canonical','true')}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run);else run();window.addEventListener('load',run,{once:true});
})();
</script>
