<section class="sg-series-page" data-sq-state-guard-root>
  <div class="sg-series-wrap">
    <header class="sg-series-header sg-series-header--title">
      <p class="sg-series-kicker">State Guard Series</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="sg-series-description">{{ collection.description }}</div>{% endif %}
    </header>
    <section class="sq-sg-merch-feature" data-sq-state-guard-merch-feature aria-label="State Guard themed merchandise">
      <a class="sq-sg-merch-feature__card" href="/collections/state-guard-naval-militia-themed-merchandise">
        <span class="sq-sg-merch-feature__media"><img src="https://cdn.shopify.com/s/files/1/0774/4602/1275/files/ninjapod_media_1201797_463281_c6cf_FRONT_759b4420-3537-464e-b49e-6eab71da868a.jpg?v=1787771125" alt="State Guard USDF logo shirt merchandise" loading="eager" decoding="async"></span>
        <span class="sq-sg-merch-feature__copy"><span class="sq-sg-merch-feature__eyebrow">Stateside Quartermaster Originals</span><strong>State Guard Themed Merchandise</strong><span>Shop USDF and State Guard hats, shirts and other State Guard / Naval Militia themed merchandise.</span><span class="sq-sg-merch-feature__cta">Shop State Guard Themed Merchandise →</span></span>
      </a>
    </section>
    <div class="sg-series-header sg-series-header--chooser">
      <h2>Choose your state or territory</h2>
      <p class="sg-series-intro">Choose the state or territory first. Where multiple State Guard, State Defense Force, Naval Militia, maritime, cyber, or related state military organizations exist, you will choose the organization on the next page.</p>
    </div>
    <div class="sg-entity-grid">
      {% for row in sg_entities %}
        {% assign r = row | strip %}{% if r != blank %}{% assign p = r | split: '|' %}{% assign c = collections[p[0]] %}{% assign initial_count = c.products_count | default: 0 %}{% assign seal_src = 'https://commons.wikimedia.org/wiki/Special:FilePath/' | append: p[3] %}{% assign seal_fallback = blank %}{% if p[0] == 'new-jersey-state-guard-naval-militia' %}{% assign seal_src = 'https://upload.wikimedia.org/wikipedia/commons/thumb/8/8d/Seal_of_New_Jersey.svg/512px-Seal_of_New_Jersey.svg.png' %}{% assign seal_fallback = 'https://upload.wikimedia.org/wikipedia/commons/8/8d/Seal_of_New_Jersey.svg' %}{% endif %}
        <a class="sg-entity" href="/collections/{{ p[0] | escape }}?filter.v.availability=1" aria-label="Shop {{ p[2] | escape }}" data-sg-handle="{{ p[0] | escape }}"><span class="sg-entity__media"><img class="sg-entity__seal" src="{{ seal_src }}"{% if seal_fallback != blank %} data-alt-src="{{ seal_fallback }}"{% endif %} alt="Official seal for {{ p[2] | escape }}" loading="lazy" decoding="async" referrerpolicy="no-referrer"></span><span class="sg-entity__copy"><span class="sg-entity__name">{{ p[2] }}</span><span class="sg-entity__count" data-sg-count>{{ initial_count }} {{ initial_count | pluralize: 'item', 'items' }}</span><span class="sg-entity__arrow" aria-hidden="true">→</span></span></a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
