{% if request.page_type == 'collection' and collection.handle == 'army-national-guard-series' and template.suffix == 'guard-logo-tree' %}
  <section class="sq-guard-shop-all" aria-label="Army National Guard full catalog">
    <div class="sq-guard-shop-all__wrap">
      <a class="sq-guard-shop-all__link" href="{{ collection.url }}?view=guard-all&amp;filter.v.availability=1">
        <span>Shop All Army National Guard Products</span>
        <strong>{{ collection.products_count }} items</strong>
      </a>
    </div>
  </section>
{% endif %}
{% stylesheet %}
  .sq-guard-shop-all{padding:0 20px 18px;background:#f4f5f3}
  .sq-guard-shop-all__wrap{max-width:1280px;margin:0 auto}
  .sq-guard-shop-all__link{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px;border:1px solid #aeb8be;border-radius:12px;background:#071d2d;color:#fff;text-decoration:none;box-shadow:0 6px 18px rgba(7,29,45,.12)}
  .sq-guard-shop-all__link:hover,.sq-guard-shop-all__link:focus-visible{border-color:#a91827;box-shadow:0 10px 24px rgba(7,29,45,.2)}
  .sq-guard-shop-all__link:focus-visible{outline:3px solid #d5ab4b;outline-offset:3px}
  .sq-guard-shop-all__link span{font-size:14px;font-weight:900;letter-spacing:.02em;text-transform:uppercase}
  .sq-guard-shop-all__link strong{color:#d5ab4b;font-size:13px;white-space:nowrap}
  @media(max-width:749px){.sq-guard-shop-all{padding:0 14px 14px}.sq-guard-shop-all__link{align-items:flex-start;flex-direction:column;gap:5px;padding:12px 14px}}
{% endstylesheet %}
{% schema %}{"name":"Guard shop all link","settings":[],"presets":[{"name":"Guard shop all link"}]}{% endschema %}
