 'state-guard-series-louisiana':[['Louisiana State Guard','louisiana state guard'],['Louisiana Naval Militia','louisiana naval militia']],
 'new-jersey-state-guard-naval-militia':[['New Jersey State Guard','new jersey state guard'],['New Jersey Naval Militia','new jersey naval militia']],
 'state-guard-series-new-york':[['New York Guard','new york guard'],['New York Naval Militia','new york naval militia']],
 'state-guard-series-ohio':[['Ohio Military Reserve','ohio military reserve|ohmr'],['Ohio Naval Militia','ohio naval militia'],['Ohio Cyber Reserve','ohio cyber reserve']],
 'state-guard-series-south-carolina':[['South Carolina State Guard','south carolina state guard'],['South Carolina Naval Militia','south carolina naval militia']]
};
var ST='alabama|alaska|california|connecticut|florida|georgia|indiana|louisiana|maryland|massachusetts|michigan|mississippi|new mexico|new jersey|new york|ohio|oregon|puerto rico|rhode island|south carolina|tennessee|texas|texas state guard|vermont|virginia|washington'.split('|');
var ORDER='uniforms|insignia|awards|headwear|patches|footwear|apparel|equipment|reference'.split('|');
var LAB={uniforms:'Uniforms',insignia:'Insignia & Identification',awards:'Awards & Decorations',headwear:'Headwear',patches:'Patches & Flags',footwear:'Footwear & Uniform Accessories',apparel:'Apparel & Merchandise',equipment:'Equipment & Field Gear',reference:'Reference & Training'};
var TYPE_ORDER={uniforms:['OCP / Field Uniform','Service / Dress Uniform','PT Uniform','Cold Weather & Outerwear','Medical / Utility Uniforms','Undershirts','Uniform Components'],insignia:['Rank','Name Tapes','Name Plates','Identification & Dog Tags','Badges & Devices','Unit / Branch Insignia'],awards:['Ribbons','Medals','Ribbon & Medal Devices','Other Awards'],headwear:['Patrol Caps','Service / Dress Headwear','Cold Weather Headwear','Boonie Hats','Other Headwear'],patches:['State & U.S. Flags','Unit & Shoulder Patches','Tabs & Scrolls','Other Patches'],footwear:['Boots','Dress Shoes','Socks','Belts & Blousing','Gloves','Uniform Accessories'],apparel:['T-Shirts & Casual Shirts','Polos','Hoodies & Sweatshirts','Other Merchandise'],equipment:['Medical & IFAK','Packs & Pouches','Field & Tactical Gear','Watches & Timepieces','Other Equipment'],reference:['Manuals & Regulations','Training Guides','Books & Reference']};
function n(x){return String(x||'').trim().toLowerCase().replace(/\s+/g,' ')}
function tags(p){var t=p.tags||[];return Array.isArray(t)?t:String(t).split(',').map(function(x){return x.trim()}).filter(Boolean)}
function txt(p){return n([p.title,p.product_type,tags(p).join(' ')].join(' '))}
function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function img(p){var x=p&&p.images&&p.images[0];return x?(typeof x==='string'?x:x.src||''):''}
function avail(p){return !p.variants||!p.variants.length||p.variants.some(function(x){return x.available===true})}
function groups(){return ORG[h]||[]}
function om(p,g){var s=txt(p);return g[1].split('|').some(function(t){return s.indexOf(t)!==-1})}
