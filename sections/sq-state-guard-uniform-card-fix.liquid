function pool(a,o){if(!o)return a;return a.filter(function(p){var m=mo(p);return !m||m===o})}
function ss(p){var m=mo(p);if(m)return m;var tt=n([p.title,p.product_type].join(' '));if(sl&&tt.indexOf(sl)!==-1)return state;var ts=tags(p).map(n),k=sl==='texas'?'texas state guard':sl,c=0;ST.forEach(function(x){if(ts.indexOf(x)!==-1)c++});return ts.indexOf(k)!==-1&&c===1?state:''}
function cat(p){var s=txt(p);if(/\b(ribbon|medal|award|decoration)\b/.test(s)&&!/cap device/.test(s))return'awards';if(/\b(flag|patch|patches|tab|tabs|scroll|scrolls)\b/.test(s))return'patches';if(/\b(rank|insignia|nametape|name tape|nameplate|name plate|badge|dog tag|shoulder board|identification|pin back|unit crest|branch insignia|cap device)\b/.test(s))return'insignia';if(/\b(patrol cap|service cap|garrison cap|cover|beret|beanie|boonie|headwear|watch cap|hat|balaclava|neck gaiter|gaiter)\b/.test(s))return'headwear';if(/\b(boot|boots|sock|socks|belt|blouser|blousing|glove|gloves|dress shoe|uniform shoe)\b/.test(s))return'footwear';if(/\b(book|manual|guide|reference|regulation|training aid|field manual)\b/.test(s))return'reference';if(/\b(pt |physical training|combat uniform|field uniform|uniform coat|uniform pants|uniform trouser|service uniform|dress uniform|asu|agsu|ocp|acu|ihwcu|undershirt|outerwear|parka|fleece jacket|windbreaker|scrub top|scrub pants|scrubs)\b/.test(s)||s.indexOf('sq verified uniforms')!==-1)return'uniforms';if(/\b(t-shirt|tee|polo|hoodie|sweatshirt|apparel|merchandise)\b/.test(s))return'apparel';return'equipment'}
function typ(p,c){var s=txt(p);if(c==='uniforms'){if(/\b(pt |physical training)/.test(s))return'PT Uniform';if(/\b(ocp|acu|ihwcu|combat uniform|field uniform)\b/.test(s))return'OCP / Field Uniform';if(/\b(asu|agsu|service uniform|dress uniform|dress shirt|service shirt)\b/.test(s))return'Service / Dress Uniform';if(/\b(scrub top|scrub pants|scrubs)\b/.test(s))return'Medical / Utility Uniforms';if(/\b(cold weather|fleece|parka|outerwear|windbreaker|all-weather|all weather|jacket)\b/.test(s))return'Cold Weather & Outerwear';if(/undershirt|under shirt/.test(s))return'Undershirts';return'Uniform Components'}if(c==='insignia'){if(/\brank\b/.test(s))return'Rank';if(/name ?tape/.test(s))return'Name Tapes';if(/name ?plate|name badge/.test(s))return'Name Plates';if(/dog tag|identification/.test(s))return'Identification & Dog Tags';if(/badge|device|pin back/.test(s))return'Badges & Devices';return'Unit / Branch Insignia'}if(c==='awards'){if(/ribbon/.test(s))return'Ribbons';if(/medal/.test(s))return'Medals';if(/device/.test(s))return'Ribbon & Medal Devices';return'Other Awards'}if(c==='headwear'){if(/patrol cap/.test(s))return'Patrol Caps';if(/service cap|garrison cap|beret/.test(s))return'Service / Dress Headwear';if(/beanie|watch cap|cold weather|balaclava|gaiter/.test(s))return'Cold Weather Headwear';if(/boonie/.test(s))return'Boonie Hats';return'Other Headwear'}if(c==='patches'){if(/flag/.test(s))return'State & U.S. Flags';if(/unit|shoulder|patch/.test(s))return'Unit & Shoulder Patches';if(/tab|scroll/.test(s))return'Tabs & Scrolls';return'Other Patches'}if(c==='footwear'){if(/boot/.test(s))return'Boots';if(/dress shoe|uniform shoe/.test(s))return'Dress Shoes';if(/sock/.test(s))return'Socks';if(/belt|blouser|blousing/.test(s))return'Belts & Blousing';if(/glove/.test(s))return'Gloves';return'Uniform Accessories'}if(c==='apparel'){if(/t-shirt|tee|shirt/.test(s))return'T-Shirts & Casual Shirts';if(/polo/.test(s))return'Polos';if(/hoodie|sweatshirt/.test(s))return'Hoodies & Sweatshirts';return'Other Merchandise'}if(c==='equipment'){if(/medical|ifak/.test(s))return'Medical & IFAK';if(/pack|pouch/.test(s))return'Packs & Pouches';if(/field|tactical|carrier|canteen|hydration/.test(s))return'Field & Tactical Gear';if(/watch|wristwatch/.test(s))return'Watches & Timepieces';return'Other Equipment'}if(c==='reference'){if(/manual|regulation|field manual/.test(s))return'Manuals & Regulations';if(/training/.test(s))return'Training Guides';return'Books & Reference'}return p.product_type||'Other'}
async function load(){var all=[];for(var p=1;p<=8;p++){var r=await fetch('/collections/'+h+'/products.json?limit=250&page='+p,{credentials:'same-origin'});if(!r.ok)break;var j=await r.json(),a=(j&&j.products)||[];a.filter(avail).forEach(function(x){if(ss(x))all.push(x)});if(a.length<250)break}return all}
function card(label,count,href,p){var src=img(p);return '<a class="sqsg-card" href="'+esc(href)+'"><span class="sqsg-media">'+(src?'<img src="'+esc(src)+'" alt="" loading="lazy">':'SQ')+'</span><span class="sqsg-copy"><strong>'+esc(label)+'</strong><small>'+count+' '+(count===1?'item':'items')+'</small><b>→</b></span></a>'}
function render(a){var q=new URLSearchParams(location.search),org=q.get('sg_org')||'',c=q.get('sg_category')||'',t=q.get('sg_type')||'';var gs=groups();if(gs.length){oh.innerHTML='<div class="sqsg-orgs"><h2>Shop by organization</h2><div><a class="'+(!org?'on':'')+'" href="'+location.pathname+'">All '+esc(state)+' products</a>'+gs.map(function(g){var u=new URL(location.href);u.search='';u.searchParams.set('sg_org',g[0]);return'<a class="'+(org===g[0]?'on':'')+'" href="'+u.pathname+'?'+u.searchParams.toString()+'">'+esc(g[0])+'</a>'}).join('')+'</div></div>'}a=pool(a,org);if(!c){var rows=ORDER.map(function(k){var x=a.filter(function(p){return cat(p)===k});return x.length?card(LAB[k],x.length,location.pathname+'?sg_category='+encodeURIComponent(k)+(org?'&sg_org='+encodeURIComponent(org):''),x[0]):''}).filter(Boolean);v.innerHTML='<div class="sqsg-head"><div><p>Shop by category</p><h2>'+esc(org||state)+'</h2></div></div><div class="sqsg-grid">'+rows.join('')+'</div>';return}var ca=a.filter(function(p){return cat(p)===c});if(!t){var ts=TYPE_ORDER[c]||[];var rows=ts.map(function(x){var list=ca.filter(function(p){return typ(p,c)===x});return list.length?card(x,list.length,location.pathname+'?sg_category='+encodeURIComponent(c)+'&sg_type='+encodeURIComponent(x)+(org?'&sg_org='+encodeURIComponent(org):''),list[0]):''}).filter(Boolean);v.innerHTML='<div class="sqsg-head"><a class="sqsg-back" href="'+location.pathname+(org?'?sg_org='+encodeURIComponent(org):'')+'">← Categories</a><div><p>'+esc(LAB[c])+'</p><h2>Shop by type</h2></div></div><div class="sqsg-grid">'+rows.join('')+'</div>';return}var list=ca.filter(function(p){return typ(p,c)===t});v.innerHTML='<div class="sqsg-head"><a class="sqsg-back" href="'+location.pathname+'?sg_category='+encodeURIComponent(c)+(org?'&sg_org='+encodeURIComponent(org):'')+'">← '+esc(LAB[c])+'</a><div><p>'+esc(LAB[c])+'</p><h2>'+esc(t)+'</h2><small>'+list.length+' items</small></div></div><div class="sqsg-products">'+list.map(function(p){return'<a class="sqsg-product" href="/products/'+esc(p.handle)+'"><span class="sqsg-pmedia">'+(img(p)?'<img src="'+esc(img(p))+'" alt="'+esc(p.title)+'" loading="lazy">':'SQ')+'</span><span class="sqsg-pcopy"><strong>'+esc(p.title)+'</strong></span></a>'}).join('')+'</div>'}
document.querySelectorAll('main#MainContent > .shopify-section').forEach(function(s){if(!s.contains(r)&&/male versions/i.test(s.textContent||'')&&/female versions/i.test(s.textContent||''))s.classList.add('sqsg-legacy')});
load().then(render).catch(function(){v.innerHTML='<div class="sqsg-empty">Unable to load this department. Please refresh the page.</div>'})
})();
</script>
<style>
html.sqsg-on body collection-component,html.sqsg-on .sq-third-level,html.sqsg-on .sq-subcategory-section,html.sqsg-on .vac-guard-folders,html.sqsg-on .sqsg-legacy{display:none!important}
.sqsg{background:#f4f5f3;color:#071d2d;padding:28px 0 70px}.sqsg-w{width:min(1280px,calc(100% - 40px));margin:auto}.sqsg-crumb{display:flex;gap:9px;margin-bottom:24px;font-size:13px}.sqsg-crumb a,.sqsg-back{color:#17364d;text-decoration:none;font-weight:800}.sqsg-k,.sqsg-head p{margin:0 0 7px;color:#a91827;font-size:12px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.sqsg h1{margin:0;font-size:clamp(42px,6vw,76px);line-height:.95;text-transform:uppercase}.sqsg-org{margin:12px 0 0;font-size:18px;font-weight:800}.sqsg-intro{max-width:820px;color:#5a6670}.sqsg-orgs{margin:26px 0 34px}.sqsg-orgs h2{font-size:20px}.sqsg-orgs>div{display:flex;flex-wrap:wrap;gap:8px}.sqsg-orgs a,.sqsg-back{display:inline-flex;padding:10px 14px;border:1px solid #9eaab1;border-radius:999px;background:#fff;text-decoration:none}.sqsg-orgs a.on{background:#071d2d;color:#fff}.sqsg-head{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;margin:24px 0 18px}.sqsg-head h2{margin:0;font-size:clamp(28px,4vw,44px)}.sqsg-head small{display:block;max-width:760px;margin-top:7px;color:#5f6c74;line-height:1.45}.sqsg-grid,.sqsg-products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.sqsg-card,.sqsg-product{display:flex;flex-direction:column;overflow:hidden;border:1px solid #aeb8be;border-radius:14px;background:#fff;text-decoration:none;box-shadow:0 8px 22px #071d2d1f}.sqsg-card{height:315px}.sqsg-media,.sqsg-pmedia{display:grid;height:205px;place-items:center;overflow:hidden;background:#fff;color:#d5ab4b;font-size:36px;font-weight:900}.sqsg-media img,.sqsg-pmedia img{display:block;width:100%;height:100%;object-fit:contain;object-position:center center;padding:10px;box-sizing:border-box;background:#fff}.sqsg-copy,.sqsg-pcopy{position:relative;display:flex;flex:1;flex-direction:column;padding:15px 42px 18px 15px;background:#071d2d;color:#fff}.sqsg-copy small,.sqsg-pcopy small{margin-top:7px;color:#c7d0d6}.sqsg-copy b{position:absolute;right:15px;bottom:17px;color:#d5ab4b;font-size:22px}.sqsg-section{margin-top:32px}.sqsg-section h3{font-size:18px}.sqsg-product{min-height:300px}.sqsg-empty{padding:30px;border:1px solid #cbd2d6;border-radius:14px;background:#fff}.sqsg a:focus-visible{outline:3px solid #d5ab4b;outline-offset:3px}@media(max-width:1000px){.sqsg-grid,.sqsg-products{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.sqsg-w{width:calc(100% - 24px)}.sqsg-grid,.sqsg-products{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.sqsg-card{height:240px}.sqsg-media,.sqsg-pmedia{height:140px}.sqsg-head{align-items:flex-start;flex-direction:column}.sqsg-product{min-height:240px}}@media(max-width:420px){.sqsg-grid,.sqsg-products{grid-template-columns:1fr}}
</style>
