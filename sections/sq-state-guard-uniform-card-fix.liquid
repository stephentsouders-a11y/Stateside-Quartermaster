{% liquid
  assign sq_sg = false
  if collection.handle contains 'state-guard-series-' or collection.handle == 'new-jersey-state-guard-naval-militia'
    assign sq_sg = true
  endif
  if collection.handle == 'state-guard-series-ohio'
    assign sq_sg = false
  endif
  assign sq_state = collection.title
  assign sq_states = 'state-guard-series-alabama|Alabama,state-guard-series-alaska|Alaska,state-guard-series-california|California,state-guard-series-connecticut|Connecticut,state-guard-series-florida|Florida,state-guard-series-georgia|Georgia,state-guard-series-indiana|Indiana,state-guard-series-louisiana|Louisiana,state-guard-series-maryland|Maryland,state-guard-series-massachusetts|Massachusetts,state-guard-series-michigan|Michigan,state-guard-series-mississippi|Mississippi,state-guard-series-new-mexico|New Mexico,new-jersey-state-guard-naval-militia|New Jersey,state-guard-series-new-york|New York,state-guard-series-ohio|Ohio,state-guard-series-oregon|Oregon,state-guard-series-puerto-rico|Puerto Rico,state-guard-series-rhode-island|Rhode Island,state-guard-series-south-carolina|South Carolina,state-guard-series-tennessee|Tennessee,state-guard-series-texas|Texas state guard|Vermont,state-guard-series-vermont|Vermont,state-guard-series-virginia|Virginia,state-guard-series-washington|Washington' | split: ','
  for row in sq_states
    assign bits = row | split: '|'
    if bits[0] == collection.handle
      assign sq_state = bits[1]
      break
    endif
  endfor
%}
{% if request.page_type == 'collection' and sq_sg %}
<section class="sqsg" data-sqsg data-state="{{ sq_state | escape }}" data-handle="{{ collection.handle | escape }}">
  <div class="sqsg-w">
    <nav class="sqsg-crumb"><a href="/collections/state-guard-series">State Guard Series</a><span>/</span><span>{{ sq_state }}</span></nav>
    <header>
      <p class="sqsg-k">State Guard Series</p>
      <h1>{{ sq_state }}</h1>
      <p class="sqsg-org">{{ collection.title }}</p>
      <p class="sqsg-intro">Choose what you need. Every category, uniform system, component and item count is built from customer-purchasable products in this department.</p>
    </header>
    <div data-sqsg-orgs></div>
    <div data-sqsg-view><div class="sqsg-empty">Organizing {{ sq_state }} products…</div></div>
  </div>
</section>
<script data-sqsg-tree>
(function(){
var r=document.querySelector('[data-sqsg]');if(!r)return;document.documentElement.classList.add('sqsg-on');
var v=r.querySelector('[data-sqsg-view]'),oh=r.querySelector('[data-sqsg-orgs]'),state=r.dataset.state||'',h=r.dataset.handle||'',sl=state.toLowerCase();
var ORG={
 'state-guard-series-alabama':[['Alabama State Guard','alabama state guard'],['Alabama Service Corps','alabama service corps|asc pt']],
 'state-guard-series-alaska':[['Alaska State Defense Force','alaska state defense force'],['Alaska Naval Militia','alaska naval militia']],
