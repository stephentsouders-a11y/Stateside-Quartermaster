{% doc %}
Air National Guard root navigation built on the same collection-card architecture as the U.S. Air Force series. ANG is the U.S. Air Force product universe plus ANG-specific merchandise. This section is intentionally server-rendered only: no fetches, timers, observers, or click interception. The root cards are explicitly excluded from the site-wide reactive navigation rewriter so they remain native collection links.
{% enddoc %}

{% if request.page_type == 'collection' and collection.handle == 'air-national-guard-series' and request.path == collection.url %}
  {% liquid
    assign sq_ang_rows_raw = 'air-national-guard-apparel-pt-gear|Apparel & PT Gear||air-national-guard-awards-medals-ribbons|Awards, Medals & Ribbons||air-national-guard-books-manuals-reference|Books, Manuals & Reference||air-national-guard-flags-displays-memorials|Flags, Displays & Memorials||air-national-guard-gifts-collectibles|Gifts & Collectibles||air-national-guard-headwear|Headwear||air-national-guard-insignia-rank-badges|Insignia, Rank & Badges||air-national-guard-patches-nametapes-identification|Patches, Nametapes & Identification||air-national-guard-uniforms-uniform-accessories|Uniforms & Uniform Accessories'
    assign sq_ang_rows = sq_ang_rows_raw | split: '||'
  %}

  <section class="sq-line-series-categories sq-ang-air-force-root" data-sq-ang-air-force-root aria-labelledby="sq-ang-air-force-page-title">
    <div class="sq-line-series-categories__wrap">
      <p class="sq-line-series-categories__kicker">Products Built for the Line</p>
      <h1 class="sq-ang-air-force-root__page-title" id="sq-ang-air-force-page-title">{{ collection.title }}</h1>
      <h2 id="sq-ang-air-force-root-title">Shop Air National Guard by Category</h2>
      <p class="sq-line-series-categories__intro">The Air National Guard Series combines applicable U.S. Air Force merchandise with Air National Guard-specific merchandise. Choose a category, then choose the exact product type.</p>
      <div class="sq-line-series-categories__grid">
        {% for sq_ang_row in sq_ang_rows %}
          {% assign sq_ang_parts = sq_ang_row | split: '|' %}
          {% assign sq_ang_handle = sq_ang_parts[0] | strip %}
          {% assign sq_ang_label = sq_ang_parts[1] | strip %}
          {% assign sq_ang_collection = collections[sq_ang_handle] %}
          {% if sq_ang_collection != blank and sq_ang_collection.products_count > 0 %}
            {% assign sq_ang_image = sq_ang_collection.image | default: sq_ang_collection.products.first.featured_image %}
            <a class="sq-line-series-categories__card" href="{{ sq_ang_collection.url }}" data-product-card="sq-ang-native-root" data-sq-ang-category-card aria-label="Shop {{ sq_ang_label | escape }}">
              <span class="sq-line-series-categories__media">
                {% if sq_ang_image != blank %}
                  <img src="{{ sq_ang_image | image_url: width: 900 }}" alt="{{ sq_ang_label | escape }}" width="900" height="675" loading="lazy">
                {% else %}
                  <span class="sq-line-series-categories__placeholder" aria-hidden="true">ANG</span>
                {% endif %}
              </span>
              <span class="sq-line-series-categories__copy">
                <span class="sq-line-series-categories__name">{{ sq_ang_label }}</span>
                <span class="sq-line-series-categories__meta">{{ sq_ang_collection.products_count }} {% if sq_ang_collection.products_count == 1 %}item{% else %}items{% endif %}</span>
                <span class="sq-line-series-categories__arrow" aria-hidden="true">›</span>
              </span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <style data-sq-ang-air-force-root-style>
    body:has([data-sq-ang-air-force-root]) #MainContent > .shopify-section collection-component{display:none!important}
    .sq-ang-air-force-root{padding:12px 20px 48px;background:#f4f5f3;color:#071d2d}
    .sq-ang-air-force-root .sq-line-series-categories__wrap{max-width:1280px;margin:0 auto}
    .sq-ang-air-force-root .sq-line-series-categories__kicker{margin:0 0 6px;color:#a91827;font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
    .sq-ang-air-force-root__page-title{display:block!important;margin:0 0 18px;color:#071d2d;font-size:clamp(34px,4.6vw,60px);font-weight:850;line-height:1.04;letter-spacing:-.02em;visibility:visible!important;opacity:1!important}
    .sq-ang-air-force-root h2{margin:0;font-size:clamp(26px,3vw,40px);line-height:1.08}
    .sq-ang-air-force-root .sq-line-series-categories__intro{max-width:900px;margin:10px 0 26px;color:#41505b;font-size:16px;line-height:1.55}
    .sq-ang-air-force-root .sq-line-series-categories__grid{display:grid!important;width:100%!important;grid-template-columns:repeat(5,minmax(0,1fr))!important;gap:16px!important}
    .sq-ang-air-force-root .sq-line-series-categories__card{position:relative;display:flex!important;min-width:0;height:327px;flex-direction:column;overflow:hidden;border:1px solid #aeb8be;border-radius:16px;background:#071d2d;color:#fff;text-decoration:none!important;box-shadow:0 8px 22px rgba(0,0,0,.12);transition:transform .18s ease,box-shadow .18s ease}
    .sq-ang-air-force-root .sq-line-series-categories__card::after{content:"";position:absolute;inset:auto 0 0;height:5px;background:#a91827;pointer-events:none}
    .sq-ang-air-force-root .sq-line-series-categories__card:hover,.sq-ang-air-force-root .sq-line-series-categories__card:focus-visible{transform:translateY(-3px);box-shadow:0 12px 28px rgba(0,0,0,.18)}
    .sq-ang-air-force-root .sq-line-series-categories__card:focus-visible{outline:3px solid #d5ab4b;outline-offset:3px}
    .sq-ang-air-force-root .sq-line-series-categories__media{display:flex;align-items:center;justify-content:center;width:100%;height:220px;flex:0 0 220px;overflow:hidden;background:#fff;border-bottom:1px solid #d9dee1}
    .sq-ang-air-force-root .sq-line-series-categories__media img{display:block;width:100%;height:100%;padding:10px;box-sizing:border-box;background:#fff;object-fit:contain;object-position:center}
    .sq-ang-air-force-root .sq-line-series-categories__placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:#071d2d;font-size:34px;font-weight:900;letter-spacing:.06em}
    .sq-ang-air-force-root .sq-line-series-categories__copy{position:relative;display:flex;min-height:107px;flex:1;flex-direction:column;justify-content:center;padding:14px 42px 18px 16px;background:#071d2d;color:#fff;border-bottom:5px solid #a91827;box-sizing:border-box}
    .sq-ang-air-force-root .sq-line-series-categories__name{display:block;color:#fff;font-size:15px;font-weight:800;line-height:1.23;overflow-wrap:anywhere}
    .sq-ang-air-force-root .sq-line-series-categories__meta{display:block;margin-top:7px;color:#c7d0d6;font-size:12px;font-weight:650;line-height:1.25}
    .sq-ang-air-force-root .sq-line-series-categories__arrow{position:absolute;right:15px;bottom:19px;color:#d5ab4b;font-size:22px;font-weight:900;line-height:1;pointer-events:none}
    @media(max-width:1120px){.sq-ang-air-force-root .sq-line-series-categories__grid{grid-template-columns:repeat(4,minmax(0,1fr))!important}}
    @media(max-width:900px){.sq-ang-air-force-root .sq-line-series-categories__grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}}
    @media(max-width:749px){.sq-ang-air-force-root{padding:6px 14px 36px}.sq-ang-air-force-root__page-title{font-size:clamp(30px,9vw,44px);margin-bottom:14px}.sq-ang-air-force-root .sq-line-series-categories__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important}.sq-ang-air-force-root .sq-line-series-categories__card{height:236px}.sq-ang-air-force-root .sq-line-series-categories__media{height:138px;flex-basis:138px}.sq-ang-air-force-root .sq-line-series-categories__copy{min-height:98px;padding:12px 34px 15px 12px}.sq-ang-air-force-root .sq-line-series-categories__name{font-size:14px}.sq-ang-air-force-root .sq-line-series-categories__arrow{right:11px;bottom:14px}}
    @media(max-width:560px){.sq-ang-air-force-root .sq-line-series-categories__grid{grid-template-columns:minmax(0,1fr)!important}.sq-ang-air-force-root .sq-line-series-categories__card{height:auto;min-height:246px}.sq-ang-air-force-root .sq-line-series-categories__media{height:156px;flex-basis:156px}.sq-ang-air-force-root .sq-line-series-categories__copy{min-height:90px}}
  </style>
{% endif %}

{% schema %}{"name":"ANG Air Force root","settings":[],"presets":[{"name":"ANG Air Force root"}]}{% endschema %}
