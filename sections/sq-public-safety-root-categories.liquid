{% liquid
  assign sq_ps_active = false
  assign sq_ps_intro = ''
  assign sq_ps_handles_csv = ''
  if request.page_type == 'collection' and request.path == collection.url
    case collection.handle
      when 'law-enforcement-corrections'
        assign sq_ps_active = true
        assign sq_ps_intro = 'Shop law enforcement and corrections gear by mission, uniform, identification, protective equipment and duty function.'
        assign sq_ps_handles_csv = 'public-safety-law-enforcement,public-safety-corrections,law-enforcement-general-police-duty-gear,law-enforcement-insignia-ranks,public-safety-police-compatible-army-pin-on-rank,law-enforcement-thin-blue-line,public-safety-body-armor,public-safety-ballistic-helmets,law-enforcement-police-k9,law-enforcement-flags-memorial-displays,law-enforcement-communications-radio-gear,law-enforcement-handcuff-pouches-restraint-carry,law-enforcement-patrol-duty-bags,law-enforcement-badge-id-credentials,law-enforcement-police-sheriff-apparel-identification,law-enforcement-traffic-visibility-scene-safety,law-enforcement-riot-tactical-response-ballistic-shields,law-enforcement-baton-pepper-spray-carry,law-enforcement-duty-footwear-gloves,law-enforcement-duty-scene-lighting,police-law-enforcement-decals,art-law-enforcement-prints'
      when 'firefighting-ems-search-rescue'
        assign sq_ps_active = true
        assign sq_ps_intro = 'Shop firefighting, EMS and search & rescue gear by discipline, protection, identification and response function.'
        assign sq_ps_handles_csv = 'public-safety-firefighting,public-safety-ems,public-safety-search-rescue,firefighter-ems-insignia-ranks-bugles,fire-ems-thin-red-line,public-safety-body-armor,public-safety-ballistic-helmets,fire-ems-rescue-patches,ems-medical-nursing-stickers,firefighter-rescue-stickers,art-firefighter-ems-prints,search-rescue-medical-trauma-field-care,search-rescue-casualty-evacuation-gear,search-rescue-lighting-markers,search-rescue-rescue-helmets-head-protection,search-rescue-rescue-cutting-entanglement-tools,search-rescue-water-dive-rescue,search-rescue-surface-markers-buoys-dive-reels,search-rescue-rope-rigging-elevated-rescue'
    endcase
  endif
%}
{% if sq_ps_active %}{% assign sq_ps_handles = sq_ps_handles_csv | split: ',' %}
<section class="sq-ps-root" data-sq-public-safety-root="{{ collection.handle }}">
 <div class="sq-ps-root__wrap"><p class="sq-ps-root__kicker">Products Built for the Line</p><h2>Shop {{ collection.title }} by Category</h2><p class="sq-ps-root__intro">{{ sq_ps_intro }}</p><div class="sq-ps-root__grid">
 {% for sq_handle in sq_ps_handles %}{% assign sq_c = collections[sq_handle] %}{% if sq_c != blank and sq_c.products_count > 0 %}{% assign sq_image = sq_c.image %}{% if sq_image == blank and sq_c.products.first != blank %}{% assign sq_image = sq_c.products.first.featured_image %}{% endif %}{% assign sq_label = sq_c.title | remove: 'Public Safety - ' | remove: 'Law Enforcement - ' | remove: 'Search & Rescue - ' | remove: 'Fire / EMS - ' | remove: 'Art — ' %}
  <a class="sq-ps-root__card" data-sq-ps-root-card href="{{ sq_c.url }}" aria-label="Shop {{ sq_label | escape }}"><span class="sq-ps-root__media">{% if sq_image != blank %}<img src="{{ sq_image | image_url: width: 720 }}" alt="{{ sq_label | escape }}" width="720" height="500" loading="lazy">{% else %}<span class="sq-ps-root__placeholder">SQ</span>{% endif %}</span><span class="sq-ps-root__copy"><strong>{{ sq_label }}</strong><small>{{ sq_c.products_count }} items</small><span aria-hidden="true">→</span></span></a>
 {% endif %}{% endfor %}
 </div></div>
</section>
<style>html:has(.sq-ps-root) body .sq-third-level,html:has(.sq-ps-root) body .sq-subcategory-section,html:has(.sq-ps-root) body collection-component{display:none!important}.sq-ps-root{padding:12px 20px 48px;background:#f4f5f3;color:#071d2d}.sq-ps-root__wrap{max-width:1280px;margin:0 auto}.sq-ps-root__kicker{margin:0 0 6px;color:#a91827;font-size:12px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.sq-ps-root h2{margin:0;font-size:clamp(26px,3vw,40px);line-height:1.08}.sq-ps-root__intro{max-width:900px;margin:10px 0 26px;color:#41505b;font-size:16px;line-height:1.55}.sq-ps-root__grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}.sq-ps-root__card{position:relative;display:flex;min-width:0;height:327px;flex-direction:column;overflow:hidden;border:1px solid #aeb8be;border-radius:14px;background:#fff;color:#fff;text-decoration:none;box-shadow:0 8px 22px rgba(0,0,0,.12)}.sq-ps-root__card::after{content:"";position:absolute;inset:auto 0 0;height:4px;background:#a91827}.sq-ps-root__media{display:grid;height:220px;flex:0 0 220px;place-items:center;overflow:hidden;background:#fff;border-bottom:1px solid #d9dee1}.sq-ps-root__media img{display:block;width:100%;height:100%;padding:10px;box-sizing:border-box;background:#fff;object-fit:contain}.sq-ps-root__placeholder{display:grid;width:100%;height:100%;place-items:center;color:#d5ab4b;font-size:38px;font-weight:950}.sq-ps-root__copy{position:relative;display:flex;min-height:107px;flex:1;flex-direction:column;padding:14px 42px 16px 15px;background:#071d2d}.sq-ps-root__copy strong{font-size:14px;line-height:1.24}.sq-ps-root__copy small{margin-top:6px;color:#c7d0d6;font-size:12px}.sq-ps-root__copy>span{position:absolute;right:15px;bottom:16px;color:#d5ab4b;font-size:22px;font-weight:900}@media(max-width:1120px){.sq-ps-root__grid{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:900px){.sq-ps-root__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:749px){.sq-ps-root{padding:6px 14px 36px}.sq-ps-root__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.sq-ps-root__card{height:218px}.sq-ps-root__media{height:128px;flex-basis:128px}.sq-ps-root__copy{min-height:90px;padding:12px 34px 14px 12px}.sq-ps-root__copy strong{font-size:13px}}</style>
<script>(function(){var root=document.querySelector('[data-sq-public-safety-root]');if(!root)return;var cards=[].slice.call(root.querySelectorAll('[data-sq-ps-root-card]')),used={};function norm(s){if(!s)return'';try{var u=new URL(s,location.origin);return u.origin+u.pathname}catch(e){return String(s).split('?')[0]}}function picks(h){var d=new DOMParser().parseFromString(h,'text/html'),o=[];d.querySelectorAll('.product-grid__item img[src],#ResultsList img[src],collection-component img[src]').forEach(function(i){var s=i.getAttribute('src')||'',k=norm(s);if(s&&k)o.push({src:s,key:k})});return o}async function hydrate(c){try{var u=new URL(c.href,location.origin),r=await fetch(u.pathname+u.search,{credentials:'same-origin'});if(!r.ok)return;var list=picks(await r.text()),p=null;for(var i=0;i<list.length;i++){if(!used[list[i].key]){p=list[i];break}}if(!p){var m=c.querySelector('.sq-ps-root__media');if(m)m.innerHTML='<span class="sq-ps-root__placeholder">SQ</span>';return}used[p.key]=1;var m=c.querySelector('.sq-ps-root__media'),img=m&&m.querySelector('img');if(m&&!img){m.innerHTML='<img width="720" height="500" loading="lazy">';img=m.querySelector('img')}if(img){img.src=p.src;img.removeAttribute('srcset');img.removeAttribute('sizes');img.alt=(c.querySelector('strong')||{}).textContent||'Category'}}catch(e){}}(async function(){for(var i=0;i<cards.length;i++)await hydrate(cards[i])})()})();</script>
{% endif %}
