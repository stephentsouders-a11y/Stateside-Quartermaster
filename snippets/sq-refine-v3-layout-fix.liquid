{% doc %}
Keeps the V3 products-per-page control and product surface together in the right-hand product column. This is deliberately inactive on State Guard Series. Includes route-specific cleanup for certified collection roots.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<style data-sq-refine-v3-layout-fix>
#MainContent .sq-refine-v3-products{min-width:0}
#MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size{grid-column:2;grid-row:1;margin-bottom:0}
#MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size + collection-component,
#MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size + #ResultsList,
#MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size + .product-grid{grid-column:2;grid-row:2}
#MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-sidebar{grid-column:1;grid-row:1 / span 2;z-index:20}
#MainContent.sq-refine-v3-active .sq-refine-v3-group>summary{position:relative;z-index:2;pointer-events:auto}
html body #MainContent.sq-refine-v3-active [data-sq-refine-v3-hidden-nav='true']{display:none!important;visibility:hidden!important;pointer-events:none!important}
html body #MainContent.sq-refine-v3-active .sq-refine-v3-group>summary::after{content:'+'!important}
html body #MainContent.sq-refine-v3-active .sq-refine-v3-group[open]>summary::after{content:'−'!important}
@media(max-width:900px){
  #MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size,
  #MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size + collection-component,
  #MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size + #ResultsList,
  #MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-page-size + .product-grid,
  #MainContent.sq-refine-v3-active .sq-refine-v3-layout>.sq-refine-v3-sidebar{grid-column:auto;grid-row:auto}
}
</style>
<script data-sq-refine-v3-hardening>
(function(){
  function enforce(){
    var main=document.getElementById('MainContent');
    if(!main||main.dataset.sqRefineV3Ready!=='true')return false;
    main.querySelectorAll('[data-sq-refine-v3-hidden-nav="true"]').forEach(function(node){
      if(node.closest('.sq-refine-v3-sidebar,.sq-refine-v3-results,.sq-refine-v3-page-size'))return;
      node.hidden=true;
      node.setAttribute('aria-hidden','true');
      node.style.setProperty('display','none','important');
      node.style.setProperty('visibility','hidden','important');
      node.style.setProperty('pointer-events','none','important');
    });
    main.querySelectorAll('.sq-refine-v3-group').forEach(function(details){
      var summary=details.querySelector(':scope>summary');
      if(!summary)return;
      function sync(){summary.setAttribute('aria-expanded',details.open?'true':'false')}
      sync();
      if(details.dataset.sqRefineV3ToggleBound==='1')return;
      details.dataset.sqRefineV3ToggleBound='1';
      summary.dataset.sqRefineV3ToggleBound='1';
      details.addEventListener('toggle',sync);
    });
    main.dataset.sqRefineV3Hardened='true';
    return true;
  }
  if(enforce())return;
  var observer=new MutationObserver(function(){if(enforce())observer.disconnect()});
  observer.observe(document.documentElement,{subtree:true,childList:true,attributes:true,attributeFilter:['data-sq-refine-v3-ready']});
  window.addEventListener('load',enforce,{once:true});
})();
</script>
{% if collection.handle == 'armed-forces-gear' %}
<style data-sq-refine-v3-afg-mobile-grid>
@media(max-width:900px){
  html body #MainContent.sq-refine-v3-active .sq-refine-v3-results .product-grid{
    display:grid!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
  }
}
</style>
{% endif %}
{% if collection.handle == 'accessories-gifts-collectibles' or collection.handle == 'airsoft-milsim' or collection.handle == 'apparel' or collection.handle == 'armed-forces-gear' or collection.handle == 'art' %}
<script data-sq-refine-v3-route-fix="{{ collection.handle | escape }}">
(function(){
  var route='{{ collection.handle | escape }}';
  var falseHandles=new Set(['all','stateside-quartermaster-logo-merch','air-national-guard-series','state-guard-series','rotc-series','jrotc-series','military-schools-academies','public-safety-series','army-national-guard-series']);
  function targetHandle(raw){try{var m=new URL(raw,location.origin).pathname.match(/^\/collections\/([^/?#]+)/);return m?decodeURIComponent(m[1]):''}catch(_){return''}}
  function clean(){
    var main=document.getElementById('MainContent');
    if(!main||main.dataset.sqRefineV3Ready!=='true')return false;
    document.querySelectorAll('[data-sq-refine-v3-hidden-nav="true"]').forEach(function(node){if(!main.contains(node))node.removeAttribute('data-sq-refine-v3-hidden-nav')});
    if(route==='armed-forces-gear'){
      var results=main.querySelector('.sq-refine-v3-results');
      main.querySelectorAll('[id*="sq_afg_branch_buttons"]').forEach(function(node){
        var host=node.querySelector('collection-component');
        if(host&&results&&!results.contains(host))results.appendChild(host);
        node.remove();
      });
    }
    var sidebar=main.querySelector('.sq-refine-v3-sidebar');
    if(!sidebar)return false;
    sidebar.querySelectorAll('input[data-kind="structural"]').forEach(function(input){
      if(falseHandles.has(targetHandle(input.dataset.target||''))){var row=input.closest('.sq-refine-v3-choice');if(row)row.remove()}
    });
    sidebar.querySelectorAll('.sq-refine-v3-group').forEach(function(group){if(!group.querySelector('input[type="checkbox"]'))group.remove()});
    main.dataset.sqRefineV3RouteFix=route;
    return true;
  }
  if(clean())return;
  var observer=new MutationObserver(function(){if(clean())observer.disconnect()});
  observer.observe(document.documentElement,{subtree:true,childList:true,attributes:true,attributeFilter:['data-sq-refine-v3-ready']});
  window.addEventListener('load',clean,{once:true});
})();
</script>
{% endif %}
{% endif %}