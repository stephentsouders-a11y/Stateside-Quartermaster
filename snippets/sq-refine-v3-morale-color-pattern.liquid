{% doc %}
Adds tag-backed Color / Pattern filtering to the Morale Patches and Patriotic & American Heritage V3 Refine Products sidebars. The visible filter state is mirrored in filter.p.tag while the Shopify collection-tag path guarantees that the product grid is actually filtered.
{% enddoc %}
{% if request.page_type == 'collection' %}
  {% assign sq_color_root = '' %}
  {% if collection.handle == 'morale-patches-tactical-id' %}
    {% assign sq_color_root = 'morale-patches-tactical-id' %}
  {% elsif collection.handle == 'patriotic-american-heritage' %}
    {% assign sq_color_root = 'patriotic-american-heritage' %}
  {% endif %}
  {% if sq_color_root != blank %}
<script type="application/json" data-sq-color-pattern-tags>{{ collection.all_tags | json }}</script>
{% if sq_color_root == 'morale-patches-tactical-id' %}
<script type="application/json" data-sq-color-pattern-fallback>["SQ Color/Pattern: Black","SQ Color/Pattern: Blue","SQ Color/Pattern: Brown / Tan","SQ Color/Pattern: Camouflage","SQ Color/Pattern: Gray","SQ Color/Pattern: Green","SQ Color/Pattern: Orange","SQ Color/Pattern: Pink","SQ Color/Pattern: Red","SQ Color/Pattern: White"]</script>
{% endif %}
<script data-sq-color-pattern-controller data-sq-color-root="{{ sq_color_root | escape }}">
(function () {
  'use strict';
  var script = document.currentScript;
  var root = script && script.dataset.sqColorRoot || '';
  if (!root) return;
  var guard = '__sqColorPattern_' + root.replace(/[^a-z0-9]/gi, '_');
  if (window[guard]) return;
  window[guard] = true;
  var main = document.getElementById('MainContent');
  if (!main) return;
  var prefix = /^SQ Color\/Pattern:\s*/i;
  var collectionPath = '/collections/' + root;
  function readJson(selector) {
    var node = document.querySelector(selector);
    if (!node) return [];
    try { return JSON.parse(node.textContent) || []; } catch (_) { return []; }
  }
  function handleize(value) {
    return String(value || '')
      .toLowerCase()
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[’']/g, '')
      .replace(/&/g, ' and ')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }
  var tags = readJson('[data-sq-color-pattern-tags]').filter(function (tag) {
    return prefix.test(tag) && tag.replace(prefix, '').trim();
  });
  if (!tags.length && root === 'morale-patches-tactical-id') {
    tags = readJson('[data-sq-color-pattern-fallback]');
  }
  tags = Array.from(new Set(tags.filter(function (tag) {
    return prefix.test(tag) && tag.replace(prefix, '').trim();
  })));
  tags.sort(function (a, b) {
    return a.replace(prefix, '').localeCompare(b.replace(prefix, ''), undefined, { sensitivity: 'base' });
  });
  if (!tags.length) return;
  function activeTag() {
    var params = new URLSearchParams(location.search);
    return params.getAll('filter.p.tag').find(function (value) { return prefix.test(value); }) || '';
  }
  function selectedHandles() {
    var path = location.pathname.replace(/\/+$/, '');
    if (path.indexOf(collectionPath + '/') !== 0) return [];
    return path.slice((collectionPath + '/').length).split('+').filter(Boolean);
  }
  function install() {
    var side = main.querySelector('.sq-refine-v3-sidebar');
    if (!side || main.dataset.sqRefineV3Ready !== 'true') return false;
    var owned = side.querySelector('[data-sq-color-pattern-owned="' + root + '"]');
    if (owned) return true;
    Array.from(side.querySelectorAll(':scope > details.sq-refine-v3-group')).forEach(function (details) {
      var summary = details.querySelector(':scope > summary');
      if (summary && summary.textContent.trim() === 'Shop by Color / Pattern') details.remove();
    });
    var group = document.createElement('details');
    group.className = 'sq-refine-v3-group';
    group.dataset.sqColorPatternOwned = root;
    var summary = document.createElement('summary');
    summary.textContent = 'Shop by Color / Pattern';
    var choices = document.createElement('div');
    choices.className = 'sq-refine-v3-choices';
    var selectedTag = activeTag();
    var handles = selectedHandles();
    tags.forEach(function (tag) {
      var tagHandle = handleize(tag);
      var row = document.createElement('label');
      row.className = 'sq-refine-v3-choice';
      var input = document.createElement('input');
      input.type = 'checkbox';
      input.name = 'filter.p.tag';
      input.value = tag;
      input.dataset.sqColorPatternTag = tag;
      input.dataset.sqColorPatternHandle = tagHandle;
      input.checked = selectedTag === tag || handles.indexOf(tagHandle) !== -1;
      var text = document.createElement('span');
      text.textContent = tag.replace(prefix, '').trim();
      input.addEventListener('change', function () {
        var url = new URL(location.href);
        url.pathname = collectionPath + (input.checked ? '/' + tagHandle : '');
        url.searchParams.delete('filter.p.tag');
        if (input.checked) url.searchParams.append('filter.p.tag', tag);
        url.searchParams.set('sq_root', root);
        url.searchParams.delete('page');
        url.searchParams.delete('sq_view_page');
        location.assign(url.pathname + '?' + url.searchParams.toString());
      });
      row.append(input, text);
      choices.appendChild(row);
    });
    group.append(summary, choices);
    group.open = !!choices.querySelector('input:checked');
    group.dataset.active = group.open ? 'true' : 'false';
    var groups = Array.from(side.querySelectorAll(':scope > details.sq-refine-v3-group'));
    var after = groups.find(function (details) {
      var summaryNode = details.querySelector(':scope > summary');
      return /manufacturer|vendor|availability|price/i.test(summaryNode ? summaryNode.textContent : '');
    });
    side.insertBefore(group, after || null);
    return true;
  }
  if (install()) return;
  var observer = new MutationObserver(function () {
    if (install()) {
      observer.disconnect();
      clearTimeout(deadline);
    }
  });
  observer.observe(main, { childList: true, subtree: true, attributes: true, attributeFilter: ['data-sq-refine-v3-ready'] });
  var deadline = setTimeout(function () { observer.disconnect(); }, 60000);
})();
</script>
  {% endif %}
{% endif %}
