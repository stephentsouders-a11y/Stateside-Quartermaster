{% if request.page_type == 'collection' and collection.handle == 'state-guard-series-ohio' %}
<style data-sq-ohio-refine-restoration>
#MainContent .sq-ohio-refine-layout{
  display:grid!important;
  grid-template-columns:minmax(250px,300px) minmax(0,1fr)!important;
  gap:24px!important;
  align-items:start!important;
}
#MainContent .sq-ohio-refine-layout>.sq-global-refine-sidebar{
  grid-column:1!important;
  grid-row:1 / span 50!important;
  min-width:0!important;
  width:auto!important;
  display:block!important;
  visibility:visible!important;
}
#MainContent .sq-ohio-refine-layout .facets-block-wrapper--horizontal,
#MainContent .sq-ohio-refine-layout .facets-toggle,
#MainContent .sq-ohio-refine-layout theme-drawer#filters-drawer{
  display:none!important;
  visibility:hidden!important;
  pointer-events:none!important;
}
#MainContent .sq-ohio-refine-layout> :not(.sq-global-refine-sidebar):not(.facets-block-wrapper--horizontal):not(.facets-toggle):not(theme-drawer#filters-drawer){
  grid-column:2!important;
  min-width:0!important;
}
#MainContent .sq-ohio-refine-layout>[data-sq-ohio-taxonomy-products]{
  grid-column:2!important;
  width:100%!important;
  min-width:0!important;
  padding:0!important;
}
@media(max-width:900px){
  #MainContent .sq-ohio-refine-layout{grid-template-columns:1fr!important;gap:16px!important}
  #MainContent .sq-ohio-refine-layout>.sq-global-refine-sidebar{
    grid-column:1!important;
    grid-row:auto!important;
    position:static!important;
    max-height:none!important;
    overflow:visible!important;
  }
  #MainContent .sq-ohio-refine-layout> :not(.sq-global-refine-sidebar):not(.facets-block-wrapper--horizontal):not(.facets-toggle):not(theme-drawer#filters-drawer),
  #MainContent .sq-ohio-refine-layout>[data-sq-ohio-taxonomy-products]{grid-column:1!important}
}
</style>

<aside class="sq-global-refine-sidebar" data-sq-ohio-refine-host aria-label="Refine Products">
  <h2 class="sq-global-refine-sidebar__title">Refine Products</h2>
  <p class="sq-ohio-refine-loading">Loading refinements…</p>
</aside>

<script data-sq-ohio-refine-restoration-host>
(function(){
  var controller=window.__sqOhioRefineRestorationController;
  if(controller&&controller.destroy){try{controller.destroy()}catch(_){}}

  var state={ownerAttempts:0,ownerBusy:false,lastOwnerStart:0,repairTimer:null,observerTimer:null,observer:null,destroyed:false};
  window.__sqOhioRefineRestorationController={destroy:function(){
    state.destroyed=true;
    clearTimeout(state.repairTimer);clearTimeout(state.observerTimer);
    if(state.observer)try{state.observer.disconnect()}catch(_){}
  }};

  function main(){return document.getElementById('MainContent')}

  function syncInitialAvailability(){
    try{
      var u=new URL(location.href);
      if(u.searchParams.get('filter.v.availability')==='1'&&!u.searchParams.has('sq_oh_availability')){
        u.searchParams.append('sq_oh_availability','In stock');
        history.replaceState(history.state,'',u.pathname+(u.search?'?'+u.searchParams.toString():'')+u.hash);
      }
    }catch(_){}
  }

  function install(){
    if(state.destroyed)return false;
    var m=main();if(!m)return false;
    var sides=[].slice.call(document.querySelectorAll('[data-sq-ohio-refine-host]'));
    var wrap=m.querySelector('collection-component .collection-wrapper');
    if(!wrap)return false;
    var side=sides.filter(function(x){return m.contains(x)})[0]||sides[0];
    if(!side){
      side=document.createElement('aside');
      side.className='sq-global-refine-sidebar';
      side.dataset.sqOhioRefineHost='true';
      side.setAttribute('aria-label','Refine Products');
      side.innerHTML='<h2 class="sq-global-refine-sidebar__title">Refine Products</h2><p class="sq-ohio-refine-loading">Loading refinements…</p>';
    }
    sides.filter(function(x){return x!==side}).forEach(function(x){x.remove()});
    wrap.classList.add('sq-global-refine-layout','sq-state-guard-refine-layout','sq-ohio-refine-layout');
    if(side.parentNode!==wrap)wrap.insertBefore(side,wrap.firstChild);
    side.removeAttribute('hidden');side.removeAttribute('aria-hidden');
    side.style.removeProperty('display');side.style.removeProperty('visibility');
    return true;
  }

  function hasCompleteSidebar(){
    var m=main();if(!m)return false;
    var side=m.querySelector('[data-sq-ohio-refine-host]');if(!side)return false;
    var groups=[].slice.call(side.querySelectorAll('.sq-ohio-refine-group>summary')).map(function(x){return String(x.textContent||'').trim()});
    var required=['Shop by Category','Shop by Subcategory','Shop by Type','Shop by Manufacturers','Shop by Color / Pattern','Availability'];
    return required.every(function(x){return groups.indexOf(x)!==-1});
  }

  function ownerScript(){
    var scripts=document.querySelectorAll('script[data-sq-state-guard-special-refine-owner]');
    return scripts.length?scripts[scripts.length-1]:null;
  }

  function runOwnerRepair(){
    if(state.destroyed)return false;
    install();
    if(hasCompleteSidebar()){state.ownerBusy=false;state.ownerAttempts=0;return true;}
    var now=Date.now();
    if(state.ownerBusy&&now-state.lastOwnerStart<4500)return false;
    var owner=ownerScript();
    if(!owner||!String(owner.textContent||'').trim())return false;
    state.ownerAttempts+=1;state.ownerBusy=true;state.lastOwnerStart=now;
    window.__sqOhioStableRefineV2=false;
    try{new Function(owner.textContent)();}
    catch(err){state.ownerBusy=false;console.error('Ohio refine owner repair failed',err);return false;}
    setTimeout(function(){
      if(state.destroyed)return;
      state.ownerBusy=false;
      if(!hasCompleteSidebar())scheduleRepair(250);
    },1800);
    return false;
  }

  function scheduleRepair(delay){
    if(state.destroyed)return;
    clearTimeout(state.repairTimer);
    state.repairTimer=setTimeout(runOwnerRepair,delay||120);
  }

  function withinOhio(ev){
    var m=main();return !!(m&&ev.target&&m.contains(ev.target));
  }

  syncInitialAvailability();

  document.addEventListener('click',function(ev){
    if(!withinOhio(ev))return;
    var row=ev.target&&ev.target.closest&&ev.target.closest('.sq-ohio-refine-choice');if(!row)return;
    var box=ev.target&&ev.target.closest&&ev.target.closest('input[type="checkbox"]');if(box)return;
    ev.preventDefault();ev.stopPropagation();
  },true);

  document.addEventListener('change',function(ev){
    if(!withinOhio(ev))return;
    var input=ev.target&&ev.target.closest&&ev.target.closest('input[data-sq-ohio-group="availability"]');if(!input)return;
    try{
      var u=new URL(location.href),value=String(input.value||'').trim().toLowerCase();
      if(input.checked&&value==='in stock')u.searchParams.set('filter.v.availability','1');
      else u.searchParams.delete('filter.v.availability');
      history.replaceState(history.state,'',u.pathname+(u.search?'?'+u.searchParams.toString():'')+u.hash);
    }catch(_){}
  },true);

  function auditAndRepair(){
    if(state.destroyed)return;
    install();
    if(!hasCompleteSidebar())scheduleRepair(180);
  }

  function boot(){auditAndRepair()}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
  window.addEventListener('load',auditAndRepair,{once:true});

  state.observer=new MutationObserver(function(){
    clearTimeout(state.observerTimer);
    state.observerTimer=setTimeout(auditAndRepair,70);
  });
  state.observer.observe(document.documentElement,{childList:true,subtree:true});

  [700,1800,3500,6000,9500,13500,18000].forEach(function(ms){setTimeout(auditAndRepair,ms)});
})();
</script>

{% render 'sq-state-guard-special-refine-owner' %}
{% endif %}
