{% doc %}
Sitewide authoritative pagination repair for Refine V3 collection pages.
The V3 interface supports logical page sizes of 50, 100, and 250 while its alternate
Shopify source view renders 50 products per native page. This guard determines whether
a logical Next page exists by probing the first native source page after the current
logical view instead of trusting a missing native pagination marker. It applies to every
Refine V3 root and child route and leaves State Guard Series untouched.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<style data-sq-refine-v3-pagination-button-style>
#MainContent .sq-refine-v3-pager a,
#MainContent .sq-refine-v3-pager span{
  background:#0b3a63!important;
  color:#fff!important;
  border-color:#0b3a63!important;
}
#MainContent .sq-refine-v3-pager a:hover,
#MainContent .sq-refine-v3-pager a:focus-visible{
  background:#071d2d!important;
  border-color:#071d2d!important;
  color:#fff!important;
}
</style>
<script data-sq-refine-v3-pagination-repair data-revision="logical-sentinel-probe-20260911-v3-blue-buttons">
(function(){
  if(window.__sqRefineV3PaginationRepair)return;
  window.__sqRefineV3PaginationRepair=true;

  var ROOTS=new Set(['accessories-gifts-collectibles','airsoft-milsim','apparel','armed-forces-gear','art','body-armor-ballistic-protection','literature','child-safety-shop','dive-scuba','firearm-accessories','first-aid-medical-ifak','flags-patriotic-decor','flashlights-lighting','footwear-gloves-eyewear','k9-dog-gear','knives-axes-cutlery','morale-patches-tactical-id','outdoor-preparedness-gear','patriotic-american-heritage','safety-rescue-climbing','sta-brite-insignia','tactical-gear','thin-line','uniforms','watches','zippos-lighters-torches','stateside-quartermaster-logo-merch','army-national-guard-series','air-national-guard-series','products-built-for-the-line-u-s-army','products-built-for-the-line-u-s-navy','products-built-for-the-line-u-s-air-force','products-built-for-the-line-u-s-marine-corps','products-built-for-the-line-u-s-coast-guard','products-built-for-the-line-u-s-space-force','rotc-series','jrotc-series','military-schools-academies','law-enforcement-corrections','firefighting-ems-search-rescue']);
  var q=new URLSearchParams(location.search);
  var currentHandle='{{ collection.handle | escape }}';
  var rootHandle=q.get('sq_root')||currentHandle;
  if(!ROOTS.has(rootHandle))return;
  var main=document.getElementById('MainContent');
  if(!main)return;

  function perPage(){
    var n=parseInt(q.get('sq_per_page')||'50',10);
    return [50,100,250].indexOf(n)>-1?n:50;
  }
  function currentView(){
    return Math.max(1,parseInt(q.get('sq_view_page')||'1',10)||1);
  }
  function sourcePath(){
    return currentHandle==='air-national-guard-series'
      ?'/collections/products-built-for-the-line-u-s-air-force'
      :location.pathname;
  }
  function alternateUrl(page){
    var u=new URL(sourcePath(),location.origin);
    q.forEach(function(v,k){
      if(k.indexOf('filter.')===0||k==='sort_by'||k==='preview_theme_id')u.searchParams.append(k,v);
    });
    u.searchParams.set('view','sq-refine-v3-products');
    u.searchParams.set('page',String(page));
    return u.pathname+'?'+u.searchParams.toString();
  }
  function logicalUrl(page){
    var u=new URL(location.href);
    u.searchParams.delete('page');
    u.searchParams.set('sq_per_page',String(perPage()));
    u.searchParams.set('sq_view_page',String(page));
    return u.pathname+'?'+u.searchParams.toString();
  }
  function sentinelNativePage(view,size){
    return Math.floor((view*size)/50)+1;
  }
  function productLinks(doc){
    var grid=doc.querySelector('.product-grid');
    if(!grid)return[];
    return Array.from(new Set(Array.from(grid.querySelectorAll('a[href*="/products/"]')).map(function(a){return a.getAttribute('href')||a.href}).filter(Boolean)));
  }
  async function nativePageHasProducts(page){
    var r=await fetch(alternateUrl(page),{credentials:'same-origin',cache:'no-store'});
    if(!r.ok)throw new Error('HTTP '+r.status+' for source page '+page);
    var doc=new DOMParser().parseFromString(await r.text(),'text/html');
    return productLinks(doc).length>0;
  }
  function pagerHost(){
    var grid=main.querySelector('.sq-refine-v3-results .product-grid');
    return grid&&grid.parentElement?grid.parentElement:null;
  }
  function authoritativePager(){
    var host=pagerHost();
    if(!host)return null;
    var all=Array.from(main.querySelectorAll('.sq-refine-v3-pager'));
    var pager=all.find(function(x){return x.parentElement===host})||all[0]||null;
    all.forEach(function(x){if(x!==pager)x.remove()});
    if(!pager){
      pager=document.createElement('nav');
      pager.className='sq-refine-v3-pager';
      pager.setAttribute('aria-label','Product pages');
      host.appendChild(pager);
    }else if(pager.parentElement!==host){
      host.appendChild(pager);
    }
    return pager;
  }
  function renderPager(pager,view,hasNext){
    while(pager.firstChild)pager.removeChild(pager.firstChild);
    if(view>1){
      var prev=document.createElement('a');
      prev.href=logicalUrl(view-1);
      prev.textContent='Previous';
      prev.setAttribute('aria-label','Previous product page');
      prev.dataset.sqPaginationRepair='previous';
      pager.appendChild(prev);
    }
    var label=document.createElement('span');
    label.textContent='Page '+view;
    label.setAttribute('aria-current','page');
    pager.appendChild(label);
    if(hasNext){
      var next=document.createElement('a');
      next.href=logicalUrl(view+1);
      next.textContent='Next';
      next.setAttribute('aria-label','Next product page');
      next.dataset.sqPaginationRepair='next';
      pager.appendChild(next);
    }
  }
  async function repair(){
    if(main.dataset.sqRefineV3Error)return;
    if(main.dataset.sqRefineV3Ready!=='true')return;
    var pager=authoritativePager();
    if(!pager)return;
    var size=perPage();
    var view=currentView();
    var sourcePage=sentinelNativePage(view,size);
    try{
      var hasNext=await nativePageHasProducts(sourcePage);
      renderPager(pager,view,hasNext);
      main.dataset.sqRefineV3PaginationRepaired='true';
      main.dataset.sqRefineV3PaginationCertified=(hasNext?'next-source-page-':'last-source-page-')+sourcePage;
      main.dataset.sqRefineV3PaginationPageSize=String(size);
    }catch(e){
      main.dataset.sqRefineV3PaginationRepairError=String(e&&e.message||e);
      console.error('[SQ V3 pagination repair]',e);
    }
  }
  function schedule(){
    clearTimeout(window.__sqRefineV3PaginationTimer);
    window.__sqRefineV3PaginationTimer=setTimeout(repair,60);
  }
  function whenReady(){
    if(main.dataset.sqRefineV3Ready==='true')schedule();
    var obs=new MutationObserver(function(){
      if(main.dataset.sqRefineV3Ready==='true')schedule();
    });
    obs.observe(main,{childList:true,subtree:true,attributes:true,attributeFilter:['data-sq-refine-v3-ready']});
    [250,900,1800].forEach(function(ms){setTimeout(function(){if(main.dataset.sqRefineV3Ready==='true')schedule()},ms)});
    setTimeout(function(){obs.disconnect();if(main.dataset.sqRefineV3Ready==='true')schedule()},12000);
    window.addEventListener('pageshow',schedule);
    window.addEventListener('popstate',schedule);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',whenReady,{once:true});
  else whenReady();
})();
</script>
{% endif %}
