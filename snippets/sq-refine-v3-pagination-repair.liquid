{% doc %}
Sitewide authoritative pagination repair for Refine V3 collection pages.
Design Concept One: every logical page number is rendered with persistent previous/next arrows.
Products-per-page state (50/100/250), filters, sort order, preview theme, and sq_root context
remain linked in every logical page URL. State Guard Series stays on standard pagination.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<style data-sq-refine-v3-pagination-button-style data-design="concept-one">
#MainContent .sq-refine-v3-pager{display:flex!important;visibility:visible!important;opacity:1!important;width:100%!important;min-height:48px!important;align-items:center!important;justify-content:center!important;gap:10px!important;margin:24px 0 10px!important;padding:4px 0!important;position:relative!important;z-index:2!important;box-sizing:border-box!important}
#MainContent .sq-refine-v3-page-rail{display:flex!important;flex:0 1 auto!important;align-items:center!important;justify-content:center!important;gap:8px!important;flex-wrap:wrap!important;min-width:0!important;max-width:calc(100% - 108px)!important}
#MainContent .sq-refine-v3-page-btn{box-sizing:border-box!important;display:inline-flex!important;visibility:visible!important;opacity:1!important;align-items:center!important;justify-content:center!important;width:44px!important;min-width:44px!important;height:44px!important;min-height:44px!important;padding:0!important;border:1px solid #cfd8df!important;border-radius:10px!important;background:#fff!important;color:#0b3a63!important;text-decoration:none!important;font-weight:900!important;line-height:1!important;box-shadow:0 1px 2px rgba(7,29,45,.08)!important;transition:background .15s ease,border-color .15s ease,color .15s ease,transform .15s ease!important}
#MainContent .sq-refine-v3-page-btn--arrow{flex:0 0 44px!important;border-color:#0b3a63!important;background:#0b3a63!important;color:#fff!important;font-size:30px!important;font-family:Arial,sans-serif!important;font-weight:700!important}
#MainContent .sq-refine-v3-page-btn--current{border-color:#0b3a63!important;background:#0b3a63!important;color:#fff!important;cursor:default!important}
#MainContent a.sq-refine-v3-page-btn:hover{border-color:#0b3a63!important;background:#eef4f8!important;color:#071d2d!important;transform:translateY(-1px)!important}
#MainContent a.sq-refine-v3-page-btn--arrow:hover{border-color:#071d2d!important;background:#071d2d!important;color:#fff!important}
#MainContent .sq-refine-v3-page-btn:focus-visible{outline:3px solid #d5ab4b!important;outline-offset:2px!important}
#MainContent .sq-refine-v3-page-btn--disabled{opacity:.34!important;cursor:not-allowed!important;pointer-events:none!important}
@media(max-width:749px){#MainContent .sq-refine-v3-pager{gap:7px!important;padding-inline:2px!important}#MainContent .sq-refine-v3-page-rail{flex:1 1 auto!important;justify-content:flex-start!important;flex-wrap:nowrap!important;overflow-x:auto!important;overscroll-behavior-inline:contain!important;scrollbar-width:thin!important;max-width:none!important;padding:3px 1px 6px!important}#MainContent .sq-refine-v3-page-btn{width:42px!important;min-width:42px!important;height:42px!important;min-height:42px!important}#MainContent .sq-refine-v3-page-btn--arrow{flex-basis:42px!important}}
</style>
<script data-sq-refine-v3-pagination-repair data-revision="concept-one-all-pages-ppp-linked-20260912-v1">
(function(){
if(window.__sqRefineV3PaginationRepair)return;window.__sqRefineV3PaginationRepair=true;
var ROOTS=new Set(['accessories-gifts-collectibles','airsoft-milsim','apparel','armed-forces-gear','art','body-armor-ballistic-protection','literature','child-safety-shop','dive-scuba','firearm-accessories','first-aid-medical-ifak','flags-patriotic-decor','flashlights-lighting','footwear-gloves-eyewear','k9-dog-gear','knives-axes-cutlery','morale-patches-tactical-id','outdoor-preparedness-gear','patriotic-american-heritage','safety-rescue-climbing','sta-brite-insignia','tactical-gear','thin-line','uniforms','watches','zippos-lighters-torches','stateside-quartermaster-logo-merch','army-national-guard-series','air-national-guard-series','products-built-for-the-line-u-s-army','products-built-for-the-line-u-s-navy','products-built-for-the-line-u-s-air-force','products-built-for-the-line-u-s-marine-corps','products-built-for-the-line-u-s-coast-guard','products-built-for-the-line-u-s-space-force','rotc-series','jrotc-series','military-schools-academies','law-enforcement-corrections','firefighting-ems-search-rescue']);
var currentHandle='{{ collection.handle | escape }}',rootHandle=new URLSearchParams(location.search).get('sq_root')||currentHandle;if(!ROOTS.has(rootHandle))return;
var main=document.getElementById('MainContent');if(!main)return;
function perPage(){var n=parseInt(new URLSearchParams(location.search).get('sq_per_page')||'50',10);return[50,100,250].indexOf(n)>-1?n:50}
function currentView(){return Math.max(1,parseInt(new URLSearchParams(location.search).get('sq_view_page')||'1',10)||1)}
function logicalUrl(page){var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.delete('view');u.searchParams.set('sq_per_page',String(perPage()));u.searchParams.set('sq_view_page',String(page));return u.pathname+'?'+u.searchParams.toString()}
function authoritativePager(){var grid=main.querySelector('.sq-refine-v3-results .product-grid')||main.querySelector('collection-component .product-grid')||main.querySelector('.product-grid');if(!grid||!grid.parentElement)return null;var host=grid.parentElement,all=Array.from(main.querySelectorAll('.sq-refine-v3-pager')),pager=all.find(function(x){return x.parentElement===host})||all[0]||null;all.forEach(function(x){if(x!==pager)x.remove()});if(!pager){pager=document.createElement('nav');pager.className='sq-refine-v3-pager';pager.setAttribute('aria-label','Product pages');host.appendChild(pager)}else if(pager.parentElement!==host)host.appendChild(pager);return pager}
function makeButton(tag,classes,text,label){var el=document.createElement(tag);el.className=classes;el.textContent=text;if(label)el.setAttribute('aria-label',label);return el}
function renderPager(pager,view,totalPages){totalPages=Math.max(view,parseInt(totalPages||1,10));pager.replaceChildren();pager.dataset.sqPaginationConcept='one';pager.dataset.sqPageTotal=String(totalPages);pager.dataset.sqPerPage=String(perPage());var prev=view>1?makeButton('a','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow','‹','Previous product page'):makeButton('span','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow sq-refine-v3-page-btn--disabled','‹','Previous product page unavailable');if(view>1)prev.href=logicalUrl(view-1);else prev.setAttribute('aria-disabled','true');pager.appendChild(prev);var rail=document.createElement('div');rail.className='sq-refine-v3-page-rail';rail.setAttribute('role','list');for(var n=1;n<=totalPages;n++){var current=n===view,btn=makeButton(current?'span':'a','sq-refine-v3-page-btn sq-refine-v3-page-btn--number'+(current?' sq-refine-v3-page-btn--current':''),String(n),'Product page '+n+(current?', current page':''));btn.dataset.sqPageNumber=String(n);btn.setAttribute('role','listitem');if(current)btn.setAttribute('aria-current','page');else btn.href=logicalUrl(n);rail.appendChild(btn)}pager.appendChild(rail);var next=view<totalPages?makeButton('a','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow','›','Next product page'):makeButton('span','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow sq-refine-v3-page-btn--disabled','›','Next product page unavailable');if(view<totalPages)next.href=logicalUrl(view+1);else next.setAttribute('aria-disabled','true');pager.appendChild(next)}
function repair(){if(main.dataset.sqRefineV3Ready!=='true')return;var pager=authoritativePager();if(!pager)return;var existingTotal=parseInt(main.dataset.sqRefineV3PaginationTotal||pager.dataset.sqPageTotal||'1',10)||1;renderPager(pager,currentView(),existingTotal);main.dataset.sqRefineV3PaginationRepaired='true';main.dataset.sqRefineV3PaginationConcept='one';main.dataset.sqRefineV3PaginationPageSize=String(perPage())}
function schedule(){clearTimeout(window.__sqRefineV3PaginationTimer);window.__sqRefineV3PaginationTimer=setTimeout(repair,60)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',schedule,{once:true});else schedule();new MutationObserver(schedule).observe(main,{childList:true,subtree:true,attributes:true,attributeFilter:['data-sq-refine-v3-ready','data-sq-refine-v3-pagination-total']});window.addEventListener('pageshow',schedule);window.addEventListener('popstate',schedule);
})();
</script>
{% endif %}
