{% doc %}
Sitewide authoritative pagination repair for Refine V3 collection pages.
Design Concept One: every logical page number is rendered with persistent previous/next arrows.
Products-per-page state (50/100/250), filters, sort order, preview theme, and sq_root context
remain linked in every logical page URL. State Guard Series stays on standard pagination.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<style data-sq-refine-v3-pagination-button-style data-design="concept-one">
#MainContent .sq-refine-v3-pager{display:flex!important;visibility:visible!important;opacity:1!important;width:100%!important;min-height:48px!important;align-items:center!important;justify-content:center!important;gap:10px!important;margin:24px 0 10px!important;padding:4px 0!important;position:relative!important;z-index:2!important;box-sizing:border-box!important}
#MainContent .sq-refine-v3-page-rail{display:flex!important;flex:0 1 auto!important;align-items:center!important;justify-content:center!important;gap:8px!important;flex-wrap:wrap!important;min-width:0!important;max-width:calc(100% - 108px)!important}
#MainContent .sq-refine-v3-page-btn{box-sizing:border-box!important;display:inline-flex!important;visibility:visible!important;opacity:1!important;align-items:center!important;justify-content:center!important;width:44px!important;min-width:44px!important;height:44px!important;min-height:44px!important;padding:0!important;border:1px solid #cfd8df!important;border-radius:10px!important;background:#fff!important;color:#0b3a63!important;text-decoration:none!important;font-weight:900!important;line-height:1!important;box-shadow:0 1px 2px rgba(7,29,45,.08)!important;transition:background .15s ease,border-color .15s ease,color .15s ease,transform .15s ease!important}
#MainContent .sq-refine-v3-page-btn--arrow{flex:0 0 44px!important;border-color:#0b3a63!important;background:#0b3a63!important;color:#fff!important;font-size:30px!important;font-family:Arial,sans-serif!important;font-weight:700!important}
#MainContent .sq-refine-v3-page-btn--current{border-color:#0b3a63!important;background:#0b3a63!important;color:#fff!important;cursor:default!important}
#MainContent a.sq-refine-v3-page-btn:hover{border-color:#0b3a63!important;background:#eef4f8!important;color:#071d2d!important;transform:translateY(-1px)!important}
#MainContent a.sq-refine-v3-page-btn--arrow:hover{border-color:#071d2d!important;background:#071d2d!important;color:#fff!important}
#MainContent .sq-refine-v3-page-btn:focus-visible{outline:3px solid #d5ab4b!important;outline-offset:2px!important}
#MainContent .sq-refine-v3-page-btn--disabled{opacity:.34!important;cursor:not-allowed!important;pointer-events:none!important}
@media(max-width:749px){#MainContent .sq-refine-v3-pager{gap:7px!important;padding-inline:2px!important}#MainContent .sq-refine-v3-page-rail{flex:1 1 auto!important;justify-content:flex-start!important;flex-wrap:nowrap!important;overflow-x:auto!important;overscroll-behavior-inline:contain!important;scrollbar-width:thin!important;max-width:none!important;padding:3px 1px 6px!important}#MainContent .sq-refine-v3-page-btn{width:42px!important;min-width:42px!important;height:42px!important;min-height:42px!important}#MainContent .sq-refine-v3-page-btn--arrow{flex-basis:42px!important}}
</style>
<script data-sq-refine-v3-pagination-repair data-revision="concept-one-all-pages-ppp-linked-20260912-v1">
(function(){
if(window.__sqRefineV3PaginationRepair)return;window.__sqRefineV3PaginationRepair=true;
var ROOTS=new Set(['accessories-gifts-collectibles','airsoft-milsim','apparel','armed-forces-gear','art','body-armor-ballistic-protection','literature','child-safety-shop','dive-scuba','firearm-accessories','first-aid-medical-ifak','flags-patriotic-decor','flashlights-lighting','footwear-gloves-eyewear','k9-dog-gear','knives-axes-cutlery','morale-patches-tactical-id','outdoor-preparedness-gear','patriotic-american-heritage','safety-rescue-climbing','sta-brite-insignia','tactical-gear','thin-line','uniforms','watches','zippos-lighters-torches','stateside-quartermaster-logo-merch','army-national-guard-series','air-national-guard-series','products-built-for-the-line-u-s-army','products-built-for-the-line-u-s-navy','products-built-for-the-line-u-s-air-force','products-built-for-the-line-u-s-marine-corps','products-built-for-the-line-u-s-coast-guard','products-built-for-the-line-u-s-space-force','rotc-series','jrotc-series','military-schools-academies','law-enforcement-corrections','firefighting-ems-search-rescue']);
var currentHandle='{{ collection.handle | escape }}',rootHandle=new URLSearchParams(location.search).get('sq_root')||currentHandle;if(!ROOTS.has(rootHandle))return;
var main=document.getElementById('MainContent');if(!main)return;
function wait(ms){return new Promise(function(resolve){setTimeout(resolve,ms)})}
function perPage(){var n=parseInt(new URLSearchParams(location.search).get('sq_per_page')||'50',10);return[50,100,250].indexOf(n)>-1?n:50}
function currentView(){return Math.max(1,parseInt(new URLSearchParams(location.search).get('sq_view_page')||'1',10)||1)}
function sourcePath(){return currentHandle==='air-national-guard-series'?'/collections/products-built-for-the-line-u-s-air-force':location.pathname}
function alternateUrl(page){var now=new URLSearchParams(location.search),u=new URL(sourcePath(),location.origin);now.forEach(function(v,k){if(k.indexOf('filter.')===0||k==='sort_by'||k==='preview_theme_id')u.searchParams.append(k,v)});u.searchParams.set('view','sq-refine-v3-products');u.searchParams.set('page',String(page));return u.pathname+'?'+u.searchParams.toString()}
function logicalUrl(page){var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.delete('view');u.searchParams.set('sq_per_page',String(perPage()));u.searchParams.set('sq_view_page',String(page));return u.pathname+'?'+u.searchParams.toString()}
function sentinelNativePage(view,size){return Math.floor((view*size)/50)+1}
function productLinks(doc){var grid=doc.querySelector('.product-grid');if(!grid)return[];return Array.from(new Set(Array.from(grid.querySelectorAll('a[href*="/products/"]')).map(function(a){return a.getAttribute('href')||a.href}).filter(Boolean)))}
function nativeTotalPages(doc){var grid=doc.querySelector('.product-grid'),n=parseInt(grid&&grid.getAttribute('data-last-page')||'',10);if(n>0)return n;var max=1;Array.from(doc.querySelectorAll('.pagination a[href*="page="],pagination-component a[href*="page="]')).forEach(function(a){try{var p=parseInt(new URL(a.href,location.origin).searchParams.get('page')||'0',10);if(p>max)max=p}catch(_){}});return max}
function logicalTotalPages(doc,size){return Math.max(1,Math.ceil((nativeTotalPages(doc)*50)/size))}
async function sourceDocument(page){var lastStatus=0,lastError=null;for(var attempt=0;attempt<6;attempt++){try{var r=await fetch(alternateUrl(page),{credentials:'same-origin',cache:'no-store'});lastStatus=r.status;if(r.ok)return new DOMParser().parseFromString(await r.text(),'text/html');if(r.status!==429&&r.status<500)throw new Error('HTTP '+r.status+' for source page '+page);lastError=new Error('HTTP '+r.status+' for source page '+page)}catch(e){lastError=e;if(!/HTTP 429|HTTP 5\d\d|Failed to fetch|NetworkError/i.test(String(e&&e.message||e)))throw e}if(attempt<5)await wait(Math.min(6500,550*Math.pow(2,attempt)))}throw lastError||new Error('HTTP '+lastStatus+' for source page '+page)}
async function nativePageHasProducts(page){return productLinks(await sourceDocument(page)).length>0}
function sourceCards(doc){var grid=doc.querySelector('.product-grid');if(!grid)return[];return Array.from(grid.querySelectorAll(':scope > .product-grid__item')).filter(function(card){return!!card.querySelector('a[href*="/products/"]')})}
function liveGrid(){return main.querySelector('.sq-refine-v3-results .product-grid')||main.querySelector('collection-component .product-grid')||main.querySelector('.product-grid')}
function pagerHost(){var grid=liveGrid();return grid&&grid.parentElement?grid.parentElement:null}
function authoritativePager(){var host=pagerHost();if(!host)return null;var all=Array.from(main.querySelectorAll('.sq-refine-v3-pager')),pager=all.find(function(x){return x.parentElement===host})||all[0]||null;all.forEach(function(x){if(x!==pager)x.remove()});if(!pager){pager=document.createElement('nav');pager.className='sq-refine-v3-pager';pager.setAttribute('aria-label','Product pages');host.appendChild(pager)}else if(pager.parentElement!==host)host.appendChild(pager);return pager}
function makeButton(tag,classes,text,label){var el=document.createElement(tag);el.className=classes;el.textContent=text;if(label)el.setAttribute('aria-label',label);return el}
function renderPager(pager,view,totalPages,hasNext){totalPages=Math.max(view,parseInt(totalPages||0,10)||1);while(pager.firstChild)pager.removeChild(pager.firstChild);pager.dataset.sqPaginationConcept='one';pager.dataset.sqPageTotal=String(totalPages);pager.dataset.sqPerPage=String(perPage());var prev=view>1?makeButton('a','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow','‹','Previous product page'):makeButton('span','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow sq-refine-v3-page-btn--disabled','‹','Previous product page unavailable');if(view>1){prev.href=logicalUrl(view-1);prev.dataset.sqPaginationRepair='previous'}else prev.setAttribute('aria-disabled','true');pager.appendChild(prev);var rail=document.createElement('div');rail.className='sq-refine-v3-page-rail';rail.setAttribute('role','list');rail.setAttribute('aria-label','All product pages');for(var n=1;n<=totalPages;n++){var current=n===view,btn=makeButton(current?'span':'a','sq-refine-v3-page-btn sq-refine-v3-page-btn--number'+(current?' sq-refine-v3-page-btn--current':''),String(n),'Product page '+n+(current?', current page':''));btn.dataset.sqPageNumber=String(n);btn.setAttribute('role','listitem');if(current)btn.setAttribute('aria-current','page');else btn.href=logicalUrl(n);rail.appendChild(btn)}pager.appendChild(rail);var canNext=typeof hasNext==='boolean'?hasNext:view<totalPages,next=canNext?makeButton('a','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow','›','Next product page'):makeButton('span','sq-refine-v3-page-btn sq-refine-v3-page-btn--arrow sq-refine-v3-page-btn--disabled','›','Next product page unavailable');if(canNext){next.href=logicalUrl(view+1);next.dataset.sqPaginationRepair='next'}else next.setAttribute('aria-disabled','true');pager.appendChild(next)}
async function rescueAssembly(){if(window.__sqRefineV3AssemblyRescueRunning)return false;var grid=liveGrid();if(!grid)return false;window.__sqRefineV3AssemblyRescueRunning=true;try{var size=perPage(),view=currentView(),globalStart=(view-1)*size,startPage=Math.floor(globalStart/50)+1,offset=globalStart%50,need=offset+size+1,cards=[],p=startPage;while(cards.length<need&&p<startPage+8){var batch=sourceCards(await sourceDocument(p));if(!batch.length)break;cards=cards.concat(batch);if(batch.length<50)break;p++;await wait(220)}var sliced=cards.slice(offset,offset+size);if(!sliced.length)return false;var frag=document.createDocumentFragment();sliced.forEach(function(card){frag.appendChild(document.importNode(card,true))});grid.replaceChildren(frag);main.querySelectorAll('pagination-component,.pagination').forEach(function(node){node.style.display='none'});var pager=authoritativePager();if(pager)renderPager(pager,view,view+(cards.length>offset+size?1:0),cards.length>offset+size);delete main.dataset.sqRefineV3Error;delete main.dataset.sqRefineV3PaginationRepairError;main.dataset.sqRefineV3Ready='true';main.dataset.sqRefineV3PaginationRescued='true';main.dataset.sqRefineV3PaginationRepaired='true';main.dataset.sqRefineV3PaginationPageSize=String(size);main.dataset.sqRefineV3PaginationCertified='rescued-logical-page-'+view;return true}finally{window.__sqRefineV3AssemblyRescueRunning=false}}
async function repair(){if(main.dataset.sqRefineV3Error){try{await rescueAssembly()}catch(e){main.dataset.sqRefineV3PaginationRepairError=String(e&&e.message||e);console.error('[SQ V3 pagination rescue]',e)}}if(main.dataset.sqRefineV3Ready!=='true')return;var pager=authoritativePager();if(!pager)return;var size=perPage(),view=currentView(),sourcePage=sentinelNativePage(view,size);try{var pair=await Promise.all([sourceDocument(1),nativePageHasProducts(sourcePage)]),total=logicalTotalPages(pair[0],size),hasNext=pair[1]&&view<total;renderPager(pager,view,total,hasNext);delete main.dataset.sqRefineV3PaginationRepairError;main.dataset.sqRefineV3PaginationRepaired='true';main.dataset.sqRefineV3PaginationConcept='one';main.dataset.sqRefineV3PaginationTotal=String(total);main.dataset.sqRefineV3PaginationCertified=(hasNext?'next-source-page-':'last-source-page-')+sourcePage;main.dataset.sqRefineV3PaginationPageSize=String(size);main.dataset.sqRefineV3PaginationAttempts='retry-capable'}catch(e){main.dataset.sqRefineV3PaginationRepairError=String(e&&e.message||e);console.error('[SQ V3 pagination repair]',e)}}
function schedule(delay){clearTimeout(window.__sqRefineV3PaginationTimer);window.__sqRefineV3PaginationTimer=setTimeout(repair,typeof delay==='number'?delay:60)}
function whenReady(){if(main.dataset.sqRefineV3Ready==='true'||main.dataset.sqRefineV3Error)schedule(60);var obs=new MutationObserver(function(){if(main.dataset.sqRefineV3Ready==='true'||main.dataset.sqRefineV3Error)schedule(80)});obs.observe(main,{childList:true,subtree:true,attributes:true,attributeFilter:['data-sq-refine-v3-ready','data-sq-refine-v3-error']});[250,900,1800,4500,9000,14000].forEach(function(ms){setTimeout(function(){if(main.dataset.sqRefineV3Ready==='true'||main.dataset.sqRefineV3Error)schedule(30)},ms)});setTimeout(function(){obs.disconnect();if(main.dataset.sqRefineV3Ready==='true'||main.dataset.sqRefineV3Error)schedule(30)},20000);window.addEventListener('pageshow',function(){schedule(40)});window.addEventListener('popstate',function(){schedule(40)})}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',whenReady,{once:true});else whenReady();
})();
</script>
{% endif %}
