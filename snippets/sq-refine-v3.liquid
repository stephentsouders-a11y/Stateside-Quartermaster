{% doc %}
Clean Refine Products V3 for Stateside Quartermaster collection roots. State Guard Series is deliberately excluded. Structural choices are discovered from the existing collection navigation and converted into checkbox disclosures that navigate to Shopify collection URLs. Native Shopify storefront filter inputs are mirrored as checkbox disclosures and applied through URL parameters. The native Shopify product cards remain authoritative. Products-per-page is outside the sidebar and supports 50, 100, and 250 by assembling Shopify-rendered collection pages rather than downloading product JSON.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
{% assign sq_v3_handle = collection.handle | downcase %}
<script type="application/json" data-sq-refine-v3-book-tags>{% if sq_v3_handle == 'literature' %}{{ collection.all_tags | json }}{% else %}[]{% endif %}</script>
<style data-sq-refine-v3-style>
#MainContent.sq-refine-v3-active .sq-refine-v3-layout{display:grid;grid-template-columns:minmax(230px,1fr) minmax(0,3fr);gap:22px;align-items:start}
#MainContent .sq-refine-v3-sidebar{min-width:0;border:1px solid #dfe4e7;border-radius:10px;background:#fff;padding:14px}
#MainContent .sq-refine-v3-sidebar__title{margin:0 0 8px;font-size:1.15rem;font-weight:900}
#MainContent .sq-refine-v3-group{border-top:1px solid #dfe4e7;padding:0;margin:0}
#MainContent .sq-refine-v3-group>summary{position:relative;cursor:pointer;list-style:none;padding:13px 34px 13px 2px;font-weight:900;line-height:1.25}
#MainContent .sq-refine-v3-group>summary::-webkit-details-marker{display:none}
#MainContent .sq-refine-v3-group>summary::marker{content:''}
#MainContent .sq-refine-v3-group>summary::after{content:'+';position:absolute;right:4px;top:50%;transform:translateY(-50%);width:24px;height:24px;display:grid;place-items:center;font-size:21px;font-weight:900;line-height:1}
#MainContent .sq-refine-v3-group[open]>summary::after{content:'\2212'}
#MainContent .sq-refine-v3-group[data-active='true']>summary{font-weight:950}
#MainContent .sq-refine-v3-choices{display:grid;gap:6px;padding:0 0 12px}
#MainContent .sq-refine-v3-choice{display:flex;align-items:center;gap:9px;min-height:38px;padding:7px 8px;border:1px solid #e0e5e8;border-radius:7px;background:#f8f9f8;color:#071d2d;font-size:12px;font-weight:800;line-height:1.2;cursor:pointer}
#MainContent .sq-refine-v3-choice:hover{border-color:#a91827;background:#fff}
#MainContent .sq-refine-v3-choice input{appearance:none;-webkit-appearance:none;width:18px;height:18px;min-width:18px;margin:0;border:2px solid #7b8790;border-radius:3px;background:#fff;display:grid;place-items:center;cursor:pointer}
#MainContent .sq-refine-v3-choice input:checked{border-color:#a91827;background:#a91827}
#MainContent .sq-refine-v3-choice input:checked::after{content:'\2713';color:#fff;font-size:13px;font-weight:900;line-height:1}
#MainContent .sq-refine-v3-choice input:focus-visible,#MainContent .sq-refine-v3-group>summary:focus-visible{outline:3px solid #d5ab4b;outline-offset:2px}
#MainContent .sq-refine-v3-choice>span{min-width:0;flex:1 1 auto}
#MainContent .sq-refine-v3-page-size{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap;margin:0 0 14px}
#MainContent .sq-refine-v3-page-size>strong{font-size:12px;margin-right:3px}
#MainContent .sq-refine-v3-page-size label{display:flex;align-items:center;gap:5px;border:1px solid #d6dce0;border-radius:7px;background:#fff;padding:7px 9px;font-size:12px;font-weight:900;cursor:pointer}
#MainContent .sq-refine-v3-page-size input{margin:0}
#MainContent .sq-refine-v3-pager{display:flex;align-items:center;justify-content:center;gap:12px;margin:22px 0 8px}
#MainContent .sq-refine-v3-pager a,#MainContent .sq-refine-v3-pager span{padding:9px 13px;border:1px solid #d6dce0;border-radius:7px;background:#fff;color:inherit;text-decoration:none;font-weight:850}
#MainContent.sq-refine-v3-active [data-sq-refine-v3-hidden-nav='true']{display:none!important}
#MainContent.sq-refine-v3-active [data-sq-refine-v3-native-filter-source='true']{display:none!important}
#MainContent.sq-refine-v3-active [data-sq-refine-v3-native-pager='true']{display:none!important}
@media (min-width:901px){#MainContent .sq-refine-v3-sidebar{position:sticky;top:18px;height:calc(100vh - 36px);min-height:720px;max-height:calc(100vh - 36px);overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-gutter:stable;padding-bottom:28px}#MainContent.sq-refine-v3-active .product-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important}}
@media (max-width:900px){#MainContent.sq-refine-v3-active .sq-refine-v3-layout{display:block}#MainContent .sq-refine-v3-sidebar{position:static;height:auto;min-height:0;max-height:none;overflow:visible;margin-bottom:16px}#MainContent.sq-refine-v3-active .product-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}#MainContent .sq-refine-v3-page-size{justify-content:flex-start}}
</style>
<script data-sq-refine-v3 data-current-handle="{{ collection.handle | escape }}">
(function(){
  if(window.__sqRefineV3)return;window.__sqRefineV3=true;
  var script=document.currentScript,currentHandle=(script&&script.dataset.currentHandle)||'';
  var ROOTS=new Set(['accessories-gifts-collectibles','airsoft-milsim','apparel','armed-forces-gear','art','body-armor-ballistic-protection','literature','child-safety-shop','dive-scuba','firearm-accessories','first-aid-medical-ifak','flags-patriotic-decor','flashlights-lighting','footwear-gloves-eyewear','k9-dog-gear','knives-axes-cutlery','morale-patches-tactical-id','outdoor-preparedness-gear','patriotic-american-heritage','safety-rescue-climbing','sta-brite-insignia','tactical-gear','thin-line','uniforms','watches','zippos-lighters-torches','stateside-quartermaster-logo-merch','army-national-guard-series','air-national-guard-series','products-built-for-the-line-u-s-army','products-built-for-the-line-u-s-navy','products-built-for-the-line-u-s-air-force','products-built-for-the-line-u-s-marine-corps','products-built-for-the-line-u-s-coast-guard','products-built-for-the-line-u-s-space-force','rotc-series','jrotc-series','military-schools-academies','law-enforcement-corrections','firefighting-ems-search-rescue']);
  var query=new URLSearchParams(location.search),rootHandle=query.get('sq_root')||currentHandle;
  if(rootHandle==='state-guard-series'||!ROOTS.has(rootHandle))return;
  var main=document.getElementById('MainContent');if(!main)return;
  var sourceNodes=new Set(),nativeSourceNodes=new Set(),sidebar,layout,productHost;
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function norm(v){return clean(v).toLowerCase().replace(/[\u2019']/g,'').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').trim()}
  function esc(v){return clean(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function handleize(v){return clean(v).toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')}
  function collectionHandle(raw){try{var m=new URL(raw,location.origin).pathname.match(/^\/collections\/([^/?#]+)/);return m?decodeURIComponent(m[1]):''}catch(_){return''}}
  function labelOf(a){var x=a.querySelector('[class*="title"],[class*="label"],strong,h3,h4');return clean(x?x.textContent:(a.getAttribute('aria-label')||a.textContent)).replace(/^shop\s+(?:all\s+)?/i,'')}
  function canonicalGroup(t){var n=norm(t);if(/manufacturer|vendor|brand/.test(n))return'Shop by Manufacturer';if(/shop by branch|service branch|by branch|service/.test(n))return'Shop by Branch';if(/shop by subcategory|sub category|subcategory/.test(n))return'Shop by Subcategory';if(/shop by type|product type|by type/.test(n))return'Shop by Type';if(/shop by category|categories|category/.test(n))return'Shop by Category';if(/pattern|camo|camouflage/.test(n)&&!/color/.test(n))return'Shop by Pattern';if(/color|colour/.test(n)&&!/pattern/.test(n))return'Shop by Color';if(/availability/.test(n))return'Availability';if(/price/.test(n))return'Price';return clean(t).replace(/:$/,'')}
  function structural(a){if(!a||!collectionHandle(a.href)||a.closest('.sq-refine-v3-sidebar'))return false;if(a.closest('collection-component,results-list,.product-grid,product-card,#ResultsList'))return false;var cls=String(a.className||''),parent=String(a.parentElement&&a.parentElement.className||'');return /(?:^|\s)(?:sq-|vac-)/i.test(cls)||/(subcategory|third-level|button-tree|branch|category|program|folder|type-grid|match-grid|navigation)/i.test(cls+' '+parent)}
  function groupName(a){var node=a;for(var i=0;i<8&&node&&node!==main;i++,node=node.parentElement){var h=node.querySelector&&node.querySelector(':scope > h2,:scope > h3,:scope > header h2,:scope > header h3,:scope > .section-header h2,:scope > .section-header h3');if(h&&clean(h.textContent))return canonicalGroup(clean(h.textContent).replace(/\s*\(.*?\)\s*$/,''))}var s=(a.href+' '+labelOf(a)).toLowerCase();if(/army|navy|air force|marine|coast guard|space force/.test(s)&&/branch|service|series/.test(s))return'Shop by Branch';if(/type/.test(s))return'Shop by Type';return'Shop by Category'}
  function sourceContainer(a){var node=a;for(var i=0;i<8&&node&&node!==main;i++,node=node.parentElement){if(node.matches&&node.matches('section,.sq-subcategory-section,[class*="button-tree"],[class*="category-section"],[class*="navigation"],[class*="program-tree"],[class*="third-level"],[class*="branch-grid"],[class*="type-grid"]'))return node}return a}
  function extractStructural(doc){var map=new Map();[].slice.call(doc.querySelectorAll('a[href*="/collections/"]')).filter(structural).forEach(function(a){var h=collectionHandle(a.href),lab=labelOf(a);if(!h||!lab||h===rootHandle)return;var g=groupName(a),k=norm(g);if(!map.has(k))map.set(k,{label:g,items:[]});var bucket=map.get(k);if(!bucket.items.some(function(x){return x.handle===h}))bucket.items.push({label:lab,handle:h,href:a.href});if(doc===document)sourceNodes.add(sourceContainer(a))});return [].slice.call(map.values()).filter(function(g){return g.items.length})}
  async function rootDocument(){if(currentHandle===rootHandle)return document;var u=new URL('/collections/'+rootHandle,location.origin);var preview=query.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);try{var r=await fetch(u.pathname+(u.search?'?'+u.searchParams.toString():''),{credentials:'same-origin'});if(!r.ok)return document;return new DOMParser().parseFromString(await r.text(),'text/html')}catch(_){return document}}
  function activeStructural(handle){return currentHandle===handle}
  function structuralUrl(item){var u=new URL(item.href,location.origin);['page','sq_per_page','sq_view_page'].forEach(function(k){u.searchParams.delete(k)});u.searchParams.set('sq_root',rootHandle);var preview=query.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return u.pathname+'?'+u.searchParams.toString()}
  function groupMarkup(g,kind){var active=false,rows=g.items.map(function(x){var checked=kind==='structural'?activeStructural(x.handle):!!x.checked;if(checked)active=true;var attrs=kind==='structural'?'data-target="'+esc(structuralUrl(x))+'" data-kind="structural"':'data-filter-name="'+esc(x.name)+'" data-filter-value="'+esc(x.value)+'" data-kind="native"';return'<label class="sq-refine-v3-choice"><input type="checkbox" '+attrs+(checked?' checked':'')+'><span>'+esc(x.label)+'</span></label>'}).join('');return'<details class="sq-refine-v3-group" data-active="'+(active?'true':'false')+'"'+(active?' open':'')+'><summary>'+esc(g.label)+'</summary><div class="sq-refine-v3-choices">'+rows+'</div></details>'}
  function nativeGroups(){var inputs=[].slice.call(main.querySelectorAll('input[type="checkbox"][name^="filter."],input[type="radio"][name^="filter."]')).filter(function(i){return !i.closest('.sq-refine-v3-sidebar')});var map=new Map();inputs.forEach(function(input){var holder=input.closest('details,fieldset,facet-filter,facet-inputs')||input.parentElement;if(holder)nativeSourceNodes.add(holder.closest('details,fieldset,form,facet-filter,facet-inputs')||holder);var heading='';var details=input.closest('details');if(details)heading=clean(details.querySelector(':scope>summary')&&details.querySelector(':scope>summary').textContent);if(!heading){var fs=input.closest('fieldset');heading=clean(fs&&fs.querySelector('legend')&&fs.querySelector('legend').textContent)}if(!heading){var name=input.name.replace(/^filter\.[^.]+\./,'').replace(/[._-]+/g,' ');heading=name}var group=canonicalGroup(heading),lab='';var id=input.id;if(id){var l=main.querySelector('label[for="'+CSS.escape(id)+'"]');if(l)lab=clean(l.textContent)}if(!lab)lab=clean(input.closest('label')&&input.closest('label').textContent)||clean(input.value);if(!lab)return;var n=norm(group),value=clean(input.value),entry={label:lab,name:input.name,value:value,checked:input.checked};if(/color\s*\/\s*pattern|color and pattern/.test(n)){if(patternish(lab)){group='Shop by Pattern'}else{group='Shop by Color'}}var key=norm(group);if(!map.has(key))map.set(key,{label:group,items:[]});var arr=map.get(key).items;if(!arr.some(function(x){return x.name===entry.name&&x.value===entry.value}))arr.push(entry)});return [].slice.call(map.values()).filter(function(g){return g.items.length})}
  function patternish(v){return /(multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a[- ]?tacs|tiger stripe|lizard|camo|camouflage|digital|pattern)/i.test(clean(v))}
  function parseBookTags(doc){var node=doc.querySelector('[data-sq-refine-v3-book-tags]');if(!node)return[];try{return JSON.parse(node.textContent||'[]')}catch(_){return[]}}
  function bookGroups(tags){var specs=[['Shop by Author',['author','book author']],['Shop by Publisher',['publisher','book publisher']],['Shop by War / Conflict',['war','conflict','war conflict']],['Shop by Branch',['branch','service','service branch']],['Shop by Topic',['topic','subject','book topic']]],out=[];specs.forEach(function(spec){var vals=[];tags.forEach(function(tag){var m=clean(tag).match(/^([^:]+):\s*(.+)$/);if(!m||spec[1].indexOf(norm(m[1]))<0)return;var label=clean(m[2]);if(label&&!vals.some(function(x){return norm(x.label)===norm(label)}))vals.push({label:label,tag:clean(tag)})});if(vals.length){vals.sort(function(a,b){return a.label.localeCompare(b.label,undefined,{numeric:true,sensitivity:'base'})});out.push({label:spec[0],items:vals})}});return out}
  function bookMarkup(g){var path=location.pathname,activePath=decodeURIComponent(path).toLowerCase(),active=false;var rows=g.items.map(function(x){var tagHandle=handleize(x.tag),checked=activePath.indexOf('/'+tagHandle)>-1;if(checked)active=true;var u=new URL('/collections/'+rootHandle+'/'+tagHandle,location.origin);u.searchParams.set('sq_root',rootHandle);var preview=query.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return'<label class="sq-refine-v3-choice"><input type="checkbox" data-kind="structural" data-target="'+esc(u.pathname+'?'+u.searchParams.toString())+'"'+(checked?' checked':'')+'><span>'+esc(x.label)+'</span></label>'}).join('');return'<details class="sq-refine-v3-group" data-active="'+(active?'true':'false')+'"'+(active?' open':'')+'><summary>'+esc(g.label)+'</summary><div class="sq-refine-v3-choices">'+rows+'</div></details>'}
  function findProductHost(){return main.querySelector('collection-component')||main.querySelector('#ResultsList')||main.querySelector('.product-grid')}
  function ensureLayout(){productHost=findProductHost();if(!productHost)return false;var parent=productHost.parentElement;if(!parent)return false;layout=document.createElement('div');layout.className='sq-refine-v3-layout';sidebar=document.createElement('aside');sidebar.className='sq-refine-v3-sidebar';sidebar.setAttribute('aria-label','Refine Products');parent.insertBefore(layout,productHost);layout.appendChild(sidebar);layout.appendChild(productHost);main.classList.add('sq-refine-v3-active');return true}
  function applyNative(input){var u=new URL(location.href),name=input.dataset.filterName,value=input.dataset.filterValue,current=u.searchParams.getAll(name);u.searchParams.delete(name);if(input.checked){current.push(value)}else{current=current.filter(function(v){return v!==value})}Array.from(new Set(current)).forEach(function(v){u.searchParams.append(name,v)});u.searchParams.delete('page');u.searchParams.delete('sq_view_page');location.assign(u.pathname+(u.search?'?'+u.searchParams.toString():''))}
  function bindSidebar(){sidebar.querySelectorAll('input[data-kind]').forEach(function(input){input.addEventListener('change',function(){var d=input.closest('details');if(d){d.dataset.active=input.checked||!!d.querySelector('input:checked')?'true':'false';if(d.dataset.active==='true')d.open=true}if(input.dataset.kind==='structural'){if(input.checked){location.assign(input.dataset.target)}else{var u=new URL('/collections/'+rootHandle,location.origin);var preview=query.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);location.assign(u.pathname+(u.search?'?'+u.searchParams.toString():''))}}else applyNative(input)})})}
  function hideSources(){sourceNodes.forEach(function(n){if(n&&n!==productHost)n.dataset.sqRefineV3HiddenNav='true'});nativeSourceNodes.forEach(function(n){if(n&&!n.closest('.sq-refine-v3-sidebar'))n.dataset.sqRefineV3NativeFilterSource='true'})}
  function pageSize(){var n=parseInt(query.get('sq_per_page')||'50',10);return[50,100,250].indexOf(n)>-1?n:50}
  function pageSizeMarkup(){var current=pageSize();return'<div class="sq-refine-v3-page-size" aria-label="Products per page"><strong>Products per page:</strong>'+[50,100,250].map(function(n){return'<label><input type="radio" name="sq_per_page_control" value="'+n+'"'+(n===current?' checked':'')+'><span>'+n+'</span></label>'}).join('')+'</div>'}
  function cardSelector(doc){var grid=doc.querySelector('#ResultsList')||doc.querySelector('.product-grid');if(!grid)return{grid:null,cards:[]};var cards=[].slice.call(grid.querySelectorAll(':scope > .product-grid__item,:scope > li,product-card')).filter(function(el){return !!el.querySelector('a[href*="/products/"]')||el.matches('product-card')});if(!cards.length)cards=[].slice.call(grid.querySelectorAll('.product-grid__item')).filter(function(el){return !!el.querySelector('a[href*="/products/"]')});return{grid:grid,cards:cards}}
  function fetchPage(p){var u=new URL(location.href);u.searchParams.delete('sq_view_page');u.searchParams.delete('sq_per_page');u.searchParams.set('page',String(p));return fetch(u.pathname+'?'+u.searchParams.toString(),{credentials:'same-origin'}).then(function(r){if(!r.ok)throw new Error('page '+p+' '+r.status);return r.text()}).then(function(html){return new DOMParser().parseFromString(html,'text/html')})}
  async function assembleProducts(){var live=cardSelector(document);if(!live.grid||!live.cards.length)return;var target=pageSize(),base=live.cards.length,view=Math.max(1,parseInt(query.get('sq_view_page')||'1',10)||1),globalStart=(view-1)*target,startPage=Math.floor(globalStart/base)+1,offset=globalStart%base,need=offset+target+1,docs=[];if(startPage===1)docs.push(document);else docs.push(await fetchPage(startPage));var cards=cardSelector(docs[0]).cards.slice(),p=startPage+1;while(cards.length<need&&p<startPage+20){var d;try{d=await fetchPage(p)}catch(_){break}var next=cardSelector(d).cards;if(!next.length)break;cards=cards.concat(next);p++}var sliced=cards.slice(offset,offset+target),hasNext=cards.length>offset+target;if(!sliced.length)return;var frag=document.createDocumentFragment();sliced.forEach(function(c){frag.appendChild(document.importNode(c,true))});live.grid.innerHTML='';live.grid.appendChild(frag);var nativePager=main.querySelector('pagination-component,.pagination,[class*="pagination"]');if(nativePager)nativePager.dataset.sqRefineV3NativePager='true';var old=main.querySelector('.sq-refine-v3-pager');if(old)old.remove();var pager=document.createElement('nav');pager.className='sq-refine-v3-pager';pager.setAttribute('aria-label','Product pages');function viewUrl(n){var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.set('sq_per_page',String(target));u.searchParams.set('sq_view_page',String(n));return u.pathname+'?'+u.searchParams.toString()}pager.innerHTML=(view>1?'<a href="'+esc(viewUrl(view-1))+'">Previous</a>':'')+'<span>Page '+view+'</span>'+(hasNext?'<a href="'+esc(viewUrl(view+1))+'">Next</a>':'');live.grid.parentElement.appendChild(pager)}
  function installPageSize(){var holder=document.createElement('div');holder.innerHTML=pageSizeMarkup();var control=holder.firstElementChild;productHost.parentElement.insertBefore(control,productHost);control.querySelectorAll('input[name="sq_per_page_control"]').forEach(function(i){i.addEventListener('change',function(){var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.set('sq_per_page',i.value);u.searchParams.set('sq_view_page','1');location.assign(u.pathname+'?'+u.searchParams.toString())})})}
  async function launch(){if(!ensureLayout())return;var rootDoc=await rootDocument(),structuralGroups=extractStructural(rootDoc),native=nativeGroups(),books=rootHandle==='literature'?bookGroups(parseBookTags(rootDoc)):[];var html='<h2 class="sq-refine-v3-sidebar__title">Refine Products</h2>';structuralGroups.forEach(function(g){html+=groupMarkup(g,'structural')});books.forEach(function(g){html+=bookMarkup(g)});native.forEach(function(g){html+=groupMarkup(g,'native')});sidebar.innerHTML=html;hideSources();bindSidebar();installPageSize();assembleProducts().catch(function(){})}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',launch,{once:true});else launch();
})();
</script>
{% endif %}