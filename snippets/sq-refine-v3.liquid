    return Array.from(map.values()).filter(function(g){return g.items.length});
  }
  async function fetchText(u,attempts){var last;for(var i=0;i<(attempts||4);i++){try{var r=await fetch(u,{credentials:'same-origin'});if(r.ok)return r.text();last=new Error('HTTP '+r.status);if([429,500,502,503,504].indexOf(r.status)<0)throw last}catch(e){last=e}await delay(500*(i+1)*(i+1))}throw last||new Error('request failed')}
  async function rootDocument(){if(currentHandle===rootHandle)return document;var u=new URL('/collections/'+rootHandle,location.origin);var preview=query.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return new DOMParser().parseFromString(await fetchText(u.pathname+'?'+u.searchParams.toString(),5),'text/html')}
  function productSourcePath(){return currentHandle==='air-national-guard-series'?'/collections/products-built-for-the-line-u-s-air-force':location.pathname}
  function alternateUrl(page){var u=new URL(productSourcePath(),location.origin);query.forEach(function(v,k){if(k.indexOf('filter.')===0||k==='sort_by'||k==='preview_theme_id')u.searchParams.append(k,v)});u.searchParams.set('view','sq-refine-v3-products');if(page)u.searchParams.set('page',String(page));return u.pathname+'?'+u.searchParams.toString()}
  async function ensureProductHost(){productHost=main.querySelector('collection-component:has(.product-grid)')||main.querySelector('collection-component');if(productHost&&productHost.querySelector('.product-grid'))return true;var html=await fetchText(alternateUrl(1),4),doc=new DOMParser().parseFromString(html,'text/html'),host=doc.querySelector('[data-sq-refine-v3-fallback-host]')||doc.querySelector('collection-component:has(.product-grid)');if(!host)throw new Error('fallback product host missing');productHost=document.importNode(host,true);usingFallback=true;main.appendChild(productHost);return true}
  function structuralTarget(item){var u=new URL(item.href,location.origin);['page','sq_per_page','sq_view_page','view'].forEach(function(k){u.searchParams.delete(k)});u.searchParams.set('sq_root',rootHandle);query.forEach(function(v,k){if(k.indexOf('filter.')===0||k==='sort_by')u.searchParams.append(k,v)});var preview=query.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return u.pathname+'?'+u.searchParams.toString()}
  function groupMarkup(g,kind){var active=false,rows=g.items.map(function(x){var checked=kind==='structural'?structuralChecked(x):!!x.checked;if(checked)active=true;var attrs=kind==='structural'?'data-kind="structural" data-target="'+esc(structuralTarget(x))+'"':'data-kind="native" data-filter-name="'+esc(x.name)+'" data-filter-value="'+esc(x.value)+'"';return'<label class="sq-refine-v3-choice"><input type="checkbox" '+attrs+(checked?' checked':'')+'><span>'+esc(x.label)+'</span></label>'}).join('');return'<details class="sq-refine-v3-group" data-active="'+(active?'true':'false')+'"'+(active?' open':'')+'><summary>'+esc(g.label)+'</summary><div class="sq-refine-v3-choices">'+rows+'</div></details>'}
  function nativeGroups(){var inputs=[].slice.call(productHost.querySelectorAll('input[type="checkbox"][name^="filter."],input[type="radio"][name^="filter."]')),map=new Map();inputs.forEach(function(input){var details=input.closest('details'),heading=clean(details&&details.querySelector(':scope>summary')&&details.querySelector(':scope>summary').textContent);if(!heading){var fs=input.closest('fieldset');heading=clean(fs&&fs.querySelector('legend')&&fs.querySelector('legend').textContent)}if(!heading)heading=input.name.replace(/^filter\.[^.]+\./,'').replace(/[._-]+/g,' ');var group=canonicalGroup(heading),lab='',id=input.id;if(id){var l=productHost.querySelector('label[for="'+CSS.escape(id)+'"]');if(l)lab=clean(l.textContent)}if(!lab)lab=clean(input.closest('label')&&input.closest('label').textContent)||clean(input.value);if(!lab)return;if(/color/.test(norm(group))&&/pattern/.test(norm(group)))group=patternish(lab)?'Shop by Pattern':'Shop by Color';var key=norm(group),entry={label:lab,name:input.name,value:clean(input.value),checked:input.checked};if(!map.has(key))map.set(key,{label:group,items:[]});var a=map.get(key).items;if(!a.some(function(x){return x.name===entry.name&&x.value===entry.value}))a.push(entry)});return Array.from(map.values()).filter(function(g){return g.items.length})}
  function parseBookTags(doc){var n=doc.querySelector('[data-sq-refine-v3-book-tags]');if(!n)return[];try{return JSON.parse(n.textContent||'[]')}catch(_){return[]}}
  function bookGroups(tags){var specs=[['Shop by Author',['author','book author']],['Shop by Publisher',['publisher','book publisher']],['Shop by War / Conflict',['war','conflict','war conflict']],['Shop by Branch',['branch','service','service branch']],['Shop by Topic',['topic','subject','book topic']]],out=[];specs.forEach(function(spec){var vals=[];tags.forEach(function(tag){var m=clean(tag).match(/^([^:]+):\s*(.+)$/);if(!m||spec[1].indexOf(norm(m[1]))<0)return;var lab=clean(m[2]);if(lab&&!vals.some(function(x){return norm(x.label)===norm(lab)}))vals.push({label:lab,tag:clean(tag)})});if(vals.length)out.push({label:spec[0],items:vals})});return out}
  function bookMarkup(g){var active=false,rows=g.items.map(function(x){var h=handleize(x.tag),checked=decodeURIComponent(location.pathname).toLowerCase().indexOf('/'+h)>-1;if(checked)active=true;var u=new URL('/collections/'+rootHandle+'/'+h,location.origin);u.searchParams.set('sq_root',rootHandle);var preview=query.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return'<label class="sq-refine-v3-choice"><input type="checkbox" data-kind="structural" data-target="'+esc(u.pathname+'?'+u.searchParams.toString())+'"'+(checked?' checked':'')+'><span>'+esc(x.label)+'</span></label>'}).join('');return'<details class="sq-refine-v3-group" data-active="'+(active?'true':'false')+'"'+(active?' open':'')+'><summary>'+esc(g.label)+'</summary><div class="sq-refine-v3-choices">'+rows+'</div></details>'}
  function makeLayout(){layout=document.createElement('div');layout.className='sq-refine-v3-layout';sidebar=document.createElement('aside');sidebar.className='sq-refine-v3-sidebar';sidebar.setAttribute('aria-label','Refine Products');results=document.createElement('div');results.className='sq-refine-v3-results';main.appendChild(layout);layout.appendChild(sidebar);layout.appendChild(results);results.appendChild(productHost);main.classList.add('sq-refine-v3-active')}
  function hideSources(){sourceNodes.forEach(function(n){if(n&&n!==productHost&&!n.contains(productHost))n.dataset.sqRefineV3HiddenNav='true'})}
  function enforceSingleProductGrid(){if(rootHandle!=='zippos-lighters-torches'||!productHost)return;var primary=productHost.querySelector('.product-grid');if(!primary)return;main.querySelectorAll('.product-grid').forEach(function(g){if(g!==primary)g.dataset.sqRefineV3DuplicateGrid='true'});var seen=new Set();[].slice.call(primary.querySelectorAll(':scope > .product-grid__item')).forEach(function(card){var a=card.querySelector('a[href*="/products/"]');if(!a)return;var key=(a.pathname||a.getAttribute('href')||'').split('?')[0];if(!key)return;if(seen.has(key))card.remove();else seen.add(key)})}
  function guardSingleProductGrid(){if(rootHandle!=='zippos-lighters-torches')return;enforceSingleProductGrid();var observer=new MutationObserver(function(){enforceSingleProductGrid()});observer.observe(main,{childList:true,subtree:true});window.__sqZipposGridGuard=observer}
  function bindSidebar(){sidebar.querySelectorAll('input[data-kind]').forEach(function(input){input.addEventListener('change',function(){var d=input.closest('details');if(d&&input.checked){d.dataset.active='true';d.open=true}if(input.dataset.kind==='structural'){if(input.checked)location.assign(input.dataset.target);else{var u=new URL('/collections/'+rootHandle,location.origin);var p=query.get('preview_theme_id');if(p)u.searchParams.set('preview_theme_id',p);location.assign(u.pathname+'?'+u.searchParams.toString())}}else{var u=new URL(location.href),name=input.dataset.filterName,value=input.dataset.filterValue,vals=u.searchParams.getAll(name).filter(function(v){return v!==value});if(input.checked)vals.push(value);u.searchParams.delete(name);Array.from(new Set(vals)).forEach(function(v){u.searchParams.append(name,v)});u.searchParams.delete('page');u.searchParams.delete('sq_view_page');location.assign(u.pathname+'?'+u.searchParams.toString())}})})}
