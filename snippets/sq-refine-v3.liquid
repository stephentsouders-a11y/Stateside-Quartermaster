  async function assembleProducts(){if(rootHandle==='uniforms'&&query.getAll('sq_ucp').length)return;var live=gridCards(document);if(!live.grid)return;var target=pageSize(),view=Math.max(1,parseInt(query.get('sq_view_page')||'1',10)||1),globalStart=(view-1)*target,startPage=Math.floor(globalStart/50)+1,offset=globalStart%50,need=offset+target+1,cards=[],p=startPage,nativeNext=!!productHost.querySelector('a[rel="next"],pagination-component a[href*="page=2"],.pagination a[href*="page=2"],.pagination__item--next a');if(!(target===50&&view===1&&offset===0&&live.cards.length)){while(cards.length<need&&p<startPage+8){var batch=await altCards(p);if(!batch.length)break;cards=cards.concat(batch);if(batch.length<50)break;p++}}else{cards=live.cards.slice();}var sliced=cards.slice(offset,offset+target),hasNext=(target===50&&view===1&&offset===0)?nativeNext:cards.length>offset+target;if(!sliced.length)return;var frag=document.createDocumentFragment();sliced.forEach(function(c){frag.appendChild(document.importNode(c,true))});live.grid.replaceChildren(frag);var pagers=productHost.querySelectorAll('pagination-component,.pagination');pagers.forEach(function(x){x.style.display='none'});var pager=document.createElement('nav');pager.className='sq-refine-v3-pager';pager.setAttribute('aria-label','Product pages');function vu(n){var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.set('sq_per_page',String(target));u.searchParams.set('sq_view_page',String(n));return u.pathname+'?'+u.searchParams.toString()}pager.innerHTML=(view>1?'<a href="'+esc(vu(view-1))+'">Previous</a>':'')+'<span>Page '+view+'</span>'+(hasNext?'<a href="'+esc(vu(view+1))+'">Next</a>':'');live.grid.parentElement.appendChild(pager)}
  async function launch(){try{var rootDoc=await rootDocument(),structuralGroups=extractStructural(rootDoc);await ensureProductHost();makeLayout();var native=nativeGroups(),books=rootHandle==='literature'?bookGroups(parseBookTags(rootDoc)):[],html='<h2 class="sq-refine-v3-sidebar__title">Refine Products</h2>';structuralGroups.forEach(function(g){html+=groupMarkup(g,'structural')});books.forEach(function(g){html+=bookMarkup(g)});native.forEach(function(g){html+=groupMarkup(g,'native')});sidebar.innerHTML=html;hideSources();bindSidebar();installPageSize();await assembleProducts();guardSingleProductGrid();main.dataset.sqRefineV3CategorySource='collection-interior-20260911';main.dataset.sqRefineV3Ready='true';main.dataset.sqRefineV3Fallback=usingFallback?'true':'false'}catch(e){main.dataset.sqRefineV3Error=clean(e&&e.message||e);console.error('[SQ V3]',e)}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',launch,{once:true});else launch();
