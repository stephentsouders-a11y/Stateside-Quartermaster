{% doc %}
Moves the Stateside Quartermaster root-collection button hierarchy into Refine Products as responsive checkbox groups and replaces the inner button-tree/product surface with a paged product catalog surface. Existing collection-button membership remains the source of truth for structural facets. Product metadata adds Shop by Color and Shop by Pattern on every supported root and richer book facets for Author, Publisher, War / Conflict, Branch / Service, and Topic. Structural choices are ORed within a group and intersected across groups. Products-per-page stays with the product controls outside the sidebar and offers 50, 100, or 250, with 50 as the default.
{% enddoc %}
{% if request.page_type == 'collection' %}
<script data-sq-refine-taxonomy-panel-v2 data-root-handle="{{ collection.handle | escape }}">
(function(){
  if(window.__sqRefineTaxonomyPanelV2)return;window.__sqRefineTaxonomyPanelV2=true;window.__sqRefineTaxonomyPanelV1=true;
  var rootHandle=(document.currentScript&&document.currentScript.dataset.rootHandle)||'';
  var ROOTS=new Set(['accessories-gifts-collectibles','airsoft-milsim','apparel','armed-forces-gear','art','body-armor-ballistic-protection','literature','child-safety-shop','dive-scuba','firearm-accessories','first-aid-medical-ifak','flags-patriotic-decor','flashlights-lighting','footwear-gloves-eyewear','k9-dog-gear','knives-axes-cutlery','morale-patches-tactical-id','outdoor-preparedness-gear','patriotic-american-heritage','safety-rescue-climbing','sta-brite-insignia','tactical-gear','thin-line','uniforms','watches','zippos-lighters-torches','stateside-quartermaster-logo-merch','army-national-guard-series','air-national-guard-series','state-guard-series','products-built-for-the-line-u-s-army','products-built-for-the-line-u-s-navy','products-built-for-the-line-u-s-air-force','products-built-for-the-line-u-s-marine-corps','products-built-for-the-line-u-s-coast-guard','products-built-for-the-line-u-s-space-force','rotc-series','jrotc-series','military-schools-academies','law-enforcement-corrections','firefighting-ems-search-rescue']);
  if(!ROOTS.has(rootHandle))return;
  var main=document.getElementById('MainContent');if(!main)return;
  var cache=new Map(),groups=[],sourceNodes=new Set(),allProducts=[],pageSize=50,currentPage=1;
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function norm(v){return clean(v).toLowerCase().replace(/[\u2019']/g,'').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').trim()}
  function esc(v){return clean(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function handleFrom(href){try{var m=new URL(href,location.origin).pathname.match(/^\/collections\/([^/?#]+)/);return m?decodeURIComponent(m[1]):''}catch(_){return''}}
  function isNavCard(a){if(!a||!handleFrom(a.href)||a.closest('.sq-global-refine-sidebar'))return false;if(a.closest('collection-component,.product-grid,product-card,[data-sq-filtered-product-surface-guard-products],[data-sq-military-filtered-products],[data-sq-category-universe-products],[data-sq-custom-color-products]'))return false;var cls=String(a.className||''),parent=String(a.parentElement&&a.parentElement.className||'');return /(?:^|\s)(?:sq-|vac-)/i.test(cls)||/(subcategory|third-level|button-tree|branch|category|program|folder|type-grid|match-grid|navigation)/i.test(cls+' '+parent)}
  function labelOf(a){var x=a.querySelector('[class*="title"],[class*="label"],strong,h3,h4');return clean(x?x.textContent:(a.getAttribute('aria-label')||a.textContent)).replace(/^shop\s+(?:all\s+)?/i,'')}
  function canonicalGroup(t){var n=norm(t);if(/shop by branch|service branch|by branch/.test(n))return'Shop by Branch';if(/shop by subcategory|sub category|subcategory/.test(n))return'Shop by Subcategory';if(/shop by type|product type|by type/.test(n))return'Shop by Type';if(/shop by category|categories|category/.test(n))return'Shop by Category';if(/shop by color/.test(n)&&!/pattern/.test(n))return'Shop by Color';if(/shop by pattern|camo|camouflage/.test(n))return'Shop by Pattern';if(/manufacturer|brand/.test(n))return'Shop by Manufacturer';return clean(t).replace(/:$/,'')}
  function groupName(a){var node=a;for(var i=0;i<7&&node;i++,node=node.parentElement){var h=node.querySelector&&node.querySelector(':scope > h2,:scope > h3,:scope > header h2,:scope > header h3');if(h){var t=clean(h.textContent).replace(/\s*\(.*?\)\s*$/,'');if(t)return canonicalGroup(t)}}var href=(a.getAttribute('href')||'').toLowerCase(),lab=labelOf(a).toLowerCase();if(/branch|army|navy|air force|marine|coast guard|space force/.test(href+' '+lab)&&/series|branch|service/.test(href+' '+lab))return'Shop by Branch';if(/pattern|camo|camouflage/.test(href+' '+lab))return'Shop by Pattern';if(/color|colour/.test(href+' '+lab))return'Shop by Color';if(/type/.test(href+' '+lab))return'Shop by Type';return'Shop by Category'}
  function sourceContainer(a){var node=a;for(var i=0;i<8&&node&&node!==main;i++,node=node.parentElement){if(node.matches&&node.matches('section,.sq-subcategory-section,[class*="button-tree"],[class*="category-section"],[class*="navigation"],[class*="program-tree"],[class*="third-level"]'))return node;var cards=node.querySelectorAll?[...node.querySelectorAll('a[href*="/collections/"]')].filter(isNavCard):[];if(cards.length>=2&&node.querySelector('h2,h3'))return node}return a}
  function discover(){var by=new Map();[...main.querySelectorAll('a[href*="/collections/"]')].filter(isNavCard).forEach(function(a){var h=handleFrom(a.href),lab=labelOf(a);if(!h||!lab||h===rootHandle)return;var g=groupName(a),k=norm(g);if(!by.has(k))by.set(k,{label:g,items:[]});var bucket=by.get(k);if(!bucket.items.some(function(x){return x.handle===h}))bucket.items.push({label:lab,handle:h,href:a.href});sourceNodes.add(sourceContainer(a))});groups=[...by.values()].filter(function(g){return g.items.length})}
  async function loadCollection(handle){if(cache.has(handle))return cache.get(handle);var p=(async function(){var out=[],seen={};for(var pg=1;pg<=24;pg++){var r;try{r=await fetch('/collections/'+encodeURIComponent(handle)+'/products.json?limit=250&page='+pg,{credentials:'same-origin'})}catch(_){break}if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(x){if(x&&x.handle&&!seen[x.handle]){seen[x.handle]=1;out.push(x)}});if(a.length<250)break}return out})();cache.set(handle,p);return p}
  function tags(p){return Array.isArray(p&&p.tags)?p.tags:[]}
  function taggedValue(p,names){var wanted=names.map(norm),out=[];tags(p).forEach(function(t){var s=clean(t),m=s.match(/^([^:]+):\s*(.+)$/);if(!m)return;if(wanted.indexOf(norm(m[1]))>-1)out.push(clean(m[2]))});return out}
  function patternish(v){var s=norm(v);return !!s&&/(multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a tacs|tiger stripe|lizard|camo|camouflage|digital|pattern)/.test(s)}
  function colorish(v){var s=norm(v);if(!s||s==='default title'||/^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|6xl|small|medium|large|one size|standard)$/.test(s))return false;return /(black|white|grey|gray|charcoal|red|blue|navy|green|olive|foliage|coyote|tan|khaki|brown|sand|gold|silver|orange|yellow|pink|purple|maroon|burgundy|teal|aqua|beige)/.test(s)}
  function appearanceFacets(p){var colors=[],patterns=[],seenColor={},seenPattern={};function add(v,kind){v=clean(v);var k=norm(v);if(!k)return;if(kind==='pattern'||patternish(v)){if(!seenPattern[k]){seenPattern[k]=1;patterns.push(v)}return}if((kind==='color'||colorish(v))&&!seenColor[k]){seenColor[k]=1;colors.push(v)}}tags(p).forEach(function(t){var raw=clean(t),m=raw.match(/^(?:sq\s+)?(color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m){var kind=/pattern|camo/i.test(m[1])?'pattern':'color';add(m[2],kind)}else if(patternish(raw))add(raw,'pattern');else if(colorish(raw))add(raw,'color')});var opts=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];opts.forEach(function(o,i){var name=clean(typeof o==='string'?o:(o&&o.name)||'');if(!/color|colour|pattern|camo|camouflage/i.test(name))return;var kind=/pattern|camo|camouflage/i.test(name)?'pattern':'color';vs.forEach(function(v){add(v&&v['option'+(i+1)],kind)})});return{colors:colors,patterns:patterns}}
  function metadataGroups(products){var out=[],specs=[['Shop by Color','colors'],['Shop by Pattern','patterns']];specs.forEach(function(s){var vals=new Map();products.forEach(function(p){appearanceFacets(p)[s[1]].forEach(function(v){var k=norm(v);if(k&&!vals.has(k))vals.set(k,v)})});if(vals.size)out.push({label:s[0],metadata:true,kind:s[1],items:[...vals.values()].sort(function(a,b){return a.localeCompare(b,undefined,{numeric:true,sensitivity:'base'})}).map(function(v){return{label:v,value:v}})})});if(rootHandle==='literature'){[['Shop by Author',['author','book author']],['Shop by Publisher',['publisher','book publisher']],['Shop by War / Conflict',['war','conflict','war conflict']],['Shop by Branch',['branch','service','service branch']],['Shop by Topic',['topic','subject','book topic']]].forEach(function(s){var vals=new Map();products.forEach(function(p){taggedValue(p,s[1]).forEach(function(v){var k=norm(v);if(k&&!vals.has(k))vals.set(k,v)})});if(vals.size)out.push({label:s[0],metadata:true,items:[...vals.values()].sort(function(a,b){return a.localeCompare(b,undefined,{numeric:true,sensitivity:'base'})}).map(function(v){return{label:v,value:v}})})})}return out}
  function selected(){var s={};document.querySelectorAll('.sq-refine-taxonomy input[type="checkbox"]:checked').forEach(function(i){(s[i.dataset.group]||(s[i.dataset.group]=[])).push(i.value)});return s}
  async function structuralMatch(product,group,values){if(!values||!values.length)return true;var handles=group.items.filter(function(x){return values.indexOf(x.handle)>-1}).map(function(x){return x.handle});if(!handles.length)return true;for(var i=0;i<handles.length;i++){var ps=await loadCollection(handles[i]);if(ps.some(function(p){return p.handle===product.handle}))return true}return false}
  function metadataMatch(p,g,vals){if(!vals||!vals.length)return true;if(g.label==='Shop by Color'||g.kind==='colors'){var cf=appearanceFacets(p).colors.map(norm);return vals.some(function(v){return cf.indexOf(norm(v))>-1})}if(g.label==='Shop by Pattern'||g.kind==='patterns'){var pf=appearanceFacets(p).patterns.map(norm);return vals.some(function(v){return pf.indexOf(norm(v))>-1})}var names=g.label==='Shop by Author'?['author','book author']:g.label==='Shop by Publisher'?['publisher','book publisher']:g.label==='Shop by War / Conflict'?['war','conflict','war conflict']:g.label==='Shop by Branch'?['branch','service','service branch']:['topic','subject','book topic'];var pv=taggedValue(p,names).map(norm);return vals.some(function(v){return pv.indexOf(norm(v))>-1})}
  function queryValues(q,key){var out=[];q.getAll(key).forEach(function(v){String(v||'').split(',').forEach(function(x){x=clean(x);if(x&&!out.some(function(y){return norm(y)===norm(x)}))out.push(x)})});return out}
  function queryMatch(p){var q=new URLSearchParams(location.search),maker=clean(q.get('sq_maker')||q.get('filter.p.vendor')),colors=queryValues(q,'sq_color'),patterns=queryValues(q,'sq_pattern'),legacy=clean(q.get('sq_color_pattern'));if(maker&&norm(p.vendor)!==norm(maker))return false;var a=appearanceFacets(p),pc=a.colors.map(norm),pp=a.patterns.map(norm);if(colors.length&&!colors.some(function(v){return pc.indexOf(norm(v))>-1}))return false;if(patterns.length&&!patterns.some(function(v){return pp.indexOf(norm(v))>-1}))return false;if(legacy&&pc.indexOf(norm(legacy))<0&&pp.indexOf(norm(legacy))<0)return false;return true}
  async function filteredProducts(){var sel=selected(),out=[];for(var i=0;i<allProducts.length;i++){var p=allProducts[i];if(!queryMatch(p))continue;var ok=true;for(var j=0;j<groups.length&&ok;j++){var g=groups[j],vals=sel[norm(g.label)]||[];if(!vals.length)continue;if(g.metadata)ok=metadataMatch(p,g,vals);else ok=await structuralMatch(p,g,vals)}if(ok)out.push(p)}return out}
  function productImage(p){var x=p&&((p.image&&p.image.src)||p.image||(p.images&&p.images[0]&&((p.images[0].src)||p.images[0])));return typeof x==='string'?x:''}
  function pageSizeHtml(){return'<div class="sq-refine-page-size" aria-label="Products per page"><span>Products per page:</span>'+[50,100,250].map(function(n){return'<label><input type="radio" name="sq_page_size" value="'+n+'" '+(n===pageSize?'checked':'')+'><span>'+n+'</span></label>'}).join('')+'</div>'}
  function bindPageSize(host){host.querySelectorAll('input[name="sq_page_size"]').forEach(function(i){i.addEventListener('change',function(){pageSize=parseInt(i.value,10)||50;currentPage=1;renderProducts()})})}
  async function renderProducts(){var token=Date.now();renderProducts.token=token;var ps=await filteredProducts();if(renderProducts.token!==token)return;var totalPages=Math.max(1,Math.ceil(ps.length/pageSize));if(currentPage>totalPages)currentPage=1;var start=(currentPage-1)*pageSize,show=ps.slice(start,start+pageSize),host=main.querySelector('.sq-refine-taxonomy-products');if(!host){host=document.createElement('section');host.className='sq-refine-taxonomy-products';var anchor=main.querySelector('collection-component,.product-grid,#product-grid')||main.lastElementChild;anchor.parentNode.insertBefore(host,anchor)}host.innerHTML='<div class="sq-refine-taxonomy-products__top"><strong>'+ps.length+' products</strong>'+pageSizeHtml()+'<span>Page '+currentPage+' of '+totalPages+'</span></div><div class="sq-refine-taxonomy-products__grid">'+show.map(function(p){var im=productImage(p);return'<a class="sq-refine-taxonomy-product" href="/products/'+encodeURIComponent(p.handle)+'"><span class="sq-refine-taxonomy-product__media">'+(im?'<img src="'+esc(im)+'" alt="'+esc(p.title)+'" loading="lazy" decoding="async">':'')+'</span><strong>'+esc(p.title)+'</strong><small>'+esc(p.vendor||'')+'</small></a>'}).join('')+'</div><div class="sq-refine-taxonomy-pager"><button type="button" data-page="prev" '+(currentPage<=1?'disabled':'')+'>Previous</button><span>'+currentPage+' / '+totalPages+'</span><button type="button" data-page="next" '+(currentPage>=totalPages?'disabled':'')+'>Next</button></div>';bindPageSize(host);host.querySelectorAll('[data-page]').forEach(function(b){b.addEventListener('click',function(){currentPage+=b.dataset.page==='next'?1:-1;renderProducts();host.scrollIntoView({behavior:'smooth',block:'start'})})})}
  function groupHtml(g){var key=norm(g.label);return'<details class="sq-refine-taxonomy__group" open><summary>'+esc(g.label)+'</summary><div class="sq-refine-taxonomy__choices">'+g.items.map(function(x){var val=g.metadata?x.value:x.handle;return'<label class="sq-global-refine-sidebar__choice"><input type="checkbox" data-group="'+esc(key)+'" value="'+esc(val)+'"><span>'+esc(x.label)+'</span></label>'}).join('')+'</div></details>'}
  function removeCombinedAppearance(side){[...side.querySelectorAll('details')].forEach(function(d){var s=clean(d.querySelector(':scope>summary')&&d.querySelector(':scope>summary').textContent);if(/shop by color\s*\/\s*pattern/i.test(s))d.remove()})}
  function buildSidebar(){var side=main.querySelector('.sq-global-refine-sidebar');if(!side)return false;removeCombinedAppearance(side);var old=side.querySelector('.sq-refine-taxonomy');if(old)old.remove();var box=document.createElement('div');box.className='sq-refine-taxonomy';box.innerHTML=groups.map(groupHtml).join('');side.appendChild(box);box.querySelectorAll('input[type="checkbox"]').forEach(function(i){i.addEventListener('change',function(){currentPage=1;renderProducts()})});return true}
  function hideOldNav(){sourceNodes.forEach(function(n){if(n&&n.style)n.style.setProperty('display','none','important')});main.classList.add('sq-refine-taxonomy-active')}
  function style(){if(document.getElementById('sq-refine-taxonomy-style'))return;var s=document.createElement('style');s.id='sq-refine-taxonomy-style';s.textContent='#MainContent.sq-refine-taxonomy-active collection-component,#MainContent.sq-refine-taxonomy-active>.product-grid,#MainContent.sq-refine-taxonomy-active #product-grid,#MainContent.sq-refine-taxonomy-active [data-sq-filtered-product-surface-guard-products]:not(.sq-refine-taxonomy-products),#MainContent.sq-refine-taxonomy-active [data-sq-military-filtered-products],#MainContent.sq-refine-taxonomy-active [data-sq-global-refine-products],#MainContent.sq-refine-taxonomy-active [data-sq-category-universe-products]:not(.sq-refine-taxonomy-products),#MainContent.sq-refine-taxonomy-active [data-sq-custom-color-products]:not(.sq-refine-taxonomy-products),#MainContent.sq-refine-taxonomy-active .sqbfl-products,#MainContent.sq-refine-taxonomy-active .sqsg-products,#MainContent.sq-refine-taxonomy-active .sq-type-family-products__grid{display:none!important}.sq-refine-taxonomy{margin-top:12px}.sq-refine-taxonomy__group{border-top:1px solid #dfe4e7;padding:8px 0}.sq-refine-taxonomy__group>summary{cursor:pointer;font-weight:900;padding:8px 2px}.sq-refine-taxonomy__choices{display:grid;gap:6px;padding-top:6px}.sq-refine-taxonomy-products{display:block!important;min-width:0}.sq-refine-taxonomy-products__top,.sq-refine-taxonomy-pager{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:12px 0}.sq-refine-page-size{display:flex;align-items:center;justify-content:center;gap:6px;flex-wrap:wrap}.sq-refine-page-size>span{font-size:12px;font-weight:800}.sq-refine-page-size label{display:flex;align-items:center;gap:4px;border:1px solid #dfe4e7;border-radius:7px;padding:6px 8px;cursor:pointer;font-weight:800;background:#fff}.sq-refine-page-size input{margin:0}.sq-refine-taxonomy-products__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.sq-refine-taxonomy-product{display:flex;min-width:0;flex-direction:column;gap:5px;text-decoration:none;color:inherit}.sq-refine-taxonomy-product__media{display:block;aspect-ratio:1/1;background:#fff;overflow:hidden}.sq-refine-taxonomy-product__media img{width:100%;height:100%;object-fit:contain}.sq-refine-taxonomy-product small{opacity:.7}.sq-refine-taxonomy-pager button{padding:10px 16px;border:1px solid #ccd3d7;border-radius:8px;background:#fff;font-weight:800;cursor:pointer}.sq-refine-taxonomy-pager button:disabled{opacity:.45;cursor:default}@media(max-width:900px){.sq-refine-taxonomy-products__top{align-items:flex-start;flex-direction:column}.sq-refine-taxonomy-products__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sq-refine-page-size{justify-content:flex-start}}';document.head.appendChild(s)}
  async function start(){style();discover();allProducts=await loadCollection(rootHandle);metadataGroups(allProducts).forEach(function(g){var ix=groups.findIndex(function(x){return norm(x.label)===norm(g.label)});if(ix>=0)groups[ix]=g;else groups.push(g)});if(!buildSidebar()){setTimeout(start,250);return}hideOldNav();renderProducts();window.addEventListener('sq:refine-controls-change',function(){currentPage=1;renderProducts()});window.addEventListener('popstate',function(){currentPage=1;renderProducts()})}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(start,120)},{once:true});else setTimeout(start,120);
})();
</script>
{% endif %}
