{% doc %}
Moves the Stateside Quartermaster root-collection button hierarchy into Refine Products as responsive checkbox groups and replaces the inner button-tree/product surface with a paged product catalog surface. Existing collection-button membership is used as the source of truth for structural facets. Product metadata tags add richer facets, including book Author, Publisher, War / Conflict, Branch / Service, and Topic. Structural choices are ORed within a group and intersected across groups. Product page sizes are 50, 100, or 250, with 50 as the default.
{% enddoc %}
{% if request.page_type == 'collection' %}
<script data-sq-refine-taxonomy-panel-v1 data-root-handle="{{ collection.handle | escape }}">
(function(){
  if(window.__sqRefineTaxonomyPanelV1)return;window.__sqRefineTaxonomyPanelV1=true;
  var rootHandle=(document.currentScript&&document.currentScript.dataset.rootHandle)||'';
  var ROOTS=new Set(['accessories-gifts-collectibles','airsoft-milsim','apparel','armed-forces-gear','art','body-armor-ballistic-protection','literature','child-safety-shop','dive-scuba','firearm-accessories','first-aid-medical-ifak','flags-patriotic-decor','flashlights-lighting','footwear-gloves-eyewear','k9-dog-gear','knives-axes-cutlery','morale-patches-tactical-id','outdoor-preparedness-gear','patriotic-american-heritage','safety-rescue-climbing','sta-brite-insignia','tactical-gear','thin-line','uniforms','watches','zippos-lighters-torches','stateside-quartermaster-logo-merch','army-national-guard-series','air-national-guard-series','state-guard-series','products-built-for-the-line-u-s-army','products-built-for-the-line-u-s-navy','products-built-for-the-line-u-s-air-force','products-built-for-the-line-u-s-marine-corps','products-built-for-the-line-u-s-coast-guard','products-built-for-the-line-u-s-space-force','rotc-series','jrotc-series','military-schools-academies','law-enforcement-corrections','firefighting-ems-search-rescue']);
  if(!ROOTS.has(rootHandle))return;
  var main=document.getElementById('MainContent');if(!main)return;
  var cache=new Map(),groups=[],sourceNodes=new Set(),allProducts=[],pageSize=50,currentPage=1;
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function norm(v){return clean(v).toLowerCase().replace(/[’']/g,'').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').trim()}
  function esc(v){return clean(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[k]})}
  function handleFrom(href){try{var m=new URL(href,location.origin).pathname.match(/^\/collections\/([^/?#]+)/);return m?decodeURIComponent(m[1]):''}catch(_){return''}}
  function isNavCard(a){if(!a||!handleFrom(a.href)||a.closest('.sq-global-refine-sidebar'))return false;if(a.closest('collection-component,.product-grid,product-card,[data-sq-filtered-product-surface-guard-products],[data-sq-military-filtered-products],[data-sq-category-universe-products],[data-sq-custom-color-products]'))return false;var cls=String(a.className||'');var parent=String(a.parentElement&&a.parentElement.className||'');return /(?:^|\s)(?:sq-|vac-)/i.test(cls)||/(subcategory|third-level|button-tree|branch|category|program|folder|type-grid|match-grid|navigation)/i.test(cls+' '+parent)}
  function labelOf(a){var x=a.querySelector('[class*="title"],[class*="label"],strong,h3,h4');return clean(x?x.textContent:(a.getAttribute('aria-label')||a.textContent)).replace(/^shop\s+(?:all\s+)?/i,'')}
  function canonicalGroup(t){var n=norm(t);if(/shop by branch|service branch|by branch/.test(n))return'Shop by Branch';if(/shop by subcategory|sub category|subcategory/.test(n))return'Shop by Subcategory';if(/shop by type|product type|by type/.test(n))return'Shop by Type';if(/shop by category|categories|category/.test(n))return'Shop by Category';if(/manufacturer|brand/.test(n))return'Shop by Manufacturer';return clean(t).replace(/:$/,'')}
  function groupName(a){var node=a;for(var i=0;i<7&&node;i++,node=node.parentElement){var h=node.querySelector&&node.querySelector(':scope > h2,:scope > h3,:scope > header h2,:scope > header h3');if(h){var t=clean(h.textContent).replace(/\s*\(.*?\)\s*$/,'');if(t)return canonicalGroup(t)}}var href=(a.getAttribute('href')||'').toLowerCase(),lab=labelOf(a).toLowerCase();if(/branch|army|navy|air force|marine|coast guard|space force/.test(href+' '+lab)&&/series|branch|service/.test(href+' '+lab))return'Shop by Branch';if(/type/.test(href+' '+lab))return'Shop by Type';return'Shop by Category'}
  function sourceContainer(a){var node=a;for(var i=0;i<8&&node&&node!==main;i++,node=node.parentElement){if(node.matches&&node.matches('section,.sq-subcategory-section,[class*="button-tree"],[class*="category-section"],[class*="navigation"],[class*="program-tree"],[class*="third-level"]'))return node;var cards=node.querySelectorAll?[...node.querySelectorAll('a[href*="/collections/"]')].filter(isNavCard):[];if(cards.length>=2&&node.querySelector('h2,h3'))return node}return a}
  function discover(){var by=new Map();[...main.querySelectorAll('a[href*="/collections/"]')].filter(isNavCard).forEach(function(a){var h=handleFrom(a.href),lab=labelOf(a);if(!h||!lab||h===rootHandle)return;var g=groupName(a),k=norm(g);if(!by.has(k))by.set(k,{label:g,items:[]});var bucket=by.get(k);if(!bucket.items.some(function(x){return x.handle===h}))bucket.items.push({label:lab,handle:h,href:a.href});sourceNodes.add(sourceContainer(a))});groups=[...by.values()].filter(function(g){return g.items.length})}
  async function loadCollection(handle){if(cache.has(handle))return cache.get(handle);var p=(async function(){var out=[],seen={};for(var pg=1;pg<=24;pg++){var r;try{r=await fetch('/collections/'+encodeURIComponent(handle)+'/products.json?limit=250&page='+pg,{credentials:'same-origin'})}catch(_){break}if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(x){if(x&&x.handle&&!seen[x.handle]){seen[x.handle]=1;out.push(x)}});if(a.length<250)break}return out})();cache.set(handle,p);return p}
  function tags(p){return Array.isArray(p&&p.tags)?p.tags:[]}
  function taggedValue(p,names){var wanted=names.map(norm);var out=[];tags(p).forEach(function(t){var s=clean(t),m=s.match(/^([^:]+):\s*(.+)$/);if(!m)return;if(wanted.indexOf(norm(m[1]))>-1)out.push(clean(m[2]))});return out}
  function bookGroups(products){if(rootHandle!=='literature')return[];var specs=[['Shop by Author',['author','book author']],['Shop by Publisher',['publisher','book publisher']],['Shop by War / Conflict',['war','conflict','war conflict']],['Shop by Branch',['branch','service','service branch']],['Shop by Topic',['topic','subject','book topic']]],out=[];specs.forEach(function(s){var vals=new Map();products.forEach(function(p){taggedValue(p,s[1]).forEach(function(v){var k=norm(v);if(k&&!vals.has(k))vals.set(k,v)})});if(vals.size)out.push({label:s[0],metadata:true,items:[...vals.values()].sort().map(function(v){return{label:v,value:v}})})});return out}
  function selected(){var s={};document.querySelectorAll('.sq-refine-taxonomy input[type="checkbox"]:checked').forEach(function(i){(s[i.dataset.group]||(s[i.dataset.group]=[])).push(i.value)});return s}
  async function structuralMatch(product,group,values){if(!values||!values.length)return true;var handles=group.items.filter(function(x){return values.indexOf(x.handle)>-1}).map(function(x){return x.handle});if(!handles.length)return true;for(var i=0;i<handles.length;i++){var ps=await loadCollection(handles[i]);if(ps.some(function(p){return p.handle===product.handle}))return true}return false}
  function metadataMatch(p,g,vals){if(!vals||!vals.length)return true;var names=g.label==='Shop by Author'?['author','book author']:g.label==='Shop by Publisher'?['publisher','book publisher']:g.label==='Shop by War / Conflict'?['war','conflict','war conflict']:g.label==='Shop by Branch'?['branch','service','service branch']:['topic','subject','book topic'];var pv=taggedValue(p,names).map(norm);return vals.some(function(v){return pv.indexOf(norm(v))>-1})}
  function vendorMatch(p){var q=new URLSearchParams(location.search),v=clean(q.get('sq_maker')||q.get('filter.p.vendor'));return !v||norm(p.vendor)===norm(v)}
  async function filteredProducts(){var sel=selected(),out=[];for(var i=0;i<allProducts.length;i++){var p=allProducts[i];if(!vendorMatch(p))continue;var ok=true;for(var j=0;j<groups.length&&ok;j++){var g=groups[j],vals=sel[norm(g.label)]||[];if(!vals.length)continue;if(g.metadata)ok=metadataMatch(p,g,vals);else ok=await structuralMatch(p,g,vals)}if(ok)out.push(p)}return out}
  function productImage(p){var x=p&&((p.image&&p.image.src)||p.image||(p.images&&p.images[0]&&((p.images[0].src)||p.images[0])));return typeof x==='string'?x:''}
  async function renderProducts(){var token=Date.now();renderProducts.token=token;var ps=await filteredProducts();if(renderProducts.token!==token)return;var totalPages=Math.max(1,Math.ceil(ps.length/pageSize));if(currentPage>totalPages)currentPage=1;var start=(currentPage-1)*pageSize,show=ps.slice(start,start+pageSize),host=main.querySelector('.sq-refine-taxonomy-products');if(!host){host=document.createElement('section');host.className='sq-refine-taxonomy-products';var anchor=main.querySelector('collection-component,.product-grid,#product-grid')||main.lastElementChild;anchor.parentNode.insertBefore(host,anchor)}host.innerHTML='<div class="sq-refine-taxonomy-products__top"><strong>'+ps.length+' products</strong><span>Page '+currentPage+' of '+totalPages+'</span></div><div class="sq-refine-taxonomy-products__grid">'+show.map(function(p){var im=productImage(p);return'<a class="sq-refine-taxonomy-product" href="/products/'+encodeURIComponent(p.handle)+'"><span class="sq-refine-taxonomy-product__media">'+(im?'<img src="'+esc(im)+'" alt="'+esc(p.title)+'" loading="lazy" decoding="async">':'')+'</span><strong>'+esc(p.title)+'</strong><small>'+esc(p.vendor||'')+'</small></a>'}).join('')+'</div><div class="sq-refine-taxonomy-pager"><button type="button" data-page="prev" '+(currentPage<=1?'disabled':'')+'>Previous</button><span>'+currentPage+' / '+totalPages+'</span><button type="button" data-page="next" '+(currentPage>=totalPages?'disabled':'')+'>Next</button></div>';host.querySelectorAll('[data-page]').forEach(function(b){b.addEventListener('click',function(){currentPage+=b.dataset.page==='next'?1:-1;renderProducts();host.scrollIntoView({behavior:'smooth',block:'start'})})})}
  function groupHtml(g){var key=norm(g.label);return'<details class="sq-refine-taxonomy__group" open><summary>'+esc(g.label)+'</summary><div class="sq-refine-taxonomy__choices">'+g.items.map(function(x){var val=g.metadata?x.value:x.handle;return'<label class="sq-global-refine-sidebar__choice"><input type="checkbox" data-group="'+esc(key)+'" value="'+esc(val)+'"><span>'+esc(x.label)+'</span></label>'}).join('')+'</div></details>'}
  function buildSidebar(){var side=main.querySelector('.sq-global-refine-sidebar');if(!side)return false;var old=side.querySelector('.sq-refine-taxonomy');if(old)old.remove();var box=document.createElement('div');box.className='sq-refine-taxonomy';box.innerHTML='<details class="sq-refine-taxonomy__group" open><summary>Products Per Page</summary><div class="sq-refine-page-size">'+[50,100,250].map(function(n){return'<label><input type="radio" name="sq_page_size" value="'+n+'" '+(n===pageSize?'checked':'')+'><span>'+n+'</span></label>'}).join('')+'</div></details>'+groups.map(groupHtml).join('');side.appendChild(box);box.querySelectorAll('input[type="checkbox"]').forEach(function(i){i.addEventListener('change',function(){currentPage=1;renderProducts()})});box.querySelectorAll('input[name="sq_page_size"]').forEach(function(i){i.addEventListener('change',function(){pageSize=parseInt(i.value,10)||50;currentPage=1;renderProducts()})});return true}
  function hideOldNav(){sourceNodes.forEach(function(n){if(n&&n.style)n.style.setProperty('display','none','important')});main.classList.add('sq-refine-taxonomy-active')}
  function style(){if(document.getElementById('sq-refine-taxonomy-style'))return;var s=document.createElement('style');s.id='sq-refine-taxonomy-style';s.textContent='#MainContent.sq-refine-taxonomy-active collection-component,#MainContent.sq-refine-taxonomy-active>.product-grid,#MainContent.sq-refine-taxonomy-active #product-grid,#MainContent.sq-refine-taxonomy-active [data-sq-filtered-product-surface-guard-products]:not(.sq-refine-taxonomy-products),#MainContent.sq-refine-taxonomy-active [data-sq-military-filtered-products],#MainContent.sq-refine-taxonomy-active [data-sq-global-refine-products],#MainContent.sq-refine-taxonomy-active [data-sq-category-universe-products]:not(.sq-refine-taxonomy-products),#MainContent.sq-refine-taxonomy-active [data-sq-custom-color-products]:not(.sq-refine-taxonomy-products),#MainContent.sq-refine-taxonomy-active .sqbfl-products,#MainContent.sq-refine-taxonomy-active .sqsg-products,#MainContent.sq-refine-taxonomy-active .sq-type-family-products__grid{display:none!important}.sq-refine-taxonomy{margin-top:12px}.sq-refine-taxonomy__group{border-top:1px solid #dfe4e7;padding:8px 0}.sq-refine-taxonomy__group>summary{cursor:pointer;font-weight:900;padding:8px 2px}.sq-refine-taxonomy__choices{display:grid;gap:6px;padding-top:6px}.sq-refine-page-size{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:6px 0}.sq-refine-page-size label{display:flex;justify-content:center;align-items:center;gap:6px;border:1px solid #dfe4e7;border-radius:7px;padding:8px;cursor:pointer;font-weight:800}.sq-refine-taxonomy-products{display:block!important;min-width:0}.sq-refine-taxonomy-products__top,.sq-refine-taxonomy-pager{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:12px 0}.sq-refine-taxonomy-products__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.sq-refine-taxonomy-product{display:flex;min-width:0;flex-direction:column;gap:5px;text-decoration:none;color:inherit}.sq-refine-taxonomy-product__media{display:block;aspect-ratio:1/1;background:#fff;overflow:hidden}.sq-refine-taxonomy-product__media img{width:100%;height:100%;object-fit:contain}.sq-refine-taxonomy-product small{opacity:.7}.sq-refine-taxonomy-pager button{padding:10px 16px;border:1px solid #ccd3d7;border-radius:8px;background:#fff;font-weight:800;cursor:pointer}.sq-refine-taxonomy-pager button:disabled{opacity:.45;cursor:default}@media(max-width:900px){.sq-refine-taxonomy-products__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}';document.head.appendChild(s)}
  async function start(){style();discover();allProducts=await loadCollection(rootHandle);var books=bookGroups(allProducts);books.forEach(function(g){var ix=groups.findIndex(function(x){return norm(x.label)===norm(g.label)});if(ix>=0)groups[ix]=g;else groups.push(g)});if(!buildSidebar()){setTimeout(start,250);return}hideOldNav();renderProducts();window.addEventListener('sq:refine-controls-change',function(){currentPage=1;renderProducts()});window.addEventListener('popstate',function(){currentPage=1;renderProducts()})}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(start,120)},{once:true});else setTimeout(start,120);
})();
</script>
{% endif %}