{% doc %}
Fallback normalizer for V3 Refine Products. It waits for the V3 controller to finish and guarantees the required taxonomy groups if the primary polish script ran before the controller was available. State Guard remains excluded.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<script data-sq-refine-v3-sidebar-polish-rescue data-current-handle="{{ collection.handle | escape }}">
(function(){
  var script=document.currentScript,current=(script&&script.dataset.currentHandle)||'';
  var ROOTS=new Set(['accessories-gifts-collectibles','airsoft-milsim','apparel','armed-forces-gear','art','body-armor-ballistic-protection','literature','child-safety-shop','dive-scuba','firearm-accessories','first-aid-medical-ifak','flags-patriotic-decor','flashlights-lighting','footwear-gloves-eyewear','k9-dog-gear','knives-axes-cutlery','morale-patches-tactical-id','outdoor-preparedness-gear','patriotic-american-heritage','safety-rescue-climbing','sta-brite-insignia','tactical-gear','thin-line','uniforms','watches','zippos-lighters-torches','stateside-quartermaster-logo-merch','army-national-guard-series','air-national-guard-series','products-built-for-the-line-u-s-army','products-built-for-the-line-u-s-navy','products-built-for-the-line-u-s-air-force','products-built-for-the-line-u-s-marine-corps','products-built-for-the-line-u-s-coast-guard','products-built-for-the-line-u-s-space-force','rotc-series','jrotc-series','military-schools-academies','law-enforcement-corrections','firefighting-ems-search-rescue']);
  var q=new URLSearchParams(location.search),root=q.get('sq_root')||current;if(!ROOTS.has(root))return;
  var main=document.getElementById('MainContent');if(!main)return;var meta={types:[],vendors:[],tags:[]};try{meta=JSON.parse((document.querySelector('[data-sq-refine-v3-polish-meta]')||{}).textContent||'{}')}catch(_){ }
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function norm(v){return clean(v).toLowerCase().replace(/[\u2019']/g,'').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').trim()}
  function uniq(a){var out=[];(a||[]).forEach(function(v){v=clean(v);if(v&&!out.some(function(x){return norm(x)===norm(v)}))out.push(v)});return out}
  function canonical(t){var n=norm(t);if(/firearm.*(?:make|model|platform)|(?:make|model).*firearm/.test(n))return'Shop by Firearm Make / Model';if(/author/.test(n))return'Shop by Author';if(/publisher/.test(n))return'Shop by Publishers';if(/manufacturer|vendor|brand/.test(n))return'Shop by Manufacturers';if(/color|colour|pattern|camo|camouflage/.test(n))return'Shop by Color / Pattern';if(/sub.?categor/.test(n))return'Shop by Sub-Category';if(/product type|shop by type|by type/.test(n))return'Shop by Type';if(/categor/.test(n))return'Shop by Category';if(/war|conflict/.test(n))return'Shop by War / Conflict';if(/branch|service/.test(n))return'Shop by Branch';if(/topic|subject/.test(n))return'Shop by Topic';return clean(t).replace(/:$/,'')}
  function groups(side){return [].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group'))}
  function find(side,label){var k=norm(canonical(label));return groups(side).find(function(d){var s=d.querySelector(':scope > summary');return s&&norm(canonical(s.textContent))===k})||null}
  function make(label,items,param){items=uniq(items);if(!items.length)return null;var d=document.createElement('details');d.className='sq-refine-v3-group';d.dataset.sqPolishSynthetic='true';var s=document.createElement('summary');s.textContent=label;var c=document.createElement('div');c.className='sq-refine-v3-choices';var selected=new Set(q.getAll(param));items.forEach(function(v){var row=document.createElement('label');row.className='sq-refine-v3-choice';var i=document.createElement('input');i.type='checkbox';i.dataset.sqPolishParam=param;i.dataset.sqPolishValue=v;i.checked=selected.has(v);var sp=document.createElement('span');sp.textContent=v;row.appendChild(i);row.appendChild(sp);c.appendChild(row)});d.appendChild(s);d.appendChild(c);if(c.querySelector('input:checked')){d.open=true;d.dataset.active='true'}return d}
  function bind(side){side.querySelectorAll('input[data-sq-polish-param]:not([data-sq-polish-bound])').forEach(function(i){i.dataset.sqPolishBound='true';i.addEventListener('change',function(){var u=new URL(location.href),name=i.dataset.sqPolishParam,val=i.dataset.sqPolishValue,vals=u.searchParams.getAll(name).filter(function(x){return x!==val});if(i.checked)vals.push(val);u.searchParams.delete(name);Array.from(new Set(vals)).forEach(function(x){u.searchParams.append(name,x)});u.searchParams.delete('page');u.searchParams.delete('sq_view_page');location.assign(u.pathname+'?'+u.searchParams.toString())})})}
  function firearm(side){
    if(root!=='firearm-accessories'||find(side,'Shop by Firearm Make / Model'))return;
    var rx=/(glock|1911|ar[- ]?15|ar[- ]?10|m4\b|m16\b|ak[- ]?47|ak[- ]?74|sig(?:\s+sauer)?|p320|p365|smith(?:\s*&\s*|\s+and\s+)?wesson|m&p|springfield|beretta|ruger|remington\s*870|mossberg\s*(?:500|590)|benelli|walther|\bcz\b|fn\s*509|\bhk\b|vp9|taurus)/i;
    var typeVals=uniq((meta.types||[]).filter(function(v){return rx.test(clean(v))}));
    var g=make('Shop by Firearm Make / Model',typeVals,'filter.p.product_type');
    if(g)side.appendChild(g);
  }
  function order(side){var p={'shop by category':10,'shop by sub category':20,'shop by type':30,'shop by firearm make model':35,'shop by color pattern':40,'shop by manufacturers':50,'shop by branch':55,'shop by author':60,'shop by publishers':70,'shop by war conflict':80,'shop by topic':90,'availability':900,'price':910};groups(side).sort(function(a,b){var sa=a.querySelector(':scope > summary'),sb=b.querySelector(':scope > summary'),ka=norm(canonical(sa&&sa.textContent)),kb=norm(canonical(sb&&sb.textContent));return(p[ka]||500)-(p[kb]||500)}).forEach(function(d){side.appendChild(d)})}
  function hideLegacy(side){main.querySelectorAll('[class*="button-tree"],[class*="root-categories"],[class*="subcategory"],[class*="third-level"],[class*="branch-grid"],[class*="type-grid"],[class*="program-tree"],[class*="category-grid"],[class*="navigation-grid"],.sqbfl,.sqaca').forEach(function(el){if(el===side||el.closest('.sq-refine-v3-sidebar,.sq-refine-v3-results'))return;var hc=el.matches('a[href*="/collections/"]')||el.querySelector('a[href*="/collections/"]'),hp=el.matches('a[href*="/products/"]')||el.querySelector('a[href*="/products/"]');if(hc&&!hp){el.dataset.sqRefineV3HiddenNav='true';el.style.setProperty('display','none','important')}})}
  function apply(){if(main.dataset.sqRefineV3Ready!=='true')return false;var side=main.querySelector('.sq-refine-v3-sidebar');if(!side)return false;var title=side.querySelector('.sq-refine-v3-sidebar__title');if(title)title.textContent='REFINE PRODUCTS';groups(side).forEach(function(d){var s=d.querySelector(':scope > summary');if(s)s.textContent=canonical(s.textContent)});if(!find(side,'Shop by Type')){var gt=make('Shop by Type',meta.types,'filter.p.product_type');if(gt)side.appendChild(gt)}if(!find(side,'Shop by Manufacturers')){var gv=make('Shop by Manufacturers',meta.vendors,'filter.p.vendor');if(gv)side.appendChild(gv)}if(root==='literature')groups(side).forEach(function(d){var s=d.querySelector(':scope > summary');if(s)s.textContent=canonical(s.textContent)});firearm(side);order(side);bind(side);hideLegacy(side);side.dataset.sqRefineV3Polished='true';side.dataset.sqRefineV3PolishRescued='true';return true}
  if(apply())return;var tries=0,t=setInterval(function(){tries++;try{if(apply()||tries>180)clearInterval(t)}catch(e){main.dataset.sqRefineV3PolishError=String(e&&e.message||e);clearInterval(t)}},250);
})();
</script>
{% endif %}
