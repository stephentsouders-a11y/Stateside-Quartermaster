{% if request.page_type == 'collection' or request.page_type == 'index' %}
<style>
.sq-afg-branch-placeholder,.sq-subcategory-placeholder,.sq-ps-root__placeholder,.sq-ts-match-placeholder,.sq-third-level__placeholder,.vac-category-placeholder,.sq-button-image-repair-placeholder{font-size:0!important;color:transparent!important;overflow:hidden;background:#fff!important}
</style>
<script>
(function(){
  var imageCache={};
  var inFlight={};
  function handleize(value){return String(value||'').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');}
  function productImage(product){if(!product)return'';if(product.image&&product.image.src)return product.image.src;if(Array.isArray(product.images)&&product.images.length){var first=product.images[0];if(typeof first==='string')return first;if(first&&first.src)return first.src;}return'';}
  function fetchProductPage(handle,page){return fetch('/collections/'+encodeURIComponent(handle)+'/products.json?limit=250&page='+page,{credentials:'same-origin'}).then(function(r){if(!r.ok)throw new Error('collection image lookup failed');return r.json();}).then(function(data){return Array.isArray(data.products)?data.products:[];});}
  function getProducts(handle,deep){var key=handle+(deep?'|deep':'|shallow');if(imageCache[key])return Promise.resolve(imageCache[key]);if(inFlight[key])return inFlight[key];inFlight[key]=fetchProductPage(handle,1).then(function(first){if(!deep||first.length<250)return first;var all=first.slice();function next(page){if(page>4)return Promise.resolve(all);return fetchProductPage(handle,page).then(function(batch){if(!batch.length)return all;Array.prototype.push.apply(all,batch);if(batch.length<250)return all;return next(page+1);}).catch(function(){return all;});}return next(2);}).then(function(products){imageCache[key]=products;delete inFlight[key];return products;}).catch(function(){delete inFlight[key];return[];});return inFlight[key];}
  function parseDestination(card){if(!card)return null;var url;try{url=new URL(card.href,window.location.origin);}catch(e){return null;}var parts=url.pathname.split('/').filter(Boolean);if(parts[0]!=='collections'||!parts[1])return null;return {url:url,handle:parts[1],tag:parts.length>2?parts.slice(2).join('-'):''};}
  function chooseExactProduct(products,url,card){var type=((url.searchParams.get('filter.p.product_type')||card?.dataset?.productType||'')+'').trim().toLowerCase();var parts=url.pathname.split('/').filter(Boolean);var tag=parts.length>2?parts.slice(2).join('-'):'';var match=null;if(type){match=products.find(function(p){return String(p.product_type||'').trim().toLowerCase()===type&&productImage(p);})||null;}if(!match&&tag){match=products.find(function(p){var tags=p.tags;if(typeof tags==='string')tags=tags.split(',');if(!Array.isArray(tags))tags=[];return tags.some(function(t){return handleize(t)===tag;})&&productImage(p);})||null;}return match;}
  function chooseProduct(products,url,card){return chooseExactProduct(products,url,card)||products.find(function(p){return productImage(p);})||null;}
  function labelFor(card){return (card.getAttribute('aria-label')||card.textContent||'').replace(/^Shop\s+/i,'').trim();}
  function setCardImage(card,src,label){if(!card||!src)return;var media=card.querySelector('[class*="media"],[class*="image"]');if(!media)return;var img=media.querySelector('img');if(!img){img=document.createElement('img');media.innerHTML='';media.appendChild(img);}img.src=src;img.alt=label||'';img.width=720;img.height=500;img.loading='lazy';}
  function repairTypeCard(card){if(!card||card.dataset.sqExactImageRepair==='1')return;card.dataset.sqExactImageRepair='1';var destination=parseDestination(card);if(!destination){card.dataset.sqExactImageRepair='0';return;}getProducts(destination.handle,true).then(function(products){var p=chooseExactProduct(products,destination.url,card);var src=productImage(p);if(src){setCardImage(card,src,labelFor(card));card.dataset.sqExactImageRepair='done';}else{card.dataset.sqExactImageRepair='0';}});}
  function installImage(placeholder,src,label){if(!src||!placeholder||!placeholder.parentElement)return;var img=document.createElement('img');img.src=src;img.alt=label||'';img.width=720;img.height=500;img.loading='lazy';placeholder.replaceWith(img);}
  function repairPlaceholder(placeholder){if(!placeholder||placeholder.dataset.sqRepairing==='1')return;placeholder.dataset.sqRepairing='1';var card=placeholder.closest('a[href]');var destination=parseDestination(card);if(!destination){placeholder.dataset.sqRepairing='0';return;}var isTypeCard=card&&card.classList.contains('sq-third-level__type');getProducts(destination.handle,isTypeCard).then(function(products){var p=isTypeCard?chooseExactProduct(products,destination.url,card):chooseProduct(products,destination.url,card);var src=productImage(p);if(src)installImage(placeholder,src,labelFor(card));else placeholder.dataset.sqRepairing='0';});}
  function seedBlankButtonMedia(){document.querySelectorAll('#MainContent a[href*="/collections/"]').forEach(function(card){var cls=String(card.className||'');if(!/(^|\s)(sq-|vac-)/i.test(cls)&&!/sq-|vac-/i.test(cls))return;if(!/(card|type|folder|category|branch|match|button)/i.test(cls))return;var media=card.querySelector('[class*="media"],[class*="image"]');if(!media)return;var img=media.querySelector('img');var src=img&&((img.getAttribute('src')||img.getAttribute('data-src')||'').trim());if(src)return;var known=media.querySelector('.sq-afg-branch-placeholder,.sq-subcategory-placeholder,.sq-ps-root__placeholder,.sq-ts-match-placeholder,.sq-third-level__placeholder,.vac-category-placeholder,.sq-button-image-repair-placeholder');var text=(media.textContent||'').trim();if(!known&&(text===''||text.toUpperCase()==='SQ')){media.innerHTML='<span class="sq-button-image-repair-placeholder" aria-hidden="true"></span>';}});}
  function repairTypeCards(){document.querySelectorAll('#MainContent a.sq-third-level__type[href*="/collections/"]').forEach(repairTypeCard);}
  function repairAllPlaceholders(){seedBlankButtonMedia();document.querySelectorAll('.sq-afg-branch-placeholder,.sq-subcategory-placeholder,.sq-ps-root__placeholder,.sq-ts-match-placeholder,.sq-third-level__placeholder,.vac-category-placeholder,.sq-button-image-repair-placeholder').forEach(repairPlaceholder);}
  function run(){repairTypeCards();repairAllPlaceholders();}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run,{once:true});else run();window.addEventListener('load',run,{once:true});var timer=null;new MutationObserver(function(){clearTimeout(timer);timer=setTimeout(function(){repairTypeCards();repairAllPlaceholders();},60);}).observe(document.documentElement,{childList:true,subtree:true});
})();
</script>
{% endif %}
{% if request.page_type == 'collection' %}{% render 'sq-global-refine-direct-data' %}{% render 'sq-filtered-product-surface-guard' %}{% render 'sq-filtered-child-union-bridge' %}{% endif %}