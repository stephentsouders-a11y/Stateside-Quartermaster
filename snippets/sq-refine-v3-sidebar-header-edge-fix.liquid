{% doc %}
Ensures the V3 Refine Products navy title bar visually reaches the sidebar's right border, including the desktop scrollbar gutter.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<style data-sq-refine-v3-header-edge-fix>
#MainContent .sq-refine-v3-sidebar__title{position:relative!important;width:calc(100% + 28px)!important;max-width:none!important;box-sizing:border-box!important;padding-right:40px!important;margin-right:-28px!important;background:#08283f!important}
#MainContent .sq-refine-v3-sidebar__title::after{content:'';position:absolute;top:0;bottom:0;right:-28px;width:28px;background:#08283f;pointer-events:none}
@media (max-width:900px){#MainContent .sq-refine-v3-sidebar__title{width:100%!important;margin-right:0!important;padding-right:12px!important}#MainContent .sq-refine-v3-sidebar__title::after{display:none!important}}
</style>
{% endif %}
