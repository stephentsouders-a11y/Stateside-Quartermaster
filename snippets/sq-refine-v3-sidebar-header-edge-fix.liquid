<script data-sq-afg-three-filter-lock data-revision="afg-three-groups-20260911-v2">
(function(){
  var main=document.getElementById('MainContent');if(!main)return;
  var params=new URLSearchParams(location.search),core=document.querySelector('script[data-sq-refine-v3]'),current=core&&core.dataset.currentHandle||'';
  if(current!=='armed-forces-gear'&&params.get('sq_root')!=='armed-forces-gear')return;
  function clean(v){return String(v||'').replace(/\s+/g,' ').trim().toLowerCase()}
  function role(d){var s=clean(d.querySelector(':scope > summary')&&d.querySelector(':scope > summary').textContent);if(/branch|service/.test(s))return'branch';if(/availability/.test(s))return'availability';if(/(?:product\s*)?type/.test(s))return'type';return''}
  function setTitle(d,title){if(!d)return;var s=d.querySelector(':scope > summary');if(s&&s.textContent!==title)s.textContent=title}
  function enforce(){
    var side=main.querySelector('.sq-refine-v3-sidebar');if(!side)return false;
    var groups=[].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group')),keep={};
    groups.forEach(function(d){var r=role(d);if(!r||keep[r])d.remove();else keep[r]=d});
    setTitle(keep.branch,'Shop by Branch');setTitle(keep.availability,'Availability');setTitle(keep.type,'Shop by Type');
    var ordered=[keep.branch,keep.availability,keep.type].filter(Boolean),currentGroups=[].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group'));
    var same=currentGroups.length===ordered.length&&ordered.every(function(d,i){return currentGroups[i]===d});
    if(!same)ordered.forEach(function(d){side.appendChild(d)});
    side.dataset.sqAfgThreeFilterLock=ordered.length===3?'true':'incomplete';
    return ordered.length===3
  }
  var tries=0,t=setInterval(function(){tries++;if(enforce()||tries>160)clearInterval(t)},50);
  var mo=new MutationObserver(function(){enforce()});mo.observe(main,{childList:true,subtree:true});
  setTimeout(function(){enforce();mo.disconnect()},12000);
})();
</script>
<script data-sq-tactical-color-429-retry data-revision="tactical-color-429-retry-20260911-v1">
(function(){
  var params=new URLSearchParams(location.search),core=document.querySelector('script[data-sq-refine-v3]'),current=core&&core.dataset.currentHandle||'';
  if(current!=='tactical-gear'&&params.get('sq_root')!=='tactical-gear')return;
  if(window.__sqTacticalColorFetchRetry)return;window.__sqTacticalColorFetchRetry=true;
  var nativeFetch=window.fetch.bind(window);
  function sleep(ms){return new Promise(function(resolve){setTimeout(resolve,ms)})}
  function isColorData(input){try{var u=new URL(typeof input==='string'?input:input.url,location.origin);return u.searchParams.get('view')==='sq-tactical-color-data'}catch(_){return false}}
  window.fetch=function(input,init){
    if(!isColorData(input))return nativeFetch(input,init);
    return (async function(){
      var response,last;
      for(var attempt=0;attempt<7;attempt++){
        response=await nativeFetch(input,init);last=response;
        if(response.status!==429)return response;
        var retryAfter=Number(response.headers.get('Retry-After')||0),delay=Math.max(retryAfter*1000,Math.min(12000,1000*Math.pow(2,attempt)));
        if(attempt<6)await sleep(delay+Math.floor(Math.random()*350));
      }
      return last;
    })();
  };
})();
</script>
<script data-sq-tactical-color-noise-cleanup data-revision="tactical-color-noise-20260911-v1">
(function(){
  var main=document.getElementById('MainContent');if(!main)return;
  var params=new URLSearchParams(location.search),core=document.querySelector('script[data-sq-refine-v3]'),current=core&&core.dataset.currentHandle||'';
  if(current!=='tactical-gear'&&params.get('sq_root')!=='tactical-gear')return;
  var bad=/^(?:captain\b|major\b|colonel\b|private\b|sergeant\b|e\d+\s|o\d+\s|only ptt\b|empty bag\b|full set\b|\d+pc\s)/i;
  function scrub(){
    var group=main.querySelector('[data-sq-tactical-colors]');if(!group)return false;
    var changed=false;
    group.querySelectorAll('[data-sq-tactical-color-label]').forEach(function(row){
      var input=row.querySelector('input'),label=String(row.dataset.sqTacticalColorLabel||(input&&input.value)||'').replace(/\s+/g,' ').trim();
      if(bad.test(label)){row.remove();changed=true;}
    });
    var remaining=group.querySelectorAll('[data-sq-tactical-color-label]').length;
    if(group.dataset.sqTacticalColorReady==='true')group.dataset.optionCount=String(remaining);
    group.dataset.sqTacticalColorNoiseClean='true';
    if(changed)main.dataset.sqTacticalColorNoisePruned='true';
    return true;
  }
  var queued=false;
  var mo=new MutationObserver(function(){if(queued)return;queued=true;queueMicrotask(function(){queued=false;scrub();});});
  mo.observe(main,{childList:true,subtree:true});
  scrub();
})();
</script>
