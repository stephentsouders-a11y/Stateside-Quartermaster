{% doc %}
Ensures the V3 Refine Products navy title bar reaches both rounded top corners while the filter body stays white throughout scrolling, preserving the sticky desktop sidebar. Armed Forces Gear is hard-locked to Shop by Branch, Availability, and Type in that order.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
{% render 'sq-refine-v3-sidebar-polish-rescue' %}
{% render 'sq-refine-v3-literature-author-safety' %}
{% render 'sq-refine-v3-literature-author-filter' %}
{% render 'sq-refine-v3-literature-author-tag-authority' %}
{% render 'sq-refine-v3-literature-author-visible-state' %}
{% render 'sq-refine-v3-literature-dedupe' %}
{% render 'sq-refine-v3-firearm-make-model' %}
{% render 'sq-refine-v3-structural-link-repair' %}
{% render 'sq-refine-v3-type-family-persistence' %}
{% render 'sq-refine-v3-visible-grid-rescue' %}
{% render 'sq-refine-v3-education-visibility-rescue' %}
{% render 'sq-refine-v3-taxonomy-normalizer' %}
{% render 'sq-refine-v3-release-taxonomy-cleanup' %}
{% render 'sq-refine-v3-button01-accessories-fix' %}
{% render 'sq-refine-v3-button01-filter-owner-v2' %}
{% render 'sq-refine-v3-button01-availability-v3' %}
{% render 'sq-refine-v3-tactical-color-pattern' %}
<style data-sq-refine-v3-header-edge-fix>
/* Paint the actual scrollport white; a viewport-sized overlay scrolls away. */
#MainContent .sq-refine-v3-sidebar{
  background-color:#fff!important;
  background-image:none!important;
  scrollbar-gutter:auto!important;
  scrollbar-width:none!important;
}
#MainContent .sq-refine-v3-sidebar::before{
  content:none!important;
  display:none!important;
}
#MainContent .sq-refine-v3-sidebar>*{position:relative;z-index:1}
#MainContent .sq-refine-v3-sidebar::-webkit-scrollbar{width:0!important;height:0!important;display:none!important}
#MainContent .sq-refine-v3-sidebar__title{
  position:relative!important;z-index:2!important;display:flex!important;align-items:center!important;
  width:100%!important;max-width:none!important;min-height:40px!important;box-sizing:border-box!important;
  margin:0!important;padding:0 12px!important;border-radius:9px 9px 0 0!important;background:#08283f!important;color:#fff!important;
}
#MainContent .sq-refine-v3-sidebar__title::after{display:none!important;content:none!important}
@media (min-width:901px){#MainContent.sq-refine-v3-active .sq-refine-v3-sidebar{position:sticky!important;top:18px!important}}
@media (max-width:900px){#MainContent.sq-refine-v3-active .sq-refine-v3-sidebar{position:static!important}}
</style>
{% if collection.handle == 'armed-forces-gear' %}
<script data-sq-afg-three-filter-lock>
(function(){
  var main=document.getElementById('MainContent');if(!main)return;
  function clean(v){return String(v||'').replace(/\s+/g,' ').trim().toLowerCase()}
  function role(d){var s=clean(d.querySelector(':scope > summary')&&d.querySelector(':scope > summary').textContent);if(/branch|service/.test(s))return'branch';if(/availability/.test(s))return'availability';if(/(?:product\s*)?type/.test(s))return'type';return''}
  function enforce(){var side=main.querySelector('.sq-refine-v3-sidebar');if(!side)return false;var groups=[].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group')),keep={};groups.forEach(function(d){var r=role(d);if(!r||keep[r])d.remove();else keep[r]=d});if(keep.branch)keep.branch.querySelector(':scope > summary').textContent='Shop by Branch';if(keep.availability)keep.availability.querySelector(':scope > summary').textContent='Availability';if(keep.type)keep.type.querySelector(':scope > summary').textContent='Type';['branch','availability','type'].forEach(function(r){if(keep[r])side.appendChild(keep[r])});side.dataset.sqAfgThreeFilterLock='true';return !!(keep.branch&&keep.availability&&keep.type)}
  var tries=0,t=setInterval(function(){tries++;if(enforce()||tries>160)clearInterval(t)},50);var mo=new MutationObserver(function(){enforce()});mo.observe(main,{childList:true,subtree:true});
})();
</script>
{% endif %}
{% endif %}
