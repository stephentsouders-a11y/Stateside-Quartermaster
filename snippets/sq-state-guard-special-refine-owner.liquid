<script data-sq-state-guard-special-refine-owner data-ohio-full-refine-owner>
(function(){
  document.documentElement.dataset.sqStateGuardRefineOwner='global-ohio-full';
  if(window.__sqOhioFullRefineV1)return;window.__sqOhioFullRefineV1=true;
  var main=document.getElementById('MainContent');if(!main)return;
  var products=[],hydrated=false,building=false;
  var CATEGORY_ORDER=['Uniforms','Insignia','Headwear','Patches','Footwear','Apparel','Equipment & Field Gear','Insignia & Identification','Tactical Gear & Body Armor'];
  var PARAMS={category:'sq_oh_category',subcategory:'sq_oh_subcategory',type:'sq_oh_type',maker:'sq_oh_maker',color:'sq_oh_color_pattern',availability:'sq_oh_availability'};
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function norm(v){return clean(v).toLowerCase().replace(/[\u2019']/g,'').replace(/&/g,' and ').replace(/[_-]+/g,' ').replace(/[^a-z0-9]+/g,' ').trim()}
  function esc(v){return clean(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function tags(p){return Array.isArray(p&&p.tags)?p.tags:[]}
  function text(p){return norm([p&&p.title,p&&p.product_type,tags(p).join(' ')].join(' '))}
  function hidden(p){var t=norm(p&&p.product_type);return !p||!p.handle||t==='options hidden product'}
  function inStock(p){var vs=Array.isArray(p&&p.variants)?p.variants:[];return !vs.length||vs.some(function(v){return v&&v.available===true})}
  function image(p){var x=p&&(p.featured_image||p.image||(p.images&&p.images[0]));if(typeof x==='string')return x;return clean(x&&(x.src||x.url))}
  function productHref(p){var u=new URL('/products/'+encodeURIComponent(clean(p.handle)),location.origin),pv=new URL(location.href).searchParams.get('preview_theme_id');if(pv)u.searchParams.set('preview_theme_id',pv);return u.pathname+(u.search?'?'+u.searchParams.toString():'')}
  function primaryCategory(p){var s=text(p);if(/\b(flag|patch|patches|tab|tabs|scroll|scrolls)\b/.test(s))return'Patches';if(/\b(rank|insignia|nametape|name tape|nameplate|name plate|badge|dog tag|shoulder board|identification|pin back|unit crest|branch insignia|cap device|ribbon|medal|award|decoration)\b/.test(s))return'Insignia';if(/\b(patrol cap|service cap|garrison cap|cover|beret|beanie|boonie|headwear|watch cap|hat|balaclava|neck gaiter|gaiter)\b/.test(s))return'Headwear';if(/\b(boot|boots|sock|socks|belt|blouser|blousing|glove|gloves|dress shoe|uniform shoe)\b/.test(s))return'Footwear';if(/\b(pt|physical training|combat uniform|field uniform|uniform coat|uniform pants|uniform trouser|service uniform|dress uniform|asu|agsu|ocp|acu|ihwcu|undershirt|outerwear|parka|fleece jacket|windbreaker|scrub top|scrub pants|scrubs)\b/.test(s)||s.indexOf('sq verified uniforms')!==-1)return'Uniforms';if(/\b(t-shirt|t shirt|tee|polo|hoodie|sweatshirt|apparel|merchandise)\b/.test(s))return'Apparel';return'Equipment & Field Gear'}
  function tactical(p){var s=text(p);return /\b(body armor|body armour|ballistic|plate carrier|armor carrier|armour carrier|chest rig|load carriage|molle|tactical vest|tactical belt|battle belt|helmet|armor plate|armour plate|plate bag|pouch|pack|hydration|field gear|tactical gear|ifak|tourniquet|flashlight|weapon light)\b/.test(s)}
  function insigniaIdentification(p){var s=text(p);return /\b(rank|insignia|nametape|name tape|nameplate|name plate|badge|dog tag|identification|pin back|unit crest|branch insignia|cap device|ribbon|medal|award|decoration|shoulder board|shoulder mark)\b/.test(s)}
  function matchesCategory(p,label){if(label==='Insignia & Identification')return insigniaIdentification(p);if(label==='Tactical Gear & Body Armor')return tactical(p);return primaryCategory(p)===label}
  function subcategoryFor(p,category){var s=text(p),c=category||primaryCategory(p);if(c==='Uniforms'){if(/\b(pt|physical training)\b/.test(s))return'PT Uniform';if(/\b(ocp|acu|ihwcu|combat uniform|field uniform)\b/.test(s))return'OCP / Field Uniform';if(/\b(asu|agsu|service uniform|dress uniform|dress shirt|service shirt)\b/.test(s))return'Service / Dress Uniform';if(/\b(scrub top|scrub pants|scrubs)\b/.test(s))return'Medical / Utility Uniforms';if(/\b(cold weather|fleece|parka|outerwear|windbreaker|all weather|jacket)\b/.test(s))return'Cold Weather & Outerwear';if(/undershirt|under shirt/.test(s))return'Undershirts';return'Uniform Components'}
    if(c==='Insignia'||c==='Insignia & Identification'){if(/\brank\b|chevron|grade insignia/.test(s))return'Rank';if(/name ?tape/.test(s))return'Name Tapes';if(/name ?plate|name badge/.test(s))return'Name Plates';if(/dog tag|identification/.test(s))return'Identification & Dog Tags';if(/ribbon|medal|award|decoration/.test(s))return'Ribbons & Awards';if(/badge|device|pin back|cap device/.test(s))return'Badges & Devices';return'Unit / Branch Insignia'}
    if(c==='Headwear'){if(/patrol cap/.test(s))return'Patrol Caps';if(/service cap|garrison cap|beret/.test(s))return'Service / Dress Headwear';if(/beanie|watch cap|cold weather|balaclava|gaiter/.test(s))return'Cold Weather Headwear';if(/boonie/.test(s))return'Boonie Hats';return'Other Headwear'}
    if(c==='Patches'){if(/\bflag\b/.test(s))return'State & U.S. Flags';if(/tab|scroll/.test(s))return'Tabs & Scrolls';if(/patch|unit|shoulder/.test(s))return'Unit & Shoulder Patches';return'Other Patches'}
    if(c==='Footwear'){if(/boot/.test(s))return'Boots';if(/dress shoe|uniform shoe/.test(s))return'Dress Shoes';if(/sock/.test(s))return'Socks';if(/belt|blouser|blousing/.test(s))return'Belts & Blousing';if(/glove/.test(s))return'Gloves';return'Uniform Accessories'}
    if(c==='Apparel'){if(/polo/.test(s))return'Polos';if(/hoodie|sweatshirt/.test(s))return'Hoodies & Sweatshirts';if(/t-shirt|t shirt|tee|shirt/.test(s))return'T-Shirts & Casual Shirts';return'Other Merchandise'}
    if(c==='Tactical Gear & Body Armor'){if(/body armor|body armour|armor plate|armour plate|ballistic plate/.test(s))return'Body Armor';if(/plate carrier|armor carrier|armour carrier|tactical vest/.test(s))return'Plate Carriers & Vests';if(/chest rig|load carriage/.test(s))return'Chest Rigs & Load Carriage';if(/helmet/.test(s))return'Helmets';if(/battle belt|tactical belt|duty belt/.test(s))return'Tactical Belts & Platforms';if(/pack|pouch|molle/.test(s))return'Tactical Packs & Pouches';if(/medical|ifak|tourniquet/.test(s))return'Medical & IFAK';if(/flashlight|weapon light|lighting/.test(s))return'Tactical Lighting';return'Other Tactical Gear'}
    if(/medical|ifak|tourniquet/.test(s))return'Medical & IFAK';if(/pack|pouch/.test(s))return'Packs & Pouches';if(/watch|wristwatch|g-shock|g shock/.test(s))return'Watches & Timepieces';if(/flashlight|lighting|lantern|headlamp/.test(s))return'Flashlights & Lighting';if(/field|tactical|carrier|canteen|hydration|molle/.test(s))return'Field & Tactical Gear';return'Other Equipment'}
  function allSubcategories(p,cats){var out=[];if(cats&&cats.length){cats.forEach(function(c){if(matchesCategory(p,c)){var x=subcategoryFor(p,c);if(x&&!out.some(function(y){return norm(y)===norm(x)}))out.push(x)}})}else{var x=subcategoryFor(p,primaryCategory(p));if(x)out.push(x);if(insigniaIdentification(p)){var y=subcategoryFor(p,'Insignia & Identification');if(y&&!out.some(function(z){return norm(z)===norm(y)}))out.push(y)}if(tactical(p)){var q=subcategoryFor(p,'Tactical Gear & Body Armor');if(q&&!out.some(function(z){return norm(z)===norm(q)}))out.push(q)}}return out}
  function appearanceValues(p){var out=[],seen={};function add(v){v=clean(v);var k=norm(v);if(!v||!k||seen[k]||k==='default title'||/^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|6xl|small|medium|large|one size|standard)$/.test(k))return;var ok=/(black|white|grey|gray|charcoal|red|blue|navy|green|olive|foliage|coyote|tan|khaki|brown|sand|gold|silver|orange|yellow|pink|purple|maroon|burgundy|teal|aqua|multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a tacs|tiger stripe|lizard|camo|camouflage|pattern|beige)/.test(k);if(!ok)return;seen[k]=1;out.push(v)}tags(p).forEach(function(t){var raw=clean(t),m=raw.match(/^(?:sq\s+)?(?:color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m)add(m[1]);else add(raw)});var opts=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];opts.forEach(function(o,i){var name=clean(typeof o==='string'?o:(o&&o.name)||'');if(!/color|colour|pattern|camo|camouflage/i.test(name))return;vs.forEach(function(v){add(v&&v['option'+(i+1)])})});return out}
  function listParam(name){var q=new URLSearchParams(location.search),out=[];q.getAll(name).forEach(function(v){v=clean(v);if(v&&!out.some(function(x){return norm(x)===norm(v)}))out.push(v)});return out}
  function state(){return{category:listParam(PARAMS.category),subcategory:listParam(PARAMS.subcategory),type:listParam(PARAMS.type),maker:listParam(PARAMS.maker),color:listParam(PARAMS.color),availability:listParam(PARAMS.availability)}}
  function anyState(st){return Object.keys(st).some(function(k){return st[k]&&st[k].length})}
  function anyNorm(list,value){var nv=norm(value);return (list||[]).some(function(x){return norm(x)===nv})}
  function matches(p,st,skip){if(hidden(p))return false;if(skip!=='category'&&st.category.length&&!st.category.some(function(c){return matchesCategory(p,c)}))return false;if(skip!=='subcategory'&&st.subcategory.length&&!allSubcategories(p,st.category).some(function(x){return anyNorm(st.subcategory,x)}))return false;if(skip!=='type'&&st.type.length&&!anyNorm(st.type,clean(p.product_type)||'Other'))return false;if(skip!=='maker'&&st.maker.length&&!anyNorm(st.maker,clean(p.vendor)||'Unknown'))return false;if(skip!=='color'&&st.color.length&&!appearanceValues(p).some(function(x){return anyNorm(st.color,x)}))return false;if(skip!=='availability'&&st.availability.length){var a=inStock(p)?'In stock':'Out of stock';if(!anyNorm(st.availability,a))return false}return true}
  function countWhere(fn){var n=0;products.forEach(function(p){if(fn(p))n++});return n}
  function sortedMap(map){return Object.keys(map).map(function(k){return map[k]}).sort(function(a,b){return a.label.localeCompare(b.label,undefined,{numeric:true,sensitivity:'base'})})}
  function rowsFor(group,st){var rows=[],map={};if(group==='category'){CATEGORY_ORDER.forEach(function(label){rows.push({label:label,count:countWhere(function(p){return matchesCategory(p,label)&&matches(p,st,'category')})})});return rows}
    products.forEach(function(p){if(!matches(p,st,group))return;var vals=[];if(group==='subcategory')vals=allSubcategories(p,st.category);else if(group==='type')vals=[clean(p.product_type)||'Other'];else if(group==='maker')vals=[clean(p.vendor)||'Unknown'];else if(group==='color')vals=appearanceValues(p);else if(group==='availability')vals=[inStock(p)?'In stock':'Out of stock'];vals.forEach(function(v){v=clean(v);var k=norm(v);if(!k)return;if(!map[k])map[k]={label:v,count:0};map[k].count++})});rows=sortedMap(map);if(group==='availability'){var order=['In stock','Out of stock'];rows.sort(function(a,b){return order.indexOf(a.label)-order.indexOf(b.label)})}return rows}
  function choice(group,row,st){var active=anyNorm(st[group],row.label);return '<div class="sq-ohio-refine-choice" data-active="'+(active?'true':'false')+'"><input type="checkbox" data-sq-ohio-group="'+esc(group)+'" value="'+esc(row.label)+'" aria-label="'+esc(row.label)+'"'+(active?' checked':'')+'><span>'+esc(row.label)+'</span><small>'+row.count+' '+(row.count===1?'item':'items')+'</small></div>'}
  function groupHtml(title,group,rows,st,open){if(!rows.length)return'';return '<details class="sq-ohio-refine-group"'+(open?' open':'')+'><summary>'+esc(title)+'</summary><div class="sq-ohio-refine-list">'+rows.map(function(r){return choice(group,r,st)}).join('')+'</div></details>'}
  function sidebar(){var sides=[].slice.call(main.querySelectorAll('.sq-global-refine-sidebar'));if(!sides.length)return null;sides.sort(function(a,b){var av=getComputedStyle(a),bv=getComputedStyle(b),as=(av.display!=='none'&&av.visibility!=='hidden')?1:0,bs=(bv.display!=='none'&&bv.visibility!=='hidden')?1:0;return bs-as});var keep=sides[0];sides.slice(1).forEach(function(s){s.remove()});return keep}
  function writeParam(group,value,on){var key=PARAMS[group],u=new URL(location.href),vals=[];u.searchParams.getAll(key).forEach(function(v){v=clean(v);if(v&&!vals.some(function(x){return norm(x)===norm(v)}))vals.push(v)});if(on&&!vals.some(function(x){return norm(x)===norm(value)}))vals.push(value);if(!on)vals=vals.filter(function(x){return norm(x)!==norm(value)});u.searchParams.delete(key);vals.forEach(function(v){u.searchParams.append(key,v)});u.searchParams.delete('page');history.pushState({sqOhioRefine:true},'',u.pathname+(u.search?'?'+u.searchParams.toString():''));renderAll()}
  function bindSidebar(side){if(side.dataset.sqOhioBound==='true')return;side.dataset.sqOhioBound='true';side.addEventListener('change',function(ev){var input=ev.target&&ev.target.closest&&ev.target.closest('input[data-sq-ohio-group]');if(!input||!side.contains(input))return;ev.stopPropagation();writeParam(input.dataset.sqOhioGroup,input.value,input.checked)})}
  function renderSidebar(){if(!hydrated||building)return false;var side=sidebar();if(!side)return false;building=true;try{var st=state();side.dataset.sqOhioRefine='true';side.removeAttribute('hidden');side.removeAttribute('aria-hidden');side.style.removeProperty('display');side.style.removeProperty('visibility');bindSidebar(side);var html='<h2 class="sq-global-refine-sidebar__title" tabindex="0">Refine Products</h2>';html+=groupHtml('Shop by Category','category',rowsFor('category',st),st,true);html+=groupHtml('Shop by Subcategory','subcategory',rowsFor('subcategory',st),st,false);html+=groupHtml('Shop by Type','type',rowsFor('type',st),st,false);html+=groupHtml('Shop by Manufacturers','maker',rowsFor('maker',st),st,false);html+=groupHtml('Shop by Color / Pattern','color',rowsFor('color',st),st,false);html+=groupHtml('Availability','availability',rowsFor('availability',st),st,false);side.innerHTML=html;return true}finally{building=false}}
  function removeProducts(){var old=main.querySelector('[data-sq-ohio-taxonomy-products]');if(old)old.remove();main.classList.remove('sq-ohio-taxonomy-active')}
  function summaryLabel(st){var a=[];if(st.category.length)a.push(st.category.join(', '));if(st.subcategory.length)a.push(st.subcategory.join(', '));if(st.type.length)a.push(st.type.join(', '));if(st.maker.length)a.push(st.maker.join(', '));if(st.color.length)a.push(st.color.join(', '));if(st.availability.length)a.push(st.availability.join(', '));return a.length?a.join(' / '):'Ohio State Guard Products'}
  function renderProducts(){if(!hydrated)return;var st=state();if(!anyState(st)){removeProducts();return}var out=products.filter(function(p){return matches(p,st,'')});removeProducts();var s=document.createElement('section');s.dataset.sqOhioTaxonomyProducts='true';s.className='sq-ohio-products';var h='<div class="sq-ohio-products__wrap"><div class="sq-ohio-products__head"><h2>'+esc(summaryLabel(st))+'</h2><p>'+out.length+' '+(out.length===1?'product':'products')+'</p></div>';if(out.length){h+='<div class="sq-ohio-products__grid">';out.forEach(function(p){var src=image(p);h+='<a class="sq-ohio-product" href="'+esc(productHref(p))+'"><span class="sq-ohio-product__media">'+(src?'<img src="'+esc(src)+'" alt="'+esc(p.title)+'" loading="lazy" decoding="async">':'')+'</span><span class="sq-ohio-product__copy"><strong>'+esc(p.title)+'</strong>'+(p.vendor?'<span class="sq-ohio-product__vendor">'+esc(p.vendor)+'</span>':'')+'</span></a>'});h+='</div>'}else h+='<p>No products match the selected refinements.</p>';h+='</div>';s.innerHTML=h;var side=sidebar(),layout=side&&side.closest('.sq-global-refine-layout,.sq-state-guard-refine-layout');if(layout)layout.insertBefore(s,side.nextSibling);else main.appendChild(s);main.classList.add('sq-ohio-taxonomy-active')}
  function renderAll(){renderSidebar();renderProducts()}
  async function hydrate(){var out=[],seen={};for(var page=1;page<=8;page++){try{var r=await fetch('/collections/state-guard-series-ohio/products.json?limit=250&page='+page,{credentials:'same-origin'});if(!r.ok)break;var j=await r.json(),a=j&&Array.isArray(j.products)?j.products:[];a.forEach(function(p){if(hidden(p)||seen[p.handle])return;seen[p.handle]=1;out.push(p)});if(a.length<250)break}catch(_){break}}products=out;hydrated=true;var prior=window.__sqDirectFacetUniverse||{};window.__sqDirectFacetUniverse={products:out,maker:prior.maker||[],color:prior.color||[]};window.dispatchEvent(new CustomEvent('sq:refine-universe-ready',{detail:window.__sqDirectFacetUniverse}));renderAll();[100,300,700,1400,2600,5000].forEach(function(ms){setTimeout(renderAll,ms)})}
  window.addEventListener('popstate',function(){setTimeout(renderAll,0)});
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',hydrate,{once:true});else hydrate();
})();
</script>
