{% if request.page_type == 'collection' %}
{% if collection.handle contains 'state-guard-series-' or collection.handle == 'new-jersey-state-guard-naval-militia' %}
<style data-sq-state-guard-special-refine-owner>
#MainContent .sq-global-refine-sidebar{display:none!important;visibility:hidden!important;pointer-events:none!important}
</style>
<script data-sq-state-guard-special-refine-owner>
(function(){
  if(window.__sqStateGuardSpecialRefineOwner)return;window.__sqStateGuardSpecialRefineOwner=true;
  var main=document.getElementById('MainContent');if(!main)return;
  var innerDesc=Object.getOwnPropertyDescriptor(Element.prototype,'innerHTML');
  function stabilizeSpecializedSide(){
    var side=main.querySelector('.sqsg-refine-sidebar');
    if(!side||side.dataset.sqsgStableOwner==='true'||!innerDesc||!innerDesc.get||!innerDesc.set)return;
    side.dataset.sqsgStableOwner='true';
    side.__sqsgLastMarkup=innerDesc.get.call(side);
    try{
      Object.defineProperty(side,'innerHTML',{
        configurable:true,
        get:function(){return innerDesc.get.call(this)},
        set:function(v){var next=String(v);if(this.__sqsgLastMarkup===next)return;innerDesc.set.call(this,next);this.__sqsgLastMarkup=next;}
      });
    }catch(_){return}
    side.addEventListener('change',function(ev){
      var input=ev.target&&ev.target.closest&&ev.target.closest('input[data-sqsg-refine-href]');
      if(!input||!side.contains(input))return;
      ev.stopImmediatePropagation();
      ev.stopPropagation();
      var href=input.dataset.sqsgRefineHref;
      if(href)location.assign(href);
    },true);
  }
  function unwrapLegacyGlobal(){
    var sides=[].slice.call(main.querySelectorAll('.sq-global-refine-sidebar'));
    sides.forEach(function(side){
      var layout=side.closest('.sq-global-refine-layout');
      if(layout&&layout.parentNode){
        var body=layout.querySelector(':scope > .sq-global-refine-main'),parent=layout.parentNode;
        if(body){while(body.firstChild)parent.insertBefore(body.firstChild,layout)}
        layout.remove();
      }else side.remove();
    });
    stabilizeSpecializedSide();
    document.documentElement.dataset.sqStateGuardRefineOwner='specialized';
  }
  var queued=false;
  function queue(){if(queued)return;queued=true;requestAnimationFrame(function(){queued=false;unwrapLegacyGlobal()})}
  unwrapLegacyGlobal();
  new MutationObserver(queue).observe(main,{childList:true,subtree:true});
  [50,150,350,700,1400,2600,5000,8000].forEach(function(ms){setTimeout(unwrapLegacyGlobal,ms)});
})();
</script>
{% endif %}
{% endif %}
