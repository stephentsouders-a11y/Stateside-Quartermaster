{% doc %}
Keeps the visible product-results surface synchronized with active Stateside Quartermaster Manufacturer/Color refinement parameters, including client-side URL changes. For Manufacturer filtering it first reuses Shopify's filtered main-section HTML, avoiding slow catalog scans and stale infinite-scroll pages. JSON product data remains a fallback and supports custom Color/Pattern filtering.
{% enddoc %}
{% if request.page_type == 'collection' %}
<script data-sq-filtered-product-surface-guard-v2 data-handle="{{ collection.handle | escape }}">
(function(){
  if(window.__sqFilteredProductSurfaceGuardV2)return;window.__sqFilteredProductSurfaceGuardV2=true;
  var boot=document.currentScript,handle=boot&&boot.dataset.handle||'',main=document.getElementById('MainContent');if(!main||!handle)return;
  var military=/^(?:products-built-for-the-line-u-s-(?:army|navy|air-force|marine-corps|coast-guard|space-force)|army-national-guard-series|air-national-guard-series|state-guard-series|rotc-series|jrotc-series|military-schools-academies)$/;if(military.test(handle))return;
  function c(v){return String(v==null?'':v).trim()}
  function n(v){return c(v).toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ')}
  function e(v){return c(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function filters(){var q=new URLSearchParams(location.search);return{maker:c(q.get('sq_maker')||q.get('filter.p.vendor')),color:c(q.get('sq_color_pattern'))}}
  function key(f){return n(f.maker)+'|'+n(f.color)}
  function hidden(p){var t=n(p&&p.product_type);return !p||t==='options hidden product'||t==='options_hidden_product'}
  function colorish(v){var s=n(v);if(!s||s==='default title'||/^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|6xl|small|medium|large|one size|standard)$/.test(s))return false;return /black|white|grey|gray|charcoal|red|blue|navy|green|olive|foliage|coyote|tan|khaki|brown|sand|gold|silver|orange|yellow|pink|purple|maroon|burgundy|teal|aqua|multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a[- ]?tacs|tiger stripe|lizard|camo|camouflage|pattern|beige/.test(s)}
  function colors(p){var out=[],seen={};function add(v){v=c(v);var k=n(v);if(!v||seen[k]||!colorish(v))return;seen[k]=1;out.push(v)};(Array.isArray(p&&p.tags)?p.tags:[]).forEach(function(t){var raw=c(t),m=raw.match(/^(?:sq\s+)?(?:color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m)add(m[1]);else if(colorish(raw))add(raw)});var opts=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];opts.forEach(function(o,i){var name=c(typeof o==='string'?o:(o&&o.name)||'');if(/color|colour|pattern|camo|camouflage/i.test(name))vs.forEach(function(v){add(v&&v['option'+(i+1)])})});return out}
  function matches(p,f){if(hidden(p))return false;if(f.maker&&n(p.vendor)!==n(f.maker))return false;if(f.color&&!colors(p).some(function(x){return n(x)===n(f.color)}))return false;return true}
  var cache=null,inflight=null,lastRendered='',sectionInflight=null;
  async function load(){if(window.__sqDirectFacetUniverse&&Array.isArray(window.__sqDirectFacetUniverse.products)&&window.__sqDirectFacetUniverse.products.length)return window.__sqDirectFacetUniverse.products;if(cache)return cache;if(inflight)return inflight;inflight=(async function(){var out=[],seen={};for(var pg=1;pg<=24;pg++){var r;try{r=await fetch('/collections/'+encodeURIComponent(handle)+'/products.json?limit=250&page='+pg,{credentials:'same-origin'})}catch(_){break}if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(!hidden(p)&&p.handle&&!seen[p.handle]){seen[p.handle]=1;out.push(p)}});if(a.length<250)break}cache=out;inflight=null;return out})();return inflight}
  function imageOf(p){var x=(p&&p.featured_image)||(p&&p.image)||(p&&p.images&&p.images[0]);if(typeof x==='string')return x;return c(x&&(x.src||x.url))}
  function ensureStyle(){if(document.getElementById('sq-filtered-product-surface-guard-style'))return;var st=document.createElement('style');st.id='sq-filtered-product-surface-guard-style';st.textContent='#MainContent.sq-filtered-result-guard-active collection-component,#MainContent.sq-filtered-result-guard-active .product-grid,#MainContent.sq-filtered-result-guard-active #product-grid,#MainContent.sq-filtered-result-guard-active [data-sq-category-universe-products]:not([data-sq-filtered-product-surface-guard-products]),#MainContent.sq-filtered-result-guard-active [data-sq-custom-color-products]:not([data-sq-filtered-product-surface-guard-products]),#MainContent.sq-filtered-result-guard-active .sqbfl-products,#MainContent.sq-filtered-result-guard-active .sqsg-products,#MainContent.sq-filtered-result-guard-active .sq-type-family-products__grid{display:none!important}#MainContent.sq-filtered-result-guard-active [data-sq-filtered-product-surface-guard-products]{display:block!important}.sq-filtered-product-results .sq-custom-color-product__vendor{display:block;margin-top:5px;font-size:.82rem;opacity:.72}';document.head.appendChild(st)}
  function cleanup(){var old=main.querySelector('[data-sq-filtered-product-surface-guard-products]');if(old)old.remove();main.classList.remove('sq-filtered-result-guard-active');lastRendered=''}
  function mountCards(items,f,source){var old=main.querySelector('[data-sq-filtered-product-surface-guard-products]');if(old)old.remove();ensureStyle();main.classList.add('sq-filtered-result-guard-active');var s=document.createElement('section');s.className='sq-custom-color-products sq-filtered-product-results';s.dataset.sqFilteredProductSurfaceGuardProducts='true';s.dataset.sqCategoryUniverseProducts='true';s.dataset.sqFilterKey=key(f);s.dataset.sqFilterSource=source||'unknown';var label=[f.maker,f.color].filter(Boolean).join(' / '),h='<div class="sq-custom-color-products__wrap"><div class="sq-custom-color-products__head"><div><h2>'+e(label||'Filtered Products')+'</h2><p>'+items.length+' synchronized products. Sold-out products are included.</p></div></div>';if(items.length){h+='<div class="sq-custom-color-products__grid">';items.forEach(function(p){var src=imageOf(p);h+='<a class="sq-custom-color-product" href="/products/'+encodeURIComponent(c(p.handle))+'"><span class="sq-custom-color-product__media">'+(src?'<img src="'+e(src)+'" alt="'+e(p.title)+'" loading="lazy" decoding="async">':'')+'</span><span class="sq-custom-color-product__copy"><strong>'+e(p.title)+'</strong>'+(p.vendor?'<span class="sq-custom-color-product__vendor">'+e(p.vendor)+'</span>':'')+'</span></a>'});h+='</div>'}else h+='<p class="sq-global-refine-sidebar__empty">No products match the selected refinement.</p>';h+='</div>';s.innerHTML=h;var host=main.querySelector('.sq-global-refine-main')||main;host.insertBefore(s,host.firstChild);lastRendered=key(f);window.dispatchEvent(new CustomEvent('sq:filtered-product-surface-guard-ready',{detail:{products:items,maker:f.maker,color:f.color,source:source||'unknown'}}));return true}
  function render(ps,f){return mountCards(ps.filter(function(p){return matches(p,f)}),f,'catalog')}
  function sectionId(){var all=[].slice.call(document.querySelectorAll('[id^="shopify-section-template--"]'));var sec=all.find(function(x){return /__main$/.test(x.id)&&(x.querySelector('collection-component')||x.querySelector('.product-grid')||x.querySelector('product-card'))});return sec?sec.id.replace(/^shopify-section-/,''):''}
  function sectionItems(html){var d=new DOMParser().parseFromString(html,'text/html'),seen={},out=[];[].slice.call(d.querySelectorAll('collection-component a[href*="/products/"],.product-grid a[href*="/products/"],product-card a[href*="/products/"]')).forEach(function(a){var m='';try{m=new URL(a.getAttribute('href')||a.href,location.origin).pathname.match(/^\/products\/([^/?#]+)/)?.[1]||''}catch(_){return}if(!m||seen[m])return;seen[m]=1;var card=a.closest('product-card,li,article,.card,.product-card')||a,img=card.querySelector('img')||a.querySelector('img'),src=img&&c(img.getAttribute('src')||img.getAttribute('data-src')||img.getAttribute('srcset')||''),title=c((img&&img.getAttribute('alt'))||a.textContent||m);if(src&&src.indexOf(',')>-1)src=c(src.split(',')[0].trim().split(/\s+/)[0]);out.push({handle:decodeURIComponent(m),title:title||m,image:src})});return out}
  async function renderFilteredSection(f){if(!f.maker||f.color)return false;if(sectionInflight)return sectionInflight;sectionInflight=(async function(){var sid=sectionId();if(!sid)return false;var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.delete('filter.v.availability');u.searchParams.set('filter.p.vendor',f.maker);u.searchParams.set('sq_maker',f.maker);u.searchParams.set('section_id',sid);var r;try{r=await fetch(u.pathname+'?'+u.searchParams.toString(),{credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}})}catch(_){return false}if(!r.ok)return false;var items=sectionItems(await r.text());if(!items.length)return false;return mountCards(items,f,'shopify-section')})().finally(function(){sectionInflight=null});return sectionInflight}
  var enforcing=false,pending=false;
  async function enforce(){if(enforcing){pending=true;return}enforcing=true;try{var f=filters(),k=key(f);if(!f.maker&&!f.color){cleanup();return}var existing=main.querySelector('[data-sq-filtered-product-surface-guard-products]');if(existing&&lastRendered===k)return;if(await renderFilteredSection(f))return;var ps=await load();if(!ps||!ps.length)return;render(ps,f)}finally{enforcing=false;if(pending){pending=false;setTimeout(enforce,40)}}}
  function schedule(ms){setTimeout(enforce,ms||0)}
  function start(){schedule(120);schedule(700);schedule(1800);window.addEventListener('sq:refine-universe-ready',function(){schedule(40)});window.addEventListener('sq:refine-results-ready',function(){schedule(70)});window.addEventListener('sq:refine-controls-change',function(){schedule(20)});window.addEventListener('popstate',function(){schedule(50)});var last=location.search;setInterval(function(){if(location.search!==last){last=location.search;schedule(60)}},200)}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
})();
</script>
{% endif %}