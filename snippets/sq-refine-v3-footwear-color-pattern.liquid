{% doc %}
Adds a functional Shop by Color / Pattern group to the Footwear, Gloves & Eyewear Refine V3 sidebar when Shopify's native filters do not expose one. Values are derived from real product Color/Colour/Pattern/Camo options and the matching cards are rendered from the collection's native alternate product view.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle == 'footwear-gloves-eyewear' %}
<script data-sq-refine-v3-footwear-color-pattern data-revision="20260911-v1">
(function(){
  if(window.__sqFootwearColorPattern)return;window.__sqFootwearColorPattern=true;
  var main=document.getElementById('MainContent');if(!main)return;
  var PARAM='sq_fw_color', products=[], byHandle=new Map(), cardPool=null, renderTurn=0;
  var clean=function(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()};
  var key=function(v){return clean(v).toLowerCase().replace(/\bgray\b/g,'grey')};
  var esc=function(v){return String(v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})};
  function selected(){return Array.from(new Set(new URL(location.href).searchParams.getAll(PARAM).map(key)))}
  function relevantOptions(p){return(p.options||[]).filter(function(o){return /colou?r|pattern|camo/i.test(o.name||'')})}
  function valuesFor(p){var out=[];relevantOptions(p).forEach(function(o){(o.values||[]).forEach(function(v){var s=clean(typeof v==='string'?v:v&&v.name);if(s&&!/default title/i.test(s)&&!out.some(function(x){return key(x)===key(s)}))out.push(s)})});return out}
  async function get(url,json){var last;for(var i=0;i<4;i++){try{var r=await fetch(url,{credentials:'same-origin'});if(r.ok)return json?r.json():r.text();last=new Error('HTTP '+r.status);if([429,500,502,503,504].indexOf(r.status)<0)throw last}catch(e){last=e}await new Promise(function(res){setTimeout(res,600*(i+1)*(i+1))})}throw last||new Error('request failed')}
  async function loadProducts(){var out=[],seen=new Set();for(var page=1;page<=40;page++){var u=new URL('/collections/footwear-gloves-eyewear/products.json',location.origin);u.searchParams.set('limit','250');u.searchParams.set('page',String(page));var data=await get(u,true),batch=data&&data.products||[];batch.forEach(function(p){if(!seen.has(p.id)){seen.add(p.id);p.__sqValues=valuesFor(p);out.push(p)}});if(batch.length<250)break}return out}
  function cardHandle(card){var a=card.querySelector('a[href*="/products/"]');if(!a)return'';try{return decodeURIComponent(new URL(a.href,location.origin).pathname.split('/products/')[1]||'')}catch(_){return''}}
  async function loadCards(){if(cardPool)return cardPool;cardPool=(async function(){var out=[],seen=new Set();for(var page=1;page<=80;page++){var u=new URL('/collections/footwear-gloves-eyewear',location.origin),q=new URL(location.href).searchParams;q.forEach(function(v,k){if(k.indexOf('filter.')===0||k==='sort_by'||k==='preview_theme_id')u.searchParams.append(k,v)});u.searchParams.set('view','sq-refine-v3-products');u.searchParams.set('page',String(page));var doc=new DOMParser().parseFromString(await get(u,false),'text/html'),batch=Array.from(doc.querySelectorAll('.product-grid > .product-grid__item'));var added=0;batch.forEach(function(c){var h=cardHandle(c);if(h&&!seen.has(h)){seen.add(h);out.push(c);added++}});if(batch.length<50||!added)break}return out})().catch(function(e){cardPool=null;throw e});return cardPool}
  function pageSize(){var n=Number(new URL(location.href).searchParams.get('sq_per_page')||50);return[50,100,250].indexOf(n)>-1?n:50}
  function pageNo(){return Math.max(1,Number(new URL(location.href).searchParams.get('sq_view_page')||1)||1)}
  function urlForPage(n){var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.set('sq_view_page',String(n));return u.pathname+'?'+u.searchParams.toString()}
  function syncChecks(group){var wanted=selected();group.querySelectorAll('input[data-sq-fw-color]').forEach(function(i){i.checked=wanted.indexOf(i.value)>-1});group.dataset.active=wanted.length?'true':'false';if(wanted.length)group.open=true}
  async function render(group){var turn=++renderTurn,wanted=selected(),results=main.querySelector('.sq-refine-v3-results'),grid=results&&results.querySelector('.product-grid');if(!results||!grid)return;syncChecks(group);if(!wanted.length){location.assign((function(){var u=new URL(location.href);u.searchParams.delete(PARAM);u.searchParams.delete('sq_view_page');return u.pathname+'?'+u.searchParams.toString()})());return}main.dataset.sqFootwearColorBusy='true';try{var cards=await loadCards();if(turn!==renderTurn)return;var matched=cards.filter(function(c){var p=byHandle.get(cardHandle(c));return p&&p.__sqValues.some(function(v){return wanted.indexOf(key(v))>-1})});var size=pageSize(),pages=Math.max(1,Math.ceil(matched.length/size)),page=Math.min(pageNo(),pages);if(page!==pageNo())history.replaceState({},'',urlForPage(page));var frag=document.createDocumentFragment();matched.slice((page-1)*size,page*size).forEach(function(c){frag.appendChild(document.importNode(c,true))});grid.replaceChildren(frag);results.querySelectorAll('.sq-refine-v3-pager').forEach(function(n){n.remove()});var pager=document.createElement('nav');pager.className='sq-refine-v3-pager';pager.setAttribute('aria-label','Product pages');pager.innerHTML=(page>1?'<a href="'+esc(urlForPage(page-1))+'">Previous</a>':'')+'<span>Page '+page+'</span>'+(page<pages?'<a href="'+esc(urlForPage(page+1))+'">Next</a>':'');grid.parentElement.appendChild(pager);pager.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();history.pushState({},'',a.href);render(group)})});main.dataset.sqFootwearColorReady='true'}catch(e){main.dataset.sqFootwearColorError=clean(e&&e.message||e);console.error('[SQ Footwear Color]',e)}finally{delete main.dataset.sqFootwearColorBusy}}
  async function install(){if(main.dataset.sqRefineV3Ready!=='true'){setTimeout(install,100);return}var side=main.querySelector('.sq-refine-v3-sidebar');if(!side)return;var existing=Array.from(side.querySelectorAll('summary')).some(function(s){return /^shop by (?:color|colour)\s*\/\s*pattern$/i.test(clean(s.textContent))});if(existing){main.dataset.sqFootwearColorReady='native';return}try{products=await loadProducts();products.forEach(function(p){byHandle.set(p.handle,p)});var vals=[];products.forEach(function(p){p.__sqValues.forEach(function(v){if(!vals.some(function(x){return key(x)===key(v)}))vals.push(v)})});vals.sort(function(a,b){return a.localeCompare(b)});if(!vals.length){main.dataset.sqFootwearColorReady='no-values';return}var group=document.createElement('details');group.className='sq-refine-v3-group';group.dataset.sqFootwearColorPattern='true';group.innerHTML='<summary>Shop by Color / Pattern</summary><div class="sq-refine-v3-choices">'+vals.map(function(v){return'<label class="sq-refine-v3-choice"><input type="checkbox" data-sq-fw-color value="'+esc(key(v))+'"><span>'+esc(v)+'</span></label>'}).join('')+'</div>';var title=side.querySelector('.sq-refine-v3-sidebar__title');if(title&&title.nextSibling)side.insertBefore(group,title.nextSibling);else side.appendChild(group);syncChecks(group);group.querySelectorAll('input[data-sq-fw-color]').forEach(function(i){i.addEventListener('change',function(){var u=new URL(location.href),vals=u.searchParams.getAll(PARAM).map(key).filter(function(v){return v!==i.value});if(i.checked)vals.push(i.value);u.searchParams.delete(PARAM);Array.from(new Set(vals)).forEach(function(v){u.searchParams.append(PARAM,v)});u.searchParams.set('sq_view_page','1');history.pushState({},'',u.pathname+'?'+u.searchParams.toString());render(group)})});if(selected().length)render(group);else main.dataset.sqFootwearColorReady='true'}catch(e){main.dataset.sqFootwearColorError=clean(e&&e.message||e);console.error('[SQ Footwear Color]',e)}}
  install();window.addEventListener('popstate',function(){var g=main.querySelector('[data-sq-footwear-color-pattern]');if(g&&selected().length)render(g)});
})();
</script>
{% endif %}
