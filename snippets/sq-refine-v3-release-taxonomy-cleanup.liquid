{% doc %}
Final semantic cleanup for Refine V3. Literature receives explicit curated structural groups so raw supplier/catalog tags never appear as Branch, War/Conflict, or Topic navigation. Sta-Brite removes the invalid generic All -> /collections/all structural choice. State Guard is deliberately excluded.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<script data-sq-refine-v3-release-taxonomy-cleanup>
(function(){
  var params=new URLSearchParams(location.search),root=params.get('sq_root')||'{{ collection.handle | escape }}';
  if(root==='state-guard-series')return;
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function key(v){return clean(v).toLowerCase().replace(/[\u2019']/g,'').replace(/&/g,' ').replace(/\band\b/g,' ').replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim()}
  function detailsBy(side,title){return [].slice.call(side.querySelectorAll('details.sq-refine-v3-group')).find(function(d){return key(d.querySelector(':scope>summary')&&d.querySelector(':scope>summary').textContent)===key(title)})||null}
  function target(handle){var u=new URL('/collections/'+handle,location.origin);u.searchParams.set('sq_root',root);var preview=params.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return u.pathname+'?'+u.searchParams.toString()}
  function choice(label,handle){var l=document.createElement('label');l.className='sq-refine-v3-choice';var i=document.createElement('input');i.type='checkbox';i.dataset.kind='structural';i.dataset.target=target(handle);i.checked=location.pathname.replace(/^\/collections\//,'').replace(/\/$/,'')===handle;var s=document.createElement('span');s.textContent=label;l.appendChild(i);l.appendChild(s);i.addEventListener('change',function(){if(i.checked)location.assign(i.dataset.target);else location.assign(target(root))});return l}
  function rebuild(side,title,rows){var d=detailsBy(side,title);if(!d){d=document.createElement('details');d.className='sq-refine-v3-group';d.dataset.active='false';d.innerHTML='<summary></summary><div class="sq-refine-v3-choices"></div>';var type=detailsBy(side,'Shop by Type');if(type)type.parentNode.insertBefore(d,type);else side.appendChild(d)}d.querySelector(':scope>summary').textContent=title;var host=d.querySelector('.sq-refine-v3-choices');host.replaceChildren();rows.forEach(function(r){host.appendChild(choice(r[0],r[1]))});var active=!!host.querySelector('input:checked');d.dataset.active=active?'true':'false';if(active)d.open=true;return d}
  var LIT={
    category:[['Service Branch','literature-service-branch'],['War / Conflict','literature-war-conflict'],['Public Safety','literature-public-safety'],['Politics / Government','literature-politics-government'],['History','literature-history'],['Veterans','literature-veterans'],['Military History','literature-military-history'],['Manuals & Reference','literature-manuals-reference'],['Outdoor, Survival & Preparedness','literature-outdoor-survival-preparedness'],['Biographies & Memoirs','literature-biographies-memoirs']],
    branch:[['U.S. Army','literature-u-s-army'],['U.S. Navy','literature-u-s-navy'],['U.S. Air Force','literature-u-s-air-force'],['U.S. Marine Corps','literature-u-s-marine-corps'],['U.S. Coast Guard','literature-u-s-coast-guard'],['U.S. Space Force','literature-u-s-space-force'],['National Guard','literature-national-guard'],['Joint & U.S. Armed Forces','literature-joint-u-s-armed-forces']],
    war:[['American Civil War','literature-u-s-conflicts-american-civil-war'],['American Indian Wars','literature-u-s-conflicts-american-indian-wars'],['American Revolution','literature-u-s-conflicts-american-revolution'],['Balkans & Kosovo','literature-u-s-conflicts-balkans-kosovo'],['Barbary Wars','literature-u-s-conflicts-barbary-wars'],['Cold War','literature-u-s-conflicts-cold-war'],['French & Indian War','literature-u-s-conflicts-french-indian-war'],['Global War on Terror','literature-u-s-conflicts-global-war-on-terror'],['Gulf War & Desert Storm','literature-u-s-conflicts-gulf-war-desert-storm'],['Iraq War','literature-u-s-conflicts-iraq-war'],['Korean War','literature-u-s-conflicts-korean-war'],['Mexican-American War','literature-u-s-conflicts-mexican-american-war'],['Philippine-American War','literature-u-s-conflicts-philippine-american-war'],['Somalia & Black Hawk Down','literature-u-s-conflicts-somalia-black-hawk-down'],['Spanish-American War','literature-u-s-conflicts-spanish-american-war'],['Vietnam War','literature-u-s-conflicts-vietnam-war'],['War in Afghanistan','literature-u-s-conflicts-war-in-afghanistan'],['War of 1812','literature-u-s-conflicts-war-of-1812'],['World War I','literature-u-s-conflicts-world-war-i'],['World War II','literature-u-s-conflicts-world-war-ii']],
    topic:[['Aviation & Technical Manuals','literature-aviation-technical-manuals'],['Children’s Military & First Responder Books','literature-children-s-military-first-responder-books'],['Field Manuals & Reference Guides','literature-field-manuals-reference-guides'],['Firefighter & EMS','literature-firefighter-ems'],['Military History & Heritage','literature-military-history-heritage-curated'],['Outdoor & Preparedness','literature-outdoor-survival'],['Police & Law Enforcement','literature-police-law-enforcement'],['Strategy & Special Operations','literature-military-strategy-special-operations'],['Veterans & Military Families','literature-veterans-military-families']]
  };
  function apply(){var side=document.querySelector('#MainContent .sq-refine-v3-sidebar');if(!side)return false;
    if(root==='literature'){rebuild(side,'Shop by Category',LIT.category);rebuild(side,'Shop by Branch',LIT.branch);rebuild(side,'Shop by War / Conflict',LIT.war);rebuild(side,'Shop by Topic',LIT.topic);side.dataset.sqRefineV3LiteratureCurated='true'}
    if(root==='sta-brite-insignia'){var cat=detailsBy(side,'Shop by Category');if(cat){[].slice.call(cat.querySelectorAll('.sq-refine-v3-choice')).forEach(function(c){var i=c.querySelector('input'),label=clean(c.querySelector('span')&&c.querySelector('span').textContent);if(label==='All'||(i&&/^\/collections\/all(?:\?|$)/.test(i.dataset.target||'')))c.remove()});if(!cat.querySelector('.sq-refine-v3-choice'))cat.remove()}side.dataset.sqRefineV3StaBriteClean='true'}
    return true
  }
  var n=0,t=setInterval(function(){n++;if(apply()||n>120)clearInterval(t)},50);new MutationObserver(function(){apply()}).observe(document.getElementById('MainContent')||document.documentElement,{subtree:true,childList:true});
})();
</script>
{% endif %}
