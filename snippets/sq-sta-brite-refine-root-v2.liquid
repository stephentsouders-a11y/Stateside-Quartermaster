{% if request.page_type == 'collection' and collection.handle == 'sta-brite-insignia' %}
<style data-sq-stabrite-refine-v2>
#MainContent.sq-stabrite-refine-active collection-component,#MainContent.sq-stabrite-refine-active .product-grid,#MainContent.sq-stabrite-refine-active #product-grid{display:none!important}.sq-stabrite-old-nav-hidden{display:none!important}.sq-stabrite-refine{max-width:1480px;margin:18px auto 36px;padding:0 24px;display:grid;grid-template-columns:minmax(260px,320px) minmax(0,1fr);gap:24px;align-items:start}.sq-stabrite-refine__side{position:sticky;top:18px;border:1px solid #d5dce1;border-radius:10px;background:#fff;overflow:hidden;max-height:calc(100vh - 36px);overflow-y:auto}.sq-stabrite-refine__title{margin:0;padding:16px 18px;background:#071d2d;color:#fff;font-size:20px;font-weight:900}.sq-stabrite-refine__group{padding:12px 14px;border-top:1px solid #e1e6e9}.sq-stabrite-refine__group>summary{cursor:pointer;font-weight:900;color:#071d2d;padding:4px 0 10px}.sq-stabrite-refine__choices{display:grid;gap:7px}.sq-stabrite-refine__choice{display:flex;align-items:center;gap:9px;min-height:40px;padding:8px;border:1px solid #e0e5e8;border-radius:7px;background:#f8f9f8;color:#071d2d;font-size:12px;font-weight:800;line-height:1.2;cursor:default}.sq-stabrite-refine__choice:hover{border-color:#a91827;background:#fff}.sq-stabrite-refine__choice input{appearance:none;-webkit-appearance:none;width:18px;height:18px;min-width:18px;margin:0;border:2px solid #7b8790;border-radius:3px;background:#fff;display:grid;place-items:center;cursor:pointer}.sq-stabrite-refine__choice input:checked{border-color:#a91827;background:#a91827}.sq-stabrite-refine__choice input:checked::after{content:'×';color:#fff;font-size:16px;font-weight:900;line-height:1;transform:translateY(-1px)}.sq-stabrite-refine__choice span{min-width:0;flex:1 1 auto;pointer-events:none}.sq-stabrite-refine__choice small{flex:0 0 auto;color:#66737b;font-size:10px;font-weight:800;pointer-events:none}.sq-stabrite-refine__sizes{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.sq-stabrite-refine__sizes label{display:flex;justify-content:center;align-items:center;gap:5px;border:1px solid #dfe4e7;border-radius:7px;padding:8px 4px;font-size:12px;font-weight:900;cursor:pointer}.sq-stabrite-refine__main{min-width:0}.sq-stabrite-refine__head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 14px}.sq-stabrite-refine__head h2{margin:0;font-size:22px}.sq-stabrite-refine__meta{font-size:13px;color:#58656e;font-weight:800}.sq-stabrite-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.sq-stabrite-product{display:flex;min-width:0;flex-direction:column;gap:7px;color:inherit;text-decoration:none}.sq-stabrite-product__media{display:block;aspect-ratio:1/1;background:#fff;border:1px solid #e4e7e9;border-radius:8px;overflow:hidden}.sq-stabrite-product__media img{width:100%;height:100%;object-fit:contain}.sq-stabrite-product strong{font-size:14px;line-height:1.3}.sq-stabrite-product small{font-size:11px;color:#68757d}.sq-stabrite-refine__pager{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;margin:20px 0 0;width:100%}.sq-stabrite-refine__pager button{box-sizing:border-box;display:grid;place-items:center;min-width:44px;height:44px;padding:0 12px;border:1px solid #cfd8df;border-radius:10px;background:#fff;color:#0b3a63;font-weight:900;line-height:1;cursor:pointer;box-shadow:0 1px 2px rgba(7,29,45,.08)}.sq-stabrite-refine__pager button[data-dir]{border-color:#0b3a63;background:#0b3a63;color:#fff}.sq-stabrite-refine__pager button[aria-current=true]{border-color:#0b3a63;background:#0b3a63;color:#fff}.sq-stabrite-refine__pager button:disabled{opacity:.34;cursor:not-allowed}.sq-stabrite-refine__empty{padding:30px;border:1px dashed #c9d0d5;border-radius:10px;text-align:center}.sq-stabrite-refine__loading{padding:24px;text-align:center;font-weight:800;color:#58656e}@media(max-width:900px){.sq-stabrite-refine{grid-template-columns:1fr;padding:0 14px}.sq-stabrite-refine__side{position:relative;top:auto;max-height:none}.sq-stabrite-products{grid-template-columns:repeat(2,minmax(0,1fr);gap:12px}.sq-stabrite-refine__pager{gap:7px}.sq-stabrite-refine__pager button{min-width:42px;height:42px}}
</style>
<script data-sq-stabrite-refine-root-v2>
(function(){
 if(window.__sqStaBriteRefineRootV2)return;window.__sqStaBriteRefineRootV2=true;
 var main=document.getElementById('MainContent');if(!main)return;
 var rows=[
  {label:'U.S. Air Force',handle:'sta-brite-air-force',count:{{ collections['sta-brite-air-force'].products_count | default: 0 | json }}},
  {label:'U.S. Army',handle:'sta-brite-army',count:{{ collections['sta-brite-army'].products_count | default: 0 | json }}},
  {label:'U.S. Coast Guard',handle:'sta-brite-coast-guard',count:{{ collections['sta-brite-coast-guard'].products_count | default: 0 | json }}},
  {label:'U.S. Marine Corps',handle:'sta-brite-marine-corps',count:{{ collections['sta-brite-marine-corps'].products_count | default: 0 | json }}},
  {label:'U.S. Navy',handle:'sta-brite-navy',count:{{ collections['sta-brite-navy'].products_count | default: 0 | json }}},
  {label:'U.S. Space Force',handle:'sta-brite-space-force',count:{{ collections['sta-brite-space-force'].products_count | default: 0 | json }}},
  {label:'ROTC',handle:'sta-brite-rotc',count:{{ collections['sta-brite-rotc'].products_count | default: 0 | json }}},
  {label:'JROTC',handle:'sta-brite-jrotc',count:{{ collections['sta-brite-jrotc'].products_count | default: 0 | json }}},
  {label:'Military & Service Academies',handle:'sta-brite-military-service-academies',count:{{ collections['sta-brite-military-service-academies'].products_count | default: 0 | json }}},
  {label:'Law Enforcement',handle:'sta-brite-law-enforcement',count:{{ collections['sta-brite-law-enforcement'].products_count | default: 0 | json }}},
  {label:'Firefighting',handle:'sta-brite-firefighting',count:{{ collections['sta-brite-firefighting'].products_count | default: 0 | json }}}
 ];
 var rootCount={{ collection.products_count | default: 0 | json }},pageSize=50,page=1,active=null,requestToken=0;
 function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
 function imageOf(p){var x=(p&&p.featured_image)||(p&&p.image)||(p&&p.images&&p.images[0]);if(typeof x==='string')return x;return x&&String(x.src||x.url||'')||''}
 function priceOf(p){var vs=Array.isArray(p&&p.variants)?p.variants:[],nums=vs.map(function(v){return Number(v&&v.price)}).filter(function(n){return Number.isFinite(n)});if(!nums.length)return'';return '$'+Math.min.apply(Math,nums).toFixed(2)}
 function hideOldNavigation(){var known=new Set(rows.map(function(r){return r.handle}));var links=[].slice.call(main.querySelectorAll('a[href*="/collections/"]')).filter(function(a){try{var m=new URL(a.href,location.origin).pathname.match(/^\/collections\/([^/?#]+)/);return m&&known.has(decodeURIComponent(m[1]))}catch(_){return false}});var sections=[];links.forEach(function(a){var s=a.closest('section');if(s&&!sections.includes(s)){var n=[].slice.call(s.querySelectorAll('a[href*="/collections/"]')).filter(function(x){try{var m=new URL(x.href,location.origin).pathname.match(/^\/collections\/([^/?#]+)/);return m&&known.has(decodeURIComponent(m[1]))}catch(_){return false}}).length;if(n>=3)sections.push(s)}});sections.forEach(function(s){s.classList.add('sq-stabrite-old-nav-hidden')});if(!sections.length)links.forEach(function(a){var card=a.closest('[class*="card"],[class*="item"],li')||a;card.classList.add('sq-stabrite-old-nav-hidden')})}
 function build(){if(main.querySelector('[data-sq-stabrite-refine-shell]'))return;var shell=document.createElement('section');shell.className='sq-stabrite-refine';shell.dataset.sqStabriteRefineShell='true';shell.innerHTML='<aside class="sq-stabrite-refine__side sq-global-refine-sidebar"><h2 class="sq-stabrite-refine__title">Refine Products</h2><details class="sq-stabrite-refine__group" open><summary>Shop by Category</summary><div class="sq-stabrite-refine__choices">'+rows.map(function(r){return'<div class="sq-stabrite-refine__choice"><input type="checkbox" data-handle="'+esc(r.handle)+'" value="'+esc(r.handle)+'" aria-label="Show '+esc(r.label)+' products"><span>'+esc(r.label)+'</span><small>'+r.count+' items</small></div>'}).join('')+'</div></details><details class="sq-stabrite-refine__group" open><summary>Products Per Page</summary><div class="sq-stabrite-refine__sizes">'+[50,100,250].map(function(n){return'<label><input type="radio" name="sq_stabrite_page_size" value="'+n+'" '+(n===50?'checked':'')+'><span>'+n+'</span></label>'}).join('')+'</div></details></aside><div class="sq-stabrite-refine__main"><div class="sq-stabrite-refine__head"><div><h2>All Sta-Brite Insignia</h2><div class="sq-stabrite-refine__meta"></div></div></div><div class="sq-stabrite-refine__loading">Loading products…</div><div class="sq-stabrite-products" data-sq-stabrite-products></div><nav class="sq-stabrite-refine__pager" data-pagination-design="concept-one" aria-label="Product pages"></nav></div>';
  var anchor=main.querySelector('collection-component,#product-grid,.product-grid');if(anchor&&anchor.parentNode)anchor.parentNode.insertBefore(shell,anchor);else main.appendChild(shell);main.classList.add('sq-stabrite-refine-active');hideOldNavigation();
  shell.querySelectorAll('.sq-stabrite-refine__choice input').forEach(function(input){input.addEventListener('change',function(){var on=input.checked;shell.querySelectorAll('.sq-stabrite-refine__choice input').forEach(function(other){if(other!==input)other.checked=false});active=on?rows.find(function(r){return r.handle===input.dataset.handle}):null;page=1;render()})});
  shell.querySelectorAll('input[name="sq_stabrite_page_size"]').forEach(function(input){input.addEventListener('change',function(){pageSize=parseInt(input.value,10)||50;page=1;render()})});render();
 }
 function pagerHtml(totalPages){var html='<button type="button" data-dir="prev" aria-label="Previous page" '+(page<=1?'disabled':'')+'>&lsaquo;</button>';for(var n=1;n<=totalPages;n++){html+='<button type="button" data-page="'+n+'" '+(n===page?'aria-current="page"':'')+' aria-label="Page '+n+'">'+n+'</button>'}html+='<button type="button" data-dir="next" aria-label="Next page" '+(page>=totalPages?'disabled':'')+'>&rsaquo;</button>';return html}
 async function render(){var token=++requestToken,shell=main.querySelector('[data-sq-stabrite-refine-shell]');if(!shell)return;var handle=active?active.handle:'sta-brite-insignia',total=active?active.count:rootCount,totalPages=Math.max(1,Math.ceil(total/pageSize)),title=active?active.label:'All Sta-Brite Insignia';if(page>totalPages)page=1;var grid=shell.querySelector('[data-sq-stabrite-products]'),loading=shell.querySelector('.sq-stabrite-refine__loading'),meta=shell.querySelector('.sq-stabrite-refine__meta'),head=shell.querySelector('.sq-stabrite-refine__head h2'),pager=shell.querySelector('.sq-stabrite-refine__pager');head.textContent=title;meta.textContent=total+' products • Page '+page+' of '+totalPages;loading.style.display='block';grid.innerHTML='';pager.innerHTML='';var url='/collections/'+encodeURIComponent(handle)+'/products.json?limit='+pageSize+'&page='+page;var products=[];try{var r=await fetch(url,{credentials:'same-origin'});if(!r.ok)throw new Error('HTTP '+r.status);var j=await r.json();products=Array.isArray(j&&j.products)?j.products:[]}catch(e){if(token!==requestToken)return;loading.textContent='Unable to load products. Please try again.';return}if(token!==requestToken)return;loading.style.display='none';if(!products.length){grid.innerHTML='<p class="sq-stabrite-refine__empty">No products match this selection.</p>'}else{grid.innerHTML=products.map(function(p){var im=imageOf(p),price=priceOf(p);return'<a class="sq-stabrite-product" href="/products/'+encodeURIComponent(p.handle)+'"><span class="sq-stabrite-product__media">'+(im?'<img src="'+esc(im)+'" alt="'+esc(p.title)+'" loading="lazy" decoding="async">':'')+'</span><strong>'+esc(p.title)+'</strong>'+(price?'<small>'+esc(price)+'</small>':'')+'</a>'}).join('')}pager.innerHTML=pagerHtml(totalPages);pager.querySelectorAll('button[data-page]').forEach(function(b){b.addEventListener('click',function(){page=parseInt(b.dataset.page,10)||1;render();shell.scrollIntoView({behavior:'smooth',block:'start'})})});pager.querySelectorAll('button[data-dir]').forEach(function(b){b.addEventListener('click',function(){page+=b.dataset.dir==='next'?1:-1;page=Math.max(1,Math.min(totalPages,page));render();shell.scrollIntoView({behavior:'smooth',block:'start'})})});window.dispatchEvent(new CustomEvent('sq:stabrite-refine-ready',{detail:{handle:handle,count:total,page:page,pageSize:pageSize,products:products.length,totalPages:totalPages}}))}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',build,{once:true});else build();
})();
</script>
{% endif %}