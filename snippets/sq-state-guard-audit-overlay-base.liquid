{% if request.page_type == 'collection' %}
<style data-sq-state-guard-root-zero-guard>
#MainContent [data-sq-state-guard-root] .sg-entity[data-sq-zero-count="true"]{display:flex!important}
</style>
<script data-sq-state-guard-audit-overlay>
(function(){
if(window.__sqStateGuardAuditOverlay)return;window.__sqStateGuardAuditOverlay=true;
function norm(x){return String(x||'').trim().toLowerCase()}
function previewId(){var q=new URLSearchParams(location.search).get('preview_theme_id');if(q)return q;var t=window.Shopify&&Shopify.theme;if(t&&t.id&&norm(t.role)!=='main')return String(t.id);return''}
function withPreview(href){try{var u=new URL(href,location.origin),id=previewId();if(id&&u.origin===location.origin&&!u.searchParams.has('preview_theme_id'))u.searchParams.set('preview_theme_id',id);return u.pathname+(u.search?'?'+u.searchParams.toString():'')+u.hash}catch(e){return href}}
function patchLinks(){document.querySelectorAll('[data-sq-state-guard-root] a,[data-sqsg] a,.sqsg-card,.sqsg-back,.sqsg-product,.sqsg-orgs a,[data-vac-unified-builder] a,.vac-uniform-checklist a').forEach(function(a){var h=a.getAttribute('href');if(h)a.setAttribute('href',withPreview(h))})}
function guardRootVisibility(){if(location.pathname!=='/collections/state-guard-series')return;document.querySelectorAll('[data-sq-state-guard-root] .sg-entity[data-sq-zero-count="true"]').forEach(function(card){card.removeAttribute('data-sq-zero-count')})}
function ok(p){return p&&p.product_type!=='OPTIONS_HIDDEN_PRODUCT'&&(!p.variants||!p.variants.length||p.variants.some(function(v){return v.available===true}))}
async function countCollection(handle){var seen={},n=0;for(var page=1;page<=10;page++){var r=await fetch('/collections/'+encodeURIComponent(handle)+'/products.json?limit=250&page='+page,{credentials:'same-origin'});if(!r.ok)break;var j=await r.json(),a=j&&Array.isArray(j.products)?j.products:[];a.forEach(function(p){if(p&&p.handle&&!seen[p.handle]&&ok(p)){seen[p.handle]=1;n++}});if(a.length<250)break}return n}
function ensureConnecticut(){if(location.pathname!=='/collections/state-guard-series')return;var grid=document.querySelector('[data-sq-state-guard-root] .sg-entity-grid');if(!grid||grid.querySelector('[data-sg-handle="state-guard-series-connecticut"]'))return;var card=document.createElement('a');card.className='sg-entity';card.setAttribute('data-sg-handle','state-guard-series-connecticut');card.setAttribute('aria-label','Shop Connecticut State Militia Units');card.href=withPreview('/collections/state-guard-series-connecticut?filter.v.availability=1');card.innerHTML='<span class="sg-entity__media"><img class="sg-entity__seal" src="https://commons.wikimedia.org/wiki/Special:FilePath/Seal_of_Connecticut.svg" alt="Official seal for Connecticut State Militia Units" loading="lazy" decoding="async" referrerpolicy="no-referrer"></span><span class="sg-entity__copy"><span class="sg-entity__name">Connecticut State Militia Units</span><span class="sg-entity__count" data-sg-count>0 items</span><span class="sg-entity__arrow" aria-hidden="true">→</span></span>';var ca=grid.querySelector('[data-sg-handle="state-guard-series-california"]');if(ca&&ca.nextSibling)grid.insertBefore(card,ca.nextSibling);else if(ca)grid.appendChild(card);else grid.insertBefore(card,grid.children[3]||null)}
var OHIO=[
 ['Male OCP Uniform','sdf-ocp-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-ocp-uniform-button.png?v=1786834885'],
 ['Female OCP Uniform','ohmr-female-ocp-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-ocp-uniform-button_7c94ea11-9312-4228-bf06-6a655fc574cf.png?v=1786911114'],
 ['Male AGSU / Green Service Uniform','sdf-green-service-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-green-service-uniform-button.png?v=1786834896'],
 ['Female AGSU / Green Service Uniform','ohmr-female-green-service-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-green-service-uniform-button_09c43f9b-f7cc-4f59-997e-df2bf1de9fb8.png?v=1786911116'],
 ['Male ASU / Blue Service Uniform','sdf-service-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-service-uniform-button.png?v=1786834857'],
 ['Female ASU / Blue Service Uniform','ohmr-female-service-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-service-uniform-button_583bdc6c-5cef-4274-8e1c-e31685ebff05.png?v=1786911113'],
 ['Male PT Uniform','ohmr-pt-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-pt-uniform-button.png?v=1786834891'],
 ['Female PT Uniform','ohmr-female-pt-uniform','https://cdn.shopify.com/s/files/1/0774/4602/1275/collections/ohmr-pt-uniform-button_dd01ab36-ff1e-4f56-b58a-5ec53492502f.png?v=1786911115']
];
function ohioCard(x,i){return'<a class="sqsg-card" data-sq-ohio-uniform="'+i+'" href="'+withPreview('/collections/'+x[1]+'?filter.v.availability=1')+'"><span class="sqsg-media"><img src="'+x[2]+'" alt="" loading="lazy" decoding="async"></span><span class="sqsg-copy"><strong>'+x[0]+'</strong><small><span data-sq-ohio-count="'+i+'">…</span> items</small><b>→</b></span></a>'}
async function applyOhio(){var path=location.pathname.match(/\/collections\/([^\/?#]+)/),handle=path?decodeURIComponent(path[1]):'';if(handle!=='state-guard-series-ohio')return;var q=new URLSearchParams(location.search),org=q.get('sg_org')||'';if(q.get('sg_category')!=='uniforms'||q.get('sg_type')||q.get('sg_component')||(org&&org!=='Ohio Military Reserve'))return;var view=document.querySelector('[data-sqsg-view]');if(!view||view.querySelector('[data-sq-ohio-uniform]'))return;var back=withPreview('/collections/state-guard-series-ohio'+(org?'?sg_org='+encodeURIComponent(org):''));view.innerHTML='<div class="sqsg-head"><a class="sqsg-back" href="'+back+'">← Shop by Category</a><div><p>Uniforms</p><h2>Choose your Ohio Military Reserve uniform &amp; fit</h2><small>Choose OCP, AGSU / Green Service, ASU / Blue Service, or PT, then choose male or female fit.</small></div></div><div class="sqsg-grid">'+OHIO.map(ohioCard).join('')+'</div>';patchLinks();OHIO.forEach(async function(x,i){try{var n=await countCollection(x[1]),el=view.querySelector('[data-sq-ohio-count="'+i+'"]');if(el)el.textContent=String(n)}catch(e){var el=view.querySelector('[data-sq-ohio-count="'+i+'"]');if(el)el.textContent='0'}})}
function cleanUniformBuilder(){var path=location.pathname.match(/\/collections\/([^\/?#]+)/),handle=path?decodeURIComponent(path[1]):'';if(!/^state-guard-series(?:-|$)/.test(handle))return;var root=document.querySelector('[data-vac-unified-builder]');if(!root||root.hidden)return;var intro=root.querySelector('.vac-unified-uniform-builder__intro');if(intro)intro.textContent='Available components are shown below. Required components that are not currently stocked remain listed in the checklist so the uniform standard stays complete.';root.querySelectorAll('.sq-green-service-builder__group').forEach(function(group){group.hidden=false;group.removeAttribute('aria-hidden')});patchLinks()}
var queued=false;function run(){queued=false;guardRootVisibility();ensureConnecticut();patchLinks();applyOhio();cleanUniformBuilder()}function queue(){if(queued)return;queued=true;setTimeout(run,120)}
new MutationObserver(queue).observe(document.documentElement,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:['data-sq-zero-count']});if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',queue,{once:true});else queue();
})();
</script>
{% endif %}
