{% doc %}
Networkless filtered-results bridge for ordinary category roots whose Refine universe comes from child collections. It never fetches catalog data itself. Instead it consumes the exact product universe already assembled by sq-global-refine-direct-data, eliminating duplicate child-collection requests while ensuring the visible product surface matches the selected Manufacturer/Color.
{% enddoc %}
{% if request.page_type == 'collection' %}
<script data-sq-filtered-child-union-bridge-v2>
(function(){
  if(window.__sqFilteredChildUnionBridgeV2)return;window.__sqFilteredChildUnionBridgeV2=true;
  var main=document.getElementById('MainContent');if(!main)return;
  var military=/^(?:products-built-for-the-line-u-s-(?:army|navy|air-force|marine-corps|coast-guard|space-force)|army-national-guard-series|air-national-guard-series|state-guard-series|rotc-series|jrotc-series|military-schools-academies)$/;
  var handle={{ collection.handle | json }};if(military.test(handle))return;
  function c(v){return String(v==null?'':v).trim()}
  function n(v){return c(v).toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ')}
  function e(v){return c(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function active(){var q=new URLSearchParams(location.search);return{maker:c(q.get('sq_maker')||q.get('filter.p.vendor')),color:c(q.get('sq_color_pattern'))}}
  var f=active();if(!f.maker&&!f.color)return;
  function hidden(p){var t=n(p&&p.product_type);return !p||t==='options hidden product'||t==='options_hidden_product'}
  function colorish(v){var s=n(v);if(!s||s==='default title'||/^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|6xl|small|medium|large|one size|standard)$/.test(s))return false;return /black|white|grey|gray|charcoal|red|blue|navy|green|olive|foliage|coyote|tan|khaki|brown|sand|gold|silver|orange|yellow|pink|purple|maroon|burgundy|teal|aqua|multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a[- ]?tacs|tiger stripe|lizard|camo|camouflage|pattern|beige/.test(s)}
  function colors(p){var out=[],seen={};function add(v){v=c(v);var k=n(v);if(!v||seen[k]||!colorish(v))return;seen[k]=1;out.push(v)};(Array.isArray(p&&p.tags)?p.tags:[]).forEach(function(t){var raw=c(t),m=raw.match(/^(?:sq\s+)?(?:color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m)add(m[1]);else if(colorish(raw))add(raw)});var opts=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];opts.forEach(function(o,i){var name=c(typeof o==='string'?o:(o&&o.name)||'');if(/color|colour|pattern|camo|camouflage/i.test(name))vs.forEach(function(v){add(v&&v['option'+(i+1)])})});return out}
  function matches(p){if(hidden(p))return false;if(f.maker&&n(p.vendor)!==n(f.maker))return false;if(f.color&&!colors(p).some(function(x){return n(x)===n(f.color)}))return false;return true}
  function imageOf(p){var x=(p&&p.featured_image)||(p&&p.image)||(p&&p.images&&p.images[0]);if(typeof x==='string')return x;return c(x&&(x.src||x.url))}
  function ensureStyle(){if(document.getElementById('sq-filtered-child-union-bridge-style'))return;var st=document.createElement('style');st.id='sq-filtered-child-union-bridge-style';st.textContent='#MainContent.sq-filtered-child-union-active collection-component,#MainContent.sq-filtered-child-union-active .product-grid,#MainContent.sq-filtered-child-union-active #product-grid,#MainContent.sq-filtered-child-union-active [data-sq-category-universe-products]:not([data-sq-filtered-child-union-products]),#MainContent.sq-filtered-child-union-active [data-sq-custom-color-products]{display:none!important}#MainContent.sq-filtered-child-union-active [data-sq-filtered-child-union-products]{display:block!important}.sq-filtered-child-union-products .sq-custom-color-product__vendor{display:block;margin-top:5px;font-size:.82rem;opacity:.72}';document.head.appendChild(st)}
  function render(ps){if(main.querySelector('[data-sq-filtered-child-union-products]'))return;var out=(Array.isArray(ps)?ps:[]).filter(matches);if(!out.length)return;ensureStyle();main.classList.add('sq-filtered-child-union-active');var s=document.createElement('section');s.className='sq-custom-color-products sq-filtered-child-union-products';s.dataset.sqFilteredChildUnionProducts='true';s.dataset.sqFilteredProductSurfaceGuardProducts='true';s.dataset.sqCategoryUniverseProducts='true';var label=[f.maker,f.color].filter(Boolean).join(' / '),h='<div class="sq-custom-color-products__wrap"><div class="sq-custom-color-products__head"><div><h2>'+e(label||'Filtered Products')+'</h2><p>'+out.length+' synchronized products. Sold-out products are included.</p></div></div><div class="sq-custom-color-products__grid">';out.forEach(function(p){var src=imageOf(p);h+='<a class="sq-custom-color-product" href="/products/'+encodeURIComponent(c(p.handle))+'"><span class="sq-custom-color-product__media">'+(src?'<img src="'+e(src)+'" alt="'+e(p.title)+'" loading="lazy" decoding="async">':'')+'</span><span class="sq-custom-color-product__copy"><strong>'+e(p.title)+'</strong>'+(p.vendor?'<span class="sq-custom-color-product__vendor">'+e(p.vendor)+'</span>':'')+'</span></a>'});h+='</div></div>';s.innerHTML=h;var host=main.querySelector('.sq-global-refine-main')||main;host.insertBefore(s,host.firstChild)}
  function consume(detail){if(main.querySelector('[data-sq-filtered-product-surface-guard-products]'))return;var ps=(detail&&Array.isArray(detail.products)&&detail.products.length)?detail.products:(window.__sqDirectFacetUniverse&&Array.isArray(window.__sqDirectFacetUniverse.products)?window.__sqDirectFacetUniverse.products:null);if(ps&&ps.length)render(ps)}
  window.addEventListener('sq:refine-universe-ready',function(ev){setTimeout(function(){consume(ev&&ev.detail)},50)});
  setTimeout(function(){consume(window.__sqDirectFacetUniverse)},700);setTimeout(function(){consume(window.__sqDirectFacetUniverse)},1800);setTimeout(function(){consume(window.__sqDirectFacetUniverse)},3600);
})();
</script>
{% endif %}