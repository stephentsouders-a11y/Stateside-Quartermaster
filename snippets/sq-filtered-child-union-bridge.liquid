{% doc %}
Fallback authority for filtered ordinary category roots whose Refine universe is assembled from child collections rather than the root collection. It runs only when a Manufacturer/Color filter is active, only when the primary filtered-product guard has not already produced a synchronized surface, and only when visible subcategory cards expose child collection routes.
{% enddoc %}
{% if request.page_type == 'collection' %}
<script data-sq-filtered-child-union-bridge-v1>
(function(){
  if(window.__sqFilteredChildUnionBridgeV1)return;window.__sqFilteredChildUnionBridgeV1=true;
  var main=document.getElementById('MainContent');if(!main)return;
  var military=/^(?:products-built-for-the-line-u-s-(?:army|navy|air-force|marine-corps|coast-guard|space-force)|army-national-guard-series|air-national-guard-series|state-guard-series|rotc-series|jrotc-series|military-schools-academies)$/;
  var handle={{ collection.handle | json }};if(military.test(handle))return;
  function c(v){return String(v==null?'':v).trim()}
  function n(v){return c(v).toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ')}
  function e(v){return c(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function active(){var q=new URLSearchParams(location.search);return{maker:c(q.get('sq_maker')||q.get('filter.p.vendor')),color:c(q.get('sq_color_pattern'))}}
  var f=active();if(!f.maker&&!f.color)return;
  function hidden(p){var t=n(p&&p.product_type);return !p||t==='options hidden product'||t==='options_hidden_product'}
  function colorish(v){var s=n(v);if(!s||s==='default title'||/^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|6xl|small|medium|large|one size|standard)$/.test(s))return false;return /black|white|grey|gray|charcoal|red|blue|navy|green|olive|foliage|coyote|tan|khaki|brown|sand|gold|silver|orange|yellow|pink|purple|maroon|burgundy|teal|aqua|multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a[- ]?tacs|tiger stripe|lizard|camo|camouflage|pattern|beige/.test(s)}
  function colors(p){var out=[],seen={};function add(v){v=c(v);var k=n(v);if(!v||seen[k]||!colorish(v))return;seen[k]=1;out.push(v)};(Array.isArray(p&&p.tags)?p.tags:[]).forEach(function(t){var raw=c(t),m=raw.match(/^(?:sq\s+)?(?:color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m)add(m[1]);else if(colorish(raw))add(raw)});var opts=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];opts.forEach(function(o,i){var name=c(typeof o==='string'?o:(o&&o.name)||'');if(/color|colour|pattern|camo|camouflage/i.test(name))vs.forEach(function(v){add(v&&v['option'+(i+1)])})});return out}
  function matches(p){if(hidden(p))return false;if(f.maker&&n(p.vendor)!==n(f.maker))return false;if(f.color&&!colors(p).some(function(x){return n(x)===n(f.color)}))return false;return true}
  function route(raw){try{var u=new URL(raw,location.origin);if(!/^\/collections\//.test(u.pathname))return'';['filter.v.availability','preview_theme_id','page','limit','sq_maker','sq_color_pattern','filter.p.vendor'].forEach(function(k){u.searchParams.delete(k)});var q=u.searchParams.toString();return u.pathname.replace(/\/$/,'')+(q?'?'+q:'')}catch(_){return''}}
  function routes(){var out=[];[...main.querySelectorAll('.sq-global-refine-main .sq-subcategory-card[href*="/collections/"],.sq-subcategory-card[href*="/collections/"]')].forEach(function(a){var r=route(a.href);if(r&&out.indexOf(r)<0)out.push(r)});return out}
  var cache={};async function load(r){if(cache[r])return cache[r];cache[r]=(async function(){var out=[],seen={};for(var pg=1;pg<=24;pg++){var u=new URL(r,location.origin);u.pathname=u.pathname.replace(/\/$/,'')+'/products.json';u.searchParams.set('limit','250');u.searchParams.set('page',String(pg));var res;try{res=await fetch(u.pathname+'?'+u.searchParams.toString(),{credentials:'same-origin'})}catch(_){break}if(!res.ok)break;var j=await res.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(!hidden(p)&&p.handle&&!seen[p.handle]){seen[p.handle]=1;out.push(p)}});if(a.length<250)break}return out})();return cache[r]}
  function imageOf(p){var x=(p&&p.featured_image)||(p&&p.image)||(p&&p.images&&p.images[0]);if(typeof x==='string')return x;return c(x&&(x.src||x.url))}
  function ensureStyle(){if(document.getElementById('sq-filtered-child-union-bridge-style'))return;var st=document.createElement('style');st.id='sq-filtered-child-union-bridge-style';st.textContent='#MainContent.sq-filtered-child-union-active collection-component,#MainContent.sq-filtered-child-union-active .product-grid,#MainContent.sq-filtered-child-union-active #product-grid,#MainContent.sq-filtered-child-union-active [data-sq-category-universe-products]:not([data-sq-filtered-child-union-products]),#MainContent.sq-filtered-child-union-active [data-sq-custom-color-products]{display:none!important}#MainContent.sq-filtered-child-union-active [data-sq-filtered-child-union-products]{display:block!important}.sq-filtered-child-union-products .sq-custom-color-product__vendor{display:block;margin-top:5px;font-size:.82rem;opacity:.72}';document.head.appendChild(st)}
  function render(ps){var out=ps.filter(matches),old=main.querySelector('[data-sq-filtered-child-union-products]');if(old)old.remove();ensureStyle();main.classList.add('sq-filtered-child-union-active');var s=document.createElement('section');s.className='sq-custom-color-products sq-filtered-child-union-products';s.dataset.sqFilteredChildUnionProducts='true';s.dataset.sqFilteredProductSurfaceGuardProducts='true';s.dataset.sqCategoryUniverseProducts='true';var label=[f.maker,f.color].filter(Boolean).join(' / '),h='<div class="sq-custom-color-products__wrap"><div class="sq-custom-color-products__head"><div><h2>'+e(label||'Filtered Products')+'</h2><p>'+out.length+' synchronized products. Sold-out products are included.</p></div></div>';if(out.length){h+='<div class="sq-custom-color-products__grid">';out.forEach(function(p){var src=imageOf(p);h+='<a class="sq-custom-color-product" href="/products/'+encodeURIComponent(c(p.handle))+'"><span class="sq-custom-color-product__media">'+(src?'<img src="'+e(src)+'" alt="'+e(p.title)+'" loading="lazy" decoding="async">':'')+'</span><span class="sq-custom-color-product__copy"><strong>'+e(p.title)+'</strong>'+(p.vendor?'<span class="sq-custom-color-product__vendor">'+e(p.vendor)+'</span>':'')+'</span></a>'});h+='</div>'}else h+='<p class="sq-global-refine-sidebar__empty">No products match the selected refinement.</p>';h+='</div>';s.innerHTML=h;var host=main.querySelector('.sq-global-refine-main')||main;host.insertBefore(s,host.firstChild)}
  async function enforce(){if(main.querySelector('[data-sq-filtered-product-surface-guard-products]'))return;var rs=routes();if(!rs.length)return;var union=[],seen={},next=0;async function worker(){while(next<rs.length){var r=rs[next++],arr=await load(r);arr.forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;union.push(p)}})}}var ws=[];for(var i=0;i<Math.min(3,rs.length);i++)ws.push(worker());await Promise.all(ws);if(!union.length||!union.some(matches))return;render(union)}
  function start(){setTimeout(enforce,1100);setTimeout(enforce,2800);window.addEventListener('sq:refine-universe-ready',function(){setTimeout(enforce,250)})}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
})();
</script>
{% endif %}