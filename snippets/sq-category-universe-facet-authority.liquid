{% doc %}
Builds Manufacturer and Color/Pattern from the current category collection first, reusing one shared product-universe promise for Refine. Child Shop by Category destinations are loaded sequentially only as a fallback when the root collection returns no products. Sold-out products remain included.
{% enddoc %}
{% if request.page_type == 'collection' %}
<script data-sq-category-universe-v4 data-handle="{{ collection.handle | escape }}">
(function(){
if(window.__sqCategoryUniverseV4)return;window.__sqCategoryUniverseV4=true;
var boot=document.currentScript,rootHandle=boot&&boot.dataset.handle||'',main=document.getElementById('MainContent');if(!main||main.querySelector('.sqbfl'))return;
function c(x){return String(x==null?'':x).trim()}
function n(x){return c(x).toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ')}
function e(x){return c(x).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
function tags(p){return Array.isArray(p&&p.tags)?p.tags:[]}
function hidden(p){var t=n(p&&p.product_type);return !p||t==='options hidden product'||t==='options_hidden_product'}
function root(){var r=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';return r.slice(-1)==='/'?r:r+'/'}
function handle(a){try{var m=new URL(a.href,location.origin).pathname.match(/^\/collections\/([^/]+)/);return m?decodeURIComponent(m[1]):''}catch(_){return''}}
async function load(h){var out=[],seen={};if(!h)return out;for(var pg=1;pg<=24;pg++){var r;try{r=await fetch(root()+'collections/'+encodeURIComponent(h)+'/products.json?limit=250&page='+pg,{credentials:'same-origin'})}catch(_){break}if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(!hidden(p)&&p.handle&&!seen[p.handle]){seen[p.handle]=1;out.push(p)}});if(a.length<250)break}return out}
function colorish(v){var s=n(v);if(!s||s==='default title'||/^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|6xl|small|medium|large|one size|standard)$/.test(s))return false;return /black|white|grey|gray|charcoal|red|blue|navy|green|olive|foliage|coyote|tan|khaki|brown|sand|gold|silver|orange|yellow|pink|purple|maroon|burgundy|teal|aqua|multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a[- ]?tacs|tiger stripe|lizard|camo|camouflage|pattern|beige/.test(s)}
function colors(p){var out=[],seen={};function add(v){v=c(v);var k=n(v);if(!v||seen[k]||!colorish(v))return;seen[k]=1;out.push(v)}tags(p).forEach(function(t){var raw=c(t),m=raw.match(/^(?:sq\s+)?(?:color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m)add(m[1]);else if(colorish(raw))add(raw)});var opts=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];opts.forEach(function(o,i){var name=c(typeof o==='string'?o:(o&&o.name)||'');if(/color|colour|pattern|camo|camouflage/i.test(name))vs.forEach(function(v){add(v&&v['option'+(i+1)])})});return out}
function href(changes){var u=new URL(location.href);['filter.v.availability','filter.p.vendor','sq_maker','sq_color_pattern','page'].forEach(function(k){u.searchParams.delete(k)});Object.keys(changes||{}).forEach(function(k){var v=changes[k];if(v)u.searchParams.set(k,v)});return u.pathname+(u.search?'?'+u.searchParams.toString():'')}
function shell(kind,title,intro,count){var s=document.createElement('section');s.className='sq-facet-browser sq-facet-browser--'+kind;s.dataset.sqCategoryUniverse=kind;s.innerHTML='<div class="sq-facet-browser__wrap"><p class="sq-facet-browser__kicker">Stateside Quartermaster</p><h2>'+e(title)+'</h2><p class="sq-facet-browser__intro">'+e(intro)+'</p><div class="sq-facet-browser__grid"></div><p class="sq-facet-browser__meta">'+count+'</p></div>';return s}
function put(s,after){if(after&&after.parentNode){after.insertAdjacentElement('afterend',s);return}var cat=main.querySelector('.sq-subcategory-section');if(cat){cat.insertAdjacentElement('afterend',s);return}main.prepend(s)}
function productGrid(ps,after){var q=new URLSearchParams(location.search),maker=q.get('sq_maker')||'',color=q.get('sq_color_pattern')||'';if(!maker&&!color)return;var out=ps.filter(function(p){if(maker&&n(p.vendor)!==n(maker))return false;if(color&&!colors(p).some(function(x){return n(x)===n(color)}))return false;return true});document.documentElement.classList.add('sq-category-facet-active');var s=document.createElement('section');s.className='sq-custom-color-products';s.dataset.sqCategoryUniverseProducts='true';var h='<div class="sq-custom-color-products__wrap"><div class="sq-custom-color-products__head"><div><h2>'+e([maker,color].filter(Boolean).join(' / '))+'</h2><p>'+out.length+' synchronized products. Sold-out products are included.</p></div></div><div class="sq-custom-color-products__grid">';out.forEach(function(p){var im=p&&p.images&&p.images[0],src=typeof im==='string'?im:(im&&im.src)||'';h+='<a class="sq-custom-color-product" href="/products/'+encodeURIComponent(p.handle||'')+'"><span class="sq-custom-color-product__media">'+(src?'<img src="'+e(src)+'" alt="'+e(p.title)+'" loading="lazy">':'')+'</span><span class="sq-custom-color-product__copy"><strong>'+e(p.title)+'</strong></span></a>'});s.innerHTML=h+'</div></div>';put(s,after)}
function build(ps){window.__sqDirectFacetUniverse={products:ps};window.dispatchEvent(new CustomEvent('sq:refine-universe-ready',{detail:window.__sqDirectFacetUniverse}));main.querySelectorAll('.sq-maker-browser,[data-sq-facet-browser="manufacturer"],[data-sq-facet-browser="color-pattern"],[data-sq-category-universe],[data-sq-category-universe-products]:not([data-sq-filtered-product-surface-guard-products])').forEach(function(x){x.remove()});var makers={},cm={};ps.forEach(function(p){var v=c(p.vendor);if(v)makers[v]=(makers[v]||0)+1;var once={};colors(p).forEach(function(x){var k=n(x);if(once[k])return;once[k]=1;if(!cm[k])cm[k]={label:x,count:0};cm[k].count++})});var mk=Object.keys(makers).sort(),msec=shell('manufacturer','Shop by Manufacturer','Built from the same products represented by this category. Sold-out products remain included.',mk.length+' manufacturers'),mg=msec.querySelector('.sq-facet-browser__grid');mk.forEach(function(k){var a=document.createElement('a');a.className='sq-facet-browser__chip';a.href=href({sq_maker:k});a.innerHTML='<span>'+e(k)+'</span><small>'+makers[k]+' items</small>';mg.appendChild(a)});put(msec,null);var ck=Object.keys(cm).sort(function(a,b){return cm[a].label.localeCompare(cm[b].label)}),csec=null;if(ck.length){csec=shell('color-pattern','Shop by Color / Pattern','Includes colors and camouflage patterns from the same category product universe, including sold-out items.',ck.length+' options');var cg=csec.querySelector('.sq-facet-browser__grid');ck.forEach(function(k){var d=cm[k],a=document.createElement('a');a.className='sq-facet-browser__chip';a.href=href({sq_color_pattern:d.label});a.innerHTML='<span>'+e(d.label)+'</span><small>'+d.count+' items</small>';cg.appendChild(a)});put(csec,msec)}productGrid(ps,csec||msec)}
async function collect(){var primary=await load(rootHandle);if(primary.length){build(primary);return primary}var links=[].slice.call(main.querySelectorAll('.sq-subcategory-card[href*="/collections/"]')),hs=[];links.forEach(function(a){var h=handle(a);if(h&&h!==rootHandle&&hs.indexOf(h)<0)hs.push(h)});var seen={},union=[];for(var i=0;i<hs.length;i++){var batch=await load(hs[i]);batch.forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;union.push(p)}})}if(union.length)build(union);return union}
function start(){if(window.__sqCategoryUniversePromise)return;var p=collect().catch(function(){return[]});window.__sqCategoryUniversePromise=p;if(!window.__sqDirectFacetUniversePromise)window.__sqDirectFacetUniversePromise=p}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(start,250)},{once:true});else setTimeout(start,250);
})();
</script>
{% endif %}