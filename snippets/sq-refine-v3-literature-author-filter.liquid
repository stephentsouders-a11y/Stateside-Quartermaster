{% doc %}
Keeps Shop by Author inside the Literature V3 collection experience. Replaces legacy catalog-search shortcuts with collection-local author checkboxes and swaps the visible V3 product grid from a dedicated search-backed product-card feed. Publisher wording is normalized to singular and publisher checkboxes are explicitly navigable. Dedicated War / Conflict, Branch, and Topic groups point only to verified Literature collections. State Guard and all non-Literature routes are untouched.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle == 'literature' %}
<script data-sq-refine-v3-literature-author-filter>
(function(){
  var main=document.getElementById('MainContent');if(!main)return;
  var q=new URLSearchParams(location.search),active=q.get('sq_author')||'';
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function norm(v){return clean(v).toLowerCase().replace(/[\u2019']/g,'').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').trim()}
  function esc(v){return clean(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function unique(a){var out=[];(a||[]).forEach(function(v){v=clean(v).replace(/^report copyright infringement\s*/i,'');if(v&&!out.some(function(x){return norm(x)===norm(v)}))out.push(v)});return out}
  function meta(){var n=document.querySelector('[data-sq-literature-meta]');if(!n)return{authors:[]};try{return JSON.parse(n.textContent||'{}')}catch(_){return{authors:[]}}}
  function group(side,label){return [].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group')).find(function(d){var s=d.querySelector(':scope > summary');return s&&clean(s.textContent)===label})||null}
  function removeAuthorGroups(side){[].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group')).forEach(function(d){var s=d.querySelector(':scope > summary');if((s&&clean(s.textContent)==='Shop by Author')||d.hasAttribute('data-sq-author-refine'))d.remove()})}
  function normalizePublisher(side){var pub=null;[].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group')).forEach(function(d){var s=d.querySelector(':scope > summary');if(s&&/^Shop by Publisher(?:s|\s*\/\s*Supplier)?$/i.test(clean(s.textContent))){s.textContent='Shop by Publisher';pub=d}});if(!pub)return;pub.querySelectorAll('label').forEach(function(l){var span=l.querySelector('span');if(span)span.textContent=clean(span.textContent).replace(/\s*\(supplier metadata\)\s*$/i,'')});pub.querySelectorAll('input[type=checkbox][data-target]').forEach(function(i){if(i.dataset.sqPublisherBound==='1')return;i.dataset.sqPublisherBound='1';i.addEventListener('change',function(){if(i.checked){location.assign(i.dataset.target);return}var u=new URL(location.href);u.searchParams.delete('filter.p.vendor');u.searchParams.delete('page');u.searchParams.delete('sq_view_page');location.assign(u.pathname+'?'+u.searchParams.toString())})})}
  function authorTarget(author){var u=new URL('/collections/literature',location.origin);u.searchParams.set('sq_root','literature');u.searchParams.set('sq_author',author);var preview=q.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return u.pathname+'?'+u.searchParams.toString()}
  function literatureTarget(handle){var u=new URL('/collections/'+handle,location.origin);u.searchParams.set('sq_root','literature');var preview=q.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);return u.pathname+'?'+u.searchParams.toString()}
  function buildNavGroup(side,label,items,key){var old=group(side,label);if(old)old.remove();var d=document.createElement('details');d.className='sq-refine-v3-group';d.setAttribute('data-sq-literature-special',key);d.innerHTML='<summary>'+esc(label)+'</summary><div class="sq-refine-v3-choices">'+items.map(function(x){return '<label class="sq-refine-v3-choice"><input type="checkbox" data-kind="structural" data-target="'+esc(literatureTarget(x[1]))+'"><span>'+esc(x[0])+'</span></label>'}).join('')+'</div>';d.querySelectorAll('input[data-kind=structural][data-target]').forEach(function(i){i.addEventListener('change',function(){if(i.checked)location.assign(i.dataset.target)})});side.appendChild(d);return d}
  function buildLiteratureNav(side){[].slice.call(side.querySelectorAll('[data-sq-literature-special]')).forEach(function(d){d.remove()});var wars=[['American Revolution','literature-u-s-conflicts-american-revolution'],['Barbary Wars','literature-u-s-conflicts-barbary-wars'],['War of 1812','literature-u-s-conflicts-war-of-1812'],['American Civil War','literature-u-s-conflicts-american-civil-war'],['American Indian Wars','literature-u-s-conflicts-american-indian-wars'],['Mexican–American War','literature-u-s-conflicts-mexican-american-war'],['Spanish–American War','literature-u-s-conflicts-spanish-american-war'],['Philippine–American War','literature-u-s-conflicts-philippine-american-war'],['World War I','literature-u-s-conflicts-world-war-i'],['World War II','literature-u-s-conflicts-world-war-ii'],['Cold War','literature-u-s-conflicts-cold-war'],['Korean War','literature-u-s-conflicts-korean-war'],['Vietnam War','literature-u-s-conflicts-vietnam-war'],['Gulf War & Desert Storm','literature-u-s-conflicts-gulf-war-desert-storm'],['Somalia & Black Hawk Down','literature-u-s-conflicts-somalia-black-hawk-down'],['Balkans & Kosovo','literature-u-s-conflicts-balkans-kosovo'],['War in Afghanistan','literature-u-s-conflicts-war-in-afghanistan'],['Iraq War','literature-u-s-conflicts-iraq-war'],['Global War on Terror','literature-u-s-conflicts-global-war-on-terror']];var branches=[['U.S. Army','literature-u-s-army'],['U.S. Navy','literature-u-s-navy'],['U.S. Air Force','literature-u-s-air-force'],['U.S. Marine Corps','literature-u-s-marine-corps'],['U.S. Coast Guard','literature-u-s-coast-guard'],['U.S. Space Force','literature-u-s-space-force'],['National Guard','literature-national-guard'],['Air National Guard','literature-air-national-guard'],['Joint & U.S. Armed Forces','literature-joint-u-s-armed-forces']];var topics=[['Military History & Heritage','literature-military-history-heritage-curated'],['Field Manuals & Reference Guides','literature-field-manuals-reference-guides'],['Military Strategy & Special Operations','literature-military-strategy-special-operations'],['Veterans & Military Families','literature-veterans-military-families'],['Aviation & Technical Manuals','literature-aviation-technical-manuals'],['Outdoor & Survival','literature-outdoor-survival'],['Police & Law Enforcement','literature-police-law-enforcement'],['Firefighter & EMS','literature-firefighter-ems'],['Children’s Military & First Responder Books','literature-children-s-military-first-responder-books'],['Notebooks & Logbooks','literature-notebooks-logbooks']];buildNavGroup(side,'Shop by War / Conflict',wars,'war');buildNavGroup(side,'Shop by Branch',branches,'branch');buildNavGroup(side,'Shop by Topic',topics,'topic')}
  function buildAuthor(side){removeAuthorGroups(side);var authors=unique(meta().authors||[]).filter(function(a){return a&&a.length<90&&!/(description|paperback|hardcover|publisher|publication date|language|print length|isbn)/i.test(a)});if(!authors.length)return null;var d=document.createElement('details');d.className='sq-refine-v3-group';d.setAttribute('data-sq-author-refine','true');if(active)d.open=true;var rows=authors.slice(0,80).map(function(author){var checked=norm(author)===norm(active);return '<label class="sq-refine-v3-choice"><input type="checkbox" data-kind="author" data-target="'+esc(authorTarget(author))+'" data-author="'+esc(author)+'"'+(checked?' checked':'')+'><span>'+esc(author)+'</span></label>'}).join('');d.innerHTML='<summary>Shop by Author</summary><div class="sq-refine-v3-choices">'+rows+'</div>';var pub=group(side,'Shop by Publisher')||group(side,'Shop by Publishers');if(pub)side.insertBefore(d,pub);else side.appendChild(d);d.querySelectorAll('input[data-kind=author]').forEach(function(i){i.addEventListener('change',function(){if(i.checked)location.assign(i.dataset.target);else{var u=new URL(location.href);u.searchParams.delete('sq_author');u.searchParams.delete('page');u.searchParams.delete('sq_view_page');location.assign(u.pathname+'?'+u.searchParams.toString())}})});return d}
  function pageSize(){var n=parseInt(q.get('sq_per_page')||'50',10);return[50,100,250].indexOf(n)>-1?n:50}
  function searchUrl(page){var u=new URL('/search',location.origin);u.searchParams.set('q','"'+active+'"');u.searchParams.set('type','product');u.searchParams.set('options[prefix]','last');u.searchParams.set('view','sq-refine-v3-products');var preview=q.get('preview_theme_id');if(preview)u.searchParams.set('preview_theme_id',preview);q.forEach(function(v,k){if(k.indexOf('filter.')===0||k==='sort_by')u.searchParams.append(k,v)});if(page)u.searchParams.set('page',String(page));return u.pathname+'?'+u.searchParams.toString()}
  async function fetchText(url,tries){var last;for(var i=0;i<(tries||4);i++){try{var r=await fetch(url,{credentials:'same-origin'});if(r.ok)return r.text();last=new Error('HTTP '+r.status);if([429,500,502,503,504].indexOf(r.status)<0)throw last}catch(e){last=e}await new Promise(function(resolve){setTimeout(resolve,600*(i+1)*(i+1))})}throw last||new Error('author feed failed')}
  function cards(doc){var grids=[].slice.call(doc.querySelectorAll('[data-sq-refine-v3-search-host] .product-grid'));var g=grids.find(function(x){return x.querySelector(':scope > .product-grid__item a[href*="/products/"]')})||grids[0];return g?[].slice.call(g.querySelectorAll(':scope > .product-grid__item')).filter(function(x){return x.querySelector('a[href*="/products/"]')}):[]}
  async function applyAuthorProducts(){if(!active)return true;var results=main.querySelector('.sq-refine-v3-results');if(!results)return false;var grid=[].slice.call(results.querySelectorAll('.product-grid')).find(function(g){var r=g.getBoundingClientRect(),s=getComputedStyle(g);return r.width>1&&r.height>1&&s.display!=='none'&&s.visibility!=='hidden'})||results.querySelector('.product-grid');if(!grid)return false;if(main.dataset.sqRefineV3Author===active&&grid.querySelector('.product-grid__item a[href*="/products/"]'))return true;var target=pageSize(),view=Math.max(1,parseInt(q.get('sq_view_page')||'1',10)||1),start=(view-1)*target,startPage=Math.floor(start/50)+1,offset=start%50,need=offset+target+1,all=[],page=startPage;while(all.length<need&&page<startPage+8){var html=await fetchText(searchUrl(page),4),doc=new DOMParser().parseFromString(html,'text/html'),batch=cards(doc);if(!batch.length)break;all=all.concat(batch);if(batch.length<50)break;page++}var slice=all.slice(offset,offset+target);var frag=document.createDocumentFragment();slice.forEach(function(card){frag.appendChild(document.importNode(card,true))});grid.replaceChildren(frag);grid.classList.add('sq-v3-authoritative-grid');grid.style.setProperty('display','grid','important');var old=results.querySelector('.sq-refine-v3-author-pager');if(old)old.remove();var nav=document.createElement('nav');nav.className='sq-refine-v3-pager sq-refine-v3-author-pager';nav.setAttribute('aria-label','Author product pages');function vu(n){var u=new URL(location.href);u.searchParams.set('sq_view_page',String(n));u.searchParams.set('sq_per_page',String(target));return u.pathname+'?'+u.searchParams.toString()}nav.innerHTML=(view>1?'<a href="'+esc(vu(view-1))+'">Previous</a>':'')+'<span>Page '+view+'</span>'+(all.length>offset+target?'<a href="'+esc(vu(view+1))+'">Next</a>':'');grid.parentElement.appendChild(nav);main.dataset.sqRefineV3Author=active;main.dataset.sqRefineV3AuthorCount=String(slice.length);return true}
  async function apply(){if(main.dataset.sqRefineV3Ready!=='true')return false;var side=main.querySelector('.sq-refine-v3-sidebar');if(!side)return false;normalizePublisher(side);buildAuthor(side);normalizePublisher(side);buildLiteratureNav(side);try{await applyAuthorProducts()}catch(e){main.dataset.sqRefineV3AuthorError=clean(e&&e.message||e);console.error('[SQ V3 Author]',e)}return true}
  function start(){apply();setTimeout(apply,350);setTimeout(apply,1000);setTimeout(apply,2200);setTimeout(apply,4500)}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
})();
</script>
{% endif %}
