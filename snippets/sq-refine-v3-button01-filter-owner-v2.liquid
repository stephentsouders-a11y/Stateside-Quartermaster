{% doc %}
Owns Accessories, Gifts & Collectibles Type and Availability checkbox navigation before legacy/global V3 click handlers can convert Type into an intermediate sq_type_family URL. Uses pointerdown capture for real customer mouse/touch interaction and click capture as keyboard/programmatic fallback, always resolving the live MainContent/sidebar at event time. Also hardens customer-visible mobile 50/100/250 labels. State Guard is excluded.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<style data-sq-button01-mobile-page-size-proof>
@media (max-width:900px){
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:7px!important;flex-wrap:wrap!important;color:#071d2d!important}
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size:before{content:'Products per page';display:block!important;flex:0 0 100%!important;width:100%!important;color:#071d2d!important;font-size:12px!important;font-weight:900!important;line-height:1.2!important;visibility:visible!important;opacity:1!important}
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size label{display:flex!important;align-items:center!important;justify-content:flex-start!important;gap:5px!important;min-width:58px!important;min-height:34px!important;padding:7px 9px!important;color:#071d2d!important;font-size:12px!important;font-weight:900!important;line-height:1.2!important;overflow:visible!important;visibility:visible!important;opacity:1!important}
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size label:after{display:inline-block!important;color:#071d2d!important;font-size:12px!important;font-weight:900!important;line-height:1.2!important;visibility:visible!important;opacity:1!important}
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size label:has(input[value='50']):after{content:'50'}
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size label:has(input[value='100']):after{content:'100'}
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size label:has(input[value='250']):after{content:'250'}
#MainContent.sq-v3-button01-root .sq-refine-v3-page-size label>span{display:none!important}
}
</style>
<script data-sq-refine-v3-button01-filter-owner-v2>
(function(){
  var params=new URLSearchParams(location.search),current={{ collection.handle | json }},root=params.get('sq_root')||current;
  if(root!=='accessories-gifts-collectibles'||window.__sqButton01WindowOwnerV2)return;
  window.__sqButton01WindowOwnerV2=true;
  var navigating=false;
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim()}
  function key(v){return clean(v).toLowerCase().replace(/[\u2019']/g,'').replace(/&/g,' ').replace(/\band\b/g,' ').replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim()}
  function filterUrl(name,value,checked){
    var u=new URL(location.href),vals=u.searchParams.getAll(name).filter(function(v){return v!==value});
    if(checked)vals.push(value);
    u.searchParams.delete(name);
    Array.from(new Set(vals)).forEach(function(v){u.searchParams.append(name,v)});
    u.searchParams.delete('sq_type_family');u.searchParams.delete('page');u.searchParams.delete('sq_view_page');u.searchParams.delete('preview_theme_id');
    return u.pathname+(u.searchParams.toString()?'?'+u.searchParams.toString():'');
  }
  function resolveInput(e){
    var main=document.getElementById('MainContent'),side=main&&main.querySelector('.sq-refine-v3-sidebar');
    if(!side)return null;
    var input=e.target&&e.target.closest?e.target.closest('input[type="checkbox"]'):null;
    if(!input){var row=e.target&&e.target.closest?e.target.closest('.sq-refine-v3-choice'):null;input=row&&row.querySelector('input[type="checkbox"]')}
    if(!input||!side.contains(input))return null;
    return input;
  }
  function own(e,phase){
    if(navigating)return;
    if(phase==='pointerdown'&&typeof e.button==='number'&&e.button!==0)return;
    var input=resolveInput(e);if(!input)return;
    var details=input.closest('details.sq-refine-v3-group'),summary=details&&details.querySelector(':scope > summary'),group=key(summary&&summary.textContent),name='',value='';
    if(group===key('Shop by Type')){
      name='filter.p.product_type';value=clean(input.dataset.filterValue||input.dataset.sqPolishValue||input.value);
    }else if(group===key('Availability')){
      name='filter.v.availability';var choice=input.closest('.sq-refine-v3-choice'),span=choice&&choice.querySelector('span'),choiceLabel=key(span&&span.textContent);
      value=choiceLabel.indexOf('in stock')>-1?'1':choiceLabel.indexOf('out of stock')>-1?'0':'';
    }else{return}
    if(!name||!value||value==='on')return;
    e.preventDefault();e.stopImmediatePropagation();
    navigating=true;
    var nextChecked=!input.checked,href=filterUrl(name,value,nextChecked);
    window.__sqButton01LastOwnedClick={owner:'window-v2-'+phase,name:name,value:value,checked:nextChecked,href:href};
    location.assign(href);
  }
  window.addEventListener('pointerdown',function(e){own(e,'pointerdown')},true);
  window.addEventListener('click',function(e){own(e,'click')},true);
})();
</script>
{% endif %}
