{% if request.page_type == 'collection' and collection.handle == 'child-safety-shop' %}
<script data-sq-refine-v3-child-safety-taxonomy>
(function(){
  var ROOT='/collections/child-safety-shop';
  var PARENTS=[
    {label:'Ballistic Backpacks & Inserts',path:ROOT+'/sq-child-safety-ballistic'},
    {label:'First Aid & Emergency Kits',path:ROOT+'/sq-child-safety-first-aid'}
  ];
  function esc(v){return String(v||'').replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function cleanPath(v){return String(v||'').replace(/\/+$/,'')||'/'}
  function currentPath(){return cleanPath(location.pathname)}
  function parentForPath(path){
    path=cleanPath(path);
    return PARENTS.find(function(x){return path===x.path||path.indexOf(x.path+'+')===0||path.indexOf(x.path+'/')===0})||null;
  }
  function samePath(raw){
    try{return cleanPath(new URL(raw,location.origin).pathname)===currentPath()}
    catch(_){return false}
  }
  function side(){return document.querySelector('#MainContent .sq-refine-v3-sidebar')}
  function namedGroup(re){
    var s=side();if(!s)return null;
    var summary=[].slice.call(s.querySelectorAll('.sq-refine-v3-group>summary')).find(function(x){return re.test(x.textContent||'')});
    return summary?summary.parentElement:null;
  }
  function categoryGroup(){return namedGroup(/shop by category/i)}
  function typeGroup(){return namedGroup(/shop by type/i)}
  function withPreview(path){
    var u=new URL(path,location.origin),q=new URLSearchParams(location.search),preview=q.get('preview_theme_id');
    u.searchParams.set('sq_root','child-safety-shop');
    if(preview)u.searchParams.set('preview_theme_id',preview);
    return u.pathname+'?'+u.searchParams.toString();
  }
  function rootTarget(){
    var u=new URL(ROOT,location.origin),preview=new URLSearchParams(location.search).get('preview_theme_id');
    if(preview)u.searchParams.set('preview_theme_id',preview);
    return u.pathname+(u.search?'?'+u.searchParams.toString():'');
  }
  function parentActive(raw){
    try{
      var targetPath=cleanPath(new URL(raw,location.origin).pathname),p=parentForPath(currentPath());
      return !!p&&p.path===targetPath;
    }catch(_){return false}
  }
  function syncActive(group){
    if(!group)return false;
    var isParent=group.dataset.sqChildSafetyParents==='true',active=false;
    group.querySelectorAll('input[type="checkbox"][data-kind="structural"][data-target]').forEach(function(input){
      var checked=isParent?parentActive(input.dataset.target):samePath(input.dataset.target);
      input.checked=checked;
      input.toggleAttribute('data-sq-path-active',checked);
      if(checked)active=true;
    });
    group.dataset.active=active?'true':'false';
    if(active)group.open=true;
    return active;
  }
  function ensureTypeGroup(s,cat){
    var g=typeGroup();
    if(g)return g;
    g=document.createElement('details');g.className='sq-refine-v3-group';g.dataset.active='false';
    g.innerHTML='<summary>Shop by Type</summary><div class="sq-refine-v3-choices"></div>';
    if(cat&&cat.nextSibling)s.insertBefore(g,cat.nextSibling);else s.appendChild(g);
    return g;
  }
  function promoteNestedChoices(cat,s){
    if(!cat||cat.dataset.sqChildSafetyParents==='true'||!parentForPath(currentPath()))return;
    var choices=cat.querySelector(':scope>.sq-refine-v3-choices');
    if(!choices||!choices.children.length)return;
    var type=ensureTypeGroup(s,cat),dest=type.querySelector(':scope>.sq-refine-v3-choices');
    [].slice.call(choices.children).forEach(function(node){dest.appendChild(node)});
    syncActive(type);
  }
  function renderParents(cat,s){
    if(!cat){
      cat=document.createElement('details');cat.className='sq-refine-v3-group';cat.dataset.active='false';
      cat.innerHTML='<summary>Shop by Category</summary><div class="sq-refine-v3-choices"></div>';
      var first=s.querySelector('.sq-refine-v3-group');if(first)s.insertBefore(cat,first);else s.appendChild(cat);
    }
    cat.dataset.sqChildSafetyParents='true';
    var choices=cat.querySelector(':scope>.sq-refine-v3-choices');
    if(!choices){choices=document.createElement('div');choices.className='sq-refine-v3-choices';cat.appendChild(choices)}
    choices.innerHTML=PARENTS.map(function(x){var href=withPreview(x.path);return '<label class="sq-refine-v3-choice"><input type="checkbox" data-kind="structural" data-target="'+esc(href)+'"><span>'+esc(x.label)+'</span></label>'}).join('');
    choices.querySelectorAll('input[data-target]').forEach(function(input){input.addEventListener('change',function(){location.assign(input.checked?input.dataset.target:rootTarget())})});
    syncActive(cat);
    return cat;
  }
  function stabilizeNested(){
    var main=document.getElementById('MainContent');
    if(!main||main.dataset.sqRefineV3Ready!=='true')return false;
    var s=side();if(!s)return false;
    var nested=parentForPath(currentPath()),cat=categoryGroup();
    if(!nested){if(cat)syncActive(cat);main.dataset.sqChildSafetyTaxonomy='root';return true}
    promoteNestedChoices(cat,s);
    cat=renderParents(cat,s);
    syncActive(cat);syncActive(typeGroup());
    main.dataset.sqChildSafetyTaxonomy='stable-parent';
    return true;
  }
  function armPathStateSync(){
    if(document.documentElement.dataset.sqChildSafetyPathSync==='true')return;
    document.documentElement.dataset.sqChildSafetyPathSync='true';
    function run(){stabilizeNested()}
    run();setTimeout(run,0);setTimeout(run,100);setTimeout(run,300);setTimeout(run,700);setTimeout(run,1500);
    setInterval(run,500);
    addEventListener('pageshow',run);addEventListener('popstate',run);
    var main=document.getElementById('MainContent');
    if(main)new MutationObserver(function(){setTimeout(run,0)}).observe(main,{subtree:true,childList:true});
  }
  var tries=0,t=setInterval(function(){tries++;if(stabilizeNested()){clearInterval(t);armPathStateSync()}else if(tries>80)clearInterval(t)},100);
})();
</script>
{% endif %}
