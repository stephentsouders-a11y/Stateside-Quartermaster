<script data-sq-refine-v3-accessories-prepaint-guard>
(function(){
  if(window.__sqAccessoriesPrepaintGuard)return;
  window.__sqAccessoriesPrepaintGuard=true;
  function clean(v){return String(v==null?'':v).replace(/\s+/g,' ').trim().toLowerCase()}
  function prune(root){
    if(!root||!root.querySelectorAll)return;
    root.querySelectorAll('#MainContent .sq-refine-v3-sidebar > details.sq-refine-v3-group').forEach(function(d){
      var s=d.querySelector(':scope > summary');
      if(s&&clean(s.textContent)==='shop by branch')d.remove();
    });
  }
  var observer=new MutationObserver(function(records){
    var relevant=false;
    for(var i=0;i<records.length&&!relevant;i++){
      var r=records[i];
      if(r.type==='childList'&&r.addedNodes&&r.addedNodes.length)relevant=true;
    }
    if(relevant)prune(document);
  });
  observer.observe(document.documentElement,{childList:true,subtree:true});
  prune(document);
  document.addEventListener('DOMContentLoaded',function(){prune(document)},{once:true});
})();
</script>
{% endif %}
<script data-sq-refine-v3-legacy-isolation="{{ collection.handle | escape }}">
window.__sqGlobalRefineAuthorityV2=true;
window.__sqGlobalRefineVisibleSurfaceFix=true;
window.__sqCategoryUniverseV5=true;
window.__sqGlobalRefineCheckboxControls=true;
if(location.pathname==='/collections/military-schools-academies')window.__sqAcademyExclusiveTreeV6=true;
if(location.pathname==='/collections/thin-line'){
  window.__sqCollectionFacetSidebarV1=true;
  window.__sqThinStaGlobalSidebarBridgeV2=true;
  window.__sqThinStaGlobalSidebarBridge=true;
  window.__sqThinStaLegacyParentIsolationDisabled=true;
  window.__sqRefineTaxonomyPanelV1=true;
  document.addEventListener('DOMContentLoaded',function(){
    setTimeout(function(){
      if(!document.body)return;
      document.body.classList.remove('sq-ts-parent','sq-ts-parent-only');
      document.querySelectorAll('[id^="shopify-section-template--"]').forEach(function(el){
        el.classList.remove('sq-ts-keep-section');
        el.style.removeProperty('display');
      });
    },0);
  },{once:true});
}
(function(){
  function lock(name,value){
    try{Object.defineProperty(window,name,{configurable:false,enumerable:true,get:function(){return value},set:function(){}})}
    catch(_){try{window[name]=value}catch(__){}}
  }
  lock('__sqBflUnifiedTree',true);
  lock('__sqBflRecoveryRouteV4','__sq_refine_v3_disabled__');
  lock('__sqBflServerRecoveryRouteV3','__sq_refine_v3_disabled__');
  function installSentinel(){
    var main=document.getElementById('MainContent');if(!main)return false;
    if(!main.querySelector('[data-sqbfl-root]')){
      var sentinel=document.createElement('span');
      sentinel.hidden=true;
      sentinel.setAttribute('aria-hidden','true');
      sentinel.setAttribute('data-sqbfl-root','v3-watchdog-compat');
      sentinel.setAttribute('data-sq-refine-v3-watchdog-sentinel','true');
      main.appendChild(sentinel);
    }
    if(!main.__sqRefineV3WatchdogObserver){
      main.__sqRefineV3WatchdogObserver=new MutationObserver(function(){
        if(!main.querySelector('[data-sqbfl-root]'))installSentinel();
      });
      main.__sqRefineV3WatchdogObserver.observe(main,{childList:true});
    }
    return true;
  }
  if(!installSentinel())document.addEventListener('DOMContentLoaded',installSentinel,{once:true});
})();
(function(){
  if(window.__sqRefineV3MainReplaceGuard||!window.Element)return;
  window.__sqRefineV3MainReplaceGuard=true;
  var nativeReplace=Element.prototype.replaceChildren;
  function isLegacyTakeoverNode(n){
    if(!n)return false;
    if(n.nodeType===1){
      if((n.classList&&n.classList.contains('sqbfl'))||(n.matches&&n.matches('[data-sqbfl-root]')))return true;
      if(n.querySelector&&n.querySelector('.sqbfl,[data-sqbfl-root]'))return true;
    }
    if(n.nodeType===11&&n.querySelector&&n.querySelector('.sqbfl,[data-sqbfl-root]'))return true;
    return false;
  }
  Element.prototype.replaceChildren=function(){
    if(this&&this.id==='MainContent'){
      for(var i=0;i<arguments.length;i++)if(isLegacyTakeoverNode(arguments[i]))return;
    }
    return nativeReplace.apply(this,arguments);
  };
})();
(function(){
  var q=new URLSearchParams(location.search),per=parseInt(q.get('sq_per_page')||'50',10),view=parseInt(q.get('sq_view_page')||'1',10);
  if(per!==50||view!==1||window.__sqRefineV3DefaultFetchFastPath)return;
  window.__sqRefineV3DefaultFetchFastPath=true;
  var nativeFetch=window.fetch.bind(window),used=false;
  window.fetch=function(input,init){
    try{
      var u=new URL(typeof input==='string'?input:(input&&input.url)||'',location.origin);
      if(!used&&u.origin===location.origin&&u.pathname===location.pathname&&u.searchParams.get('view')==='sq-refine-v3-products'&&String(u.searchParams.get('page')||'1')==='1'&&document.querySelector('.product-grid .product-grid__item a[href*="/products/"]')){
        used=true;
        var html='<!doctype html>'+document.documentElement.outerHTML;
        return Promise.resolve(new Response(html,{status:200,headers:{'Content-Type':'text/html'}}));
      }
    }catch(_){ }
    return nativeFetch(input,init);
  };
})();
(function(){
  if(window.__sqRefineV3OriginPlacementFix)return;
  window.__sqRefineV3OriginPlacementFix=true;
  var marker=null,done=false;
  function findNativeHost(main){
    var hosts=[].slice.call(main.querySelectorAll('collection-component'));
    for(var i=0;i<hosts.length;i++){
      if(hosts[i].closest('.sq-refine-v3-layout'))continue;
      if(hosts[i].querySelector('.product-grid'))return hosts[i];
    }
    return null;
  }
  function reconcile(){
    if(done)return true;
    var main=document.getElementById('MainContent');if(!main)return false;
    if(!marker){
      var host=findNativeHost(main);
      if(host&&host.parentNode){
        marker=document.createElement('span');
        marker.hidden=true;
        marker.setAttribute('aria-hidden','true');
        marker.setAttribute('data-sq-refine-v3-origin-marker','true');
        host.parentNode.insertBefore(marker,host);
      }
    }
    var layout=main.querySelector('.sq-refine-v3-layout');
    if(marker&&marker.isConnected&&layout&&layout!==marker.parentNode){
      marker.parentNode.insertBefore(layout,marker);
      marker.remove();
      done=true;
      main.dataset.sqRefineV3Placement='original-product-position';
      return true;
    }
    return false;
  }
  var root=document.body||document.documentElement;
  var observer=new MutationObserver(function(){if(reconcile()){observer.disconnect()}});
  observer.observe(root,{childList:true,subtree:true});
  queueMicrotask(reconcile);
  document.addEventListener('DOMContentLoaded',function(){reconcile();setTimeout(reconcile,0);setTimeout(reconcile,500)},{once:true});
})();
</script>
