{% assign sq_v3_isolation_roots = 'accessories-gifts-collectibles,airsoft-milsim,apparel,armed-forces-gear,art,body-armor-ballistic-protection,literature,child-safety-shop,dive-scuba,firearm-accessories,first-aid-medical-ifak,flags-patriotic-decor,flashlights-lighting,footwear-gloves-eyewear,k9-dog-gear,knives-axes-cutlery,morale-patches-tactical-id,outdoor-preparedness-gear,patriotic-american-heritage,safety-rescue-climbing,sta-brite-insignia,tactical-gear,thin-line,uniforms,watches,zippos-lighters-torches,stateside-quartermaster-logo-merch,army-national-guard-series,air-national-guard-series,products-built-for-the-line-u-s-army,products-built-for-the-line-u-s-navy,products-built-for-the-line-u-s-air-force,products-built-for-the-line-u-s-marine-corps,products-built-for-the-line-u-s-coast-guard,products-built-for-the-line-u-s-space-force,rotc-series,jrotc-series,military-schools-academies,law-enforcement-corrections,firefighting-ems-search-rescue' | split: ',' %}
{% if request.page_type == 'collection' and sq_v3_isolation_roots contains collection.handle %}
<script data-sq-refine-v3-legacy-isolation="{{ collection.handle | escape }}">
window.__sqGlobalRefineAuthorityV2=true;
window.__sqGlobalRefineVisibleSurfaceFix=true;
window.__sqCategoryUniverseV5=true;
window.__sqGlobalRefineCheckboxControls=true;
(function(){
  var q=new URLSearchParams(location.search),per=parseInt(q.get('sq_per_page')||'50',10),view=parseInt(q.get('sq_view_page')||'1',10);
  if(per!==50||view!==1||window.__sqRefineV3DefaultFetchFastPath)return;
  window.__sqRefineV3DefaultFetchFastPath=true;
  var nativeFetch=window.fetch.bind(window),used=false;
  window.fetch=function(input,init){
    try{
      var u=new URL(typeof input==='string'?input:(input&&input.url)||'',location.origin);
      if(!used&&u.origin===location.origin&&u.pathname===location.pathname&&u.searchParams.get('view')==='sq-refine-v3-products'&&String(u.searchParams.get('page')||'1')==='1'&&document.querySelector('.product-grid .product-grid__item a[href*="/products/"]')){
        used=true;
        var html='<!doctype html>'+document.documentElement.outerHTML;
        return Promise.resolve(new Response(html,{status:200,headers:{'Content-Type':'text/html'}}));
      }
    }catch(_){ }
    return nativeFetch(input,init);
  };
})();
</script>
{% endif %}
