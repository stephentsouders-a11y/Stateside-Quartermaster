  function firstColorVariant(p,color){var vs=(p.variants||[]).filter(function(v){return v.available===true});for(var i=0;i<vs.length;i++)if(colorMatchText(variantText(vs[i]),color))return vs[i];return null}
  function productColorFallback(p,color){var s=txt(p);if(color==='OCP / Multicam Gear')return (/\b(ocp|scorpion)\b|multi ?cam/.test(s)&&!/multi ?cam black|mcamblk|mcam blk/.test(s));if(color==='Coyote Brown Gear')return /\bcoyote\b|color\/pattern: coyote/.test(s);if(color==='Black Gear')return /\bblack\b|color\/pattern: black/.test(s);return false}
  function colorEntry(p,color){var v=firstColorVariant(p,color);if(v||productColorFallback(p,color))return {p:p,variant:v,color:color};return null}
  function fieldType(entry){var p=entry.p||entry,s=txt(p);if(/plate carrier|body armor|armor plate|ballistic plate|cummerbund|soft armor|hard armor/.test(s))return'Body Armor & Plate Carriers';if(/helmet|head protection/.test(s))return'Helmets & Head Protection';if(/chest rig|load carriage|fight load carrier|tactical vest|load-bearing vest|load bearing vest/.test(s)&&!/plate carrier/.test(s))return'Chest Rigs & Load Carriage';if(/backpack|rucksack|assault pack|day pack|tactical pack|\bbag\b/.test(s))return'Packs & Bags';if(/pouch|organizer|placard|mag pouch/.test(s))return'Pouches & Organizers';if(/battle belt|war belt|tactical belt|duty belt/.test(s))return'Tactical Belts';if(/hydration|canteen|water bladder|reservoir/.test(s))return'Hydration';if(/\b(ifak|first aid|medical|trauma|tourniquet)\b/.test(s))return'Medical & IFAK';return'Other Tactical Gear'}
  async function fieldProducts(){if(fieldCache)return fieldCache;fieldCache=(async function(){var parts=await Promise.all(FIELD_SOURCES.map(function(h){return collection(h,3)}));return unique([].concat.apply([],parts))})();return fieldCache}
  async function colorEntries(color){var a=await fieldProducts(),out=[];a.forEach(function(p){var e=colorEntry(p,color);if(e)out.push(e)});return out}
  async function renderEquipment(view){if(!type){var entries=await Promise.all(COLOR_ORDER.map(colorEntries)),g={};COLOR_ORDER.forEach(function(k,i){g[k]=entries[i]});view.innerHTML=head('Equipment & Field Gear','Shop Field Gear by Color',route({sg_org:org}),'← Shop by Category','OCP/Multicam, Coyote Brown and Black gear are separated by color before product type.')+'<div class="sqsg-grid">'+grid(g,COLOR_ORDER,function(k){return route({sg_org:org,sg_category:'equipment',sg_type:k})})+'</div>';view.dataset.sqEquipmentAuthority='colors';return}if(COLOR_ORDER.indexOf(type)===-1){location.replace(route({sg_org:org,sg_category:'equipment'}));return}var entries=await colorEntries(type);if(!component){var g=groupsBy(entries,fieldType);view.innerHTML=head(type,'Shop '+type+' by Type',route({sg_org:org,sg_category:'equipment'}),'← Field Gear Colors',entries.length+' '+(entries.length===1?'item':'items')+' available in this color family.')+'<div class="sqsg-grid">'+grid(g,FIELD_TYPE_ORDER,function(k){return route({sg_org:org,sg_category:'equipment',sg_type:type,sg_component:k})})+'</div>';view.dataset.sqEquipmentAuthority='types';return}var fp=entries.filter(function(e){return fieldType(e)===component});view.innerHTML=head(type,component,route({sg_org:org,sg_category:'equipment',sg_type:type}),'← '+type,fp.length+' '+(fp.length===1?'item':'items'))+section(type.toUpperCase(),fp)+(fp.length?'':'<div class="sqsg-empty">No customer-purchasable items are currently available in this selection.</div>');view.dataset.sqEquipmentAuthority='final'}
  function findCard(view,label){return [].slice.call(view.querySelectorAll('.sqsg-card')).find(function(a){var x=a.querySelector('strong');return x&&n(x.textContent)===n(label)})}
  function setCount(a,nv){if(!a)return;var s=a.querySelector('small');if(s)s.textContent=nv+' '+(nv===1?'item':'items');a.dataset.sqItemCount=String(nv)}
  async function rootCounts(view){var pools=await Promise.all(SYSTEM_ORDER.map(uniformPool)),allUniform=unique([].concat.apply([],pools)),field=await fieldProducts(),fieldRelevant=field.filter(function(p){return COLOR_ORDER.some(function(c){return !!colorEntry(p,c)})});setCount(findCard(view,'Uniforms'),allUniform.length);setCount(findCard(view,'Equipment & Field Gear'),fieldRelevant.length);view.dataset.sqAuthorityCounts='ready'}
  function wait(){var tries=0,t=setInterval(async function(){tries++;var view=root.querySelector('[data-sqsg-view]');if(!view||!view.querySelector('.sqsg-grid,.sqsg-products,.sqsg-empty')){if(tries>80)clearInterval(t);return}clearInterval(t);try{if(cat==='uniforms')await renderUniforms(view);else if(cat==='equipment')await renderEquipment(view);else if(!cat){view.dataset.sqAuthorityCounts='native-root-fast'}}catch(e){view.dataset.sqAuthorityError='true'}},100)}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',wait,{once:true});else wait();
})();
