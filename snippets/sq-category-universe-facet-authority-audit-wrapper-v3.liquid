{% doc %}
Preserves the audited category-universe facet behavior while loading each Shop by Category card's exact collection destination, including tagged collection subpaths. Availability and preview-only query parameters are excluded. The legacy main-page Manufacturer/Color browser is skipped whenever the modern Refine sidebar exists, preventing redundant catalog hydration and rate-limit contention.
{% enddoc %}
{% capture sq_v2 %}{% render 'sq-category-universe-facet-authority-audit-wrapper-v2' %}{% endcapture %}
{% capture sq_old_handle %}function handle(a){try{var m=new URL(a.href,location.origin).pathname.match(/^\/collections\/([^/]+)/);return m?decodeURIComponent(m[1]):''}catch(_){return''}}{% endcapture %}
{% capture sq_new_handle %}function route(a){try{var u=new URL(a.href,location.origin);if(!/^\/collections\//.test(u.pathname))return'';u.searchParams.delete('filter.v.availability');u.searchParams.delete('preview_theme_id');u.searchParams.delete('page');u.searchParams.delete('limit');var q=u.searchParams.toString();return u.pathname.replace(/\/$/,'')+(q?'?'+q:'')}catch(_){return''}}{% endcapture %}
{% capture sq_old_load %}async function load(h){var out=[],seen={};for(var pg=1;pg<=24;pg++){var r=await fetch(root()+'collections/'+encodeURIComponent(h)+'/products.json?limit=250&page='+pg,{credentials:'same-origin'});if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(!hidden(p)&&p.handle&&!seen[p.handle]){seen[p.handle]=1;out.push(p)}});if(a.length<250)break}return out}{% endcapture %}
{% capture sq_new_load %}async function load(routePath){var out=[],seen={};for(var pg=1;pg<=24;pg++){var u=new URL(routePath,location.origin);u.pathname=u.pathname.replace(/\/$/,'')+'/products.json';u.searchParams.set('limit','250');u.searchParams.set('page',String(pg));var r=await fetch(u.pathname+'?'+u.searchParams.toString(),{credentials:'same-origin'});if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(!hidden(p)&&p.handle&&!seen[p.handle]){seen[p.handle]=1;out.push(p)}});if(a.length<250)break}return out}{% endcapture %}
{% capture sq_old_start %}async function start(){var links=[].slice.call(main.querySelectorAll('.sq-subcategory-card[href*="/collections/"]')),hs=[];links.forEach(function(a){var h=handle(a);if(h&&hs.indexOf(h)<0)hs.push(h)});if(!hs.length)return;var batches=await Promise.all(hs.map(load)),seen={},union=[];batches.forEach(function(a){a.forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;union.push(p)}})});if(union.length)build(union)}{% endcapture %}
{% capture sq_new_start %}async function start(){var links=[].slice.call(main.querySelectorAll('.sq-subcategory-card[href*="/collections/"]')),routes=[];links.forEach(function(a){var r=route(a);if(r&&routes.indexOf(r)<0)routes.push(r)});if(!routes.length)return;var batches=await Promise.all(routes.map(load)),seen={},union=[];batches.forEach(function(a){a.forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;union.push(p)}})});if(union.length)build(union)}{% endcapture %}
{% capture sq_old_launch %}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(start,350)},{once:true});else setTimeout(start,350);{% endcapture %}
{% capture sq_new_launch %}function sqLegacyLaunch(){var q=new URLSearchParams(location.search);if(q.get('sq_maker')||q.get('filter.p.vendor')||q.get('sq_color_pattern')||document.querySelector('.sq-global-refine-sidebar'))return;setTimeout(function(){if(document.querySelector('.sq-global-refine-sidebar'))return;start()},6000)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',sqLegacyLaunch,{once:true});else sqLegacyLaunch();{% endcapture %}
{{ sq_v2 | replace: sq_old_handle, sq_new_handle | replace: sq_old_load, sq_new_load | replace: sq_old_start, sq_new_start | replace: sq_old_launch, sq_new_launch }}
