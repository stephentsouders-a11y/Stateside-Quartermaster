{% doc %}
Removes unsafe Literature Author refine groups immediately when legacy V3 builders insert them. Only verified native Author: / Book Author: tag controls or the transitional collection-local sq_author controls may survive. Search-derived or malformed author controls are never allowed to remain customer-interactive.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle == 'literature' %}
<script data-sq-refine-v3-literature-author-safety>
(function(){
  var main=document.getElementById('MainContent');if(!main)return;
  var cleaning=false,observer=null;
  function clean(){
    if(cleaning)return false;cleaning=true;
    var side=main.querySelector('.sq-refine-v3-sidebar');
    if(!side){cleaning=false;return false}
    [].slice.call(side.querySelectorAll(':scope > details.sq-refine-v3-group')).forEach(function(group){
      var summary=group.querySelector(':scope > summary');
      var label=(summary&&summary.textContent||'').replace(/\s+/g,' ').trim();
      if(label!=='Shop by Author')return;
      var inputs=[].slice.call(group.querySelectorAll('input[type="checkbox"]'));
      var unsafe=!inputs.length||inputs.some(function(input){
        var option=(input.closest('label')&&input.closest('label').textContent||input.parentElement&&input.parentElement.textContent||'').replace(/\s+/g,' ').trim();
        var target=input.dataset.target||'';
        var legacySafe=input.dataset.kind==='author'&&target.indexOf('/collections/literature?')===0&&target.indexOf('sq_author=')>-1;
        var tagSafe=input.dataset.kind==='native'&&input.dataset.filterName==='filter.p.tag'&&/^(author|book author)\s*:\s*.+/i.test(input.dataset.filterValue||'');
        return !(legacySafe||tagSafe)||option.length>90||/(?:description|paperback|hardcover|publisher|publication date|language|print length|isbn)/i.test(option);
      });
      if(unsafe)group.remove();
    });
    if(!observer){
      observer=new MutationObserver(function(){queueMicrotask(clean)});
      observer.observe(side,{childList:true,subtree:true});
    }
    cleaning=false;return true;
  }
  clean();
  var tries=0,t=setInterval(function(){if(clean()&&++tries>20)clearInterval(t);else if(++tries>80)clearInterval(t)},50);
  window.addEventListener('load',clean,{once:true});
})();
</script>
{% endif %}
