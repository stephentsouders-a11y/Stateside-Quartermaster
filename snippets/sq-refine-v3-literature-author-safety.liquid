{% doc %}
Removes only an unsafe Literature Author refine group when its options are malformed or are not backed by collection routes. This prevents search-derived/free-text author controls from misleading customers. Other Literature refinements remain intact.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle == 'literature' %}
<script data-sq-refine-v3-literature-author-safety>
(function(){
  const main=document.getElementById('MainContent');
  if(!main)return;
  function clean(){
    const side=main.querySelector('.sq-refine-v3-sidebar');
    if(!side)return false;
    for(const group of side.querySelectorAll(':scope > details.sq-refine-v3-group')){
      const label=(group.querySelector(':scope > summary')?.textContent||'').replace(/\s+/g,' ').trim();
      if(label!=='Shop by Author')continue;
      const inputs=[...group.querySelectorAll('input[type="checkbox"]')];
      const unsafe=!inputs.length || inputs.some(function(input){
        const option=(input.closest('label')?.textContent||input.parentElement?.textContent||'').replace(/\s+/g,' ').trim();
        const target=input.dataset.target||'';
        return option.length>90 || /(?:description|paperback|hardcover|publisher|publication date|language|print length|isbn)/i.test(option) || !target.startsWith('/collections/');
      });
      if(unsafe)group.remove();
    }
    return true;
  }
  clean();
  setTimeout(clean,500);
  setTimeout(clean,1200);
  setTimeout(clean,2500);
  setTimeout(clean,4000);
})();
</script>
{% endif %}
