{% if request.page_type == 'collection' %}
<style data-sq-refine-checkbox-controls>
#MainContent .sq-global-refine-sidebar__choice{display:flex!important;align-items:center!important;gap:9px!important;min-height:38px!important;padding:7px 8px!important;border:1px solid #e0e5e8!important;border-radius:7px!important;background:#f8f9f8!important;color:#071d2d!important;font-size:12px!important;font-weight:800!important;line-height:1.2!important;cursor:default!important}
#MainContent .sq-global-refine-sidebar__choice:hover{border-color:#a91827!important;background:#fff!important}
#MainContent .sq-global-refine-sidebar__choice input{appearance:none!important;-webkit-appearance:none!important;width:18px!important;height:18px!important;min-width:18px!important;margin:0!important;border:2px solid #7b8790!important;border-radius:3px!important;background:#fff!important;display:grid!important;place-items:center!important;cursor:pointer!important}
#MainContent .sq-global-refine-sidebar__choice input:checked{border-color:#a91827!important;background:#a91827!important}
#MainContent .sq-global-refine-sidebar__choice input:checked::after{content:'×'!important;color:#fff!important;font-size:16px!important;font-weight:900!important;line-height:1!important;transform:translateY(-1px)!important}
#MainContent .sq-global-refine-sidebar__choice input:focus-visible{outline:3px solid #d5ab4b!important;outline-offset:2px!important}
#MainContent .sq-global-refine-sidebar__choice>span{min-width:0!important;flex:1 1 auto!important;cursor:default!important;pointer-events:none!important}
#MainContent .sq-global-refine-sidebar__choice>small{flex:0 0 auto!important;color:#66737b!important;font-size:10px!important;font-weight:800!important;cursor:default!important;pointer-events:none!important}
#MainContent .sq-global-refine-sidebar__choice[data-active='true']{border-color:#a91827!important;box-shadow:inset 3px 0 0 #a91827!important;background:#fff!important}
#MainContent .sq-global-refine-sidebar label:has(input[type='checkbox']),#MainContent .sq-global-refine-sidebar a:has(input[type='checkbox']),#MainContent .sq-refine-taxonomy label:has(input[type='checkbox']),#MainContent .sq-refine-taxonomy a:has(input[type='checkbox']){cursor:default!important}
#MainContent .sq-global-refine-sidebar label:has(input[type='checkbox']) input[type='checkbox'],#MainContent .sq-global-refine-sidebar a:has(input[type='checkbox']) input[type='checkbox'],#MainContent .sq-refine-taxonomy label:has(input[type='checkbox']) input[type='checkbox'],#MainContent .sq-refine-taxonomy a:has(input[type='checkbox']) input[type='checkbox']{cursor:pointer!important}
</style>
<script data-sq-refine-checkbox-controls data-sq-refine-checkbox-navigation="history-v5-box-only">
(function(){
if(window.__sqRefineCheckboxControlsV5)return;window.__sqRefineCheckboxControlsV5=true;window.__sqRefineCheckboxControlsV4=true;window.__sqRefineCheckboxControlsV3=true;window.__sqRefineCheckboxControlsV2=true;window.__sqRefineCheckboxControls=true;
var main=document.getElementById('MainContent');if(!main)return;var timer=null,busy=false;
function txt(el){return String(el&&el.textContent||'').replace(/\s+/g,' ').trim()}
function norm(s){return String(s||'').trim().toLowerCase().replace(/\s+/g,' ')}
function currentVendor(){var u=new URL(location.href);return u.searchParams.get('sq_maker')||u.searchParams.get('filter.p.vendor')||''}
function nextUrl(v,on){var u=new URL(location.href);u.searchParams.delete('page');u.searchParams.delete('filter.v.availability');u.searchParams.delete('sq_maker');u.searchParams.delete('filter.p.vendor');if(on&&v){u.searchParams.set('sq_maker',v);u.searchParams.set('filter.p.vendor',v)}return u.pathname+(u.search?'?'+u.searchParams.toString():'')}
function manufacturerDetails(side){return [].slice.call(side.querySelectorAll('details')).find(function(d){return /manufacturer/i.test(txt(d.querySelector(':scope>summary')))})||null}
function applyState(v,on){var next=nextUrl(v,on);history.pushState({sqRefine:true,vendor:on?v:''},'',next);window.dispatchEvent(new CustomEvent('sq:refine-controls-change',{detail:{vendor:on?v:'',active:!!on}}));queue()}
function bind(input,v){if(!input||input.dataset.bound)return;input.dataset.bound='true';input.addEventListener('change',function(ev){ev.stopPropagation();applyState(v,input.checked)})}
function blockedRowTarget(target){if(!(target instanceof Element)||target.matches('input[type="checkbox"]'))return null;var scope=target.closest('.sq-global-refine-sidebar,.sq-refine-taxonomy');if(!scope)return null;var row=target.closest('label,a,.sq-global-refine-sidebar__choice,li');if(!row||!scope.contains(row))return null;var box=row.querySelector&&row.querySelector('input[type="checkbox"]');if(!box){var parent=row.closest('.sq-global-refine-sidebar__choice,li');box=parent&&parent.querySelector&&parent.querySelector('input[type="checkbox"]')}return box?row:null}
function blockTextActivation(ev){if(!blockedRowTarget(ev.target))return;ev.preventDefault();ev.stopPropagation();if(typeof ev.stopImmediatePropagation==='function')ev.stopImmediatePropagation()}
main.addEventListener('pointerdown',blockTextActivation,true);
main.addEventListener('mousedown',blockTextActivation,true);
main.addEventListener('click',blockTextActivation,true);
function upgrade(){if(busy)return;busy=true;try{var side=main.querySelector('.sq-global-refine-sidebar');if(!side)return;var d=manufacturerDetails(side);if(!d)return;var active=norm(currentVendor());[].slice.call(d.querySelectorAll('a.sq-global-refine-sidebar__item')).forEach(function(a){var label=txt(a.querySelector('span')||a),small=a.querySelector('small');if(!label)return;var row=document.createElement('div');row.className='sq-global-refine-sidebar__choice';row.dataset.vendor=label;var checked=active&&norm(label)===active;row.dataset.active=checked?'true':'false';var input=document.createElement('input');input.type='checkbox';input.className='sq-global-refine-manufacturer-checkbox';input.value=label;input.checked=!!checked;input.setAttribute('aria-label','Show only '+label+' products');bind(input,label);var name=document.createElement('span');name.textContent=label;row.appendChild(input);row.appendChild(name);if(small){var co=document.createElement('small');co.textContent=txt(small);row.appendChild(co)}a.replaceWith(row)});[].slice.call(d.querySelectorAll('.sq-global-refine-sidebar__choice')).forEach(function(row){var input=row.querySelector('input'),v=row.dataset.vendor||'',checked=active&&norm(v)===active;if(!input)return;input.checked=!!checked;row.dataset.active=checked?'true':'false';bind(input,v)})}finally{busy=false}}
function queue(){clearTimeout(timer);timer=setTimeout(upgrade,40)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',upgrade,{once:true});else upgrade();window.addEventListener('popstate',queue);new MutationObserver(queue).observe(main,{childList:true,subtree:true});[120,350,700,1300,2200,3600,5600,8200].forEach(function(ms){setTimeout(upgrade,ms)});
})();
</script>
{% endif %}