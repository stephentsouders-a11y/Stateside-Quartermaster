{% doc %}
Accessories, Gifts & Collectibles child-route rescue. Keeps the V3 Refine Products sidebar in the first column on structural child routes (including Collectibles & Cards) and guarantees the child collection product surface remains visible. This is intentionally scoped to sq_root=accessories-gifts-collectibles and excludes State Guard.
{% enddoc %}
{% if request.page_type == 'collection' and collection.handle != 'state-guard-series' %}
<style data-sq-button01-child-route-rescue>
html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent.sq-refine-v3-active .sq-refine-v3-layout{display:grid!important;grid-template-columns:minmax(240px,1fr) minmax(0,3fr)!important;align-items:start!important}
html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-sidebar{grid-column:1!important;grid-row:1!important;align-self:start!important;display:block!important;visibility:visible!important;opacity:1!important}
html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-results{grid-column:2!important;grid-row:1!important;min-width:0!important;display:block!important;visibility:visible!important;opacity:1!important}
html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-results collection-component,html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-results results-list,html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-results .product-grid-container{display:block!important;visibility:visible!important;opacity:1!important}
html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-results .product-grid{display:grid!important;visibility:visible!important;opacity:1!important;grid-template-columns:repeat(3,minmax(0,1fr))!important}
@media (max-width:900px){html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent.sq-refine-v3-active .sq-refine-v3-layout{display:block!important}html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-sidebar,html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-results{display:block!important;width:100%!important}html[data-sq-refine-v3-child-root="accessories-gifts-collectibles"] #MainContent .sq-refine-v3-results .product-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
</style>
<script data-sq-button01-child-route-rescue>
(function(){var current={{ collection.handle | json }};var params=new URLSearchParams(location.search),root=params.get('sq_root')||current;if(root!=='accessories-gifts-collectibles'||current==='accessories-gifts-collectibles')return;var main=document.getElementById('MainContent');if(!main)return;function rescue(){var layout=main.querySelector('.sq-refine-v3-layout'),side=main.querySelector('.sq-refine-v3-sidebar'),results=main.querySelector('.sq-refine-v3-results');if(!layout||!side||!results)return false;main.classList.add('sq-refine-v3-active','sq-v3-button01-root');if(side.parentElement!==layout)layout.insertBefore(side,layout.firstChild);else if(layout.firstElementChild!==side)layout.insertBefore(side,layout.firstElementChild);if(results.parentElement!==layout)layout.appendChild(results);else if(side.nextElementSibling!==results)layout.insertBefore(results,side.nextSibling);[side,results].forEach(function(el){el.style.removeProperty('display');el.style.removeProperty('visibility');el.style.removeProperty('opacity')});results.querySelectorAll('collection-component,results-list,.product-grid-container,.product-grid').forEach(function(el){el.style.removeProperty('display');el.style.removeProperty('visibility');el.style.removeProperty('opacity')});layout.dataset.sqButton01ChildRescued='true';return true}var tries=0,t=setInterval(function(){tries++;if(rescue()||tries>180)clearInterval(t)},100);[0,100,250,500,900,1500,2500,4000,6500,9000].forEach(function(ms){setTimeout(rescue,ms)});new MutationObserver(rescue).observe(main,{childList:true,subtree:true})})();
</script>
{% endif %}
