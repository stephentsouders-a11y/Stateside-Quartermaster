{% doc %}
Builds the final left Refine Products sidebar from the exact shopper-facing collection universe. Unified PBTL, program, and Public Safety roots reuse the product universe already loaded by their customer-facing tree instead of downloading the same catalog again. Ordinary collection roots retain exact child-route union loading, with one cached pass only. Sold-out products remain included. When a Refine selection is active and no specialized synchronized product surface exists, this authority also renders the filtered results from the already-loaded universe so stale broad grids cannot contradict the selected filter.
{% enddoc %}
{% if request.page_type == 'collection' %}
  {% assign sq_shared_refine = false %}
  {% assign sq_refine_handle = collection.handle | downcase %}
  {% if sq_refine_handle == 'products-built-for-the-line-u-s-army' or sq_refine_handle == 'army-national-guard-series' or sq_refine_handle == 'products-built-for-the-line-u-s-air-force' or sq_refine_handle == 'air-national-guard-series' or sq_refine_handle == 'products-built-for-the-line-u-s-navy' or sq_refine_handle == 'products-built-for-the-line-u-s-marine-corps' or sq_refine_handle == 'products-built-for-the-line-u-s-coast-guard' or sq_refine_handle == 'products-built-for-the-line-u-s-space-force' or sq_refine_handle == 'rotc-series' or sq_refine_handle == 'jrotc-series' or sq_refine_handle == 'military-schools-academies' or sq_refine_handle == 'law-enforcement-corrections' or sq_refine_handle == 'firefighting-ems-search-rescue' %}
    {% assign sq_shared_refine = true %}
  {% endif %}
<script data-sq-global-refine-direct-data-v4>
(function(){
  if(window.__sqGlobalRefineDirectDataV4)return;window.__sqGlobalRefineDirectDataV4=true;
  var main=document.getElementById('MainContent');if(!main)return;
  var shared={{ sq_shared_refine | json }},rendered=false,routeCache={},syncTimer=null;
  function c(v){return String(v==null?'':v).trim()}
  function n(v){return c(v).toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ')}
  function e(v){return c(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
  function hidden(p){var t=n(p&&p.product_type);return !p||t==='options hidden product'||t==='options_hidden_product'}
  function routeFromUrl(raw){try{var u=new URL(raw,location.origin);if(!/^\/collections\//.test(u.pathname))return'';['filter.v.availability','preview_theme_id','page','limit','sq_maker','sq_color_pattern','filter.p.vendor'].forEach(function(k){u.searchParams.delete(k)});var q=u.searchParams.toString();return u.pathname.replace(/\/$/,'')+(q?'?'+q:'')}catch(_){return''}}
  function load(route){if(routeCache[route])return routeCache[route];routeCache[route]=(async function(){var out=[],seen={};for(var pg=1;pg<=24;pg++){var u=new URL(route,location.origin);u.pathname=u.pathname.replace(/\/$/,'')+'/products.json';u.searchParams.set('limit','250');u.searchParams.set('page',String(pg));var r;try{r=await fetch(u.pathname+'?'+u.searchParams.toString(),{credentials:'same-origin'})}catch(_){break}if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(!hidden(p)&&p.handle&&!seen[p.handle]){seen[p.handle]=1;out.push(p)}});if(a.length<250)break}return out})();return routeCache[route]}
  function colorish(v){var s=n(v);if(!s||s==='default title'||/^(xs|s|m|l|xl|xxl|2xl|3xl|4xl|5xl|6xl|small|medium|large|one size|standard)$/.test(s))return false;return /black|white|grey|gray|charcoal|red|blue|navy|green|olive|foliage|coyote|tan|khaki|brown|sand|gold|silver|orange|yellow|pink|purple|maroon|burgundy|teal|aqua|multicam|ocp|scorpion|woodland|m81|marpat|nwu|flecktarn|tropentarn|strichtarn|mtp|ucp|acu|cce|kryptek|a[- ]?tacs|tiger stripe|lizard|camo|camouflage|pattern|beige/.test(s)}
  function colors(p){var out=[],seen={};function add(v){v=c(v);var k=n(v);if(!v||seen[k]||!colorish(v))return;seen[k]=1;out.push(v)};(Array.isArray(p&&p.tags)?p.tags:[]).forEach(function(t){var raw=c(t),m=raw.match(/^(?:sq\s+)?(?:color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m)add(m[1]);else if(colorish(raw))add(raw)});var opts=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];opts.forEach(function(o,i){var name=c(typeof o==='string'?o:(o&&o.name)||'');if(/color|colour|pattern|camo|camouflage/i.test(name))vs.forEach(function(v){add(v&&v['option'+(i+1)])})});return out}
  function href(changes){var u=new URL(location.href);['filter.v.availability','preview_theme_id','page','sq_maker','sq_color_pattern','filter.p.vendor'].forEach(function(k){u.searchParams.delete(k)});Object.keys(changes||{}).forEach(function(k){var v=changes[k];if(v){u.searchParams.set(k,v);if(k==='sq_maker')u.searchParams.set('filter.p.vendor',v)}});return u.pathname+(u.searchParams.toString()?'?'+u.searchParams.toString():'')}
  function group(title,rows,param){if(!rows.length)return'';var h='<details open><summary>'+e(title)+'</summary><div class="sq-global-refine-sidebar__list">';rows.forEach(function(x){h+='<a class="sq-global-refine-sidebar__item" href="'+e(href((function(){var o={};o[param]=x.label;return o})()))+'"><span>'+e(x.label)+'</span><small>'+x.count+' items</small></a>'});return h+'</div></details>'}
  function activeFilters(){var q=new URLSearchParams(location.search);return{maker:c(q.get('sq_maker')||q.get('filter.p.vendor')),color:c(q.get('sq_color_pattern'))}}
  function visible(el){if(!el)return false;var s=getComputedStyle(el),r=el.getBoundingClientRect();return s.display!=='none'&&s.visibility!=='hidden'&&r.width>2&&r.height>2}
  function specializedResultsExist(){var sels=['[data-sq-category-universe-products]:not([data-sq-global-refine-products]) a[href*="/products/"]','[data-sq-custom-color-products] a[href*="/products/"]','.sqbfl-products a[href*="/products/"]','.sqsg-products a[href*="/products/"]','.sq-type-family-products__grid a[href*="/products/"]'];for(var i=0;i<sels.length;i++){var as=main.querySelectorAll(sels[i]);for(var j=0;j<as.length;j++)if(visible(as[j]))return true}return false}
  function imageOf(p){var x=(p&&p.featured_image)||(p&&p.image)||(p&&p.images&&p.images[0]);if(typeof x==='string')return x;return c(x&&(x.src||x.url))}
  function ensureFallbackStyle(){if(document.getElementById('sq-global-refine-products-fallback-style'))return;var st=document.createElement('style');st.id='sq-global-refine-products-fallback-style';st.textContent='#MainContent.sq-global-refine-fallback-active collection-component,#MainContent.sq-global-refine-fallback-active .product-grid,#MainContent.sq-global-refine-fallback-active #product-grid{display:none!important}.sq-global-refine-products .sq-custom-color-products__head{margin-bottom:16px}.sq-global-refine-products .sq-custom-color-product__vendor{display:block;margin-top:4px;font-size:.82rem;opacity:.72}';document.head.appendChild(st)}
  function syncFilteredProducts(ps){var f=activeFilters();if(!f.maker&&!f.color)return;clearTimeout(syncTimer);syncTimer=setTimeout(function(){if(specializedResultsExist())return;var out=(Array.isArray(ps)?ps:[]).filter(function(p){if(hidden(p))return false;if(f.maker&&n(p.vendor)!==n(f.maker))return false;if(f.color&&!colors(p).some(function(x){return n(x)===n(f.color)}))return false;return true});var old=main.querySelector('[data-sq-global-refine-products]');if(old)old.remove();ensureFallbackStyle();main.classList.add('sq-global-refine-fallback-active');var s=document.createElement('section');s.className='sq-custom-color-products sq-global-refine-products';s.dataset.sqGlobalRefineProducts='true';s.dataset.sqCategoryUniverseProducts='true';var label=[f.maker,f.color].filter(Boolean).join(' / '),h='<div class="sq-custom-color-products__wrap"><div class="sq-custom-color-products__head"><div><h2>'+e(label||'Filtered Products')+'</h2><p>'+out.length+' synchronized products. Sold-out products are included.</p></div></div>';if(out.length){h+='<div class="sq-custom-color-products__grid">';out.forEach(function(p){var src=imageOf(p);h+='<a class="sq-custom-color-product" href="/products/'+encodeURIComponent(c(p.handle))+'"><span class="sq-custom-color-product__media">'+(src?'<img src="'+e(src)+'" alt="'+e(p.title)+'" loading="lazy">':'')+'</span><span class="sq-custom-color-product__copy"><strong>'+e(p.title)+'</strong>'+(p.vendor?'<span class="sq-custom-color-product__vendor">'+e(p.vendor)+'</span>':'')+'</span></a>'});h+='</div>'}else h+='<p class="sq-global-refine-sidebar__empty">No products match the selected refinement.</p>';h+='</div>';s.innerHTML=h;var host=main.querySelector('.sq-global-refine-main')||main;host.insertBefore(s,host.firstChild);window.dispatchEvent(new CustomEvent('sq:refine-results-ready',{detail:{products:out,maker:f.maker,color:f.color}}))},500)}
  function render(ps){if(!Array.isArray(ps)||!ps.length)return false;var side=main.querySelector('.sq-global-refine-sidebar');if(!side)return false;var makers={},cm={};ps.forEach(function(p){if(hidden(p))return;var v=c(p.vendor);if(v)makers[v]=(makers[v]||0)+1;var once={};colors(p).forEach(function(x){var k=n(x);if(once[k])return;once[k]=1;if(!cm[k])cm[k]={label:x,count:0};cm[k].count++})});var m=Object.keys(makers).sort(function(a,b){return a.localeCompare(b,undefined,{numeric:true,sensitivity:'base'})}).map(function(k){return{label:k,count:makers[k]}});var cc=Object.keys(cm).sort(function(a,b){return cm[a].label.localeCompare(cm[b].label,undefined,{numeric:true,sensitivity:'base'})}).map(function(k){return cm[k]});window.__sqDirectFacetUniverse={products:ps,maker:m,color:cc};syncFilteredProducts(ps);if(side.querySelector('.sq-global-refine-manufacturer-checkbox')){rendered=true;window.dispatchEvent(new CustomEvent('sq:refine-universe-ready',{detail:window.__sqDirectFacetUniverse}));return true}side.innerHTML='<h2 class="sq-global-refine-sidebar__title" tabindex="0">Refine Products</h2>'+group('Shop by Manufacturer',m,'sq_maker')+group('Shop by Color / Pattern',cc,'sq_color_pattern');if(!m.length&&!cc.length)side.innerHTML+='<p class="sq-global-refine-sidebar__empty">No manufacturer or color / pattern refinements are available for this collection.</p>';var title=side.querySelector('.sq-global-refine-sidebar__title');if(title){title.onclick=function(){if(matchMedia('(max-width:900px)').matches)side.dataset.mobileCollapsed=side.dataset.mobileCollapsed==='true'?'false':'true'};title.onkeydown=function(ev){if((ev.key==='Enter'||ev.key===' ')&&matchMedia('(max-width:900px)').matches){ev.preventDefault();title.click()}}}rendered=true;window.dispatchEvent(new CustomEvent('sq:refine-universe-ready',{detail:window.__sqDirectFacetUniverse}));return true}
  function sharedStart(){if(render(window.__sqBflAllListedProducts))return;window.addEventListener('sq:bfl-all-listed',function(ev){render(ev&&ev.detail&&ev.detail.products)},{once:true});window.addEventListener('sq:bfl-facet-universe',function(ev){setTimeout(function(){if(!rendered&&!window.__sqBflAllListedProducts)render(ev&&ev.detail&&ev.detail.products)},80)},{once:true})}
  async function ordinaryStart(){if(rendered)return true;var links=[].slice.call(main.querySelectorAll('.sq-global-refine-main .sq-subcategory-card[href*="/collections/"]')),routes=[];links.forEach(function(a){var r=routeFromUrl(a.href);if(r&&routes.indexOf(r)<0)routes.push(r)});if(!routes.length){var current=routeFromUrl(location.href);if(current)routes=[current]}if(!routes.length)return false;var seen={},union=[],next=0;async function worker(){while(next<routes.length){var route=routes[next++],arr=await load(route);arr.forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;union.push(p)}})}}var workers=[];for(var i=0;i<Math.min(3,routes.length);i++)workers.push(worker());await Promise.all(workers);if(union.length)render(union);return rendered}
  function launch(){if(shared){sharedStart();return}setTimeout(function(){ordinaryStart().then(function(ok){if(!ok)setTimeout(ordinaryStart,1800)})},650)}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',launch,{once:true});else launch();
})();
</script>
{% endif %}