{% doc %}
Filtered-results authority for ROTC, JROTC, and Military Schools & Academies. It prefers the already-hydrated BFL/Refine universe. Only when an active refinement has zero in-memory matches does it make one deduplicated, sequential pass over the current military root collection so a Manufacturer advertised by Refine can always produce its matching cards.
{% enddoc %}
{% if request.page_type == 'collection' %}
{% assign sq_military_filter_handle = collection.handle | downcase %}
{% if sq_military_filter_handle == 'rotc-series' or sq_military_filter_handle == 'jrotc-series' or sq_military_filter_handle == 'military-schools-academies' %}
<style data-sq-military-filtered-results-bridge-v1>
#MainContent.sq-military-filter-active .sqbfl-products,#MainContent.sq-military-filter-active .sqbfl-grid,#MainContent.sq-military-filter-active .sqaca-grid,#MainContent.sq-military-filter-active .sqaca-products,#MainContent.sq-military-filter-active .sq-type-family-products__grid{display:none!important}#MainContent .sq-military-filtered-products{display:block!important;width:100%;padding:0 0 42px}#MainContent .sq-military-filtered-products .sq-custom-color-products__grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:16px!important}#MainContent .sq-military-filtered-products .sq-custom-color-product__vendor{display:block;margin-top:5px;font-size:.82rem;opacity:.72}@media(max-width:900px){#MainContent .sq-military-filtered-products .sq-custom-color-products__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@media(max-width:600px){#MainContent .sq-military-filtered-products .sq-custom-color-products__grid{grid-template-columns:1fr!important}}
</style>
<script data-sq-military-filtered-results-bridge-v1 data-handle="{{ collection.handle | escape }}">
(function(){
 if(window.__sqMilitaryFilteredResultsBridgeV1)return;window.__sqMilitaryFilteredResultsBridgeV1=true;
 var boot=document.currentScript,handle=boot&&boot.dataset.handle||'',main=document.getElementById('MainContent');if(!main||!handle)return;
 function c(v){return String(v==null?'':v).trim()}function n(v){return c(v).toLowerCase().replace(/[_-]+/g,' ').replace(/\s+/g,' ')}function e(v){return c(v).replace(/[&<>"']/g,function(k){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[k]})}
 function active(){var q=new URLSearchParams(location.search);return{maker:c(q.get('sq_maker')||q.get('filter.p.vendor')),color:c(q.get('sq_color_pattern'))}}
 function key(f){return n(f.maker)+'|'+n(f.color)}
 function hidden(p){var t=n(p&&p.product_type);return !p||t==='options hidden product'||t==='options_hidden_product'}
 function colors(p){var out=[],seen={};function add(v){v=c(v);var k=n(v);if(v&&!seen[k]){seen[k]=1;out.push(v)}};(Array.isArray(p&&p.tags)?p.tags:[]).forEach(function(t){var m=c(t).match(/^(?:sq\s+)?(?:color\s*\/\s*pattern|color|colour|pattern|camo|camouflage)\s*:\s*(.+)$/i);if(m)add(m[1])});var os=Array.isArray(p&&p.options)?p.options:[],vs=Array.isArray(p&&p.variants)?p.variants:[];os.forEach(function(o,i){var name=c(typeof o==='string'?o:o&&o.name);if(/color|colour|pattern|camo|camouflage/i.test(name))vs.forEach(function(v){add(v&&v['option'+(i+1)])})});return out}
 function match(p,f){if(hidden(p))return false;if(f.maker&&n(p.vendor)!==n(f.maker))return false;if(f.color&&!colors(p).some(function(x){return n(x)===n(f.color)}))return false;return true}
 function image(p){var x=(p&&p.featured_image)||(p&&p.image)||(p&&p.images&&p.images[0]);if(typeof x==='string')return x;return c(x&&(x.src||x.url))}
 function universe(detail){if(detail&&Array.isArray(detail.products)&&detail.products.length)return detail.products;if(window.__sqDirectFacetUniverse&&Array.isArray(window.__sqDirectFacetUniverse.products)&&window.__sqDirectFacetUniverse.products.length)return window.__sqDirectFacetUniverse.products;if(Array.isArray(window.__sqBflAllListedProducts)&&window.__sqBflAllListedProducts.length)return window.__sqBflAllListedProducts;if(Array.isArray(window.__sqBflProgressProducts)&&window.__sqBflProgressProducts.length)return window.__sqBflProgressProducts;return[]}
 var fallbackByKey={},fallbackInflight={};
 async function rootFallback(f){var k=key(f);if(fallbackByKey[k])return fallbackByKey[k];if(fallbackInflight[k])return fallbackInflight[k];fallbackInflight[k]=(async function(){var out=[],seen={};for(var pg=1;pg<=24;pg++){var r;try{r=await fetch('/collections/'+encodeURIComponent(handle)+'/products.json?limit=250&page='+pg,{credentials:'same-origin'})}catch(_){break}if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(p&&p.handle&&!seen[p.handle]&&match(p,f)){seen[p.handle]=1;out.push(p)}});if(a.length<250)break;await new Promise(function(resolve){setTimeout(resolve,120)})}fallbackByKey[k]=out;delete fallbackInflight[k];return out})();return fallbackInflight[k]}
 function paint(out,f){var old=main.querySelector('[data-sq-military-filtered-products]');if(old)old.remove();var s=document.createElement('section');s.className='sq-custom-color-products sq-military-filtered-products';s.dataset.sqMilitaryFilteredProducts='true';s.dataset.sqFilteredProductSurfaceGuardProducts='true';s.dataset.sqCategoryUniverseProducts='true';var label=[f.maker,f.color].filter(Boolean).join(' / '),h='<div class="sq-custom-color-products__wrap"><div class="sq-custom-color-products__head"><div><h2>'+e(label||'Filtered Products')+'</h2><p>'+out.length+' synchronized products. Sold-out products are included.</p></div></div>';if(out.length){h+='<div class="sq-custom-color-products__grid">';out.forEach(function(p){var src=image(p);h+='<a class="sq-custom-color-product" href="/products/'+encodeURIComponent(c(p.handle))+'"><span class="sq-custom-color-product__media">'+(src?'<img src="'+e(src)+'" alt="'+e(p.title)+'" loading="lazy" decoding="async">':'')+'</span><span class="sq-custom-color-product__copy"><strong>'+e(p.title)+'</strong>'+(p.vendor?'<span class="sq-custom-color-product__vendor">'+e(p.vendor)+'</span>':'')+'</span></a>'});h+='</div>'}else h+='<p class="sq-global-refine-sidebar__empty">No products match the selected refinement yet.</p>';h+='</div>';s.innerHTML=h;var host=main.querySelector('.sq-global-refine-main')||main;host.insertBefore(s,host.firstChild);main.classList.add('sq-military-filter-active');window.dispatchEvent(new CustomEvent('sq:military-filtered-results-ready',{detail:{products:out,maker:f.maker,color:f.color}}));return out.length>0}
 function render(ps){var f=active();if(!f.maker&&!f.color){main.classList.remove('sq-military-filter-active');var old=main.querySelector('[data-sq-military-filtered-products]');if(old)old.remove();return false}var seen={},all=[];(Array.isArray(ps)?ps:[]).forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;all.push(p)}});var cached=fallbackByKey[key(f)]||[];cached.forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;all.push(p)}});var out=all.filter(function(p){return match(p,f)});paint(out,f);if(!out.length&&!fallbackInflight[key(f)]&&!fallbackByKey[key(f)])rootFallback(f).then(function(extra){if(key(active())===key(f))paint(extra,f)});return out.length>0}
 function consume(d){return render(universe(d))}
 window.addEventListener('sq:refine-universe-ready',function(ev){setTimeout(function(){consume(ev&&ev.detail)},20)});window.addEventListener('sq:bfl-all-listed',function(ev){setTimeout(function(){consume(ev&&ev.detail)},20)});window.addEventListener('sq:bfl-facet-universe',function(ev){setTimeout(function(){consume(ev&&ev.detail)},20)});window.addEventListener('sq:bfl-progress',function(ev){setTimeout(function(){consume(ev&&ev.detail)},20)});
 var tries=0,iv=setInterval(function(){tries++;consume();if(tries>=100)clearInterval(iv)},150);consume();
})();
</script>
