{% assign sq_pbtl_collection = false %}{% if request.page_type == 'collection' %}{% case collection.handle %}{% when 'stateside-quartermaster-logo-merch', 'army-national-guard-series', 'air-national-guard-series', 'products-built-for-the-line-u-s-army', 'products-built-for-the-line-u-s-navy', 'products-built-for-the-line-u-s-air-force', 'products-built-for-the-line-u-s-marine-corps', 'products-built-for-the-line-u-s-coast-guard', 'products-built-for-the-line-u-s-space-force', 'rotc-series', 'jrotc-series', 'military-schools-academies' %}{% assign sq_pbtl_collection = true %}{% endcase %}{% endif %}
<!doctype html>
<html{% if request.design_mode %} class="shopify-design-mode"{% endif %} lang="{{ request.locale.iso_code }}">
  <head>
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{%- endif -%}
    {% assign sq_legacy_collection = false %}{% if request.page_type == 'collection' %}{% if collection.title contains 'LEGACY' %}{% assign sq_legacy_collection = true %}{% endif %}{% case collection.handle %}{% when 'literature-legacy-contaminated', 'notebooks-books-manuals', 'gift-cards', 'army-national-guard-series-legacy', 'armyng-national-guard-items', 'airng-air-national-guard-items', 'jrotc', 'jrotc-series-legacy', 'military-schools-academies-legacy', 'army', 'air-force', 'national-guard', 'rotc', 'apparel-uniforms', 'body-armor', 'survival-emergency-preparedness', 'survival-preparedness', 'outdoor-survival-emergency-preparedness' %}{% assign sq_legacy_collection = true %}{% endcase %}{% endif %}
    {% assign sq_block_splitshops_product = false %}{% if request.page_type == 'product' and product.vendor == 'Books by splitShops' %}{% assign sq_splitshops_relevant = false %}{% if product.tags contains 'Military' %}{% assign sq_splitshops_relevant = true %}{% endif %}{% if product.tags contains 'Literature Relevant' %}{% assign sq_splitshops_relevant = true %}{% endif %}{% unless sq_splitshops_relevant %}{% assign sq_block_splitshops_product = true %}{% endunless %}{% endif %}
    {% assign sq_block_option_helper = false %}{% if request.page_type == 'product' and product.type == 'OPTIONS_HIDDEN_PRODUCT' %}{% assign sq_block_option_helper = true %}{% endif %}
    {% if sq_legacy_collection or sq_block_splitshops_product or sq_block_option_helper %}<meta name="robots" content="noindex,nofollow">{% endif %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}{% style %}@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }{% endstyle %}{% unless sq_pbtl_collection %}<link rel="expect" href="#MainContent" blocking="render" id="view-transition-render-blocker">{% endunless %}{% endif %}
    {%- render 'meta-tags' -%}{%- render 'stylesheets' -%}{%- render 'fonts' -%}{%- render 'scripts' -%}{%- render 'theme-styles-variables' -%}{%- render 'color-palette' -%}{% if request.design_mode %}{%- render 'theme-editor' -%}{% endif %}
    {% if request.page_type == 'index' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":{{ shop.name | json }},"url":{{ shop.url | json }}}</script>{% elsif request.page_type == 'collection' and sq_legacy_collection == false %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":{{ collection.title | json }},"url":{{ canonical_url | json }},"description":{{ collection.description | strip_html | strip | json }},"isPartOf":{"@type":"WebSite","name":{{ shop.name | json }},"url":{{ shop.url | json }}}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}]}</script>{% elsif request.page_type == 'product' and sq_block_splitshops_product == false and sq_block_option_helper == false %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":{{ product.title | json }},"item":{{ canonical_url | json }}}]}</script>{% endif %}
    {{ content_for_header }}
  </head>
  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}{% render 'chat-drawer' %}{% render 'sqm-contact-success' %}
    <div class="page-wrapper"><div id="header-group">{% sections 'header-group' %}</div>{% render 'sq-mobile-navigation' %}{% render 'sq-pbtl-series-link-prefetch' %}
      <script>(function setHeaderHeighCustomProperties(){const header=document.querySelector('header-component');const headerGroup=document.querySelector('#header-group');const hasHeaderSection=headerGroup?.querySelector('.header-section');if(!header||!headerGroup)return;const headerTopRow=header.querySelector('.header__row--top');const headerHeight=header.offsetHeight;let headerGroupHeight=0;const children=headerGroup.children;for(let i=0;i<children.length;i++){const element=children[i];if(element===header||!(element instanceof HTMLElement))continue;headerGroupHeight+=element.offsetHeight;}if(header.hasAttribute('transparent')&&header.parentElement?.nextElementSibling){headerGroupHeight+=headerHeight;}document.body.style.setProperty('--header-height',`${headerHeight}px`);document.body.style.setProperty('--header-group-height',`${headerGroupHeight}px`);if(headerTopRow){window.requestAnimationFrame(function(){document.body.style.setProperty('--top-row-height',`${headerTopRow.offsetHeight}px`);});}if(!hasHeaderSection||!header?.hasAttribute('transparent')){document.body.style.setProperty('--transparent-header-offset-boolean','0');return;}const hasImmediateSection=hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');document.body.style.setProperty('--transparent-header-offset-boolean',!hasImmediateSection?'1':'0');})();(function setHeaderMenuStyle(){const headerComponent=document.querySelector('#header-component');if(headerComponent){const isTouchDevice='ontouchstart' in window&&navigator.maxTouchPoints>0;const overflowList=headerComponent?.querySelector('overflow-list');const hasReachedMinimum=overflowList&&overflowList.hasAttribute('minimum-reached');headerComponent.dataset.menuStyle=isTouchDevice||hasReachedMinimum?'drawer':'menu';}})();</script>
      {% render 'sq-air-force-semantic-preload' %}{% render 'sq-navy-semantic-preload' %}{% render 'sq-army-semantic-preload' %}{% render 'sq-pbtl-fetch-resilience' %}{% render 'sq-pbtl-image-performance' %}{% render 'sq-pbtl-shop-all-fast' %}{% render 'sq-pbtl-final-audit-fixes' %}{% render 'sq-state-guard-pt-placeholder-shield' %}{% render 'sq-polartec-black-routing' %}{% render 'sq-state-guard-pt-category-lock' %}{% render 'sq-refine-v3-legacy-isolation' %}<main id="MainContent" class="content-for-layout" role="main" data-page-transition-enabled="{{ settings.page_transition_enabled }}" data-product-transition="{{ settings.transition_to_main_product }}" data-template="{{ template }}">{% if sq_block_option_helper %}<section style="max-width:760px;margin:72px auto;padding:36px 24px;text-align:center" aria-labelledby="sq-helper-unavailable-title"><h1 id="sq-helper-unavailable-title">Option unavailable as a standalone product</h1><p>This item is an internal customization option and is not sold separately.</p><p><a href="/collections/all">Continue shopping</a></p></section>{% elsif sq_block_splitshops_product %}<section style="max-width:760px;margin:72px auto;padding:36px 24px;text-align:center" aria-labelledby="sq-product-unavailable-title"><h1 id="sq-product-unavailable-title">Product unavailable</h1><p>This item is not currently available from Stateside Quartermaster.</p><p><a href="/collections/literature">Browse Books, Literature, Manuals &amp; Reference</a></p></section>{% else %}{{ content_for_layout }}{% endif %}</main>{% render 'sq-refine-v3-sidebar-polish' %}
      <footer>{% sections 'footer-group' %}{% render 'sq-footer-trust' %}</footer></div>
    {% render 'cart-drawer', render_wrapper: true %}{% render 'theme-drawer' %}{% render 'search-modal' %}{% if settings.quick_add or settings.mobile_quick_add %}{% render 'quick-add-modal' %}{% endif %}{% render 'sqm-native-contact-reference' %}{% render 'sq-storefront-content-guard' %}{% render 'sq-navigation-button-parity' %}{% render 'sq-afg-curated-images' %}{% render 'sq-global-army-apparel-card-master' %}{% render 'sq-navigation-legacy-normalizer' %}{% render 'sq-downstream-button-master' %}{% render 'sq-guard-semantic-bridge' %}{% render 'sq-military-semantic-priority' %}{% render 'sq-downstream-card-dedupe' %}{% render 'sq-pbtl-visual-audit-overlay' %}{% render 'sq-air-force-audit-fixes' %}{% render 'sq-state-guard-audit-overlay' %}{% render 'sq-state-guard-root-reachable-counts' %}{% render 'sq-state-guard-connecticut-hotfix-v2' %}{% render 'sq-navy-patch-image-lock' %}
  </body>
</html>
