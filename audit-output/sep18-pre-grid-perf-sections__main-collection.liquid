{% if collection.handle == 'state-guard-ribbons-awards' %}
<style>
.sq-awards-split{max-width:1180px;margin:0 auto;padding:18px 20px 48px}.sq-awards-split__heading{margin:0 0 8px;color:#071d2d;font-size:clamp(28px,4vw,46px);font-weight:900;line-height:1.06}.sq-awards-split__intro{max-width:850px;margin:0 0 26px;color:#41505b;font-size:16px;line-height:1.55}.sq-awards-split__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.sq-awards-split__card{position:relative;display:flex;min-height:260px;flex-direction:column;overflow:hidden;border:1px solid #aeb8be;border-radius:14px;background:#fff;text-decoration:none!important;box-shadow:0 8px 22px rgba(7,29,45,.12);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.sq-awards-split__card::after{content:'';position:absolute;left:0;right:0;bottom:0;height:4px;background:#a91827}.sq-awards-split__card:hover,.sq-awards-split__card:focus-visible{transform:translateY(-4px);border-color:#a91827;box-shadow:0 14px 30px rgba(7,29,45,.24)}.sq-awards-split__card:focus-visible{outline:3px solid #d5ab4b;outline-offset:3px}.sq-awards-split__visual{display:grid;min-height:165px;flex:1;place-items:center;background:#fff;color:#17364d;font-size:54px;font-weight:950;letter-spacing:.06em}.sq-awards-split__copy{position:relative;min-height:95px;padding:16px 52px 17px 18px;background:#071d2d}.sq-awards-split__name{display:block;color:#fff;font-size:20px;font-weight:900;line-height:1.2}.sq-awards-split__meta{display:block;margin-top:6px;color:#c7d0d6;font-size:13px;font-weight:650;line-height:1.35}.sq-awards-split__arrow{position:absolute;right:18px;bottom:17px;color:#d5ab4b;font-size:24px;font-weight:900}@media(max-width:749px){.sq-awards-split{padding:12px 14px 38px}.sq-awards-split__grid{grid-template-columns:1fr;gap:14px}.sq-awards-split__card{min-height:220px}.sq-awards-split__visual{min-height:130px}}
</style>
<section class="sq-awards-split" aria-label="State Guard ribbons and awards choices"><h2 class="sq-awards-split__heading">Ribbons &amp; Awards</h2><p class="sq-awards-split__intro">Choose the award system you need. State Guard awards remain separate from federal U.S. Army service awards.</p><div class="sq-awards-split__grid"><a class="sq-awards-split__card" href="/collections/state-guard-awards"><span class="sq-awards-split__visual" aria-hidden="true">SG</span><span class="sq-awards-split__copy"><span class="sq-awards-split__name">State Guard Awards</span><span class="sq-awards-split__meta">State Guard and State Defense Force awards</span><span class="sq-awards-split__arrow" aria-hidden="true">→</span></span></a><a class="sq-awards-split__card" href="/collections/federal-service-awards"><span class="sq-awards-split__visual" aria-hidden="true">U.S.</span><span class="sq-awards-split__copy"><span class="sq-awards-split__name">Federal Service Awards</span><span class="sq-awards-split__meta">Federal U.S. Army ribbons, awards &amp; devices</span><span class="sq-awards-split__arrow" aria-hidden="true">→</span></span></a></div></section>
<style>body collection-component{display:none!important}</style>
{% else %}
{% if collection.handle == 'public-safety-series' %}<style>collection-component{display:none!important}</style>{% endif %}
<style>
html.sq-uniform-filter-results .sq-third-level,html.sq-uniform-filter-results .vac-unified-uniform-builder,html.sq-uniform-filter-results .sq-green-service-builder,html.sq-uniform-filter-results .vac-uniform-insignia-button,html.sq-uniform-filter-results .vac-uniform-checklist{display:none!important}html.sq-uniform-filter-results body collection-component,html.sq-uniform-filter-results body:has(.sq-third-level) collection-component{display:block!important}.sq-uniform-zero-placeholder{display:grid!important;width:100%!important;height:100%!important;place-items:center!important;background:#fff!important;color:#17364d!important;font-size:34px!important;font-weight:950!important;letter-spacing:.08em!important}
</style>
<script>
(function(){
 var path=window.location.pathname.toLowerCase().replace(/\/+$/,'');var isUniformPath=/(?:-ocp-uniform|-service-uniform|-green-service-uniform|-pt-uniform)$/.test(path);var isAgsuPath=/-green-service-uniform$/.test(path);var isAsuPath=/-service-uniform$/.test(path)&&!isAgsuPath;var uniformProductsPromise=null;
 function wireAwardsLinks(root){root=root||document;var links=root.querySelectorAll?root.querySelectorAll('a[href]'):[];for(var i=0;i<links.length;i+=1){var link=links[i];var href=link.getAttribute('href')||'';var label=String(link.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();var old=href.indexOf('/collections/sta-brite-u-s-army-asu-ribbons-devices')!==-1;var award=(link.classList.contains('vac-service-card')||link.classList.contains('vac-uniform-insignia-button__link'))&&(label.indexOf('ribbon')!==-1||label.indexOf('awards')!==-1);if(old||(isUniformPath&&award))link.setAttribute('href','/collections/state-guard-ribbons-awards');}}
 function fixOcpChecklistLinks(root){if(!isUniformPath)return;root=root||document;var links=root.querySelectorAll?root.querySelectorAll('a[href*="/products/truq-spec-"]'):[];for(var i=0;i<links.length;i+=1){var href=links[i].getAttribute('href')||'';links[i].setAttribute('href',href.replace('truq-spec-','tru-spec-'));}}
 function fixAgsuOuterwearRoutes(root){if(!isAgsuPath)return;root=root||document;var links=root.querySelectorAll?root.querySelectorAll('a[href]'):[];for(var i=0;i<links.length;i+=1){var link=links[i];var label=String(link.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();var type='';if(label.indexOf('bomber')!==-1)type='AGSU Bomber Jacket';else if(label.indexOf('ike jacket')!==-1)type='AGSU Ike Jacket';if(!type)continue;link.setAttribute('href',window.location.pathname+'?filter.p.product_type='+encodeURIComponent(type));link.setAttribute('data-product-type',type);}}
 function fixAsuShirtRoutes(root){if(!isAsuPath)return;root=root||document;var links=root.querySelectorAll?root.querySelectorAll('a[href]'):[];for(var i=0;i<links.length;i+=1){var link=links[i];var label=String(link.textContent||'').replace(/\s+/g,' ').trim().toLowerCase();var type='';if(label.indexOf('long-sleeve shirt')!==-1||label.indexOf('long sleeve shirt')!==-1)type='ASU Long Sleeve Shirt';else if(label.indexOf('short-sleeve shirt')!==-1||label.indexOf('short sleeve shirt')!==-1)type='ASU Short Sleeve Shirt';if(!type)continue;link.setAttribute('href',window.location.pathname+'?filter.p.product_type='+encodeURIComponent(type));link.setAttribute('data-product-type',type);}}
 function loadUniformProducts(){if(!isUniformPath)return Promise.resolve([]);if(uniformProductsPromise)return uniformProductsPromise;uniformProductsPromise=(async function(){var all=[];for(var page=1;page<=10;page+=1){try{var r=await fetch(window.location.pathname+'/products.json?limit=250&page='+page,{credentials:'same-origin'});if(!r.ok)break;var d=await r.json();var batch=d&&Array.isArray(d.products)?d.products:[];all=all.concat(batch);if(batch.length<250)break;}catch(e){break;}}return all;})();return uniformProductsPromise;}
 function verifyTypeCards(root){if(!isUniformPath)return;root=root||document;loadUniformProducts().then(function(products){var links=root===document?document.querySelectorAll('a[href*="filter.p.product_type="]'):(root.matches&&root.matches('a[href*="filter.p.product_type="]')?[root]:root.querySelectorAll?root.querySelectorAll('a[href*="filter.p.product_type="]'):[]);for(var i=0;i<links.length;i+=1){var link=links[i],url;try{url=new URL(link.getAttribute('href'),window.location.origin);}catch(e){continue;}var type=url.searchParams.get('filter.p.product_type');if(!type)continue;var wanted=String(type).trim().toLowerCase().replace(/\s+/g,' '),count=0;for(var j=0;j<products.length;j+=1){if(String(products[j].product_type||'').trim().toLowerCase().replace(/\s+/g,' ')===wanted)count+=1;}var meta=link.querySelector('.vac-service-card__meta,.vac-uniform-insignia-button__meta');if(meta){var text=count+' '+(count===1?'item':'items');if(meta.textContent!==text)meta.textContent=text;}if(count===0){var media=link.querySelector('.vac-service-card__media,.vac-uniform-insignia-button__media,.sq-third-level__media');if(media&&!media.querySelector('.sq-uniform-zero-placeholder')){var zero=document.createElement('span');zero.className='sq-uniform-zero-placeholder';zero.setAttribute('aria-hidden','true');zero.textContent='0';media.replaceChildren(zero);}}}}).catch(function(){});}
 function repairLinks(root){wireAwardsLinks(root);fixOcpChecklistLinks(root);fixAgsuOuterwearRoutes(root);fixAsuShirtRoutes(root);verifyTypeCards(root);}
 repairLinks(document);if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){repairLinks(document)},{once:true});var observer=new MutationObserver(function(records){for(var i=0;i<records.length;i+=1){for(var j=0;j<records[i].addedNodes.length;j+=1){var node=records[i].addedNodes[j];if(node.nodeType===1)repairLinks(node);}}});observer.observe(document.documentElement,{childList:true,subtree:true});window.setTimeout(function(){observer.disconnect();repairLinks(document)},8000);
 if(!isUniformPath)return;var params=new URLSearchParams(window.location.search);if(params.has('filter.p.product_type')){document.documentElement.classList.add('sq-uniform-filter-results');return;}
 document.addEventListener('click',function(event){var target=event.target;if(!(target instanceof Element))return;var link=target.closest('a.vac-service-card, a.sq-third-level__type');if(!link)return;var href=link.getAttribute('href');if(!href||href.indexOf('filter.p.product_type=')===-1||href.indexOf('filter.v.availability=')===-1)return;try{var url=new URL(href,window.location.origin);url.searchParams.delete('filter.v.availability');link.setAttribute('href',url.pathname+(url.searchParams.toString()?'?'+url.searchParams.toString():'')+url.hash)}catch(error){return;}},true);
})();
</script>
{% render 'vac-state-guard-ar6701' %}
<script src="{{ 'results-list.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script>(function(){var url=new URL(window.location.href);if(url.hash){document.addEventListener('DOMContentLoaded',function(){var card=document.getElementById(url.hash.slice(1));if(card)card.scrollIntoView({behavior:'instant'});},{once:true});}})();</script>
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}
{% render 'collection-wrapper-styles' %}
<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
{% # theme-check-disable-next-line UnknownFilter %}
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}" style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;" section-id="{{ section.id }}" infinite-scroll="false">
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}
    <div class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}">
      {% content_for 'block', type: 'filters', id: 'filters', results: collection, results_size: collection.products_count %}
      {% liquid
        assign products_per_page = 50
        assign sq_uniform_child_collection = false
        if collection.handle contains '-ocp-uniform' or collection.handle contains '-service-uniform' or collection.handle contains '-green-service-uniform' or collection.handle contains '-pt-uniform'
          assign sq_uniform_child_collection = true
        endif
        if sq_uniform_child_collection
          assign products_per_page = 250
        elsif template.suffix == '100' or template.suffix == 'packs-carry-100'
          assign products_per_page = 100
        endif
      %}
      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}<li id="{{ section.id }}-{{ product.id }}" class="product-grid__item product-grid__item--{{ forloop.index0 }}" data-page="{{ paginate.current_page }}" data-product-id="{{ product.id }}" ref="cards[]">{% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product, product_view_context: 'collection' %}</li>{% endfor %}
        {% endcapture %}
        {% render 'product-grid', section: section, children: children, products: collection.products, paginate: paginate, enable_infinite_scroll: false %}
      {% endpaginate %}
    </div>
  </results-list>
</collection-component>
{% endif %}
{% schema %}
{"name":"t:names.collection_container","enabled_on":{"templates":["collection"]},"settings":[{"type":"select","id":"layout_type","label":"t:settings.type","options":[{"value":"grid","label":"t:options.grid"},{"value":"organic","label":"t:options.editorial"}],"default":"grid"},{"type":"select","id":"product_card_size","label":"t:settings.card_size","options":[{"value":"small","label":"t:options.small"},{"value":"medium","label":"t:options.medium"},{"value":"large","label":"t:options.large"},{"value":"extra-large","label":"t:options.extra_large"}],"default":"medium","visible_if":"{{ section.settings.layout_type == 'grid' }}"},{"type":"select","id":"mobile_product_card_size","label":"t:settings.mobile_card_size","options":[{"value":"small","label":"t:options.small"},{"value":"large","label":"t:options.large"}],"default":"small"},{"type":"header","content":"Pagination"},{"type":"paragraph","content":"Collections use numbered pagination. Customers can choose 50 or 100 products per page."},{"type":"header","content":"t:content.layout"},{"type":"select","id":"product_grid_width","label":"t:settings.width","options":[{"value":"centered","label":"t:options.page"},{"value":"full-width","label":"t:options.full"}],"default":"centered"},{"type":"checkbox","id":"full_width_on_mobile","label":"t:settings.full_width_on_mobile","default":true,"visible_if":"{{ section.settings.product_grid_width != 'full-width' }}"},{"type":"range","id":"columns_gap_horizontal","label":"t:settings.horizontal_gap","min":0,"max":50,"step":1,"unit":"px","default":16},{"type":"range","id":"columns_gap_vertical","label":"t:settings.vertical_gap","min":0,"max":50,"step":1,"unit":"px","default":16},{"type":"range","id":"padding-inline-start","label":"t:settings.left_padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"range","id":"padding-inline-end","label":"t:settings.right_padding","min":0,"max":100,"step":1,"unit":"px","default":0},{"type":"header","content":"t:content.section_layout"},{"type":"color","id":"background_color","label":"t:settings.background_color","placeholder":"t:settings.default"},{"type":"range","id":"padding-block-start","label":"t:settings.top_padding","min":0,"max":100,"step":1,"unit":"px","default":8},{"type":"range","id":"padding-block-end","label":"t:settings.bottom_padding","min":0,"max":100,"step":1,"unit":"px","default":8}],"presets":[]}
{% endschema %}