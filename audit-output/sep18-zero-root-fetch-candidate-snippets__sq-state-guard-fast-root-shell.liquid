function n(x){return String(x||'').trim().toLowerCase().replace(/\s+/g,' ')}
function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function pv(){return new URL(location.href).searchParams.get('preview_theme_id')||''}
function href(cat,avail){var u=new URL(location.pathname,location.origin);if(avail)u.searchParams.set('filter.v.availability','1');u.searchParams.set('sg_category',cat);if(pv())u.searchParams.set('preview_theme_id',pv());return u.pathname+'?'+u.searchParams.toString()}
function find(grid,label){return [].slice.call(grid.querySelectorAll('a.sqsg-card')).find(function(a){var s=a.querySelector('strong');return s&&n(s.textContent)===n(label)})}
function make(d){var a=document.createElement('a');a.className='sqsg-card';a.href=href(d[1],d[3]);a.dataset.sqFastRootShell='true';a.innerHTML='<span class="sqsg-media"><img src="'+esc(d[2])+'" alt="'+esc(d[0])+'" loading="eager" decoding="async" style="object-fit:contain;object-position:center;background:#fff"></span><span class="sqsg-copy"><strong>'+esc(d[0])+'</strong><small>Browse items</small><b>→</b></span>';return a}
function ensure(){var view=root.querySelector('[data-sqsg-view]');if(!view)return false;var grid=view.querySelector('.sqsg-grid');if(!grid){view.innerHTML='<div class="sqsg-grid" data-sq-fast-root-grid="true"></div>';grid=view.querySelector('.sqsg-grid')}if(!grid)return false;DEF.forEach(function(d){var a=find(grid,d[0]);if(!a){a=make(d);grid.appendChild(a)}else{var sm=a.querySelector('small'),v=String(sm&&sm.textContent||'').trim().toLowerCase();if(sm&&(v==='checking items…'||v==='checking items...'||v==='loading items…'||v==='loading items...'))sm.textContent='Browse items'}});DEF.forEach(function(d,i){var a=find(grid,d[0]);if(a)grid.insertBefore(a,grid.children[i]||null)});view.dataset.sqFastRootShell='ready';return true}
