[120,300,600,1000,1600,2400].forEach(function(ms){setTimeout(ensure,ms)});
var view=root.querySelector('[data-sqsg-view]')||root;var queued=false;new MutationObserver(function(){if(queued)return;queued=true;requestAnimationFrame(function(){queued=false;ensure()})}).observe(view,{childList:true,subtree:true,characterData:true});
