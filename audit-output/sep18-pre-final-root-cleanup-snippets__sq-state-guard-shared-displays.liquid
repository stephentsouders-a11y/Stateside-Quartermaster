{% if request.page_type == 'collection' %}
{% if collection.handle contains 'state-guard-series-' or collection.handle == 'new-jersey-state-guard-naval-militia' %}
<script data-sq-state-guard-shared-displays>
(function(){
  if(window.__sqStateGuardSharedDisplays)return;
  window.__sqStateGuardSharedDisplays=true;
  var root=document.querySelector('[data-sqsg]');if(!root)return;
  var q=new URLSearchParams(location.search),org=q.get('sg_org')||'',cat=q.get('sg_category')||'',type=q.get('sg_type')||'';
  if(cat&&cat!=='displays')return;
  var STATE_NAMES=['alabama','alaska','california','connecticut','florida','georgia','indiana','louisiana','maryland','massachusetts','michigan','mississippi','new mexico','new jersey','new york','ohio','oregon','puerto rico','rhode island','south carolina','tennessee','texas','vermont','virginia','washington'];
  var TYPE_ORDER=['Flag Display Cases','Burial Flag Cases','Flag & Medal / Award Displays','Flag & Certificate / Document Displays','Multi-Flag Displays','Frames & Memorial Displays','Sword Display Plaques & Racks','Military Branch Flags','Other Displays & Memorials'];
  var cache=null;
  function n(x){return String(x||'').trim().toLowerCase().replace(/\s+/g,' ')}
  function tags(p){var t=p&&p.tags||[];return Array.isArray(t)?t:String(t).split(',').map(function(x){return x.trim()}).filter(Boolean)}
  function text(p){return n([p&&p.title,p&&p.product_type,tags(p).join(' ')].join(' '))}
  function titleType(p){return n([p&&p.title,p&&p.product_type].join(' '))}
  function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return c==='&'?'&amp;':c==='<'?'&lt;':c==='>'?'&gt;':c==='"'?'&quot;':'&#39;'})}
  function available(p){return p&&p.product_type!=='OPTIONS_HIDDEN_PRODUCT'&&(!p.variants||!p.variants.length||p.variants.some(function(v){return v.available===true}))}
  function hasTag(p,t){return tags(p).some(function(x){return n(x)===n(t)})}
  function stateSpecificToOther(p){var s=n(p&&p.title),here=n(root.dataset.state||'');return STATE_NAMES.some(function(st){return st!==here&&s.indexOf(st)!==-1})}
  function eligible(p){if(!available(p)||!hasTag(p,'State Guard Series')||!hasTag(p,'Service Branch - Army'))return false;if(stateSpecificToOther(p))return false;var s=titleType(p);return /flag.*display|display.*case|shadowbox|shadow box|award.*display|medal.*display|certificate.*display|memorial.*case|picture frame|flag frame|sword.*display|display plaque|military branch flags/.test(s)}
  function typeOf(p){var s=titleType(p),pt=n(p&&p.product_type);if(/burial flag/.test(s)||pt==='burial flag cases')return'Burial Flag Cases';if(/flag.*medal|medal.*display|award.*display|shadowbox|shadow box/.test(s)||/flag & medal display cases|military award & medal displays|medal & certificate display cases/.test(pt))return'Flag & Medal / Award Displays';if(/certificate|document/.test(s)||pt==='flag & document display cases')return'Flag & Certificate / Document Displays';if(/multi-flag|2 flag|two flag/.test(s)||pt==='multi-flag display cases')return'Multi-Flag Displays';if(/sword/.test(s)||pt==='sword display plaques & racks')return'Sword Display Plaques & Racks';if(pt==='military branch flags')return'Military Branch Flags';if(/flag display|flag case|flag frame/.test(s)||pt==='flag display cases')return'Flag Display Cases';if(/frame|memorial/.test(s)||pt==='picture frame')return'Frames & Memorial Displays';return'Other Displays & Memorials'}
  function unique(a){var seen={},out=[];(a||[]).forEach(function(p){if(p&&p.handle&&!seen[p.handle]){seen[p.handle]=1;out.push(p)}});return out}
  async function products(){if(cache)return cache;cache=(async function(){var all=[],base=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';if(base.slice(-1)!=='/')base+='/';for(var page=1;page<=4;page++){try{var r=await fetch(base+'collections/state-guard-series/products.json?limit=250&page='+page,{credentials:'same-origin'});if(!r.ok)break;var j=await r.json(),a=j&&Array.isArray(j.products)?j.products:[];a.forEach(function(p){if(eligible(p))all.push(p)});if(a.length<250)break}catch(e){break}}return unique(all)})();return cache}
  function image(p){var x=p&&p.images&&p.images[0];return x?(typeof x==='string'?x:(x.src||'')):''}
  function price(p){var v=p&&p.variants&&p.variants.find(function(x){return x.available===true})||p&&p.variants&&p.variants[0];return v&&v.price?'$'+v.price:''}
  function preview(){return new URL(location.href).searchParams.get('preview_theme_id')||''}
  function nav(extra,drop){var u=new URL(location.pathname,location.origin),pv=preview();if(org)u.searchParams.set('sg_org',org);Object.keys(extra||{}).forEach(function(k){if(extra[k])u.searchParams.set(k,extra[k])});(drop||[]).forEach(function(k){u.searchParams.delete(k)});if(pv)u.searchParams.set('preview_theme_id',pv);return u.pathname+(u.search?'?'+u.searchParams.toString():'')}
  function productHref(p){var u=new URL('/products/'+p.handle,location.origin),pv=preview();if(pv)u.searchParams.set('preview_theme_id',pv);return u.pathname+(u.search?'?'+u.searchParams.toString():'')}
  function card(label,count,href,p){var src=image(p);return '<a class="sqsg-card" href="'+esc(href)+'" data-sq-shared-display-card="1" data-sq-item-count="'+count+'"><span class="sqsg-media">'+(src?'<img src="'+esc(src)+'" alt="" loading="lazy" decoding="async">':'SQ')+'</span><span class="sqsg-copy"><strong>'+esc(label)+'</strong><small>'+count+' '+(count===1?'item':'items')+'</small><b>→</b></span></a>'}
  function productCard(p){var src=image(p),pr=price(p);return '<a class="sqsg-product" href="'+esc(productHref(p))+'" data-sq-shared-display-product="1"><span class="sqsg-pmedia">'+(src?'<img src="'+esc(src)+'" alt="'+esc(p.title)+'" loading="lazy" decoding="async">':'SQ')+'</span><span class="sqsg-pcopy"><strong>'+esc(p.title)+'</strong><small>'+esc(pr)+'</small></span></a>'}
  function findCard(view,label){return [].slice.call(view.querySelectorAll('.sqsg-card')).find(function(a){var s=a.querySelector('strong');return s&&n(s.textContent)===n(label)})}
  async function addRoot(view){var all=await products();if(!all.length)return;var grid=view.querySelector('.sqsg-grid');if(!grid||findCard(view,'Flags, Displays & Memorials'))return;grid.insertAdjacentHTML('beforeend',card('Flags, Displays & Memorials',all.length,nav({sg_category:'displays'},['sg_type','sg_component']),all[0]));view.dataset.sqSharedDisplays='category'}
  async function renderTypes(view){var all=await products(),g={};all.forEach(function(p){var k=typeOf(p);(g[k]||(g[k]=[])).push(p)});var z='<div class="sqsg-head"><a class="sqsg-back" href="'+esc(nav({},['sg_category','sg_type','sg_component']))+'">← Shop by Category</a><div><p>Flags, Displays &amp; Memorials</p><h2>Shop by Type</h2><small>'+all.length+' shared display '+(all.length===1?'item':'items')+'</small></div></div><div class="sqsg-grid">';TYPE_ORDER.forEach(function(k){var a=g[k]||[];if(a.length)z+=card(k,a.length,nav({sg_category:'displays',sg_type:k},['sg_component']),a[0])});z+='</div>';view.innerHTML=z;view.dataset.sqSharedDisplays='types'}
  async function renderFinal(view){var all=await products(),a=all.filter(function(p){return typeOf(p)===type}).sort(function(x,y){return String(x.title||'').localeCompare(String(y.title||''),undefined,{numeric:true,sensitivity:'base'})});var z='<div class="sqsg-head"><a class="sqsg-back" href="'+esc(nav({sg_category:'displays'},['sg_type','sg_component']))+'">← Display Types</a><div><p>Flags, Displays &amp; Memorials</p><h2>'+esc(type)+'</h2><small>'+a.length+' '+(a.length===1?'item':'items')+'</small></div></div>';if(a.length)z+='<section class="sqsg-section"><h3>SHARED MILITARY &amp; SERVICE DISPLAYS</h3><div class="sqsg-products">'+a.map(productCard).join('')+'</div></section>';else z+='<div class="sqsg-empty">No customer-purchasable display items are currently available in this selection.</div>';view.innerHTML=z;view.dataset.sqSharedDisplays='final'}
  var tries=0,t=setInterval(function(){tries++;var view=root.querySelector('[data-sqsg-view]');if(!view){if(tries>100)clearInterval(t);return}if(!cat&&view.querySelector('.sqsg-grid')){clearInterval(t);setTimeout(function(){addRoot(view)},250);return}if(cat==='displays'){clearInterval(t);if(type)renderFinal(view);else renderTypes(view);return}if(tries>100)clearInterval(t)},100);
})();
</script>
{% endif %}{% endif %}
