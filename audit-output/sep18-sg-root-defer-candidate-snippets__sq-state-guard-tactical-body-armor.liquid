<script data-sq-state-guard-tactical-authority-v3>
(function(){
if(window.__sqStateGuardTacticalBodyArmorV3)return;window.__sqStateGuardTacticalBodyArmorV3=true;
var root=document.querySelector('[data-sqsg]');if(!root)return;var q=new URLSearchParams(location.search),org=q.get('sg_org')||'',cat=q.get('sg_category')||'',bucket=q.get('sg_type')||'';if(cat&&cat!=='tactical')return;
var SOURCES=['tactical-packs-bags','pouches-load-carriage','packs-pouches-carry-gear-chest-rigs-load-carriage','tactical-belts-load-bearing-gear','tactical-gear-specialized-tactical-equipment','armor-plates-plate-carriers','plate-carriers-tactical-vests','helmets-accessories','ballistic-helmets-head-protection','water-hydration','first-aid-medical-ifak'];
var COLORS=['Multicam','Coyote','OD Green','Black'],cache={},promise=null;
function n(x){return String(x||'').toLowerCase().replace(/&amp;/g,'&').replace(/[^a-z0-9]+/g,' ').trim()}
function tags(p){return Array.isArray(p&&p.tags)?p.tags:[]}
function tx(p){return n([p&&p.title,p&&p.product_type,tags(p).join(' ')].join(' '))}
