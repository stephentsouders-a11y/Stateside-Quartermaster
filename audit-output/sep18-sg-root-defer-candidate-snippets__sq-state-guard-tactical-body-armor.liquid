function esc(s){return String(s||'').replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function avail(p){var v=p&&p.variants;return p&&n(p.product_type)!=='options hidden product'&&(!Array.isArray(v)||!v.length||v.some(function(x){return x&&x.available!==false}))}
function uniq(a){var m={},o=[];(a||[]).forEach(function(p){if(p&&p.handle&&!m[p.handle]){m[p.handle]=1;o.push(p)}});return o}
function forbidden(p){var s=tx(p),t=tt(p);if(/\b(rank|insignia|name tape|name plate|name badge|ribbon|medal|award|decoration|shoulder board|shoulder mark|epaulet|unit crest|branch insignia|qualification bar|morale patch|unit patch)\b/.test(s))return true;if(/\b(t shirt|tee|hoodie|sweatshirt|field shirt|combat shirt|uniform shirt|dress shirt|trouser|pants|shorts|sock|hosiery|stocking|boot|boots|footwear|dress shoe|uniform shoe|uniform coat|service coat|dress uniform|service uniform)\b/.test(t))return true;if(/\b(ammunition|ammo|cartridge|launcher|firearm|rifle|pistol|shotgun|holster|gun part|weapon part|less lethal launcher)\b/.test(s))return true;if(/\b(knife|knives|machete|axe|hatchet|sword|bayonet)\b/.test(t))return true;return false}
function tactical(p){var s=tx(p);return /plate carrier|body armor|body armour|armor plate|armour plate|ballistic plate|cummerbund|ballistic vest|side plate|soft armor|hard armor|carrier panel|helmet|head protection|mandible|visor|nvg mount|shroud|helmet rail|helmet cover|helmet pad|helmet liner|chest rig|load carriage|\bflc\b|\btaps\b|harness|tactical vest|battle belt|war belt|duty belt|load bearing belt|backpack|ruck|rucksack|assault pack|daypack|tactical pack|deployment bag|range bag|pouch|organizer|admin panel|placard|molle panel|molle adapter|molle clip|mag pouch|flap|insert|hydration|canteen|water bladder|reservoir|camelbak|ifak|first aid|medical pouch|trauma|tourniquet|medic|medical kit|sq verified tactical gear|tactical specialized equipment|military surplus field gear|field gear|protective gear|communications accessories|tactical headset|knee pad|elbow pad|hand warmer|gas mask|training equipment/.test(s)}
function eligible(p){return avail(p)&&!forbidden(p)&&tactical(p)}
async function loadCol(h){if(cache[h])return cache[h];cache[h]=(async function(){var out=[];for(var pg=1;pg<=8;pg++){try{var r=await fetch('/collections/'+encodeURIComponent(h)+'/products.json?limit=250&page='+pg,{credentials:'same-origin',cache:'no-store'});if(!r.ok)break;var j=await r.json(),a=Array.isArray(j&&j.products)?j.products:[];a.forEach(function(p){if(eligible(p))out.push(p)});if(a.length<250)break}catch(_){break}}return uniq(out)})();return cache[h]}
async function all(){if(promise)return promise;promise=(async function(){var x=await Promise.all(SOURCES.map(loadCol));return uniq([].concat.apply([],x))})();return promise}
function optionText(v){return n([v&&v.title,v&&v.option1,v&&v.option2,v&&v.option3].join(' '))}
function productText(p){return n([p&&p.title,tags(p).join(' ')].join(' '))}
function isBlackMC(s){s=n(s);return /multicam black|multi cam black|mcam black|mcamblk/.test(s)}
function isCamo(s){s=n(s);return /\bocp\b|scorpion|multicam|multi cam|camouflage|\bcamo\b|woodland|marpat|kryptek|flecktarn|\bucp\b|a tacs|atacs|m81|dpm|erdl|tropic/.test(s)}
function isMC(s){s=n(s);return !isBlackMC(s)&&!/\bucp\b|tropic/.test(s)&&/(\bocp\b|scorpion|multicam|multi cam|operational camouflage)/.test(s)}
function isCoy(s){return /\bcoyote\b|coyote brown|coyote tan/.test(n(s))}
function isOD(s){return /\bod green\b|olive drab|ranger green|\bod\b/.test(n(s))}
function isBlack(s){return /(^| )black( |$)/.test(n(s))}
function strict(s,c){s=n(s);if(!s)return false;if(c==='Multicam')return isMC(s)&&!isBlackMC(s);if(c==='Coyote')return isCoy(s)&&!isCamo(s)&&!isOD(s)&&!isBlack(s);if(c==='OD Green')return isOD(s)&&!isCamo(s)&&!isCoy(s)&&!isBlack(s);if(c==='Black')return isBlack(s)&&!isBlackMC(s)&&!isCamo(s)&&!isCoy(s)&&!isOD(s);return false}
function variantSignals(p){return (p&&p.variants||[]).filter(function(v){return v&&v.available!==false}).map(function(v){return{v:v,s:optionText(v)}})}
function matchVariant(p,c){var a=variantSignals(p),explicit=a.filter(function(x){return isMC(x.s)||isCoy(x.s)||isOD(x.s)||isBlack(x.s)||isBlackMC(x.s)||isCamo(x.s)});if(explicit.length){var m=explicit.find(function(x){return strict(x.s,c)});return m?m.v:null}return null}
function fallbackBucket(p,c){return strict(productText(p),c)}
function matches(p,c){var a=variantSignals(p),hasExplicit=a.some(function(x){return isMC(x.s)||isCoy(x.s)||isOD(x.s)||isBlack(x.s)||isBlackMC(x.s)||isCamo(x.s)});return hasExplicit?!!matchVariant(p,c):fallbackBucket(p,c)}
function byColor(a,c){return a.filter(function(p){return matches(p,c)})}
function src(x){if(!x)return'';if(typeof x==='string')return x;if(typeof x==='object')return String(x.src||x.url||'');return''}
function image(p,c){var v=matchVariant(p,c),s=src(v&&v.featured_image);if(s)return s;s=src(p&&p.featured_image);if(s)return s;var a=p&&p.images;if(Array.isArray(a)&&a.length)return src(a[0]);return''}
function price(p,c){var v=matchVariant(p,c)||(p&&p.variants||[]).find(function(x){return x&&x.available!==false})||(p&&p.variants||[])[0];return v&&v.price?'$'+v.price:''}
function pv(){return new URL(location.href).searchParams.get('preview_theme_id')||''}
function route(extra){var u=new URL(location.pathname,location.origin);u.searchParams.set('filter.v.availability','1');if(org)u.searchParams.set('sg_org',org);Object.keys(extra||{}).forEach(function(k){if(extra[k])u.searchParams.set(k,extra[k])});if(pv())u.searchParams.set('preview_theme_id',pv());return u.pathname+'?'+u.searchParams.toString()}
function ph(p,c){var u=new URL('/products/'+p.handle,location.origin),v=matchVariant(p,c);if(v&&v.id)u.searchParams.set('variant',String(v.id));if(pv())u.searchParams.set('preview_theme_id',pv());return u.pathname+u.search}
function rep(a,c){return (a||[]).find(function(p){return image(p,c)&&/plate carrier|body armor|chest rig|tactical vest|backpack|ruck|helmet|battle belt|war belt|pouch/.test(tx(p))})||(a||[]).find(function(p){return image(p,c)})||(a||[])[0]||null}
function card(label,a,c){var p=rep(a,c),m=p?image(p,c):'';return'<a class="sqsg-card" aria-label="Shop '+esc(label)+'" href="'+esc(route({sg_category:'tactical',sg_type:label}))+'" data-sq-item-count="'+a.length+'"><span class="sqsg-media">'+(m?'<img src="'+esc(m)+'" alt="" loading="lazy" decoding="async" style="object-fit:contain;object-position:center;background:#fff">':'SQ')+'</span><span class="sqsg-copy"><strong>'+esc(label)+'</strong><small>'+a.length+' '+(a.length===1?'item':'items')+'</small><b>→</b></span></a>'}
function pc(p,c){var m=image(p,c);return'<a class="sqsg-product" href="'+esc(ph(p,c))+'"><span class="sqsg-pmedia">'+(m?'<img src="'+esc(m)+'" alt="'+esc(p.title)+'" loading="lazy" decoding="async" style="object-fit:contain;object-position:center;background:#fff">':'SQ')+'</span><span class="sqsg-pcopy"><strong>'+esc(p.title)+'</strong><small>'+esc(price(p,c))+'</small></span></a>'}
async function renderColors(v){var a=await all(),html='<div class="sqsg-head"><a class="sqsg-back" href="'+esc(route({}))+'">← Shop by Category</a><div><p>TACTICAL GEAR &amp; BODY ARMOR</p><h2>Shop by Color / Pattern</h2><small>Strict color families: MultiCam, Coyote, OD/Ranger Green, Black.</small></div></div><div class="sqsg-grid">';COLORS.forEach(function(c){html+=card(c,byColor(a,c),c)});v.innerHTML=html+'</div>';v.dataset.sqTacticalAuthority='v3-colors'}
async function renderProducts(v){if(COLORS.indexOf(bucket)===-1){location.replace(route({sg_category:'tactical'}));return}var a=byColor(await all(),bucket).sort(function(x,y){return String(x.title||'').localeCompare(String(y.title||''),undefined,{numeric:true,sensitivity:'base'})}),html='<div class="sqsg-head"><a class="sqsg-back" href="'+esc(route({sg_category:'tactical'}))+'">← Tactical Gear Colors</a><div><p>TACTICAL GEAR &amp; BODY ARMOR</p><h2>'+esc(bucket)+'</h2><small>'+a.length+' '+(a.length===1?'item':'items')+'</small></div></div>';html+=a.length?'<section class="sqsg-section"><h3>'+esc(bucket.toUpperCase())+' TACTICAL GEAR &amp; BODY ARMOR</h3><div class="sqsg-products">'+a.map(function(p){return pc(p,bucket)}).join('')+'</div></section>':'<div class="sqsg-empty">No customer-purchasable tactical gear or body armor is currently available in this color.</div>';v.innerHTML=html;v.dataset.sqTacticalAuthority='v3-products'}
async function patchRoot(){var v=root.querySelector('[data-sqsg-view]'),g=v&&v.querySelector('.sqsg-grid');if(!g)return;var a=await all(),m={},pool=[];COLORS.forEach(function(c){byColor(a,c).forEach(function(p){if(!m[p.handle]){m[p.handle]=1;pool.push(p)}})});var target=[].slice.call(g.querySelectorAll('.sqsg-card')).find(function(x){return n((x.querySelector('strong')||{}).textContent||'')==='tactical gear body armor'});if(!target){var d=document.createElement('div'),c0='Black';for(var ci=0;ci<COLORS.length;ci++){if(pool.some(function(p){return matches(p,COLORS[ci])})){c0=COLORS[ci];break}}d.innerHTML=card('Tactical Gear & Body Armor',pool,c0);target=d.firstElementChild;target.href=route({sg_category:'tactical'});g.appendChild(target)}var st=target.querySelector('strong'),sm=target.querySelector('small');if(st)st.textContent='Tactical Gear & Body Armor';if(sm)sm.textContent=pool.length+' '+(pool.length===1?'item':'items');target.href=route({sg_category:'tactical'});target.dataset.sqItemCount=String(pool.length)}
function view(fn){var tries=0,t=setInterval(function(){var v=root.querySelector('[data-sqsg-view]');if(v){clearInterval(t);fn(v)}else if(++tries>160)clearInterval(t)},75)}
if(cat==='tactical'){view(function(v){bucket?renderProducts(v):renderColors(v)});return}
function deferRootPatch(){var run=function(){setTimeout(patchRoot,1200)};if('requestIdleCallback' in window){requestIdleCallback(run,{timeout:7000})}else{setTimeout(run,5000)}}
if(document.readyState==='complete')deferRootPatch();else window.addEventListener('load',deferRootPatch,{once:true});
})();
</script>
